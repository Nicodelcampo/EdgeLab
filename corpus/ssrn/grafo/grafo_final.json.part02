   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    69
   ],
   "definiciones": [
    {
     "texto": "Ejecución de múltiples backtests (escenarios) con distintos hiperparámetros, ventanas temporales y constraints en una sola corrida, con resultados agregados en una tabla única y heatmaps automáticos de robustez.",
     "doc_id": 69
