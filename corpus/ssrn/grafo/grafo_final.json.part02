   "nombres_vistos": [
    "price-dependent order intensity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    14
   ],
   "definiciones": [
    {
     "texto": "Regularidad empírica según la cual la tasa de llegada de órdenes depende de la distancia relativa del precio de la orden al mejor bid/ask; el paper la calibra con datos reales (matrices alpha, mu, beta, gamma) y confirma que mejora el ajuste frente a intensidades homogéneas.",
     "doc_id": 14
    }
   ],
   "citas": [
