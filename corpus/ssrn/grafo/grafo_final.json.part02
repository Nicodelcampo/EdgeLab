    36
   ],
   "definiciones": [
    {
     "texto": "Método de búsqueda exhaustiva sobre combinaciones de coeficientes del spread multi-activo (rango -3.00 a 3.00 en pasos de 0.01 aprox) para hallar los que minimizan el tiempo empírico de reversión a la media.",
     "doc_id": 36
