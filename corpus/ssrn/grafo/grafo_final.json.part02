  {
   "id": "arbitrage betting",
   "nombre_canonico": "arbitrage betting",
   "tipo": "estrategia",
   "nombres_vistos": [
    "arbitrage betting"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    43
   ],
   "definiciones": [
    {
     "texto": "Explotación de diferencias de odds entre distintos bookmakers/exchanges para asegurar una ganancia libre de riesgo, análogo al arbitraje financiero.",
     "doc_id": 43
    }
   ],
   "citas": [
    {
     "texto": "Arbitrage betting involves taking advantage of differing odds offered by different bookmakers to guarantee a profit regardless of the event's outcome.",
     "doc_id": 43
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
