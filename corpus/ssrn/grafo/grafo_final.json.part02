    }
   ]
  },
  {
   "id": "forced liquidation",
   "nombre_canonico": "forced liquidation",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "forced liquidation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    20
   ],
   "definiciones": [
    {
     "texto": "Riesgo de que un fondo con posiciones concentradas (como MotherRock en Natural Gas) deba liquidar posiciones abruptamente, generando movimientos extremos de precio no explicables por volatilidad normal.",
     "doc_id": 20
    }
   ],
   "citas": [
    {
     "texto": "The market had a preview of the intense liquidation pressure that could occur on the Natural Gas futures curve on 8/2/06, one day prior to the fund announcing its closure.",
     "doc_id": 20
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "liquidity sweep",
     "doc_id": 20,
     "revisar": false
    },
