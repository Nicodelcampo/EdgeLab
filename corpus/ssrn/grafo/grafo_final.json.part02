   ],
   "definiciones": [
    {
     "texto": "Extensión del Q-learning que usa redes neuronales para aproximar la función Q, permitiendo manejar espacios de estado continuos y de alta dimensión en trading.",
     "doc_id": 70
    }
   ],
   "citas": [
    {
     "texto": "An extension of Q-learning that uses a neural network to approximate the Q-value function. It enables learning in continuous and high-dimensional state spaces.",
     "doc_id": 70
    }
   ],
