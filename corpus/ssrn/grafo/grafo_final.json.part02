    }
   ]
  },
  {
   "id": "option pricing expansion",
   "nombre_canonico": "option pricing expansion",
   "tipo": "metodo",
   "nombres_vistos": [
    "option pricing expansion"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    10
   ],
   "definiciones": [
    {
     "texto": "Expansión cerrada del precio de una opción en términos del precio Black-Scholes y Greeks de orden superior, aplicable a modelos con dinámicas gobernadas por movimientos Brownianos con cambio de tiempo (saltos y volatilidad estocástica).",
     "doc_id": 10
    }
   ],
   "citas": [
    {
     "texto": "We show how the true price of an option less its Black-Scholes price is given by a series of premiums on higher-order risks that are not priced under the Black-Scholes model assumptions.",
     "doc_id": 10
    }
   ],
   "relaciones_crudas": [
    {
