   "doc_ids": [
    40
   ],
   "definiciones": [
    {
     "texto": "El AT detecta el order flow informado, opera en la misma dirección (back-running) y erosiona las rentas económicas extraíbles por traders informados, desincentivando la adquisición de información privada.",
     "doc_id": 40
    }
   ],
   "citas": [
    {
     "texto": "AT increases the incorporation of readily available information into prices, which discourages participants from acquiring private information",
