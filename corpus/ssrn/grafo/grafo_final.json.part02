    "deviation slope"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    17
   ],
   "definiciones": [
    {
     "texto": "Tasa de cambio de la desviación entre el WMPM y el precio de mercado; una pendiente positiva sostenida indica momentum alcista en fortalecimiento y gradúa el tamaño de posición (25% a 125%) según su persistencia.",
     "doc_id": 17
    }
   ],
   "citas": [
    {
     "texto": "A consistently positive deviation slope indicates strengthening bullish momentum, while a consistently negative slope suggests accelerating bearish momentum",
     "doc_id": 17
    }
   ],
   "relaciones_crudas": [
