    }
   ]
  },
  {
   "id": "log contract",
   "nombre_canonico": "log contract",
   "tipo": "metodo",
   "nombres_vistos": [
    "log contract"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    19
   ],
   "definiciones": [
    {
     "texto": "Posición corta estática en un contrato logarítmico que permite replicar la varianza total del subyacente de forma independiente del modelo, mediante una combinación ponderada de opciones europeas, siempre que el precio siga una difusión.",
     "doc_id": 19
    }
   ],
   "citas": [
    {
     "texto": "a static short position in a log-contract which can be replicated with a weighted combination of European options",
     "doc_id": 19
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "variance swap",
     "doc_id": 19,
     "revisar": false
    }
   ]
  },
  {
   "id": "implied correlation",
   "nombre_canonico": "implied correlation",
   "tipo": "concepto",
   "nombres_vistos": [
    "implied correlation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    19
   ],
   "definiciones": [
    {
     "texto": "Nivel de correlación que hay que introducir en un modelo (p.ej. fórmula de Kirk para spread options) para recuperar los precios de mercado; se interpreta como la expectativa del mercado de opciones sobre riesgo sistemático.",
     "doc_id": 19
    }
   ],
   "citas": [
    {
     "texto": "the implied correlation (IC) as the level of correlation to input in that formula in order to recover market prices",
     "doc_id": 19
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "systematic risk",
     "doc_id": 19,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "dispersion trading",
     "doc_id": 19,
     "revisar": false
    }
   ]
  },
  {
   "id": "implied correlation skew",
   "nombre_canonico": "implied correlation skew",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "implied correlation skew"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    19
   ],
   "definiciones": [
    {
     "texto": "Cuando la superficie de correlación implícita no es plana, indicando que las colas de la distribución conjunta de retornos no están bien capturadas por el marco lognormal multivariado.",
     "doc_id": 19
    }
   ],
   "citas": [
    {
     "texto": "practitioners call it the implied correlation skew (ICS), indicating that tail distributions are not properly captured in the multivariate lognormal framework",
     "doc_id": 19
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "implied correlation",
     "doc_id": 19,
     "revisar": false
    }
   ]
  },
  {
   "id": "correlation swap",
   "nombre_canonico": "correlation swap",
   "tipo": "concepto",
   "nombres_vistos": [
    "correlation swap"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    19
   ],
   "definiciones": [
    {
     "texto": "Swap entre la correlación promedio pairwise realizada de todos los miembros de un índice y un monto fijo determinado en el origen, desarrollado porque el dispersion trading no es una apuesta pura de correlación.",
     "doc_id": 19
    }
   ],
   "citas": [
    {
     "texto": "correlation swap developed as a swap between the average pairwise correlation of all members of an index and a ﬁxed amount determined at inception",
     "doc_id": 19
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "dispersion trading",
     "doc_id": 19,
     "revisar": false
    }
   ]
  },
  {
   "id": "mixvol model",
   "nombre_canonico": "MixVol model",
   "tipo": "metodo",
   "nombres_vistos": [
    "MixVol model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    19
   ],
   "definiciones": [
    {
     "texto": "Modelo paramétrico propio del paper para la superficie de volatilidad implícita, presentado como robusto, arbitrage-free en espacio y en tiempo, fácil de implementar y computacionalmente rápido, habilitando trading sistemático de volatilidad.",
     "doc_id": 19
    }
   ],
   "citas": [
    {
     "texto": "We then present an arbitrage-free model of implied volatility surface, which is robust, easy to implement and computationally fast, enabling for systematic volatility trading.",
     "doc_id": 19
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
