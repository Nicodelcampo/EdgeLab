     "tipo_original": "REQUIERE",
     "objeto_texto": "optimal execution",
     "doc_id": 20,
     "revisar": false
    }
   ]
  },
  {
   "id": "liquidity sweep",
   "nombre_canonico": "liquidity sweep",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "liquidity sweep"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    20
   ],
   "definiciones": [
    {
     "texto": "Movimiento extremo de precio causado por presión de liquidación forzada; el caso de estudio muestra el spread NG U-V moviéndose 4.5 desvíos estándar intradía por la liquidación del fondo MotherRock.",
     "doc_id": 20
    }
   ],
   "citas": [
    {
     "texto": "the spread’s intraday move, which is illustrated in the graph above, was 4.5 (12/2.67) standard deviations (based on very recent historical data)",
     "doc_id": 20
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "calendar spread",
     "doc_id": 20,
