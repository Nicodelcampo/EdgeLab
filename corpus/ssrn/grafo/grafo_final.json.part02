   "doc_ids": [
    67
   ],
   "definiciones": [
    {
     "texto": "Estrategia que maximiza el Sharpe ratio en base a la información observada, empleando la media a posteriori empírica bayesiana del alfa y suavizando las estimaciones transversalmente en lugar de cortarlas bruscamente.",
     "doc_id": 67
    }
   ],
   "citas": [
    {
     "texto": "The optimal strategy involves estimating the empirical distribution of alpha signals and assigning portfolio weights based on the relative magnitudes and associated uncertainty of the alpha estimates.",
