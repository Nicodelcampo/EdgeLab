     "doc_id": 10,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Taylor series expansion",
     "doc_id": 10,
     "revisar": false
    }
   ]
  },
  {
   "id": "taylor serie expansion",
   "nombre_canonico": "Taylor series expansion",
   "tipo": "metodo",
   "nombres_vistos": [
    "Taylor series expansion"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    10
   ],
   "definiciones": [
    {
     "texto": "Técnica de expansión bidimensional en Taylor del precio de la opción respecto al precio del subyacente y la varianza total, truncada a orden n, usada para derivar la aproximación cerrada.",
     "doc_id": 10
    }
   ],
   "citas": [
    {
     "texto": "we apply a two-dimensional Taylor series to expand (1.10) in the underlying asset price and total variance around the point (S0, EVT )",
     "doc_id": 10
    }
   ],
   "relaciones_crudas": [
