  {
   "id": "risk neutral measure",
   "nombre_canonico": "risk-neutral measure",
   "tipo": "concepto",
   "nombres_vistos": [
    "risk-neutral measure"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    31
   ],
   "definiciones": [
    {
     "texto": "Medida de probabilidad bajo la cual los precios de activos descontados son martingalas; el paper implementa el cambio hacia otras medidas (física o custom) mediante un derivado de Radon-Nikodym aplicado sobre el MAF.",
     "doc_id": 31
    }
   ],
   "citas": [
    {
     "texto": "MAFQ denotes the risk-neutral measure associated with the MAF",
     "doc_id": 31
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Radon-Nikodym derivative",
     "doc_id": 31,
     "revisar": false
    }
   ]
  },
  {
   "id": "radon nikodym derivative",
   "nombre_canonico": "Radon-Nikodym derivative",
   "tipo": "metodo",
   "nombres_vistos": [
    "Radon-Nikodym derivative"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    31
   ],
   "definiciones": [
    {
     "texto": "Factor usado para transformar el kernel de transición neutral al riesgo en una medida física o custom, permitiendo reponderar probabilidades sin resimular trayectorias.",
     "doc_id": 31
    }
   ],
   "citas": [
    {
     "texto": "Transitioning from a risk-neutral kernel... to a physical or custom measure... requires a Radon–Nikodym derivative",
     "doc_id": 31
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "likelihood ratio method",
     "doc_id": 31,
     "revisar": false
    }
   ]
  },
  {
   "id": "likelihood ratio method",
   "nombre_canonico": "likelihood ratio method",
   "tipo": "metodo",
   "nombres_vistos": [
    "likelihood ratio method"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    31
   ],
   "definiciones": [
    {
     "texto": "Técnica para reponderar trayectorias simuladas bajo una medida distinta a la original sin resimular, multiplicando el payoff por el ratio de verosimilitud acumulado a lo largo de la trayectoria.",
     "doc_id": 31
    }
   ],
   "citas": [
    {
     "texto": "For path-dependent securities, rather than re-simulating paths, we use the likelihood ratio method to reweight them.",
     "doc_id": 31
    }
   ],
