    68
   ],
   "definiciones": [
    {
     "texto": "Función hash criptográfica usada para encadenar registros de audit trail. Cada registro contiene el hash del registro anterior, formando una linked hash chain: alterar cualquier registro rompe la cadena completa, garantizando integridad.",
     "doc_id": 68
    }
   ],
   "citas": [
    {
     "texto": "Records form a linked hash chain via SHA-256; tampering with any record breaks the chain",
