  {
   "id": "bayesian belief updating",
   "nombre_canonico": "Bayesian belief updating",
   "tipo": "metodo",
   "nombres_vistos": [
    "Bayesian belief updating"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    28
   ],
   "definiciones": [
    {
     "texto": "Mecanismo por el cual el market maker en Glosten-Milgrom actualiza su probabilidad pt de que el activo valga 1, condicional en la secuencia observada de trades y precios, vía la regla de Bayes.",
     "doc_id": 28
    }
   ],
   "citas": [
    {
     "texto": "The market maker observes ht, updates her belief pt = Pr(v = 1 | ht) via Bayes’ rule, and sets quotes (Bt and At) to break even in expectation.",
     "doc_id": 28
    }
   ],
   "relaciones_crudas": [
