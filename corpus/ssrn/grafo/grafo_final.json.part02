    }
   ]
  },
  {
   "id": "graphical time serie analysi",
   "nombre_canonico": "graphical time-series analysis",
   "tipo": "metodo",
   "nombres_vistos": [
    "graphical time-series analysis"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    30
   ],
   "definiciones": [
    {
     "texto": "Método de portafolios en quintiles, ordenados por magnitud de beta, cuyo desempeño simulado se compara visualmente vía una línea de precio relativo para testear si beta alto predice retornos altos según el CAPM.",
     "doc_id": 30
    }
   ],
   "citas": [
    {
     "texto": "each share in the sample was ranked according to the magnitude of the 60-day ex-ante VWAP betas and placed into virtual portfolios in the form of quintiles",
     "doc_id": 30
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "VWAP beta",
     "doc_id": 30,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "CAPM",
     "doc_id": 30,
     "revisar": false
    }
   ]
  },
  {
   "id": "low beta anomaly",
   "nombre_canonico": "low-beta anomaly",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "low-beta anomaly"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    30
   ],
   "definiciones": [
    {
     "texto": "Hallazgo empírico de que acciones con beta más bajo generan retornos más altos que acciones con beta alto, invirtiendo la relación riesgo-retorno positiva postulada por el CAPM.",
     "doc_id": 30
    }
   ],
   "citas": [
    {
     "texto": "shares with a lower VWAP beta tend to outperform shares with high VWAP betas",
     "doc_id": 30
    }
   ],
