    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "tick size",
     "doc_id": 27,
     "revisar": false
    }
   ]
  },
  {
   "id": "mean reverting order book depth",
   "nombre_canonico": "mean-reverting order book depth",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "mean-reverting order book depth"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    27
   ],
   "definiciones": [
    {
     "texto": "Regularidad empírica de que el volumen y tamaño de cola del libro exhiben reversión a la media en escalas intermedias (horas, día) en lugar de tendencia, motivando la especificación del modelo de la Sección 4.",
     "doc_id": 27
    }
   ],
   "citas": [
    {
     "texto": "consistent with the observation that intraday dynamics of order book volume and queue size over intermediate time scales (hours, day) typically exhibit mean reversion rather than a trend",
     "doc_id": 27
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "midpoint reversion",
