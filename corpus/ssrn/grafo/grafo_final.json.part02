   "doc_ids": [
    67
   ],
   "definiciones": [
    {
     "texto": "El Sharpe ratio máximo alcanzable por una estrategia de trading que se restringe a usar únicamente información observable históricamente, sin depender de parámetros latentes del DGP.",
     "doc_id": 67
    }
   ],
   "citas": [
    {
     "texto": "Empirically, it is the feasible Sharpe ratio—not the unattainable, infeasible one—that reveals the minimum reward-to-risk compensation arbitrageurs require.",
     "doc_id": 67
    }
   ],
   "relaciones_crudas": [
