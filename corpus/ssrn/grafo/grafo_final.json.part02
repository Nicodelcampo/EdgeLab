    }
   ]
  },
  {
   "id": "open outcry trading",
   "nombre_canonico": "open-outcry trading",
   "tipo": "concepto",
   "nombres_vistos": [
    "open-outcry trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    20
   ],
   "definiciones": [
    {
     "texto": "Sistema de negociación en el que los traders se paran físicamente en un pit o ring, limitando la presencia de un market maker a un solo pit a la vez.",
     "doc_id": 20
    }
   ],
   "citas": [
    {
     "texto": "In open-outcry trading, traders physically stand in a trading ring or trading pit.",
     "doc_id": 20
    }
   ],
