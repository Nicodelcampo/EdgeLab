     "doc_id": 26,
     "revisar": false
    }
   ]
  },
  {
   "id": "queueing system",
   "nombre_canonico": "queueing systems",
   "tipo": "metodo",
   "nombres_vistos": [
    "queueing systems"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    26
   ],
   "definiciones": [
    {
     "texto": "Analogía y arsenal matemático (colas M/M/∞, procesos de nacimiento-muerte) de la que el paper toma inspiración para modelar el book, considerando las órdenes límite como clientes esperando ejecución o cancelación.",
     "doc_id": 26
    }
   ],
   "citas": [
    {
     "texto": "The dynamics of a limit order book resembles in many aspects that of a queuing system. Limit orders wait in a queue to be executed against market orders (or canceled).",
     "doc_id": 26
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "order book dynamics model",
     "doc_id": 26,
     "revisar": false
    }
   ]
  },
  {
   "id": "equilibrium model of limit order book",
   "nombre_canonico": "equilibrium models of limit order books",
   "tipo": "concepto",
   "nombres_vistos": [
    "equilibrium models of limit order books"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    26
   ],
   "definiciones": [
    {
     "texto": "Modelos alternativos (Parlour 1998, Foucault et al. 2005) que aportan insight sobre formación de precios pero contienen parámetros no observables de preferencias de agentes, difíciles de estimar.",
     "doc_id": 26
    }
   ],
   "citas": [
    {
     "texto": "These models provide interesting insights into the price formation process but contain unobservable parameters that govern agent preferences. Thus, they are diﬃcult to estimate and use in applications.",
     "doc_id": 26
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "order book dynamics model",
     "doc_id": 26,
     "revisar": false
    }
   ]
  },
  {
   "id": "unobservable behavioral parameter",
   "nombre_canonico": "unobservable behavioral parameters",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "unobservable behavioral parameters"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    26
   ],
   "definiciones": [
    {
     "texto": "Limitación de los modelos de microestructura basados en teoría de juegos que introducen parámetros de preferencias de agentes no observables, dificultando estimación y uso práctico; el paper evita esto.",
     "doc_id": 26
    }
   ],
   "citas": [
    {
     "texto": "One by-product of this study is to show how far a stochastic model can go in reproducing the dynamic properties of a limit order book without resorting to detailed behavioral assumptions about market participants or introducing unobservable parameters describing agent preferences",
     "doc_id": 26
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "order book dynamics model",
     "doc_id": 26,
     "revisar": false
    }
   ]
  },
  {
   "id": "level ii order book data",
   "nombre_canonico": "level II order book data",
   "tipo": "dato",
