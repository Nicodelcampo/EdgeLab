    }
   ]
  },
  {
   "id": "dual listed securitie",
   "nombre_canonico": "dual-listed securities",
   "tipo": "dato",
   "nombres_vistos": [
    "dual-listed securities"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    15
   ],
   "definiciones": [
    {
     "texto": "Caso de dos cotizaciones del mismo título en distintos mercados/monedas (ejemplo ANZ.AX vs ANZ.NZ) usado como ejemplo empírico donde las componentes estacionaria y no estacionaria son directamente observables porque el componente no estacionario proviene del tipo de cambio.",
     "doc_id": 15
    }
   ],
   "citas": [
    {
     "texto": "we illustrate the results of the previous section with an example synthetic asset constructed from the dual-listed pair of securities, ANZ.AX and ANZ.NZ",
     "doc_id": 15
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
