  {
   "id": "epsilon greedy strategy",
   "nombre_canonico": "epsilon-greedy strategy",
   "tipo": "metodo",
   "nombres_vistos": [
    "epsilon-greedy strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    36
   ],
   "definiciones": [
    {
     "texto": "Política de selección de acciones que elige acciones aleatorias con probabilidad epsilon durante entrenamiento y la acción de mayor Q-valor durante testeo (epsilon=0), balanceando exploración y explotación.",
     "doc_id": 36
    }
   ],
   "citas": [
    {
     "texto": "An epsilon-greedy strategy is employed for action selection.",
     "doc_id": 36
    }
   ],
