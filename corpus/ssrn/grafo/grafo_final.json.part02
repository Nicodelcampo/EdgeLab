    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "cointegration",
     "doc_id": 7,
     "revisar": false
    }
   ]
  },
  {
   "id": "pgff test",
   "nombre_canonico": "PGFF test",
   "tipo": "metodo",
   "nombres_vistos": [
    "PGFF test"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    7
   ],
   "definiciones": [
    {
     "texto": "Weighted symmetric estimator (Pantula-Gonzalez-Farias-Fuller) de raíz unitaria que, junto con PP, mostró la mayor área de poder óptimo entre los tests comparados y fue el único que mostró evidencia (débil) de persistencia de cointegración.",
     "doc_id": 7
    }
   ],
   "citas": [
    {
     "texto": "the most tantalizing results were obtained with the PGFF test at 𝑝= 0.05",
     "doc_id": 7
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
