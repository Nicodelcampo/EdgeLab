   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "vega risk"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    19
   ],
   "definiciones": [
    {
     "texto": "Riesgo asociado a cambios inesperados en la volatilidad implícita; el paper señala que la fórmula BS-vega es una aproximación útil pero teóricamente inconsistente bajo volatilidad estocástica.",
     "doc_id": 19
    }
   ],
   "citas": [
    {
     "texto": "the vega risk is associated with unexpected changes in volatility and should be accounted for",
     "doc_id": 19
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
