  {
   "id": "combinatorial purged cross validation",
   "nombre_canonico": "combinatorial purged cross-validation",
   "tipo": "metodo",
   "nombres_vistos": [
    "combinatorial purged cross-validation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    35
   ],
   "definiciones": [
    {
     "texto": "Método de validación citado como alternativa más robusta al WFO, que mejor aborda sesgos, se adapta a cambios de régimen y ofrece evaluaciones de desempeño más confiables mediante splits diversos de train-test.",
     "doc_id": 35
    }
   ],
   "citas": [
    {
     "texto": "its rigidity and computational intensity make it less robust compared to advanced methods like Combinatorial Purged Cross-Validation (CPCV), which better address biases, adapt to regime shifts, and offer more reliable performance assessments through diverse train-test splits",
     "doc_id": 35
    }
   ],
   "relaciones_crudas": [
