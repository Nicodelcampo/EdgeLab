   ],
   "definiciones": [
    {
     "texto": "Medida de \"tailedness\" de la distribución de retornos; usada para mostrar que la selección dinámica reduce la frecuencia de eventos extremos frente a la selección fija.",
     "doc_id": 35
    }
   ],
   "citas": [
