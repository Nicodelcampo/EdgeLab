  {
   "id": "black schole model",
   "nombre_canonico": "Black-Scholes model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Black-Scholes model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    10
   ],
   "definiciones": [
    {
     "texto": "Modelo de referencia clásico alrededor del cual el paper expande el precio verdadero de una opción como una serie de primas de riesgos de orden superior no valuados bajo sus supuestos.",
     "doc_id": 10
    }
   ],
   "citas": [
    {
     "texto": "we expand the true option price around the Black-Scholes price",
     "doc_id": 10
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
