   "id": "ask price increase probability",
   "nombre_canonico": "ask price increase probability",
   "tipo": "metrica",
   "nombres_vistos": [
    "ask price increase probability"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    14
   ],
   "definiciones": [
    {
     "texto": "Probabilidad condicional de que el próximo movimiento del precio ask sea al alza, condicionada al estado (profundidades bid/ask) del libro; métrica objetivo usada para validar el modelo contra datos reales.",
     "doc_id": 14
    }
   ],
   "citas": [
    {
     "texto": "ﬁnd the conditional probability that the ask price increases at the ﬁrst price movement",
     "doc_id": 14
    }
   ],
