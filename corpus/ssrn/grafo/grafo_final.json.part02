  {
   "id": "volatility smile",
   "nombre_canonico": "volatility smile",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "volatility smile"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    24
   ],
   "definiciones": [
    {
     "texto": "Patrón empírico observado en mercados reales donde la volatilidad implícita varía con el strike y el vencimiento, contradiciendo el supuesto de volatilidad constante de Black-Scholes.",
     "doc_id": 24
    }
   ],
   "citas": [
    {
     "texto": "In reality, volatility changes and depends on strike prices and expirations, creating volatility smiles and skews.",
     "doc_id": 24
    }
   ],
   "relaciones_crudas": [
    {
