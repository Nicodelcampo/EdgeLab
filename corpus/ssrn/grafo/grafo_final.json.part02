   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    6
   ],
   "definiciones": [
    {
     "texto": "Técnica de Lopez de Prado (2018) que remueve observaciones de entrenamiento cuyas ventanas de etiquetado se solapan con el set de test, combinada con embargoing (buffer temporal) para prevenir leakage por look-ahead bias.",
     "doc_id": 6
    }
   ],
   "citas": [
    {
     "texto": "Purging removes training observations whose label windows overlap with the test set, while embarging imposes a buffer period to prevent leakage.",
     "doc_id": 6
    }
   ],
