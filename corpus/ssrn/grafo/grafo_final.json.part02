    "attention mechanism"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    31
   ],
   "definiciones": [
    {
     "texto": "Interpretado en este marco como un cambio de medida de probabilidad; permite redistribuir dinámicamente la masa de probabilidad entre clusters de riesgo, análogo al mecanismo de atención de deep learning.",
     "doc_id": 31
    }
   ],
   "citas": [
