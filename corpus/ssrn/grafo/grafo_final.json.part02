   "definiciones": [
    {
     "texto": "Técnica que conecta modelos discretos de LOB (basados en colas) con modelos de ecuaciones diferenciales estocásticas mediante límites fluidos o de difusión bajo escalamiento apropiado; mencionada como dirección futura del framework.",
     "doc_id": 14
    }
   ],
   "citas": [
    {
     "texto": "studying various scaling limits of discrete order book models",
     "doc_id": 14
    }
   ],
