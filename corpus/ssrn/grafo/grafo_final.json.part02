   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    8
   ],
   "definiciones": [
    {
     "texto": "Diferencia de desempeño entre la cartera de pares fundamentalmente similares (P1) y la de pares fundamentalmente disímiles (P5); interpretada como el costo que soportan los arbitrajistas por operar pares espurios sin considerar fundamentals.",
     "doc_id": 8
    }
   ],
   "citas": [
    {
     "texto": "the performance difference between these two portfolios can be interpreted as the cost that arbitrageurs bear in trading spurious pairs if they do not consider fundamentals",
     "doc_id": 8
    }
   ],
