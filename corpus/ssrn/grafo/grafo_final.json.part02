   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    24
   ],
   "definiciones": [
    {
     "texto": "Supuesto central de Black-Scholes de que la volatilidad del activo permanece fija en el tiempo; el paper lo señala como la limitación más importante frente a mercados reales.",
     "doc_id": 24
    }
   ],
   "citas": [
    {
     "texto": "The model assumes that volatility stays the same over time.",
     "doc_id": 24
    }
