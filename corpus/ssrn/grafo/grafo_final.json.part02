    }
   ]
  },
  {
   "id": "in play bet delay",
   "nombre_canonico": "in-play bet delay",
   "tipo": "concepto",
   "nombres_vistos": [
    "in-play bet delay"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    43
   ],
   "definiciones": [
    {
     "texto": "Retraso deliberado entre la colocación y el matching de una apuesta en vivo, introducido para igualar el acceso a información y limitar ventajas de velocidad (equivalente sports del speed bump).",
     "doc_id": 43
    }
   ],
   "citas": [
    {
     "texto": "Betfair introduces a delay between when a bet is placed and when it is matched to ensure all participants have equal access to the latest information.",
     "doc_id": 43
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "latency arbitrage",
     "doc_id": 43,
     "revisar": false
    }
   ]
  },
  {
   "id": "courtsiding",
   "nombre_canonico": "courtsiding",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "courtsiding"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    43
   ],
   "definiciones": [
    {
     "texto": "Práctica de apostadores presentes en el estadio que explotan el retraso de la transmisión televisiva/broadcast para operar con información más rápida que el resto del mercado.",
     "doc_id": 43
    }
   ],
   "citas": [
    {
     "texto": "delays such as broadcast lags and in-play delays affect the betting landscape, giving rise to practices like \"courtsiding\" in tennis, where bettors at the venue attempt exploit the time lag.",
     "doc_id": 43
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "informed trading",
     "doc_id": 43,
     "revisar": false
    }
   ]
  },
  {
   "id": "dixon cole model",
