     "objeto_texto": "arithmetic Brownian motion",
     "doc_id": 15,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "signal-to-noise ratio",
     "doc_id": 15,
     "revisar": false
    }
   ]
  },
  {
   "id": "trade cycle length",
   "nombre_canonico": "trade cycle length",
   "tipo": "metrica",
   "nombres_vistos": [
    "trade cycle length"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    15
   ],
   "definiciones": [
    {
     "texto": "Tiempo total T = T1 + T2 requerido para completar un ciclo completo de compra y venta bajo la estrategia continua de bandas; su valor esperado y varianza tienen soluciones analíticas cerradas mediante funciones Erfi y series w1, w2.",
     "doc_id": 15
    }
   ],
   "citas": [
    {
     "texto": "Thus, the behaviour of T will largely determine the properties of the strategy",
     "doc_id": 15
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "non-stationary model for statistical arbitrage trading",
