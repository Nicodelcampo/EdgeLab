  {
   "id": "cointegration persistence",
   "nombre_canonico": "cointegration persistence",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "cointegration persistence"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    7
   ],
   "definiciones": [
    {
     "texto": "Hipótesis central testeada por el paper: si un par está cointegrado en un período de formación, ¿es más probable que siga estándolo en el siguiente período? El paper concluye que la evidencia no la sustenta.",
     "doc_id": 7
    }
   ],
   "citas": [
    {
     "texto": "The evidence does not support the hypothesis that cointegration is a persistent property.",
     "doc_id": 7
    }
   ],
