   "definiciones": [
    {
     "texto": "Capa adicional en la evaluación de estrategias cuantitativas enfocada en el seguimiento de métricas operativas y de negocio (KPIs) para alinear las metas de la mesa de trading con los objetivos corporativos de la empresa.",
     "doc_id": 74
    }
   ],
   "citas": [
    {
     "texto": "The Business Analytics Layer introduces: - ROI: Return on capital deployed - Turnover Ratio: Trading frequency - Drawdown: Risk evaluation - Profit Factor - Custom KPI Score",
     "doc_id": 74
    }
   ],
   "relaciones_crudas": [
