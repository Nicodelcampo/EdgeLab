   "doc_ids": [
    29
   ],
   "definiciones": [
    {
     "texto": "Precio de cierre diario/mensual usado tradicionalmente como input para calcular retornos y beta; el paper lo señala como menos eficiente que el VWAP para reflejar el precio de equilibrio.",
     "doc_id": 29
    }
   ],
   "citas": [
    {
     "texto": "a VWAP is closer to the equilibrium price of a share than the daily closing price",
