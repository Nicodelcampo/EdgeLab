  {
   "id": "time changed brownian motion",
   "nombre_canonico": "time-changed Brownian motion",
   "tipo": "concepto",
   "nombres_vistos": [
    "time-changed Brownian motion"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    10
   ],
   "definiciones": [
    {
     "texto": "Construcción del proceso de precio X mediante subordinación de Bochner de un movimiento Browniano por un proceso de varianza total, que permite generar saltos y skewness en los retornos.",
     "doc_id": 10
    }
   ],
   "citas": [
    {
     "texto": "X is obtained by Bochner's subordination of a Brownian motion with drift to V which can be interpreted either as the stochastic clock or the cumulative random variance",
     "doc_id": 10
    }
   ],
   "relaciones_crudas": [
    {
