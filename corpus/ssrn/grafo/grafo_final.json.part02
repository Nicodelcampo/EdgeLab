  {
   "id": "mixing representation",
   "nombre_canonico": "mixing representation",
   "tipo": "metodo",
   "nombres_vistos": [
    "mixing representation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    10
   ],
   "definiciones": [
    {
     "texto": "Representación del precio de una call europea como esperanza risk-neutral del precio Black-Scholes evaluado en el spot corregido y la varianza total, base analítica de las expansiones del paper.",
     "doc_id": 10
    }
   ],
   "citas": [
    {
     "texto": "we obtain the following mixing representation for its price C(S0, T ) at time t = 0",
     "doc_id": 10
    }
   ],
   "relaciones_crudas": [
    {
