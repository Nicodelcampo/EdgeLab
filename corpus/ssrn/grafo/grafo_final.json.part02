   ],
   "definiciones": [
    {
     "texto": "Relación estadística aparente entre variables sin vínculo causal real, ilustrada con el ejemplo humorístico de predecir el S&P 500 con producción de mantequilla, queso y población ovina.",
     "doc_id": 18
    }
   ],
   "citas": [
