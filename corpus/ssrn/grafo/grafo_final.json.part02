  {
   "id": "wick triggered stop loss",
   "nombre_canonico": "wick-triggered stop-loss",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "wick-triggered stop-loss"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    22
   ],
   "definiciones": [
    {
     "texto": "Fenómeno por el cual mechas intrabar del oro penetran transitoriamente niveles técnicos y disparan stops de distancia fija sin constituir una reversión de tendencia genuina.",
     "doc_id": 22
    }
   ],
   "citas": [
    {
     "texto": "gold’s intrabar wicks disproportionately represent transient liquidity imbalances rather than genuine directional reversals",
     "doc_id": 22
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "unnecessary losses",
     "doc_id": 22,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "trailing stop",
     "doc_id": 22,
     "revisar": false
    }
   ]
  },
  {
   "id": "atr position sizing",
   "nombre_canonico": "ATR position sizing",
   "tipo": "metodo",
   "nombres_vistos": [
    "ATR position sizing"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    22
   ],
   "definiciones": [
    {
     "texto": "Dimensionamiento de posición proporcional al riesgo fraccional de cuenta dividido por el ATR de 14 periodos, de modo que el tamaño se contrae en sesiones de alta volatilidad.",
     "doc_id": 22
    }
   ],
   "citas": [
    {
     "texto": "This formulation is analogous to the volatility-adjusted Kelly fraction discussed by Thorp (2006)",
     "doc_id": 22
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "volatility-adjusted Kelly fraction",
