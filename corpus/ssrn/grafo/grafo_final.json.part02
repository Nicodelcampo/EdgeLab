  {
   "id": "centred order book",
   "nombre_canonico": "centred order book",
   "tipo": "concepto",
   "nombres_vistos": [
    "centred order book"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    14
   ],
   "definiciones": [
    {
     "texto": "Representación del LOB en un marco móvil centrado en el mid-price en lugar de coordenadas de precio fijas, útil porque los traders se interesan en la región cercana a los mejores precios (spread, profundidad).",
     "doc_id": 14
    }
   ],
   "citas": [
    {
     "texto": "it is more convenient to use a moving frame with its origin at the mid-price",
     "doc_id": 14
    }
   ],
