  {
   "id": "state space filtering",
   "nombre_canonico": "state-space filtering",
   "tipo": "metodo",
   "nombres_vistos": [
    "state-space filtering"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    15
   ],
   "definiciones": [
    {
     "texto": "Método sugerido (p.ej. filtro de Kalman) para estimar los parámetros del modelo cuando las componentes Mt y Xt no son directamente observables, caso general de activos sintéticos.",
     "doc_id": 15
    }
   ],
   "citas": [
    {
     "texto": "the model parameters may be estimated by employing methods such as statespace ﬁltering [23]",
     "doc_id": 15
    }
   ],
   "relaciones_crudas": [
    {
