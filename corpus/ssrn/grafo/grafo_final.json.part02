    "level II order book data"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    26
   ],
   "definiciones": [
    {
     "texto": "Conjunto de datos de trades y cotizaciones a los 5 mejores niveles de precio a cada lado del book, más detallado que TAQ, usado para estimar los parámetros del modelo.",
     "doc_id": 26
    }
   ],
   "citas": [
    {
     "texto": "This data set, referred to as Level II order book data, provides a more detailed view of price dynamics than the Trade and Quotes (TAQ) data often used for high frequency data analysis",
     "doc_id": 26
    }
   ],
