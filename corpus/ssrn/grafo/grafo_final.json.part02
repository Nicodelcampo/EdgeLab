   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    35
   ],
   "definiciones": [
    {
     "texto": "Filtro arbitrario de mínimo 30 operaciones por par usado para descartar pares con desempeño anómalo derivado de muy baja frecuencia de trading, evitando conclusiones distorsionadas por outliers estadísticos.",
     "doc_id": 35
