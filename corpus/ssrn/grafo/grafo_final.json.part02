  {
   "id": "empirical evidence of inverse risk return relationship",
   "nombre_canonico": "empirical evidence of inverse risk-return relationship",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "empirical evidence of inverse risk-return relationship"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    29
   ],
   "definiciones": [
    {
     "texto": "Regularidad empírica documentada en literatura previa y confirmada en este paper: acciones con menor beta (menor riesgo sistemático estimado) tienden a superar en retorno a las de mayor beta, contradiciendo el tenet central del CAPM.",
     "doc_id": 29
    }
   ],
   "citas": [
    {
