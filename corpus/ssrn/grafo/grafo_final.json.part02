     "doc_id": 7,
     "revisar": false
    }
   ]
  },
  {
   "id": "variance ratio",
   "nombre_canonico": "variance ratio",
   "tipo": "metrica",
   "nombres_vistos": [
    "variance ratio"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    7
   ],
   "definiciones": [
    {
     "texto": "Cociente entre la varianza de los residuos (o innovaciones) del modelo de cointegración; el paper encuentra que afecta qué test de raíz unitaria resulta óptimo en cada caso.",
     "doc_id": 7
    }
   ],
   "citas": [
    {
     "texto": "if these variances are allowed to vary with respect to each other, then it can affect the power the unit root test",
