  {
   "id": "reward to risk ratio",
   "nombre_canonico": "reward-to-risk ratio",
   "tipo": "concepto",
   "nombres_vistos": [
    "reward-to-risk ratio"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    25
   ],
   "definiciones": [
    {
     "texto": "Relación entre el reward multiple b y el riesgo unitario (1R) que define el payoff asimétrico del sistema; el paper muestra que aumentarlo reduce el break-even win rate pero también aumenta la varianza del proceso, dificultando la validación estadística.",
     "doc_id": 25
    }
   ],
   "citas": [
    {
     "texto": "increasing 𝑏lowers the break-even win rate, but it also increases the noise of the process, so higher reward asymmetry does not make edge easier to validate statistically",
     "doc_id": 25
    }
   ],
