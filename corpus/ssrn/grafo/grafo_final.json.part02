     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "trading strategy variance",
     "doc_id": 15,
     "revisar": false
    }
   ]
  },
  {
   "id": "non stationary model for statistical arbitrage trading",
   "nombre_canonico": "non-stationary model for statistical arbitrage trading",
   "tipo": "estrategia",
   "nombres_vistos": [
    "non-stationary model for statistical arbitrage trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    15
   ],
   "definiciones": [
    {
     "texto": "Modelo propuesto en el paper donde el log-precio del activo sintético St = Xt + Mt es la suma de un proceso Ornstein-Uhlenbeck (Xt) y un movimiento Browniano aritmético (Mt); define una estrategia continua de trading con bandas b1<b2 sobre Xt.",
     "doc_id": 15
    }
   ],
   "citas": [
    {
     "texto": "we propose a model for asset dynamics as an Ornstein-Uhlenbeck process with stochastic mean",
     "doc_id": 15
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Ornstein-Uhlenbeck process",
     "doc_id": 15,
