   "tipo": "metodo",
   "nombres_vistos": [
    "event-driven backtesting"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    69
   ],
   "definiciones": [
    {
     "texto": "Simulación realista de ejecución de órdenes trade a trade, estrictamente secuencial, que replica un sistema de order routing real con constraints de cash y exposición; el paper la contrapone al backtesting tensorial (vectorizado).",
     "doc_id": 69
    }
   ],
   "citas": [
    {
     "texto": "The extensive logic within the order execution simulation aims to resemble real-world order execution systems as closely as possible",
     "doc_id": 69
    }
   ],
