  {
   "id": "exponential decay weighting",
   "nombre_canonico": "exponential decay weighting",
   "tipo": "metodo",
   "nombres_vistos": [
    "exponential decay weighting"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    17
   ],
   "definiciones": [
    {
     "texto": "Pesos w_i = λ^(i-1) × e^(−θ×|P_i − P_best|/P_best) que reducen progresivamente la contribución de niveles profundos del libro; el paper recomienda λ 0.70-0.85 y θ 0.3-0.6 según el tipo de futuro.",
     "doc_id": 17
    }
   ],
   "citas": [
    {
     "texto": "For Equity Index Futures, a level decay of 0.85 with price sensitivity of 0.3 across 5-10 levels typically works well",
     "doc_id": 17
    }
   ],
   "relaciones_crudas": [
