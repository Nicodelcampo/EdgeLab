   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    25
   ],
   "definiciones": [
    {
     "texto": "Supuesto central del modelo base: los trades son independientes e idénticamente distribuidos; el paper reconoce que procesos reales pueden exhibir dependencia serial, regímenes cambiantes y no-estacionariedad, limitando la aplicabilidad directa.",
     "doc_id": 25
    }
   ],
   "citas": [
    {
     "texto": "it is built on a benchmark model with i.i.d. trade outcomes and a binary payoff structure",
     "doc_id": 25
    }
   ],
