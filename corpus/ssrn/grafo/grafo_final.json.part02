   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    35
   ],
   "definiciones": [
    {
     "texto": "Retraso de dos días aplicado entre la generación de la señal y la ejecución de la operación, para simular condiciones reales de trading y fricciones de mercado.",
     "doc_id": 35
    }
   ],
   "citas": [
