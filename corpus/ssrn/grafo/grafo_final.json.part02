   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    27
   ],
   "definiciones": [
    {
     "texto": "Representación de un proceso de dimensión infinita u_t mediante un proceso Markov de baja dimensión Z_t y un mapa φ, que hace el modelo computacionalmente tratable para estimación y simulación.",
     "doc_id": 27
    }
   ],
   "citas": [
    {
     "texto": "A process u = (ut)t≥0 taking values in an (infinite-dimensional) function space E is said to admit a finite dimensional realization of dimension d ∈N if there exists an Rd-valued stochastic process Z",
     "doc_id": 27
    }
   ],
