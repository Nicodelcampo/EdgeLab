  {
   "id": "reciprocal gamma diffusion",
   "nombre_canonico": "reciprocal gamma diffusion",
   "tipo": "metodo",
   "nombres_vistos": [
    "reciprocal gamma diffusion"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    27
   ],
   "definiciones": [
    {
     "texto": "Forma en que se reescribe la dinámica del volumen bid/ask (V^a_t, V^b_t) para la estimación de parámetros; distribución estacionaria Inverse Gamma con cola tipo Pareto.",
     "doc_id": 27
    }
   ],
   "citas": [
    {
     "texto": "Let us rewrite the dynamics of V a t and V b t in the form of reciprocal Gamma diﬀusions",
     "doc_id": 27
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
