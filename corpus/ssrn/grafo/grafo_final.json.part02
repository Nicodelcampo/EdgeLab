   "nombres_vistos": [
    "optimization window sensitivity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    35
   ],
   "definiciones": [
    {
     "texto": "Regularidad empírica observada: ventanas cortas de WFO (1-6 meses) son muy reactivas y volátiles con drawdowns grandes, ventanas medias (18 meses) dan métricas altas pero sospechosas de overfitting, y ventanas largas (24-60 meses) dan desempeño más estable.",
     "doc_id": 35
    }
   ],
   "citas": [
    {
     "texto": "shorter windows, such as 1 to 6 months, demonstrate high variability and appear overly reactive to short-term patterns in the data",
     "doc_id": 35
    }
   ],
