    }
   ]
  },
  {
   "id": "crisi mode operating system",
   "nombre_canonico": "crisis mode operating system",
   "tipo": "estrategia",
   "nombres_vistos": [
    "crisis mode operating system"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    48
   ],
   "definiciones": [
    {
     "texto": "Submódulo que ajusta dinámicamente exposición, ponderación de señales y comportamiento de ejecución cuando se detectan condiciones de crisis, operando en tres fases: Shock, Instability y Stabilization.",
     "doc_id": 48
    }
   ],
   "citas": [
    {
     "texto": "AlphaGen incorporates a dedicated Crisis Mode Operating System (CMOS) to maintain performance stability and strategic coherence during periods of elevated market stress.",
     "doc_id": 48
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "liquidity fluctuation",
     "doc_id": 48,
