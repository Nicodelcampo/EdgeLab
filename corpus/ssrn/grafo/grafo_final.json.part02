  {
   "id": "myopic trader zero intelligence",
   "nombre_canonico": "Myopic traders / Zero-intelligence",
   "tipo": "concepto",
   "nombres_vistos": [
    "Myopic traders / Zero-intelligence"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    71
   ],
   "definiciones": [
    {
     "texto": "Agentes en el modelo que toman decisiones de trading de manera aleatoria e inmediatista, guiados por una expectativa de cambio de precio uniforme y sin consideraciones de riesgo.",
     "doc_id": 71
    }
   ],
   "citas": [
    {
     "texto": "a myopic, random (zero intelligent) trader makes a trading decision... If the price is expected to increase by the trader i, a bid (buy) order is submitted.",
     "doc_id": 71
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "bistability bimodal dynamic",
   "nombre_canonico": "Bistability / Bimodal Dynamics",
   "tipo": "concepto",
   "nombres_vistos": [
    "Bistability / Bimodal Dynamics"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    71
   ],
   "definiciones": [
    {
     "texto": "Propiedad del mercado simulado donde las trayectorias de precios convergen hacia dos estados finales distintos (precio cero o precio positivo) a pesar de partir de condiciones idénticas.",
     "doc_id": 71
    }
   ],
   "citas": [
    {
     "texto": "The study also identifies a metastable region with elevated volatility between the basins of attraction... agent-based price dynamics possess intrinsic bistability",
     "doc_id": 71
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSADO_POR",
     "tipo_original": "CAUSADO_POR",
     "objeto_texto": "supercritical pitchfork bifurcation",
     "doc_id": 71,
     "revisar": true
    }
   ]
  },
  {
   "id": "supercritical pitchfork bifurcation",
   "nombre_canonico": "Supercritical pitchfork bifurcation",
   "tipo": "concepto",
   "nombres_vistos": [
    "Supercritical pitchfork bifurcation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    71
   ],
   "definiciones": [
    {
     "texto": "Fenómeno de los sistemas dinámicos que explica la transición del sistema desde un único punto fijo estable a dos nuevos puntos estables, induciendo la biestabilidad del mercado.",
     "doc_id": 71
    }
   ],
   "citas": [
    {
     "texto": "The evolution of the system with two diverging average price trajectories over time strongly resembles a supercritical pitchfork bifurcation in a stochastic setting.",
     "doc_id": 71
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Bistability / Bimodal Dynamics",
     "doc_id": 71,
     "revisar": false
    }
   ]
  },
  {
   "id": "poincare map",
   "nombre_canonico": "Poincaré maps",
   "tipo": "metodo",
   "nombres_vistos": [
    "Poincaré maps"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    71
   ],
   "definiciones": [
    {
     "texto": "Técnica de análisis de sistemas dinámicos para estudiar el comportamiento caótico, discretizando trayectorias para visualizar cuencas de atracción de precios.",
     "doc_id": 71
    }
   ],
   "citas": [
    {
     "texto": "The Poincaré map is a technique employed in the analysis of dynamical systems, focusing on the intersections of the system’s trajectory in the phase space with a lower-dimensional subspace",
     "doc_id": 71
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Bistability / Bimodal Dynamics",
     "doc_id": 71,
     "revisar": false
    }
   ]
  },
  {
   "id": "fractal dimension",
   "nombre_canonico": "Fractal dimension",
   "tipo": "metrica",
   "nombres_vistos": [
    "Fractal dimension"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    71
   ],
   "definiciones": [
    {
     "texto": "Medida de complejidad que sugiere un comportamiento de caos intermitente o de baja dimensión en lugar de aleatoriedad pura en la dinámica de precios.",
     "doc_id": 71
    }
   ],
   "citas": [
    {
     "texto": "The fractal (correlation) dimension quantifies the complexity of a time series by describing how the system fills its phase space.",
     "doc_id": 71
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "chaotic characteristics",
     "doc_id": 71,
     "revisar": false
    }
   ]
  },
  {
   "id": "liquidity ratio",
   "nombre_canonico": "liquidity ratio",
   "tipo": "metrica",
   "nombres_vistos": [
    "liquidity ratio"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    72
   ],
   "definiciones": [
    {
     "texto": "Métrica propuesta por Cooper, Groth y Avera (1985) que mide el volumen de capital necesario para inducir un cambio del 1% en el precio, evaluando la profundidad y resiliencia del mercado.",
     "doc_id": 72
    }
   ],
   "citas": [
    {
     "texto": "I therefore calculate the liquidity ratio of Cooper et al. (1985) which measures the volume (denoted in the respective currency) that is necessary to induce a 1% price change.",
     "doc_id": 72
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "liquidity",
     "doc_id": 72,
     "revisar": false
    }
   ]
  },
  {
   "id": "corwin and schultz measure",
   "nombre_canonico": "Corwin and Schultz measure",
   "tipo": "metrica",
   "nombres_vistos": [
    "Corwin and Schultz measure"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    72
   ],
   "definiciones": [
    {
     "texto": "Estimador del spread que utiliza los precios máximos y mínimos diarios, usado como alternativa al estimador de Roll.",
     "doc_id": 72
    }
   ],
   "citas": [
    {
     "texto": "I also use the spread measure proposed by Corwin and Schultz (2012) which relies on daily high and low prices.",
     "doc_id": 72
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "bid-ask spread",
     "doc_id": 72,
     "revisar": false
    }
   ]
  },
  {
   "id": "tick test",
   "nombre_canonico": "tick test",
   "tipo": "metodo",
   "nombres_vistos": [
    "tick test"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    72
   ],
   "definiciones": [
    {
     "texto": "Regla utilizada para inferir la dirección de las operaciones (comprador o vendedor iniciador) comparando el precio de transacción con el precio anterior.",
     "doc_id": 72
    }
   ],
   "citas": [
    {
     "texto": "In order to infer the trade direction, I use the tick test according to Lee and Ready (1991). A transaction is considered to be buyer-initiated (seller-initiated) if the transaction price is higher (lower) than the previously recorded transaction price.",
     "doc_id": 72
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "trade direction",
     "doc_id": 72,
     "revisar": false
    }
   ]
  },
  {
   "id": "huang and stoll model",
   "nombre_canonico": "Huang and Stoll model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Huang and Stoll model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    72
   ],
   "definiciones": [
    {
     "texto": "Modelo de descomposición del spread basado en indicadores de transacciones que separa los costos de selección adversa asumiendo que el valor fundamental sigue un random walk que incorpora información privada.",
     "doc_id": 72
    }
   ],
   "citas": [
    {
     "texto": "In the model by Huang and Stoll (1997), the evolution of the fundamental value is assumed to take private information into account.",
     "doc_id": 72
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "adverse selection",
     "doc_id": 72,
     "revisar": false
    }
   ]
  },
  {
   "id": "glosten and harri model",
   "nombre_canonico": "Glosten and Harris model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Glosten and Harris model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    72
   ],
   "definiciones": [
    {
     "texto": "Modelo de descomposición del spread que permite que la selección adversa y el componente de inventario dependan del tamaño de la orden (order size).",
     "doc_id": 72
    }
   ],
   "citas": [
    {
     "texto": "Glosten and Harris (1988) allow the adverse selection and the inventory holding component to depend on order size.",
     "doc_id": 72
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "adverse selection",
     "doc_id": 72,
     "revisar": false
    }
   ]
  },
  {
   "id": "madhavan et al model",
   "nombre_canonico": "Madhavan et al. model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Madhavan et al. model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    72
   ],
   "definiciones": [
    {
     "texto": "Modelo de microestructura que asume que únicamente la sorpresa o el componente inesperado del flujo de órdenes (order flow) afecta el valor fundamental del activo.",
     "doc_id": 72
    }
   ],
   "citas": [
    {
     "texto": "Madhavan et al. (1997) assume that only the surprise component of the order flow affects the fundamental value",
     "doc_id": 72
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "adverse selection",
     "doc_id": 72,
     "revisar": false
    }
   ]
  },
  {
   "id": "bubble",
   "nombre_canonico": "bubble",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "bubble"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    73
   ],
   "definiciones": [
    {
     "texto": "Patrón de precios donde el valor negociado supera por mucho los dividendos máximos posibles y luego colapsa hacia el valor fundamental.",
     "doc_id": 73
    }
   ],
   "citas": [
    {
     "texto": "the price per asset starts below the fundamental value, but then quickly rises, often above the sum of maximum possible dividends. Towards the end the price drops again quickly",
     "doc_id": 73
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "fundamental value",
   "nombre_canonico": "fundamental value",
   "tipo": "metrica",
   "nombres_vistos": [
    "fundamental value"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    73
   ],
   "definiciones": [
    {
     "texto": "Valor teórico subyacente de un activo, calculado como la suma esperada de sus pagos futuros (dividendos), respecto al cual se miden las desviaciones en burbujas.",
     "doc_id": 73
    }
   ],
   "citas": [
    {
     "texto": "The fundamental value of an asset in round 1 is 15 × 24 = 360 ECU, decreasing by 24 ECU at the end of each round.",
     "doc_id": 73
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "strategic uncertainty",
   "nombre_canonico": "strategic uncertainty",
   "tipo": "concepto",
   "nombres_vistos": [
    "strategic uncertainty"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    73
   ],
   "definiciones": [
    {
     "texto": "Incertidumbre que tienen los participantes sobre las estrategias de sus contrapartes, elemento que difiere fuertemente entre mercados humanos puros y mercados con bots.",
     "doc_id": 73
    }
   ],
   "citas": [
    {
     "texto": "In 6H subjects know that they trade with humans. Hence, in the 6H treatment there is substantial strategic uncertainty while in 1H5C there is no strategic uncertainty at all.",
     "doc_id": 73
    }
   ],
