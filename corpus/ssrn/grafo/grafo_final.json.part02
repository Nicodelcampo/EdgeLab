   "tipo": "concepto",
   "nombres_vistos": [
    "Glosten-Milgrom model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    28
   ],
   "definiciones": [
    {
     "texto": "Modelo secuencial de un activo binario donde el market maker fija bid y ask actualizando su creencia bayesiana tras cada operación, en función de si el trader es informado o no.",
     "doc_id": 28
    }
   ],
   "citas": [
    {
     "texto": "Consider one risky asset with value v drawn from the set v ∈0, 1. A competitive market maker has an initial belief Pr(v = 1) = p1 = 1 2.",
     "doc_id": 28
    }
   ],
