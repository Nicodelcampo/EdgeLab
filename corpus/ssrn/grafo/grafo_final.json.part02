   "tipo": "metodo",
   "nombres_vistos": [
    "harmonic average"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    56
   ],
   "definiciones": [
    {
     "texto": "Tipo de promedio (no aritmético) que, según el paper, es el correcto para combinar la varianza de la volatilidad local a lo largo de la trayectoria clásica y obtener la volatilidad de la distribución.",
     "doc_id": 56
    }
   ],
   "citas": [
    {
     "texto": "the average is not the arithmetic average or its continuous limit, but it is a harmonic average",
     "doc_id": 56
    }
   ],
