   "tipo": "concepto",
   "nombres_vistos": [
    "capability satisficing"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    76
   ],
   "definiciones": [
    {
     "texto": "Comportamiento donde las firmas asignan capital a estrategias de trading que alcanzan un objetivo o nivel de aspiración satisfactorio, en lugar de buscar el óptimo teórico, a causa de la racionalidad limitada y la complejidad del entorno.",
     "doc_id": 76
    }
   ],
   "citas": [
    {
     "texto": "these firms are capability satisficers. They allocate to strategies that achieve some target, goal, or aspiration level, or simply that are “good enough.”",
     "doc_id": 76
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "adaptive markets hypothesis",
