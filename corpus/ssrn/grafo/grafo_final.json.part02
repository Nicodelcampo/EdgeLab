  {
   "id": "variance swap",
   "nombre_canonico": "variance swap",
   "tipo": "concepto",
   "nombres_vistos": [
    "variance swap"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    19
   ],
   "definiciones": [
    {
     "texto": "Contrato forward sobre la varianza realizada anualizada del activo subyacente; ofrece exposición a varianza sin necesidad de delta-hedging, a diferencia de comprar/vender opciones vanilla.",
     "doc_id": 19
    }
   ],
   "citas": [
    {
     "texto": "It gives investors exposure to variance without directly exposing themselves to movements in the underlying since it does not require delta hedging",
     "doc_id": 19
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
