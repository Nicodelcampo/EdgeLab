  {
   "id": "bid ask order flow correlation",
   "nombre_canonico": "bid-ask order flow correlation",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "bid-ask order flow correlation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    27
   ],
   "definiciones": [
    {
     "texto": "Correlación negativa observada empíricamente entre los flujos de orden de compra y venta (ϱ_a,b), generada por market makers, que reduce la volatilidad del precio en el modelo.",
     "doc_id": 27
    }
   ],
   "citas": [
    {
     "texto": "We observe negative values of correlation ϱa,b across bid and ask order ﬂows which is consistent with observations in (Carmona and Webster, 2013)",
