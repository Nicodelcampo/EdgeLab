   "tipo": "metodo",
   "nombres_vistos": [
    "Walk-Forward Optimization"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    35
   ],
   "definiciones": [
    {
     "texto": "Recalibración dinámica de parámetros de estrategia mediante ventanas rodantes de entrenamiento y testeo, usando solo información disponible hasta cada punto para mitigar sesgo de anticipación y evaluar robustez fuera de muestra.",
     "doc_id": 35
    }
   ],
   "citas": [
    {
     "texto": "By utilizing only the information available at each historical point, it mitigates look-ahead bias and provides a realistic simulation of real-time strategy performance",
     "doc_id": 35
    }
   ],
   "relaciones_crudas": [
    {
