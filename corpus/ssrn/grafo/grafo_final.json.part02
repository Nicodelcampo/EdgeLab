   "doc_ids": [
    74
   ],
   "definiciones": [
    {
     "texto": "Índice compuesto y ponderado que integra distintas métricas de negocio como el ROI, el Profit Factor (PF) y el Drawdown, utilizado para clasificar y comparar el rendimiento global de las estrategias de trading.",
     "doc_id": 74
    }
   ],
   "citas": [
    {
     "texto": "Composite KPI Score = α1*ROI + α2*PF - α3*Drawdown (α's are custom weights)",
