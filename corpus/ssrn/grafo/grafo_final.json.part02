   "tipo": "metrica",
   "nombres_vistos": [
    "Cooper ratio"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    76
   ],
   "definiciones": [
    {
     "texto": "Ratio que combina las preferencias idiosincrásicas de tiempo y de riesgo de la firma, el cual multiplicado por el Sharpe ratio (SRHFT) define el Capability ratio.",
     "doc_id": 76
    }
   ],
   "citas": [
    {
     "texto": "The CR combines the firm’s idiosyncratic time and risk preferences into a single measure.",
     "doc_id": 76
    }
   ],
