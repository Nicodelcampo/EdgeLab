  {
   "id": "white noise strategy",
   "nombre_canonico": "white noise strategy",
   "tipo": "metodo",
   "nombres_vistos": [
    "white noise strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    69
   ],
   "definiciones": [
    {
     "texto": "Estrategia dummy con señales aleatorias de compra/venta equiprobables usada como sanity check del motor de backtesting: se espera beta bajo por cash-heaviness y drift negativo por costos de transacción.",
     "doc_id": 69
