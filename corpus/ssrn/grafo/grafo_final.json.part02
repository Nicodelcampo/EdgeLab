  {
   "id": "dickey fuller test",
   "nombre_canonico": "Dickey-Fuller test",
   "tipo": "metodo",
   "nombres_vistos": [
    "Dickey-Fuller test"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    7
   ],
   "definiciones": [
    {
     "texto": "Test de raíz unitaria (ADF) usado tradicionalmente para determinar si el residuo de la regresión de cointegración es estacionario; el paper muestra que tiene bajo poder estadístico frente a otras alternativas.",
     "doc_id": 7
    }
   ],
   "citas": [
    {
     "texto": "researchers realized relatively quickly that the (augmented) Dickey-Fuller test lacks power, which is to say that it often fails to reject the null hypothesis when the null hypothesis is false",
     "doc_id": 7
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "cointegration",
     "doc_id": 7,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "Phillips-Perron test",
     "doc_id": 7,
     "revisar": false
    }
   ]
  },
  {
   "id": "phillip perron test",
   "nombre_canonico": "Phillips-Perron test",
   "tipo": "metodo",
   "nombres_vistos": [
    "Phillips-Perron test"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    7
   ],
   "definiciones": [
    {
     "texto": "Test de raíz unitaria alternativo al ADF que en las simulaciones del paper mostró el mejor desempeño global en potencia estadística para detectar cointegración.",
     "doc_id": 7
    }
   ],
   "citas": [
    {
     "texto": "Perhaps the best overall performance was given by the Phillips-Perron test (PP).",
     "doc_id": 7
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Dickey-Fuller test",
     "doc_id": 7,
