   "tipo": "concepto",
   "nombres_vistos": [
    "institutional holdings"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    41
   ],
   "definiciones": [
    {
     "texto": "Fracción de acciones en circulación en manos de inversores institucionales; usada como característica cross-sectional que amplifica el efecto de AT sobre investment-to-price sensitivity por ser inversores informados.",
     "doc_id": 41
    }
   ],
   "citas": [
    {
     "texto": "institutional investors are generally considered as informed investors that have positive impact on RPE",
     "doc_id": 41
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "revelatory price efficiency",
     "doc_id": 41,
     "revisar": false
    }
   ]
  },
  {
   "id": "private information",
   "nombre_canonico": "private information",
   "tipo": "metrica",
   "nombres_vistos": [
    "private information"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    41
   ],
   "definiciones": [
    {
     "texto": "Varianza de retornos accionarios atribuible a información privada específica de la firma, calculada con un modelo VAR (Brogaard et al. 2022) descomponiendo la varianza en información de mercado, privada, pública y ruido.",
     "doc_id": 41
    }
   ],
   "citas": [
    {
     "texto": "PrivateInfoi,t is computed using a vector autoregression model (VAR) to decompose a return variance into four components (market-wide information, private firm-specific information, public firm-specific information, and noise)",
     "doc_id": 41
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "price discovery",
     "doc_id": 41,
     "revisar": false
    },
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "investment-to-price sensitivity",
     "doc_id": 41,
     "revisar": false
    }
   ]
  },
  {
   "id": "operating performance",
   "nombre_canonico": "operating performance",
   "tipo": "metrica",
   "nombres_vistos": [
    "operating performance"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    41
   ],
   "definiciones": [
    {
     "texto": "Desempeño operativo futuro de la firma, medido con return on assets y sales growth; el paper lo vincula a la sensibilidad inversión-precio impulsada por AT como evidencia de que ese canal mejora decisiones de inversión.",
     "doc_id": 41
    }
   ],
   "citas": [
    {
     "texto": "we find that the amount of AT activities in stocks and the resulting increase in the investment-to-price sensitivity significantly improve firm performance",
     "doc_id": 41
    }
   ],
