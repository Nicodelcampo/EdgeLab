   "doc_frecuencia": 1,
   "doc_ids": [
    40
   ],
   "definiciones": [
    {
     "texto": "Medida generalizada del price jump que cuantifica la proporción de información revelada en el anuncio respecto de la información total acumulable, definida para todo patrón de retornos (incluye reversiones), acotada inferiormente en cero y sin necesidad de truncar la muestra.",
     "doc_id": 40
    }
   ],
   "citas": [
    {
     "texto": "the standardized price jump allows us to retain 50% of observations that would be cut if we were to employ the regular price jump instead",
     "doc_id": 40
    }
   ],
