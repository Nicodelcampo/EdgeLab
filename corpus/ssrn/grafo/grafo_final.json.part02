  {
   "id": "martingale estimation function",
   "nombre_canonico": "martingale estimation function",
   "tipo": "metodo",
   "nombres_vistos": [
    "martingale estimation function"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    27
   ],
   "definiciones": [
    {
     "texto": "Método de estimación (Bibby-Sørensen) usado para obtener los parámetros de autocorrelación ν_a, ν_b a partir de series temporales discretas de volumen bid/ask.",
     "doc_id": 27
    }
   ],
   "citas": [
    {
     "texto": "we use a martingale estimation function (Bibby and Sørensen, 1995) for the autocorrelation parameters ν⋆, ⋆∈{a, b}",
     "doc_id": 27
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
