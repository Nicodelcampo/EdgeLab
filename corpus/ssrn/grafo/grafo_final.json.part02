    }
   ]
  },
  {
   "id": "variance gamma model",
   "nombre_canonico": "Variance Gamma model",
   "tipo": "concepto",
   "nombres_vistos": [
    "Variance Gamma model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    10
   ],
   "definiciones": [
    {
     "texto": "Modelo exponencial Lévy puro de saltos al que se aplica la expansión de precios y de volatilidad implícita, usado también en los experimentos de calibración numérica.",
     "doc_id": 10
    }
   ],
   "citas": [
    {
     "texto": "we study expansions for exponential Lévy models such as the Variance Gamma and the Normal Inverse Gaussian models",
     "doc_id": 10
    }
   ],
