    }
   ]
  },
  {
   "id": "market microstructure model",
   "nombre_canonico": "market microstructure model",
   "tipo": "metodo",
   "nombres_vistos": [
    "market microstructure model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    11
   ],
   "definiciones": [
    {
     "texto": "Modelo de equilibrio de expectativas racionales (RE) del spot rate FX con dealers de aversión al riesgo CARA, brokers pasivos y una plataforma centralizada de subastas walrasianas, usado para derivar cómo la intervención cambiaria se transmite a precios y condiciones de mercado.",
     "doc_id": 11
    }
   ],
   "citas": [
    {
     "texto": "We formulate a market microstructure model of exchange determination we employ to investigate the impact of foreign exchange intervention on exchange rates",
     "doc_id": 11
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "rational expectations equilibrium",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "FX intervention",
     "doc_id": 11,
     "revisar": false
    }
   ]
  },
  {
   "id": "rational expectation equilibrium",
   "nombre_canonico": "rational expectations equilibrium",
   "tipo": "concepto",
   "nombres_vistos": [
    "rational expectations equilibrium"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    11
   ],
   "definiciones": [
    {
     "texto": "Equilibrio lineal donde el spot rate agrega la información dispersa entre dealers; el paper prueba que puede existir multiplicidad de puntos fijos y que para valores altos de la intensidad de intervención el equilibrio deja de existir.",
     "doc_id": 11
    }
   ],
   "citas": [
    {
     "texto": "we can now isolate two diﬀerent rational expectations (RE) equilibria, which identify the equilibrium spot rate which prevails in the FX market in the two scenarios",
     "doc_id": 11
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "market microstructure model",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "information asymmetry",
     "doc_id": 11,
     "revisar": false
    }
   ]
  },
  {
   "id": "signalling channel",
   "nombre_canonico": "signalling channel",
   "tipo": "concepto",
   "nombres_vistos": [
    "signalling channel"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    11
   ],
   "definiciones": [
    {
     "texto": "Canal por el cual la intervención cambiaria transmite información sobre shocks futuros a los fundamentals a través del order flow que el banco central genera.",
     "doc_id": 11
    }
   ],
   "citas": [
    {
     "texto": "how foreign exchange intervention inﬂuences exchange rates via both a portfolio-balance and a signalling channel",
     "doc_id": 11
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "central bank intervention",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "portfolio-balance channel",
     "doc_id": 11,
     "revisar": false
    }
   ]
  },
  {
   "id": "portfolio balance channel",
   "nombre_canonico": "portfolio-balance channel",
   "tipo": "concepto",
   "nombres_vistos": [
    "portfolio-balance channel"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    11
   ],
   "definiciones": [
    {
     "texto": "Canal por el cual la intervención mueve el precio simplemente porque los dealers averse al riesgo exigen compensación de precio para absorber el cambio de inventario, incluso sin contenido informativo.",
     "doc_id": 11
    }
   ],
   "citas": [
    {
     "texto": "even when they do not carry any information content intervention operations by a central bank inﬂuence exchange rates",
     "doc_id": 11
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "central bank intervention",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "inventory risk",
     "doc_id": 11,
     "revisar": false
    }
   ]
  },
  {
   "id": "direct intervention scenario",
   "nombre_canonico": "direct intervention scenario",
   "tipo": "estrategia",
   "nombres_vistos": [
    "direct intervention scenario"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    11
   ],
   "definiciones": [
    {
     "texto": "Ruta de intervención en la que el banco central negocia bilateralmente con un subconjunto pequeño de dealers privilegiados; transmite más información y reduce la volatilidad del spot rate pero aumenta mucho los costos de transacción en ese mercado.",
     "doc_id": 11
    }
   ],
   "citas": [
    {
     "texto": "in the direct intervention scenario the central bank chooses to negotiate in day t with a subset of the FX dealers",
     "doc_id": 11
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "indirect intervention scenario",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "exchange rate volatility",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "central bank intervention",
     "doc_id": 11,
     "revisar": false
    }
   ]
  },
  {
   "id": "indirect intervention scenario",
   "nombre_canonico": "indirect intervention scenario",
   "tipo": "estrategia",
   "nombres_vistos": [
    "indirect intervention scenario"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    11
   ],
   "definiciones": [
    {
     "texto": "Ruta de intervención en la que el banco central emplea un broker para colocar órdenes de mercado directamente en el libro de órdenes centralizado interdealer; transmite menos información pero aumenta la volatilidad del spot rate.",
     "doc_id": 11
    }
   ],
   "citas": [
    {
     "texto": "the central bank now decides to conduct its intervention operation via the brokered section of the FX market",
     "doc_id": 11
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "direct intervention scenario",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "limit order book",
     "doc_id": 11,
     "revisar": false
    }
   ]
  },
  {
   "id": "administered pricing",
   "nombre_canonico": "administered pricing",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "administered pricing"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    12
   ],
   "definiciones": [
    {
     "texto": "Régimen en el que la autoridad monetaria fija el tipo de cambio oficial y una banda de cotización permitida alrededor de este, actuando como un techo/piso de precio que genera no clearing de mercado y distorsiona las señales de precio.",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "in this market, prices (i.e., exchange rates) have been extensively administered by a combination of price ceilings and floors that are variable and mostly binding",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "liquidity",
     "doc_id": 12,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "parallel market",
     "doc_id": 12,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "price discovery",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "parallel market",
   "nombre_canonico": "parallel market",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "parallel market"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    12
   ],
   "definiciones": [
    {
     "texto": "Mercado negro de USD/VND que coexiste con el mercado oficial y cotiza a un premio persistente sobre la tasa comercial legal, sirviendo como indicador del exceso de demanda de divisas no satisfecho.",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "the exchange rate in the parallel market would be quoted at a much higher level than in the official market",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "administered pricing",
     "doc_id": 12,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "administered pricing",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "interbank market",
   "nombre_canonico": "interbank market",
   "tipo": "concepto",
   "nombres_vistos": [
    "interbank market"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    12
   ],
   "definiciones": [
    {
     "texto": "Segmento del mercado FX donde operan bancos comerciales entre sí; en los mercados globales concentra la mayoría del volumen, pero en Vietnam representa una porción muy pequeña frente al segmento cliente-banco.",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "the interbank segment (including transactions carried out by nonbank financial institutions) accounts for 80 percent or more of total market trading volume",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "forex market structure",
     "doc_id": 12,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "client-bank market",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "client bank market",
   "nombre_canonico": "client-bank market",
   "tipo": "concepto",
   "nombres_vistos": [
    "client-bank market"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    12
   ],
   "definiciones": [
    {
     "texto": "Segmento de mercado retail entre bancos comerciales y clientes finales (empresas e individuos), que domina el volumen total de operaciones FX en Vietnam en contraste con el patrón internacional.",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "the client-bank segment has dominated the overall market",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "interbank market",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "exchange rate peg",
   "nombre_canonico": "exchange rate peg",
   "tipo": "concepto",
   "nombres_vistos": [
    "exchange rate peg"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    12
   ],
   "definiciones": [
    {
     "texto": "Régimen cambiario de facto identificado por los autores pese a la denominación oficial de 'managed float', caracterizado por cotizaciones comerciales pegadas casi todo el tiempo a los límites de la banda permitida.",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "commercial VND/USD quotes have been at their upper or lower bounds more than 85% of the time",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "administered pricing",
     "doc_id": 12,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "managed float",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "managed float",
   "nombre_canonico": "managed float",
   "tipo": "concepto",
   "nombres_vistos": [
    "managed float"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    12
   ],
   "definiciones": [
    {
     "texto": "Denominación oficial del régimen cambiario vietnamita, en el cual el tipo de cambio en principio se determina por fuerzas de mercado con intervención del banco central; el paper argumenta que en la práctica funciona como un peg ajustable.",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "the current exchange rate regime has been described by the authorities as a managed float",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "exchange rate peg",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "coefficient of variation",
   "nombre_canonico": "coefficient of variation",
   "tipo": "metrica",
   "nombres_vistos": [
    "coefficient of variation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    12
   ],
   "definiciones": [
    {
     "texto": "Medida simple de variabilidad de una serie temporal, definida como el ratio entre el desvío estándar y la media, usada para cuantificar la estabilidad de la tasa VND/USD.",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "a simple measure of variability in a data series is its coefficient of variation (CV), defined as ratio of the standard deviation to the mean",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "exchange rate volatility",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "root mean square percentage error",
   "nombre_canonico": "root mean square percentage error",
   "tipo": "metrica",
   "nombres_vistos": [
    "root mean square percentage error"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    12
   ],
   "definiciones": [
    {
     "texto": "Métrica de error de predicción usada para cuantificar la volatilidad/impredecibilidad de la tasa cambiaria, comparando el valor observado contra un pronóstico de caminata aleatoria (valor del período anterior).",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "an alternative measure may also be used, namely the root mean square percentage error (RMPSE)",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "exchange rate volatility",
     "doc_id": 12,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "random walk model",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "random walk model",
   "nombre_canonico": "random walk model",
   "tipo": "metodo",
   "nombres_vistos": [
    "random walk model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    12
   ],
   "definiciones": [
    {
     "texto": "Mecanismo de pronóstico simple donde el valor observado en el período t-1 se usa como predicción para el período t, empleado aquí como benchmark para calcular el RMPSE de la tasa cambiaria.",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "A simple yet useful forecasting mechanism is the random walk model, where the actual Et-1 value observed in period t-1 is used as the forecast value Êt for period t",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "root mean square percentage error",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "nominal anchor",
   "nombre_canonico": "nominal anchor",
   "tipo": "concepto",
   "nombres_vistos": [
    "nominal anchor"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    12
   ],
   "definiciones": [
    {
     "texto": "Rol que cumple una moneda de referencia (el USD) para estabilizar expectativas inflacionarias y de política monetaria en países con baja credibilidad institucional, motivo aducido para el peg del VND.",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "the preference by some monetary authorities for a fixed exchange rate regime is often explained in terms of a stabilizing \"nominal anchor\"",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "exchange rate peg",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "market illiquidity episode",
   "nombre_canonico": "market illiquidity episode",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "market illiquidity episode"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    12
   ],
   "definiciones": [
    {
     "texto": "Situación recurrente en la que muchos participantes no pueden completar transacciones al precio cotizado por falta de contrapartes dispuestas, distinta de un spread ancho, y causada por exceso de demanda no satisfecho bajo el techo de la banda.",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "this term is meant to describe the situation where many participants find it difficult, if not impossible, to complete transactions (either sales or purchases) at the market-quoted price",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "parallel market",
     "doc_id": 12,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "administered pricing",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "regulatory circumvention technique",
   "nombre_canonico": "regulatory circumvention technique",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "regulatory circumvention technique"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    12
   ],
   "definiciones": [
    {
     "texto": "Conjunto de prácticas ad hoc (fees adicionales, préstamos en VND a tasas elevadas, triangulación vía terceras monedas como el EUR, forwards, opciones) desarrolladas por bancos y clientes para operar efectivamente por fuera de la banda oficial permitida.",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "market participants will always come up with new and more ingenious ways of beating the system",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "effective spread",
     "doc_id": 12,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "administered pricing",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "sterilized intervention",
   "nombre_canonico": "sterilized intervention",
   "tipo": "concepto",
   "nombres_vistos": [
    "sterilized intervention"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    12
   ],
   "definiciones": [
    {
     "texto": "Intervención del banco central en el mercado cambiario compensada por operaciones de mercado abierto (venta de títulos públicos) para neutralizar el impacto sobre la oferta monetaria, mencionada como alternativa de política no adoptada plenamente.",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "sterilized intervention should have little impact on the money supply, as the authorities would simply mop up any injections of VND into the system",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "exchange rate volatility",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "forex market turnover",
   "nombre_canonico": "forex market turnover",
   "tipo": "dato",
   "nombres_vistos": [
    "forex market turnover"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    12
   ],
   "definiciones": [
    {
     "texto": "Volumen diario total transado en el mercado FX, utilizado como proxy de tamaño y desarrollo del mercado y comparado contra el volumen de comercio internacional del país.",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "Daily total turnover on the forex market in Vietnam increased seven-fold from around $20 million in 1995 to around $150 million in 2006",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "liquidity",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "underreaction",
   "nombre_canonico": "underreaction",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "underreaction"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    13
   ],
   "definiciones": [
    {
     "texto": "El retorno tras un anuncio de buenas noticias es mayor que tras malas noticias: el precio incorpora la información lentamente, generando continuación de retornos en el corto plazo.",
     "doc_id": 13
    }
   ],
   "citas": [
    {
     "texto": "the\nreturn on a company’s stock is higher following an announcement of good news than the\nreturn following bad news",
     "doc_id": 13
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "momentum",
     "doc_id": 13,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "conservatism bias",
     "doc_id": 13,
     "revisar": false
    }
   ]
  },
  {
   "id": "representativeness heuristic",
   "nombre_canonico": "representativeness heuristic",
   "tipo": "concepto",
   "nombres_vistos": [
    "representativeness heuristic"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    13
   ],
   "definiciones": [
    {
     "texto": "Sesgo por el cual los inversores ven patrones sistemáticos en secuencias puramente aleatorias (aquí, en earnings que son un random walk) y extrapolan trends, causando sobrerreacción.",
     "doc_id": 13
    }
   ],
   "citas": [
    {
     "texto": "she sees systematic patterns in sequences that are in fact completely randomly\ngenerated",
     "doc_id": 13
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "overreaction",
     "doc_id": 13,
     "revisar": false
    }
   ]
  },
  {
   "id": "conservatism bia",
   "nombre_canonico": "conservatism bias",
   "tipo": "concepto",
   "nombres_vistos": [
    "conservatism bias"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    13
   ],
   "definiciones": [
    {
     "texto": "Tendencia de los inversores a ponderar de menos la información nueva al actualizar sus creencias, lo que produce subreacción a las noticias.",
     "doc_id": 13
    }
   ],
   "citas": [
    {
     "texto": "People with a bias towards conservatism tend to underweight new information in\nupdating their weighting of new information",
     "doc_id": 13
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "underreaction",
     "doc_id": 13,
     "revisar": false
    }
   ]
  },
  {
   "id": "stop loss rule",
   "nombre_canonico": "stop-loss rule",
   "tipo": "metodo",
   "nombres_vistos": [
    "stop-loss rule"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    13
   ],
   "definiciones": [
    {
     "texto": "Liquidar la posición perdedora al cruzar un límite (20% desde el máximo del holding period en el paper); se motiva formalmente con la martingale betting strategy: sin límite de pérdida se necesita capital infinito. El paper además la interpreta como señal contrarian que invalida la tesis de momentum, y banea el stock 15 días tras ejecutarse.",
     "doc_id": 13
    }
   ],
   "citas": [
    {
     "texto": "the stop-loss rule means that one\nliquidates a losing position when its price exceeds or drops below a certain limit",
     "doc_id": 13
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "risk control",
     "doc_id": 13,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "drawdown risk",
     "doc_id": 13,
     "revisar": false
    }
   ]
  },
  {
   "id": "martingale betting strategy",
   "nombre_canonico": "martingale betting strategy",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "martingale betting strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    13
   ],
   "definiciones": [
    {
     "texto": "Doblar la apuesta tras cada pérdida: la esperanza de pérdida acumulada diverge, por lo que sin capital infinito lleva a la quiebra. El paper lo usa como argumento teórico a favor del stop-loss y de limitar el tamaño de las apuestas.",
     "doc_id": 13
    }
   ],
   "citas": [
    {
     "texto": "the initial capital of the gambler, or investor, needs to be inﬁnite,\nif she intends to pursue her martingale betting strategy",
     "doc_id": 13
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "stop-loss rule",
     "doc_id": 13,
     "revisar": false
    }
   ]
  },
  {
   "id": "cumulative abnormal return methodology",
   "nombre_canonico": "cumulative abnormal return methodology",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "cumulative abnormal return methodology"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    13
   ],
   "definiciones": [
    {
     "texto": "Metodología académica estándar para medir momentum: rankear por retorno pasado, formar cartera long/short estática, medir el retorno anormal acumulado con t-stat. El paper la critica como rígida y simplista: excluye costos de transacción, usa rebalanceo estático y sobreestima el rendimiento alcanzable.",
     "doc_id": 13
    }
   ],
   "citas": [
    {
     "texto": "methodology used when analyzing this phenomenon in most academic papers, called Cumulative Abnormal Return (CAR), is straightforward and easy to use. However, it is also very\nrigid and simplistic.",
     "doc_id": 13
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "momentum",
     "doc_id": 13,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "backtest overfitting",
     "doc_id": 13,
     "revisar": false
    }
   ]
  },
  {
   "id": "realistic trading simulation",
   "nombre_canonico": "realistic trading simulation",
   "tipo": "metodo",
   "nombres_vistos": [
    "realistic trading simulation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    13
   ],
   "definiciones": [
    {
     "texto": "Plataforma de simulación (Java, arquitectura de plugins de reglas, cuentas separadas long/short/transacción) que incorpora costos, ejecución al cierre, rebalanceo dinámico y reglas de riesgo; el paper la propone como metodología superior al CAR para evaluar estrategias.",
     "doc_id": 13
    }
   ],
   "citas": [
    {
     "texto": "a good evaluation of any trading strategy requires more realistic simulations than is\ncommonplace in academia today",
     "doc_id": 13
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "cumulative abnormal return methodology",
     "doc_id": 13,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "transaction costs",
     "doc_id": 13,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "backtest overfitting",
     "doc_id": 13,
     "revisar": false
    }
   ]
  },
  {
   "id": "risk control",
   "nombre_canonico": "risk control",
   "tipo": "metodo",
   "nombres_vistos": [
    "risk control"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    13
   ],
   "definiciones": [
    {
     "texto": "Segunda etapa del modelo (tras la generación de señal): entre los 4 mejores candidatos del ranking se elige el que minimiza la suma de la matriz varianza-covarianza del portafolio; incluye stop-loss, corte por precio bajo (<3 SKr), bans sectoriales tras stop-losses agrupados y un indicador de valuaciones extremas (M/B duplicado/halvado en un año).",
     "doc_id": 13
    }
   ],
   "citas": [
    {
     "texto": "Our main\nsolution is that we test the best 4 candidates for inclusion in the portfolio by calculating the\nsum of the variance-covariance matrix",
     "doc_id": 13
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "stop-loss rule",
     "doc_id": 13,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "sector concentration risk",
     "doc_id": 13,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "statistical arbitrage",
     "doc_id": 13,
     "revisar": false
    }
   ]
  },
  {
   "id": "random ranking benchmark",
   "nombre_canonico": "random ranking benchmark",
   "tipo": "metodo",
   "nombres_vistos": [
    "random ranking benchmark"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    13
   ],
   "definiciones": [
    {
     "texto": "Correr la misma simulación con rankings generados aleatoriamente (mediana de 50 corridas) como hipótesis nula: si la señal real no supera claramente al azar, no hay edge. El benchmark aleatorio dio retornos levemente negativos, confirmando la señal de momentum.",
     "doc_id": 13
    }
   ],
   "citas": [
    {
     "texto": "we have ranked the stocks randomly. The average return is centered slightly\nbelow zero due to the asymmetry between the long and short positions",
     "doc_id": 13
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "data snooping",
     "doc_id": 13,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "realistic trading simulation",
     "doc_id": 13,
     "revisar": false
    }
   ]
  },
  {
   "id": "market capacity constraint",
   "nombre_canonico": "market capacity constraint",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "market capacity constraint"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    13
   ],
   "definiciones": [
    {
     "texto": "La estrategia asume ejecución inmediata al cierre sin impacto; con turnover diario de 1-2 millones SKr en los stocks menos líquidos, el paper estima que la performance se degrada si el portafolio supera ~30 millones SKr, imponiendo un límite superior de capital (y uno inferior de ~1 millón SKr para lograr costos de 0.3%).",
     "doc_id": 13
    }
   ],
   "citas": [
    {
     "texto": "we can with\na rough estimation say that returns will be hit if total portfolio value exceeds about\n30 million SKr",
     "doc_id": 13
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "liquid markets",
