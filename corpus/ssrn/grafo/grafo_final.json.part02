   "nombres_vistos": [
    "Superior Predictive Ability test"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    6
   ],
   "definiciones": [
    {
     "texto": "Refinamiento de Hansen (2005) del Reality Check que emplea un estadístico studentizado y un procedimiento bootstrap más potente, reduciendo el conservadurismo del test original.",
     "doc_id": 6
    }
   ],
   "citas": [
    {
     "texto": "Hansen (2005) refined the Reality Check with the Superior Predictive Ability (SPA) test, which employs a studentized test statistic and a more powerful bootstrap procedure, reducing the conservatism of the Reality Check.",
     "doc_id": 6
    }
   ],
