  },
  {
   "id": "laplace transform",
   "nombre_canonico": "Laplace transform",
   "tipo": "metodo",
   "nombres_vistos": [
    "Laplace transform"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    10
   ],
   "definiciones": [
    {
     "texto": "Transformada conjunta de la varianza total y su proceso cumulante, motor computacional de la aproximación de precios y condición de existencia de momentos requeridos.",
     "doc_id": 10
    }
   ],
   "citas": [
    {
     "texto": "the Laplace transform LT is also the computational engine for the option price approximation that we develop",
     "doc_id": 10
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
