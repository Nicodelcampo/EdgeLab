  {
   "id": "markovian activation function",
   "nombre_canonico": "Markovian Activation Function",
   "tipo": "metodo",
   "nombres_vistos": [
    "Markovian Activation Function"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    31
   ],
   "definiciones": [
    {
     "texto": "Función de activación de la red neuronal definida como una puerta de transición markoviana consistente con las ecuaciones de Chapman-Kolmogorov, que reemplaza las activaciones deterministas de las redes convencionales por probabilidades de transición entre estados de mercado.",
     "doc_id": 31
    }
   ],
   "citas": [
    {
     "texto": "We introduce Markovian Activation Function (MAFs), a class of transition gates consistent with Chapman–Kolmogorov dynamics and governed by local Markovian generators.",
     "doc_id": 31
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Chapman-Kolmogorov equations",
     "doc_id": 31,
     "revisar": false
    },
    {
