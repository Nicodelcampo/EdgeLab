   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    55
   ],
   "definiciones": [
    {
     "texto": "Diseño de debate en el que los agentes principalmente responden y atacan las posiciones de los otros; el paper reporta que produce efectos de dominancia retórica en vez de consenso basado en evidencia.",
     "doc_id": 55
    }
   ],
   "citas": [
    {
     "texto": "In refutation-based designs, agents primarily respond to and attack each other's positions. We find this leads to rhetorical dominance effects rather than evidence-based consensus.",
     "doc_id": 55
    }
   ],
   "relaciones_crudas": [
    {
