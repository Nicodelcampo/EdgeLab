   "doc_ids": [
    35
   ],
   "definiciones": [
    {
     "texto": "Señal de entrada/salida calculada normalizando el spread sintético del día por la media y desviación estándar del spread durante el período de entrenamiento; umbral de ±1 dispara posiciones largas/cortas.",
     "doc_id": 35
    }
   ],
   "citas": [
    {
