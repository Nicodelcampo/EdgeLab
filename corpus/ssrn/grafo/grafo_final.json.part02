  {
   "id": "execution momentum",
   "nombre_canonico": "execution momentum",
   "tipo": "metodo",
   "nombres_vistos": [
    "execution momentum"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    17
   ],
   "definiciones": [
    {
     "texto": "Precio promedio de las últimas M ejecuciones ponderado por volumen y firmado (+1 comprador-iniciado, −1 vendedor-iniciado), que captura la presión de toma de liquidez real en vez de la liquidez pasiva.",
     "doc_id": 17
    }
   ],
   "citas": [
    {
     "texto": "The Execution Momentum component captures information from recent trades, providing a complementary view of market activity based on actual executions rather than resting orders",
     "doc_id": 17
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
