   "tipo": "concepto",
   "nombres_vistos": [
    "queueing system model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    27
   ],
   "definiciones": [
    {
     "texto": "Enfoque alternativo que modela la dinámica del libro como sistema de colas (point process), preservando la naturaleza discreta pero computacionalmente costoso a alta frecuencia.",
     "doc_id": 27
    }
   ],
   "citas": [
    {
     "texto": "These models preserve the discrete nature of the dynamics at high frequencies but can become computationally challenging as one tries to incorporate realistic dynamics",
     "doc_id": 27
    }
