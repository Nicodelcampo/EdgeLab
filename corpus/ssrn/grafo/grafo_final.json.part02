  {
   "id": "financial transaction tax",
   "nombre_canonico": "financial transaction tax",
   "tipo": "concepto",
   "nombres_vistos": [
    "financial transaction tax"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    49
   ],
   "definiciones": [
    {
     "texto": "Impuesto sobre transacciones ejecutadas y/o órdenes canceladas, propuesto o implementado en EU, Francia, Italia, UK, Canadá y EEUU para desincentivar HFT; el paper documenta que reduce liquidez y volumen de negociación.",
     "doc_id": 49
    }
   ],
   "citas": [
    {
     "texto": "firms that provide liquidity using modern trading technology—which includes, but is not limited to, HFTs—will be required to pay the tax on both successfully executed transactions and order cancelations",
     "doc_id": 49
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "market liquidity",
     "doc_id": 49,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "high-frequency trading",
     "doc_id": 49,
     "revisar": false
    }
   ]
  },
  {
   "id": "minimum hold time",
   "nombre_canonico": "minimum hold time",
   "tipo": "concepto",
   "nombres_vistos": [
    "minimum hold time"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    49
   ],
   "definiciones": [
    {
     "texto": "Regulación (ej. MiFID II) que obliga a mantener órdenes sin cambios por un tiempo mínimo (500 milisegundos), diseñada para reducir la velocidad de trading y desincentivar el trend trading algorítmico.",
     "doc_id": 49
    }
   ],
   "citas": [
    {
     "texto": "Firms must hold orders, unchanged, for a minimum of 500 milliseconds",
     "doc_id": 49
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "market liquidity",
     "doc_id": 49,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "price discovery",
     "doc_id": 49,
     "revisar": false
    }
   ]
  },
  {
   "id": "market failure",
   "nombre_canonico": "market failure",
   "tipo": "concepto",
   "nombres_vistos": [
    "market failure"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    49
   ],
   "definiciones": [
    {
     "texto": "Definido por los autores como la situación en que los precios de los valores no reflejan toda la información disponible de manera eficiente, o el mercado no logra transferir la propiedad de valores eficientemente; el paper concluye que no existe evidencia de market failure atribuible exclusivamente al HFT.",
     "doc_id": 49
    }
   ],
   "citas": [
    {
     "texto": "We consider a market failure to exist in informationally efficient financial markets when securities prices do not fully reflect all available information in an efficient manner",
     "doc_id": 49
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "market efficiency",
     "doc_id": 49,
     "revisar": false
    }
   ]
  },
  {
   "id": "manipulative trading",
   "nombre_canonico": "manipulative trading",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "manipulative trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    49
   ],
   "definiciones": [
    {
     "texto": "Categoría regulatoria de prácticas (layering, spoofing, wash trading, quote stuffing) prohibidas en la mayoría de países independientemente del HFT; el paper argumenta que ya existe marco legal para atacarlas sin regulación adicional específica de HFT.",
     "doc_id": 49
    }
   ],
   "citas": [
    {
     "texto": "the practice of buying shares from one broker while selling them through another—a practice already banned under US law, but difficult to detect",
     "doc_id": 49
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "market failure",
     "doc_id": 49,
     "revisar": false
    }
   ]
  },
  {
   "id": "circuit breaker",
   "nombre_canonico": "circuit breakers",
   "tipo": "metodo",
   "nombres_vistos": [
    "circuit breakers"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    49
   ],
   "definiciones": [
    {
     "texto": "Mecanismo de mercado (junto con limit-up/limit-down controls) que exchanges y traders ya implementan voluntariamente para mantener la integridad del mercado ante movimientos extremos de precio.",
     "doc_id": 49
    }
   ],
   "citas": [
    {
     "texto": "circuit breakers",
     "doc_id": 49
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "market failure",
     "doc_id": 49,
     "revisar": false
    }
   ]
  },
  {
   "id": "colocation",
   "nombre_canonico": "colocation",
   "tipo": "concepto",
   "nombres_vistos": [
    "colocation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    49
   ],
   "definiciones": [
    {
     "texto": "Práctica de ubicar servidores propios dentro del data center de un exchange para reducir latencia; el estudio de Angel y McCabe (2010) señala que es accesible a cualquier trader ('procedural fairness'), no exclusiva de HFT.",
     "doc_id": 49
    }
   ],
   "citas": [
    {
     "texto": "buy a computer and colocate it in an exchange data center",
     "doc_id": 49
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "high-frequency trading",
     "doc_id": 49,
     "revisar": false
    }
   ]
  },
  {
   "id": "procedural fairness",
   "nombre_canonico": "procedural fairness",
   "tipo": "concepto",
   "nombres_vistos": [
    "procedural fairness"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    49
   ],
   "definiciones": [
    {
     "texto": "Noción de igualdad de oportunidad en los mercados (mismas reglas aplican a HFTs y otros traders); el estudio de Angel y McCabe (2010) concluye que el HFT es procedimentalmente justo porque cualquiera puede acceder a la misma tecnología.",
     "doc_id": 49
    }
   ],
   "citas": [
    {
     "texto": "in the case of procedural fairness (equal opportunity) in markets, the same rules applied to HFTs as to other traders",
     "doc_id": 49
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "high-frequency trading",
     "doc_id": 49,
     "revisar": false
    }
   ]
  },
  {
   "id": "market speed",
   "nombre_canonico": "market speed",
   "tipo": "concepto",
   "nombres_vistos": [
    "market speed"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    49
   ],
   "definiciones": [
    {
     "texto": "Aumento generalizado de la velocidad de negociación en todos los mercados (no exclusivo del HFT), tomado por el paper como reflejo de la mayor velocidad de la información en la sociedad, no como evidencia de market failure.",
     "doc_id": 49
    }
   ],
   "citas": [
    {
     "texto": "financial markets have adjusted by increasing their speed for everyone, not just HFTs, also indicating that a market failure does not exist",
     "doc_id": 49
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "market efficiency",
     "doc_id": 49,
     "revisar": false
    }
   ]
  },
  {
   "id": "rent seeking",
   "nombre_canonico": "rent seeking",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "rent seeking"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    49
   ],
   "definiciones": [
    {
     "texto": "Concepto usado por los autores para describir el efecto de las regulaciones anti-HFT basadas en 'fairness': transfieren riqueza a gobiernos o competidores menos productivos en lugar de corregir un market failure real.",
     "doc_id": 49
    }
   ],
   "citas": [
    {
     "texto": "Instead, they move toward rent-seeking activities designed to transfer wealth to governments or to other competitors that have not increased their productivity to compete in a high-velocity-information environment",
     "doc_id": 49
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "market liquidity",
     "doc_id": 49,
     "revisar": false
    }
   ]
  },
  {
   "id": "regulatory arbitrage",
   "nombre_canonico": "regulatory arbitrage",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "regulatory arbitrage"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    49
   ],
   "definiciones": [
    {
     "texto": "Riesgo de 'offshoring' de HFT hacia mercados emergentes (Rusia, Brasil, México, Japón, Singapur) cuando un país impone regulación agresiva, perdiendo el país regulador tanto capital como capacidad de monitoreo y aplicación de sanciones.",
     "doc_id": 49
    }
   ],
   "citas": [
    {
     "texto": "Eliminating or significantly \"curbing\" HFT in any country—rather than engaging in oversight and monitoring—may result in the offshoring of HFT to emerging HFT markets",
     "doc_id": 49
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "financial transaction tax",
     "doc_id": 49,
     "revisar": false
    }
   ]
  },
  {
   "id": "level 4 order book data",
   "nombre_canonico": "Level 4 order book data",
   "tipo": "dato",
   "nombres_vistos": [
    "Level 4 order book data"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    50
   ],
   "definiciones": [
    {
     "texto": "Extensión de los datos Level 3 convencionales que agrega identificadores pseudónimos de traders, intentos de órdenes rechazadas y de cancelación fallidos, e información de contraparte para cada trade, con timestamps de precisión nanosegundo.",
     "doc_id": 50
    }
   ],
   "citas": [
    {
     "texto": "The resulting dataset provides what Hyperliquid terms \"Level 4\" data—extending the conventional Level 3 granularity with pseudonymous trader identifiers, rejected order/cancellation attempts, and counterparty information for every trade.",
     "doc_id": 50
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "limit order book",
     "doc_id": 50,
     "revisar": false
    },
    {
     "tipo": "MEJORA_A",
