   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    71
   ],
   "definiciones": [
    {
     "texto": "Entorno simulado de mercado impulsado por órdenes donde agentes autónomos interactúan continuamente mediante un libro de órdenes límite.",
     "doc_id": 71
    }
   ],
   "citas": [
    {
     "texto": "Both papers share the ASME framework ot the artificial, order-driven stock market. Autonomous agents or traders who continuously observe market dynamics, interact through a limit order book",
     "doc_id": 71
    }
   ],
   "relaciones_crudas": [
