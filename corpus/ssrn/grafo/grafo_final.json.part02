  {
   "id": "coefficient of mean reversion",
   "nombre_canonico": "coefficient of mean reversion",
   "tipo": "metrica",
   "nombres_vistos": [
    "coefficient of mean reversion"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    7
   ],
   "definiciones": [
    {
     "texto": "Parámetro rho de la regresión AR(1) sobre el residuo de cointegración; valores cercanos a 1 indican persistencia tipo random walk, valores menores indican reversión a la media.",
     "doc_id": 7
    }
   ],
   "citas": [
    {
     "texto": "The value of 𝜌 that is fitted in the above equation will normally be between zero and one. This is called the coefficient of mean reversion.",
     "doc_id": 7
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "mean reversion",
