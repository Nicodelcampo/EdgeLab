    25
   ],
   "definiciones": [
    {
     "texto": "Simulaciones usadas no para generar el framework sino para chequear su usabilidad empírica en muestras finitas: aproximación de los umbrales analíticos, plausibilidad de los diagnósticos de path y magnitud de la inflación post-selección.",
     "doc_id": 25
    }
   ],
   "citas": [
    {
