   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    69
   ],
   "definiciones": [
    {
     "texto": "Regla práctica (citando a Chan) de mantener las órdenes por debajo del 1% del volumen diario total del activo para limitar el impacto de mercado.",
     "doc_id": 69
