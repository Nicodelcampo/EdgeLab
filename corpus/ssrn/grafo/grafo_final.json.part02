   "doc_ids": [
    41
   ],
   "definiciones": [
    {
     "texto": "Grado en que el precio de un activo predice con precisión el valor futuro de ese activo; noción distinta de la RPE, en la que se centra la literatura previa sobre AT.",
     "doc_id": 41
    }
   ],
   "citas": [
    {
     "texto": "the forecasting price efficiency (FPE) as the extent to which the price of a given security accurately predicts the future value of that security",
