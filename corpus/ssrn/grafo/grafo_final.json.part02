     "doc_id": 43,
     "revisar": false
    }
   ]
  },
  {
   "id": "back and lay betting",
   "nombre_canonico": "back and lay betting",
   "tipo": "concepto",
   "nombres_vistos": [
    "back and lay betting"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    43
   ],
   "definiciones": [
    {
     "texto": "Mecánica de apuesta en exchanges deportivos análoga a comprar (back) y vender en corto (lay) un instrumento financiero.",
     "doc_id": 43
    }
   ],
   "citas": [
    {
     "texto": "A back bet refers to betting in favour of the runner, while a lay bet is a bet against the runner, effectively acting as the bookmaker, this is obviously very similar to buying and selling an instrument on a financial exchange.",
     "doc_id": 43
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "long and short trading",
