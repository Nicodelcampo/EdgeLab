   "tipo": "concepto",
   "nombres_vistos": [
    "opportunistic algorithmic trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    41
   ],
   "definiciones": [
    {
     "texto": "Subconjunto de AT que demanda liquidez y explota oportunidades de arbitraje de latencia y estrategias de order anticipation (back-running); el paper muestra que este tipo específico deteriora la sensibilidad inversión-precio pese a que el AT agregado la mejora.",
     "doc_id": 41
    }
   ],
   "citas": [
    {
     "texto": "we also show that a subset of AT, namely opportunistic AT is harmful to managerial learning",
     "doc_id": 41
    }
   ],
