   "doc_ids": [
    55
   ],
   "definiciones": [
    {
     "texto": "Diseño en que cada agente construye un caso independiente antes de comenzar la deliberación, evitando que la habilidad retórica domine sobre la calidad de la evidencia.",
     "doc_id": 55
    }
   ],
   "citas": [
    {
     "texto": "Our constructive design requires each agent to build an independent case before deliberation begins",
