  {
   "id": "intraday volatility estimator",
   "nombre_canonico": "intraday volatility estimator",
   "tipo": "metrica",
   "nombres_vistos": [
    "intraday volatility estimator"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    27
   ],
   "definiciones": [
    {
     "texto": "Estimador de la volatilidad del precio derivado de parámetros del order flow (σ_a, σ_b, ϱ_a,b, θ) vía la relación σ_S = θ√(σ_b²+σ_a²−2σ_bσ_aϱ_a,b), comparado con volatilidad realizada del precio directo.",
     "doc_id": 27
    }
   ],
   "citas": [
    {
     "texto": "There are various estimators for intraday price volatility in this model, which allows to test the model",
     "doc_id": 27
    }
   ],
