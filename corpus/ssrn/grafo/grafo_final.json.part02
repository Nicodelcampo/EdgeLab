     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "probability normalization method",
     "doc_id": 43,
     "revisar": false
    }
   ]
  },
  {
   "id": "favourite longshot bia",
   "nombre_canonico": "favourite-longshot bias",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "favourite-longshot bias"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    43
   ],
   "definiciones": [
    {
     "texto": "Anomalía persistente en mercados de apuestas donde los apostadores sobrevaloran sistemáticamente a los perdedores probables (longshots) e infravaloran a los favoritos, generando retornos esperados menores en longshots.",
     "doc_id": 43
    }
   ],
   "citas": [
    {
     "texto": "The favourite-longshot bias is a pervasive anomaly in betting markets where bettors disproportionately favour longshots over favourites.",
     "doc_id": 43
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "lower expected returns on longshots",
     "doc_id": 43,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "peer-to-peer exchange pricing",
     "doc_id": 43,
     "revisar": false
    }
   ]
  },
  {
   "id": "shin method",
   "nombre_canonico": "Shin method",
   "tipo": "metodo",
   "nombres_vistos": [
    "Shin method"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    43
   ],
   "definiciones": [
    {
     "texto": "Método iterativo que ajusta las probabilidades implícitas de odds para corregir el favourite-longshot bias, mediante un parámetro z que representa la fracción de apostadores informados.",
     "doc_id": 43
    }
   ],
   "citas": [
    {
     "texto": "Shin's method corrects for the favourite-longshot bias by iterating on a parameter z that represents the fraction of knowledgeable bettors in the market.",
     "doc_id": 43
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "favourite-longshot bias",
     "doc_id": 43,
     "revisar": false
    }
   ]
  },
  {
   "id": "virtual liquidity",
   "nombre_canonico": "virtual liquidity",
   "tipo": "concepto",
   "nombres_vistos": [
    "virtual liquidity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    43
   ],
   "definiciones": [
    {
     "texto": "Liquidez efectiva creada por el exchange al emparejar apuestas entre distintos runners de un mismo evento (p.ej. back en un tenista equivale a lay en el otro), ofreciendo precios más ajustados que los visibles individualmente.",
     "doc_id": 43
    }
   ],
   "citas": [
    {
     "texto": "Betfair can provide virtual liquidity by matching bets across different runners, thus offering tighter prices and potentially higher volumes than is visible on individual runners.",
     "doc_id": 43
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "visible order book liquidity",
     "doc_id": 43,
     "revisar": false
    }
   ]
  },
  {
   "id": "dutching",
   "nombre_canonico": "dutching",
   "tipo": "estrategia",
   "nombres_vistos": [
    "dutching"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    43
   ],
   "definiciones": [
    {
     "texto": "Estrategia de apostar en múltiples resultados calculando los stakes de modo que el payout total sea el mismo sin importar cuál resultado gane; análogo a diversificación de portafolio.",
     "doc_id": 43
    }
   ],
   "citas": [
    {
     "texto": "In sports trading, dutching involves calculating the stakes for multiple bets in such a way that the total payout is the same regardless of which outcome wins.",
     "doc_id": 43
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "portfolio diversification",
     "doc_id": 43,
     "revisar": false
    }
   ]
  },
  {
   "id": "value betting",
   "nombre_canonico": "value betting",
   "tipo": "estrategia",
   "nombres_vistos": [
    "value betting"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    43
   ],
   "definiciones": [
    {
     "texto": "Estrategia de identificar apuestas donde las odds ofrecidas son mayores que la probabilidad real del resultado, análoga a value investing sobre acciones infravaloradas.",
     "doc_id": 43
    }
   ],
   "citas": [
    {
     "texto": "Value betting involves identifying bets where the odds offered by the bookmaker are higher than the true probability of the outcome.",
     "doc_id": 43
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "value investing",
     "doc_id": 43,
     "revisar": false
    }
   ]
  },
  {
   "id": "momentum betting",
   "nombre_canonico": "momentum betting",
   "tipo": "estrategia",
   "nombres_vistos": [
    "momentum betting"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    43
   ],
   "definiciones": [
    {
     "texto": "Estrategia de apostar por equipos o jugadores con buen desempeño reciente esperando que continúe, análoga al momentum trading financiero.",
     "doc_id": 43
    }
   ],
   "citas": [
    {
     "texto": "Momentum betting involves betting on teams or players that are currently performing well, with the expectation that their good form will continue.",
     "doc_id": 43
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "momentum",
     "doc_id": 43,
