  {
   "id": "mutually exciting process",
   "nombre_canonico": "mutually-exciting process",
   "tipo": "metodo",
   "nombres_vistos": [
    "mutually-exciting process"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    75
   ],
   "definiciones": [
    {
     "texto": "Proceso estocástico (tipo Hawkes) utilizado para modelar la intensidad de llegada de las órdenes de mercado, permitiendo que la llegada de órdenes 'influyentes' aumente de manera temporal la probabilidad de más órdenes.",
     "doc_id": 75
    }
   ],
   "citas": [
    {
     "texto": "By introducing a multi-factor mutually-exciting process we allow for feedback effects in market buy and sell orders and the shape of the limit order book (LOB).",
     "doc_id": 75
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "short-term alpha",
     "doc_id": 75,
     "revisar": false
    }
   ]
  },
  {
   "id": "inventory penalty",
   "nombre_canonico": "inventory penalty",
   "tipo": "metodo",
   "nombres_vistos": [
    "inventory penalty"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    75
   ],
   "definiciones": [
    {
     "texto": "Término en la función objetivo del HFT (dentro de la formulación HJB) que penaliza la acumulación de un inventario grande a través del tiempo para evitar mantener posiciones largas o cortas de alto riesgo.",
     "doc_id": 75
    }
   ],
   "citas": [
    {
     "texto": "Optimal postings control for inventory risks by sending quotes to the LOB which induce mean reversion of inventories to an optimal level and by including a state dependent buffer",
     "doc_id": 75
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "directional strategy",
   "nombre_canonico": "directional strategy",
   "tipo": "estrategia",
   "nombres_vistos": [
    "directional strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    75
   ],
   "definiciones": [
    {
     "texto": "Estrategia que, basándose en la predictibilidad del short-term alpha, ajusta asimétricamente las órdenes en el LOB para capturar proactivamente pequeños y efímeros movimientos direccionales en el precio.",
     "doc_id": 75
    }
   ],
   "citas": [
    {
     "texto": "HF traders who do not include predictors of short-term-alpha in their strategies are driven out of the market because they are adversely selected by better informed traders and because they are not able to profit from directional strategies.",
     "doc_id": 75
    }
   ],
