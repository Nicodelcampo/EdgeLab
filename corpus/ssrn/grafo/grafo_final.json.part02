    }
   ]
  },
  {
   "id": "capability ratio",
   "nombre_canonico": "Capability ratio",
   "tipo": "metrica",
   "nombres_vistos": [
    "Capability ratio"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    76
   ],
   "definiciones": [
    {
     "texto": "Métrica utilizada para evaluar la capacidad de una estrategia HFT para generar ganancias netas de manera confiable, calculada como el exceso de ganancia esperada sobre un costo fijo respecto a la volatilidad y riesgo tolerado.",
     "doc_id": 76
    }
   ],
   "citas": [
    {
     "texto": "Capability theory models Proposition 1 by conveying the ability of a strategy to generate net profits πnet over the firms’ acceptable w with sufficient reliability.",
     "doc_id": 76
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "success probability",
     "doc_id": 76,
