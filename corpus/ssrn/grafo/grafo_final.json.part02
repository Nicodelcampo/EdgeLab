     "tipo_original": "CAUSA",
     "objeto_texto": "liquidity commonality",
     "doc_id": 42,
     "revisar": false
    }
   ]
  },
  {
   "id": "order flow correlation",
   "nombre_canonico": "order flow correlation",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "order flow correlation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    42
   ],
   "definiciones": [
    {
     "texto": "Correlación en los flujos de órdenes entre distintas acciones causada por la combinación de traders algorítmicos tomadores y proveedores de liquidez actuando en simultáneo en varios títulos.",
     "doc_id": 42
    }
   ],
   "citas": [
    {
     "texto": "This leads to order ﬂow correlations across stocks, as documented by Domowitz et al. (2005), and increases liquidity comovement through both of the mechanisms",
     "doc_id": 42
    }
   ],
   "relaciones_crudas": [
    {
