     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "first-passage time",
     "doc_id": 15,
     "revisar": false
    }
   ]
  },
  {
   "id": "trading strategy variance",
   "nombre_canonico": "trading strategy variance",
   "tipo": "metrica",
   "nombres_vistos": [
    "trading strategy variance"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    15
   ],
   "definiciones": [
    {
     "texto": "Varianza del retorno de la estrategia por unidad de tiempo; se muestra que es función lineal de la varianza instantánea de la componente no estacionaria θ², además de depender de la varianza del tiempo de ciclo T.",
     "doc_id": 15
    }
   ],
   "citas": [
    {
     "texto": "the variance of the return is aﬀected by both the drift and the instantaneous variance of the non-stationary component",
     "doc_id": 15
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "non-stationary model for statistical arbitrage trading",
     "doc_id": 15,
     "revisar": false
    }
   ]
  },
  {
   "id": "signal to noise ratio",
   "nombre_canonico": "signal-to-noise ratio",
   "tipo": "metrica",
   "nombres_vistos": [
    "signal-to-noise ratio"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    15
   ],
   "definiciones": [
    {
     "texto": "Ratio S = sqrt(µ²/σ²) definido como función objetivo alternativa al retorno esperado puro, análogo al Sharpe ratio con tasa libre de riesgo cero, usado para hallar la banda óptima que equilibra retorno y varianza.",
     "doc_id": 15
    }
   ],
   "citas": [
    {
     "texto": "we deﬁne the objective function as the following signal-to-noise ratio",
     "doc_id": 15
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "Sharpe ratio",
     "doc_id": 15,
     "revisar": false
    },
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "expected return maximization",
     "doc_id": 15,
     "revisar": false
    }
   ]
  },
  {
   "id": "expected return maximization",
   "nombre_canonico": "expected return maximization",
   "tipo": "metodo",
   "nombres_vistos": [
    "expected return maximization"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    15
   ],
   "definiciones": [
    {
     "texto": "Criterio de optimización de bandas que maximiza solo el retorno esperado µ*(b1,c) sin considerar la varianza; el paper muestra que ignora el efecto del componente no estacionario en el riesgo.",
     "doc_id": 15
    }
   ],
   "citas": [
    {
     "texto": "Note that maximising the expected return does not take into account the behaviour of the non-stationary component of the model",
     "doc_id": 15
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "signal-to-noise ratio",
     "doc_id": 15,
