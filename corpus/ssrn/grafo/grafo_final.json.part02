  {
   "id": "probing and learning",
   "nombre_canonico": "probing and learning",
   "tipo": "metodo",
   "nombres_vistos": [
    "probing and learning"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    76
   ],
   "definiciones": [
    {
     "texto": "Proceso heurístico de experimentación usado en entornos ambiguos, en el que se lanza una estrategia, se aprende de los resultados (validated learning) y se modifica iterativamente.",
     "doc_id": 76
    }
   ],
   "citas": [
    {
     "texto": "probing and learning is a process used in ambiguous environments where firms “launch [a strategy] in the market, learn from failures, and modify for future attempts",
     "doc_id": 76
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "probationary trading",
     "doc_id": 76,
     "revisar": false
    }
   ]
  },
  {
   "id": "probationary trading",
   "nombre_canonico": "probationary trading",
   "tipo": "metodo",
   "nombres_vistos": [
    "probationary trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    76
   ],
   "definiciones": [
    {
     "texto": "Operativa en vivo con escala y riesgo muy limitados, ejecutada con el fin de obtener la verdadera distribución empírica de resultados de una estrategia en reemplazo de un backtest poco confiable.",
     "doc_id": 76
    }
   ],
   "citas": [
    {
     "texto": "they appear to move on to (what I call) the concept of “probationary trading” (i.e. trading with limited scale or risk) in order to form the reference distribution ex post.",
     "doc_id": 76
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SUSTITUYE_A",
     "tipo_original": "SUSTITUYE_A",
