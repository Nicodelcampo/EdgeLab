    "stable distribution"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    19
   ],
   "definiciones": [
    {
     "texto": "Familia de distribuciones (generalización del teorema central del límite sin varianza finita) usada para modelar retornos con colas gruesas y persistencia, en contraposición al supuesto de normalidad de Bachelier/Fama.",
     "doc_id": 19
    }
   ],
   "citas": [
    {
     "texto": "Mandelbrot [1963] described the ﬁnancial market as a system with fat tails, stable distributions and persistence",
     "doc_id": 19
    }
   ],
   "relaciones_crudas": [
