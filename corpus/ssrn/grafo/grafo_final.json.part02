     "doc_id": 7,
     "revisar": false
    }
   ]
  },
  {
   "id": "unit root test power",
   "nombre_canonico": "unit root test power",
   "tipo": "concepto",
   "nombres_vistos": [
    "unit root test power"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    7
   ],
   "definiciones": [
    {
     "texto": "Capacidad de un test de raíz unitaria para rechazar correctamente la hipótesis nula (random walk) cuando el proceso realmente revierte a la media; el paper muestra que depende del tamaño muestral n y del ratio de varianzas entre residuo e innovaciones.",
     "doc_id": 7
    }
   ],
   "citas": [
    {
     "texto": "The power of each test was calculated as a function of the length 𝑛 of the sequence and the coefficient of mean reversion 𝜌.",
     "doc_id": 7
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "cointegration",
