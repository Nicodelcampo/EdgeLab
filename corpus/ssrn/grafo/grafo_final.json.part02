  {
   "id": "price overshooting",
   "nombre_canonico": "Price overshooting",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Price overshooting"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    65
   ],
   "definiciones": [
    {
     "texto": "Comportamiento temporal de los precios donde la sobrerreacción inicial generada por el estado de los niveles profundos del libro de órdenes se revierte parcialmente, haciendo que el impacto acumulativo a lo largo del tiempo sea inferior al impacto inicial.",
     "doc_id": 65
    }
   ],
   "citas": [
    {
     "texto": "The immediate effects of the slope variable are reversed when we take the cumulative effects into consideration, suggesting that prices overreact to information embedded in the LOB.",
     "doc_id": 65
    }
   ],
   "relaciones_crudas": [
