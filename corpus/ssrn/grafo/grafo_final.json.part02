  {
   "id": "girsanov s theorem",
   "nombre_canonico": "Girsanov's theorem",
   "tipo": "metodo",
   "nombres_vistos": [
    "Girsanov's theorem"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    24
   ],
   "definiciones": [
    {
     "texto": "Resultado que justifica el cambio de la medida de probabilidad real P a la medida neutral al riesgo Q, bajo la cual el drift del activo pasa a ser la tasa libre de riesgo r.",
     "doc_id": 24
    }
   ],
   "citas": [
    {
     "texto": "Girsanov’s Theorem changes the measure from the real-world measure P to the riskneutral measure Q.",
     "doc_id": 24
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "risk-neutral valuation",
     "doc_id": 24,
     "revisar": false
    }
   ]
  },
  {
   "id": "martingale property",
   "nombre_canonico": "martingale property",
   "tipo": "concepto",
   "nombres_vistos": [
    "martingale property"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    24
   ],
   "definiciones": [
    {
     "texto": "Propiedad de que el precio del activo descontado a la tasa libre de riesgo no tiene drift bajo la medida neutral al riesgo Q, lo que garantiza ausencia de arbitraje.",
     "doc_id": 24
    }
   ],
   "citas": [
    {
     "texto": "Under Q, ˜St evolves with zero drift (martingale property): d˜St = e−rtσSt dW Q t.",
     "doc_id": 24
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "risk-neutral valuation",
     "doc_id": 24,
     "revisar": false
    }
   ]
  },
