    }
   ]
  },
  {
   "id": "greening",
   "nombre_canonico": "greening",
   "tipo": "estrategia",
   "nombres_vistos": [
    "greening"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    43
   ],
   "definiciones": [
    {
     "texto": "Estrategia de combinar back y lay a distintos precios para asegurar la misma ganancia sin importar el resultado del evento; es el análogo de hedging financiero.",
     "doc_id": 43
    }
   ],
   "citas": [
    {
     "texto": "Greening is a popular trading strategy on sports exchanges that involves hedging a position to secure the same guaranteed profit regardless of the event's outcome.",
     "doc_id": 43
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "back and lay betting",
