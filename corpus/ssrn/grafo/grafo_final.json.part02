  {
   "id": "rolling sharpe ratio",
   "nombre_canonico": "rolling Sharpe ratio",
   "tipo": "metrica",
   "nombres_vistos": [
    "rolling Sharpe ratio"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    35
   ],
   "definiciones": [
    {
     "texto": "Sharpe ratio calculado sobre una ventana rodante de N días de retornos, usado como filtro para decidir dinámicamente qué pares operar en el período de testeo siguiente.",
     "doc_id": 35
    }
   ],
   "citas": [
    {
     "texto": "we compute the rolling Sharpe ratio for each pair over a rolling training window (t−δtrain, t), and execute trades on a rolling test window (t, t+δtest) only when the Sharpe ratio for a given pair is positive",
     "doc_id": 35
    }
   ],
