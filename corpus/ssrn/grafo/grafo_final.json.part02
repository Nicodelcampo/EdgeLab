   "tipo": "metodo",
   "nombres_vistos": [
    "market clearing operator"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    14
   ],
   "definiciones": [
    {
     "texto": "Operador determinista que mapea un estado transitorio del libro (posiblemente no admisible, con bid>=ask) a un estado admisible, ejecutando el emparejamiento de órdenes compatibles por precio y prioridad.",
     "doc_id": 14
    }
   ],
   "citas": [
    {
     "texto": "the market clearing procedure, represented as an operator acting of a pair of distributions of buy and sell orders",
     "doc_id": 14
    }
   ],
   "relaciones_crudas": [
