  {
   "id": "nodal liquidity",
   "nombre_canonico": "nodal liquidity",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "nodal liquidity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    20
   ],
   "definiciones": [
    {
     "texto": "Característica propia de los mercados de commodities según la cual el flujo no es naturalmente bidireccional como en renta fija, equity o FX; el flujo comercial (hedging) aparece de forma esporádica y no a demanda.",
     "doc_id": 20
    }
   ],
   "citas": [
    {
     "texto": "The commodity markets have “nodal liquidity.”",
     "doc_id": 20
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "order flow imbalance",
     "doc_id": 20,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "liquidity sweep",
     "doc_id": 20,
     "revisar": false
    }
   ]
  },
  {
   "id": "hedging flow",
   "nombre_canonico": "hedging flow",
   "tipo": "concepto",
   "nombres_vistos": [
    "hedging flow"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    20
   ],
   "definiciones": [
    {
     "texto": "Flujo generado cuando un participante comercial necesita iniciar o levantar coberturas; no ocurre a demanda, y planear cómo salir de una estrategia dependiendo de este flujo es parte clave del desarrollo de estrategias en commodities.",
     "doc_id": 20
    }
   ],
   "citas": [
    {
     "texto": "If a commercial market participant needs to initiate or lift hedges, there will be flow, but such transactions do not occur on demand.",
     "doc_id": 20
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "nodal liquidity",
     "doc_id": 20,
     "revisar": false
    },
    {
