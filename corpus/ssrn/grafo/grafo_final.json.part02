   "tipo": "fenomeno",
   "nombres_vistos": [
    "resources sector beta sensitivity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    29
   ],
   "definiciones": [
    {
     "texto": "Patrón observado de que las acciones del sector de recursos (minería/materias primas) muestran los mayores rangos de variación de beta al cambiar el día de referencia, dentro del índice JSE ALSI.",
     "doc_id": 29
    }
   ],
   "citas": [
