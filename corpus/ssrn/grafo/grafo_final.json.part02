    54
   ],
   "definiciones": [
    {
     "texto": "Episodio de estrés extremo de mercado en el que la demanda de liquidez overnight se vuelve altamente inelástica y las tasas se disparan; en Turquía las tasas anuales overnight llegaron a 2000%.",
     "doc_id": 54
    }
   ],
   "citas": [
