    },
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "pairs trading",
     "doc_id": 8,
     "revisar": false
    }
   ]
  },
  {
   "id": "elastic net regression",
   "nombre_canonico": "elastic net regression",
   "tipo": "metodo",
   "nombres_vistos": [
    "elastic net regression"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    8
   ],
   "definiciones": [
    {
     "texto": "Técnica de regresión regularizada usada para estimar qué características de la firma importan en el desempeño del pairs trading, minimizando overfitting y multicolinealidad entre las 81 variables independientes correlacionadas.",
     "doc_id": 8
    }
   ],
   "citas": [
    {
     "texto": "we adapt the elastic net regression because it can minimize overfitting and multicollinearity problems and also allows us to evaluate which firm characteristics matter in pairs trading",
     "doc_id": 8
    }
   ],
   "relaciones_crudas": [
