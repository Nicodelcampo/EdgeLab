   "tipo": "concepto",
   "nombres_vistos": [
    "resting limit order"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    54
   ],
   "definiciones": [
    {
     "texto": "Orden límite firme que la institución que la coloca está comprometida a honrar hasta que la retire o sea ejecutada por otra institución vía orden de mercado; su impacto en el rendimiento se mide por separado del de las órdenes de mercado ejecutadas.",
     "doc_id": 54
    }
   ],
   "citas": [
    {
     "texto": "traders either enter lend or borrow quotes where these quotes are ﬁrm in the sense that the quoting institution is committed to lend/borrow until it either withdraws the quote or another institution hits the limit order with a market order",
     "doc_id": 54
    }
   ],
