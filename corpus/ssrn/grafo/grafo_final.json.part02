   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    67
   ],
   "definiciones": [
    {
     "texto": "Aplicación de penalizaciones tipo LASSO o Ridge (L1 o L2) a las regresiones transversales de alfa, cuyo objetivo es reducir o eliminar señales débiles para mejorar la estimación fuera de muestra.",
     "doc_id": 67
    }
   ],
   "citas": [
    {
     "texto": "The Lasso approach replaces all smaller signals by zero and shrinks the larger ones by λ in absolute terms. In contrast, the ridge penalty shrinks all signals proportionally... ridge is equivalent to CSR!",
     "doc_id": 67
    }
   ],
   "relaciones_crudas": [
    {
