     "revisar": false
    }
   ]
  },
  {
   "id": "overround",
   "nombre_canonico": "overround",
   "tipo": "concepto",
   "nombres_vistos": [
    "overround"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    43
   ],
   "definiciones": [
    {
     "texto": "Margen del bookmaker/exchange calculado como la suma de las probabilidades implícitas (inversas de precio) de todos los resultados posibles; si excede 1 en backs hay edge para la casa.",
     "doc_id": 43
    }
   ],
   "citas": [
    {
     "texto": "Overround measures a bookmaker's edge and is calculated by summing the inverse of the prices for all possible outcomes.",
     "doc_id": 43
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "bookmaker edge",
     "doc_id": 43,
