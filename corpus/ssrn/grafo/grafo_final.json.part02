     "objeto_texto": "de Finetti coherence",
     "doc_id": 31,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "no-arbitrage pricing",
     "doc_id": 31,
     "revisar": false
    },
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Monte Carlo simulation",
     "doc_id": 31,
     "revisar": false
    }
   ]
  },
  {
   "id": "first fundamental theorem of finance",
   "nombre_canonico": "First Fundamental Theorem of Finance",
   "tipo": "concepto",
   "nombres_vistos": [
    "First Fundamental Theorem of Finance"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    31
   ],
   "definiciones": [
    {
     "texto": "Teorema que exige que los precios admitan una representación libre de arbitraje y consistente con una medida de probabilidad, independiente de la información pasada; se usa como restricción computacional dura dentro de la arquitectura de red neuronal.",
     "doc_id": 31
    }
   ],
   "citas": [
    {
     "texto": "The First Fundamental Theorem of Finance (FFTF, [6]) requires prices to admit an arbitragefree, measure-consistent representation, independent of past information.",
     "doc_id": 31
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "no-arbitrage pricing",
     "doc_id": 31,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Markovian Activation Function",
     "doc_id": 31,
     "revisar": false
    }
   ]
  },
  {
   "id": "economic hallucination",
   "nombre_canonico": "economic hallucination",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "economic hallucination"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    31
   ],
   "definiciones": [
    {
     "texto": "Distorsión de valuación, cobertura y riesgo que surge cuando modelos de IA aprenden patrones en vez de leyes económicas, generando señales anticipatorias erróneas y arbitrajes espurios.",
     "doc_id": 31
    }
   ],
   "citas": [
    {
     "texto": "AI learns patterns, not laws, and that is where economic hallucination arises, distorting valuation, hedging, and risk.",
     "doc_id": 31
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "spurious arbitrage",
     "doc_id": 31,
     "revisar": false
    }
   ]
  },
  {
   "id": "spuriou arbitrage",
   "nombre_canonico": "spurious arbitrage",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "spurious arbitrage"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    31
   ],
   "definiciones": [
    {
     "texto": "Señales de arbitraje aparentes pero falsas que emergen en modelos de IA convencionales entrenados sin restricciones estructurales de no-arbitraje.",
     "doc_id": 31
    }
   ],
   "citas": [
    {
     "texto": "Anticipatory signals are mistaken for edge, spurious arbitrage emerges, and distorted risk exposures materialize",
     "doc_id": 31
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "chapman kolmogorov equation",
   "nombre_canonico": "Chapman-Kolmogorov equations",
   "tipo": "metodo",
   "nombres_vistos": [
    "Chapman-Kolmogorov equations"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    31
   ],
   "definiciones": [
    {
     "texto": "Ecuaciones que rigen la composición de transiciones de probabilidad en procesos markovianos multi-paso; se usan para calcular transiciones de largo plazo (MAF) como producto de transiciones de un paso.",
     "doc_id": 31
    }
   ],
   "citas": [
    {
     "texto": "For transitions from ti to tj with j > i, the long-step MAF is defined recursively... as in the Chapman–Kolmogorov equations.",
     "doc_id": 31
    }
   ],
   "relaciones_crudas": [
