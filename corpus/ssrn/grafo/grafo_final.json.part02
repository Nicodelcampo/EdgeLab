  {
   "id": "courant friedrich lewy condition",
   "nombre_canonico": "Courant-Friedrichs-Lewy condition",
   "tipo": "metodo",
   "nombres_vistos": [
    "Courant-Friedrichs-Lewy condition"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    31
   ],
   "definiciones": [
    {
     "texto": "Condición de estabilidad numérica que acota el paso temporal de la red en función de la máxima intensidad de transición del generador markoviano, garantizando que las probabilidades de transición permanezcan válidas.",
     "doc_id": 31
    }
   ],
   "citas": [
    {
     "texto": "The CFL condition bounds the time step (i.e. the granularity of all layers) to ensure transition probabilities remain valid, preventing numerical instability.",
     "doc_id": 31
    }
   ],
   "relaciones_crudas": [
    {
