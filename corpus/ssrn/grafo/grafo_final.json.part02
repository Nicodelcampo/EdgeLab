   "doc_ids": [
    56
   ],
   "definiciones": [
    {
     "texto": "Función que da la distribución de probabilidad del valor futuro del activo x(T) dado su valor inicial x(t); es la variable central que el paper deriva vía integral de caminos.",
     "doc_id": 56
    }
   ],
   "citas": [
    {
     "texto": "𝑃(𝑡, 𝑥(𝑡); 𝑇, 𝑥(𝑇)): Propagator gives the probability distribution of 𝑥(𝑇) at time 𝑇,  when at time 𝑡, the state is 𝑥(𝑡).",
