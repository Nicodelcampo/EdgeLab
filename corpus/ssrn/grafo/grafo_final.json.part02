    31
   ],
   "definiciones": [
    {
     "texto": "Ajuste XVA que cuantifica el valor esperado de las ineficiencias de cobertura como la expectativa descontada de la diferencia entre el valor del portafolio QIS y el valor de la cobertura a lo largo de trayectorias neuronales forward.",
     "doc_id": 31
    }
   ],
   "citas": [
    {
