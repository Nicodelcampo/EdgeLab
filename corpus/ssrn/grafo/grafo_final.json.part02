   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    69
   ],
   "definiciones": [
    {
     "texto": "Backtesting vectorizado con operaciones matriciales (NumPy/pandas), computacionalmente superior y dominante en investigación académica, pero menos realista para modelar balances de cash, fills parciales y constraints; adecuado sobre todo para estrategias cash-neutral.",
     "doc_id": 69
    }
   ],
   "citas": [
    {
     "texto": "Simple tensor (matrix) operations are suﬃcient to simulate cash-neutral strategies.",
     "doc_id": 69
    }
   ],
