     "doc_id": 41,
     "revisar": false
    }
   ]
  },
  {
   "id": "reverse causality",
   "nombre_canonico": "reverse causality",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "reverse causality"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    41
   ],
   "definiciones": [
    {
     "texto": "Riesgo de que la asociación entre AT e investment-to-price sensitivity no sea causal porque los AT se atraen naturalmente a acciones líquidas con mayor informatividad de precio, en lugar de causarla.",
     "doc_id": 41
    }
   ],
   "citas": [
    {
     "texto": "ATs are inherently attracted to liquid stocks. This implies that ATs tend to trade the stocks of the firms with greater investment-to-price sensitivity and benefit from their price informativeness, raising a reverse causality concern",
     "doc_id": 41
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "difference-in-differences",
     "doc_id": 41,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "two-stage least squares",
     "doc_id": 41,
     "revisar": false
    }
   ]
  },
  {
   "id": "heckman selection model",
   "nombre_canonico": "Heckman selection model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Heckman selection model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    41
   ],
   "definiciones": [
    {
     "texto": "Enfoque de estimación en dos etapas usado para testear sesgo de selección en cómo los AT eligen operar entre distintas acciones, reportado en el Apéndice de Internet.",
     "doc_id": 41
    }
   ],
   "citas": [
    {
     "texto": "we use the two-stage Heckman estimation approach to test for selection bias in how ATs trade across stocks and report the results in the Internet Appendix",
     "doc_id": 41
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "omitted variable bias",
     "doc_id": 41,
     "revisar": false
    }
   ]
  },
  {
   "id": "earning forecast accuracy",
   "nombre_canonico": "earnings forecast accuracy",
   "tipo": "metrica",
   "nombres_vistos": [
    "earnings forecast accuracy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    41
   ],
   "definiciones": [
    {
     "texto": "Precisión de los pronósticos de resultados de los gerentes, medida como la diferencia en los errores de dos pronósticos consecutivos escalada por el precio de la acción antes del primer pronóstico; usada como canal de RPE.",
     "doc_id": 41
    }
   ],
   "citas": [
    {
     "texto": "we find that an average level of AT increases the effect of a one standard deviation shock to the stock price on managers’ forecast accuracy by about 17%",
     "doc_id": 41
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "revelatory price efficiency",
     "doc_id": 41,
