   "tipo": "metodo",
   "nombres_vistos": [
    "Reality Check"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    6
   ],
   "definiciones": [
    {
     "texto": "Test bootstrap de White (2000) para data snooping que evalúa si la regla de trading de mejor desempeño entre un universo de m candidatas supera a un benchmark, usando el máximo de performance excedente estandarizado.",
     "doc_id": 6
    }
   ],
   "citas": [
    {
     "texto": "White (2000) introduced the Reality Check for data snooping, a bootstrap-based test of the null hypothesis that the best-performing trading rule (among a universe of m candidate rules) does not outperform a benchmark.",
     "doc_id": 6
    }
   ],
   "relaciones_crudas": [
