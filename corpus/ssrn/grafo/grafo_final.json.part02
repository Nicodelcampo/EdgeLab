  {
   "id": "stochastic partial differential equation model",
   "nombre_canonico": "stochastic partial differential equation model",
   "tipo": "metodo",
   "nombres_vistos": [
    "stochastic partial differential equation model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    27
   ],
   "definiciones": [
    {
     "texto": "Ecuación en derivadas parciales estocástica con ruido multiplicativo que describe la evolución de la densidad centrada del libro de órdenes u_t(x), combinando términos de convección, difusión y cancelación proporcional.",
     "doc_id": 27
    }
   ],
   "citas": [
    {
     "texto": "We propose an analytically tractable class of models for the dynamics of a limit order book, described as the solution of a stochastic partial differential equation (SPDE) with multiplicative noise",
     "doc_id": 27
    }
   ],
   "relaciones_crudas": [
