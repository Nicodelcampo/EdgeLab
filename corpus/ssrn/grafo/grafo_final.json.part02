  {
   "id": "computational cost trade off monte carlo vs kolmogorov",
   "nombre_canonico": "computational cost trade-off Monte Carlo vs Kolmogorov",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "computational cost trade-off Monte Carlo vs Kolmogorov"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    14
   ],
   "definiciones": [
    {
     "texto": "Hallazgo de complejidad computacional: el costo de Monte Carlo crece cuadráticamente con el horizonte temporal, mientras que resolver la ecuación de Kolmogorov crece linealmente, por lo que conviene Monte Carlo para un solo horizonte y Kolmogorov para evaluaciones secuenciales múltiples.",
     "doc_id": 14
    }
   ],
   "citas": [
    {
     "texto": "the time complexity of the Kolmogorov equation grows linearly...the time complexity of the Monte Carlo method grows quadratically with time",
     "doc_id": 14
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "backward Kolmogorov equation",
     "doc_id": 14,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Monte Carlo simulation",
     "doc_id": 14,
     "revisar": false
    }
   ]
  },
  {
   "id": "non stationary behaviour",
   "nombre_canonico": "non-stationary behaviour",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "non-stationary behaviour"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    15
   ],
   "definiciones": [
    {
     "texto": "Efecto no estacionario en series de precios financieras que dificulta distinguir movimientos extremos transitorios de cambios permanentes de nivel, invalidando el uso de medidas estadísticas invariantes en el tiempo para determinar puntos de entrada/salida.",
     "doc_id": 15
    }
   ],
   "citas": [
    {
     "texto": "when the data exhibits non-stationary eﬀects the entry and exit points cannot be reliably determined using methods and models based on stationary time series",
     "doc_id": 15
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "trading strategy variance",
     "doc_id": 15,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "cointegration",
     "doc_id": 15,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "mean reversion",
     "doc_id": 15,
     "revisar": false
    }
   ]
  },
  {
   "id": "arithmetic brownian motion",
   "nombre_canonico": "arithmetic Brownian motion",
   "tipo": "concepto",
   "nombres_vistos": [
    "arithmetic Brownian motion"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    15
   ],
   "definiciones": [
    {
     "texto": "Proceso estocástico no estacionario (dMt = γ dt + θ dZt) que el paper usa para modelar la componente de largo plazo del log-precio del activo sintético, driftando con γ y volatilidad instantánea θ.",
     "doc_id": 15
    }
   ],
   "citas": [
    {
     "texto": "dMt = γdt + θdZt",
     "doc_id": 15
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "non-stationary model for statistical arbitrage trading",
