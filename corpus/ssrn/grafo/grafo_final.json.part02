    }
   ]
  },
  {
   "id": "dynamic scaling factor",
   "nombre_canonico": "dynamic scaling factor",
   "tipo": "metodo",
   "nombres_vistos": [
    "dynamic scaling factor"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    17
   ],
   "definiciones": [
    {
     "texto": "Parámetro γ = γ0×(1 + δ×|OI|×σ_ratio) que aumenta el peso del momentum de ejecución cuando hay alto imbalance en el tope del libro y volatilidad elevada respecto al promedio histórico.",
     "doc_id": 17
    }
   ],
   "citas": [
    {
     "texto": "This dynamic adjustment increases the influence of execution momentum during periods of high imbalance and elevated volatility",
     "doc_id": 17
    }
   ],
   "relaciones_crudas": [
    {
