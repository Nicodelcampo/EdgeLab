   "doc_frecuencia": 1,
   "doc_ids": [
    40
   ],
   "definiciones": [
    {
     "texto": "Técnica de validación que asigna fechas de pseudo-anuncio aleatorias fuera de la ventana de evento y recalcula el AT anormal con la misma metodología, para confirmar que la relación hallada es específica al evento y no un artefacto de características persistentes de la firma.",
     "doc_id": 40
    }
   ],
   "citas": [
    {
     "texto": "All placebo coefficients are statistically insignificant (Table 7, Panel A), confirming that our measure captures event-specific dynamics rather than persistent firm characteristics.",
     "doc_id": 40
    }
   ],
