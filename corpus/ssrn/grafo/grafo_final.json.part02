  {
   "id": "multiple hypothesi testing",
   "nombre_canonico": "multiple hypothesis testing",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "multiple hypothesis testing"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    8
   ],
   "definiciones": [
    {
     "texto": "Problema por el cual el número de pares incorrectamente identificados como cointegrados crece exponencialmente con el número de acciones testeadas, aun cuando ninguna tenga relación real.",
     "doc_id": 8
    }
   ],
   "citas": [
    {
     "texto": "the number of wrongly identified pairs exponentially increases with the number of stocks, even though none of them have any long-term relationship",
     "doc_id": 8
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "non-convergence risk",
     "doc_id": 8,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "firm characteristics similarity",
     "doc_id": 8,
     "revisar": false
    }
   ]
  },
  {
   "id": "non convergence risk",
   "nombre_canonico": "non-convergence risk",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "non-convergence risk"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    8
   ],
   "definiciones": [
    {
     "texto": "Riesgo de que la divergencia de precios de un par identificado no converja, generando pérdidas; se origina en pares espurios identificados por el problema de tests múltiples.",
     "doc_id": 8
    }
   ],
   "citas": [
    {
     "texto": "incorrectly identifying pairs can increase non-convergence risk",
     "doc_id": 8
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "loss",
     "doc_id": 8,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
