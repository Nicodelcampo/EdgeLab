    6
   ],
   "definiciones": [
    {
     "texto": "Método que impone sparsity sobre la matriz de precisión (inversa de covarianza) maximizando la log-verosimilitud gaussiana penalizada con norma L1; los ceros corresponden a independencia condicional entre activos.",
     "doc_id": 6
    }
   ],
   "citas": [
