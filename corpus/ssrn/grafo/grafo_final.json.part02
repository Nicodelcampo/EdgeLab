    }
   ]
  },
  {
   "id": "electronic trading",
   "nombre_canonico": "electronic trading",
   "tipo": "concepto",
   "nombres_vistos": [
    "electronic trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    20
   ],
   "definiciones": [
    {
     "texto": "Modalidad de negociación fuera del piso físico que permite a un market-maker operar en múltiples productos simultáneamente, a diferencia del open-outcry.",
     "doc_id": 20
    }
   ],
   "citas": [
    {
     "texto": "whereas in electronic trading an off-the-floor market-maker can make markets in multiple products at the same time",
     "doc_id": 20
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
