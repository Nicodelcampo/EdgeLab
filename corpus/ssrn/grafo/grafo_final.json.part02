   "tipo": "metodo",
   "nombres_vistos": [
    "Dixon-Coles model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    43
   ],
   "definiciones": [
    {
     "texto": "Modelo temprano de fútbol basado en un proceso de arribo de Poisson que capturó derivas predecibles de precio mientras no ocurre un gol, explotando ineficiencias del mercado de apuestas.",
     "doc_id": 43
    }
   ],
   "citas": [
    {
     "texto": "Dixon and Coles [15] began with using a Poisson arrival process, which demonstrated predictable price drifts as time passed without a goal.",
     "doc_id": 43
    }
   ],
