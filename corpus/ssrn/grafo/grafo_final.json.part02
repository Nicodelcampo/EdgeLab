    }
   ]
  },
  {
   "id": "kullback leibler divergence",
   "nombre_canonico": "Kullback-Leibler divergence",
   "tipo": "metodo",
   "nombres_vistos": [
    "Kullback-Leibler divergence"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    16
   ],
   "definiciones": [
    {
     "texto": "Medida de disimilitud entre medidas de probabilidad (relative entropy), siempre positiva y cero solo si las medidas coinciden; se usa para penalizar la elección de un escenario Q distinto del estimado P, regulando cuánto se aparta la regla de trading del modelo calibrado según la confianza del agente.",
     "doc_id": 16
    }
   ],
   "citas": [
    {
     "texto": "EQ[log(dQ/dP)|Ft] is called Kullback–Leibler divergence or relative entropy",
     "doc_id": 16
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "model uncertainty",
     "doc_id": 16,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "optimal stopping",
     "doc_id": 16,
     "revisar": false
    }
   ]
  },
  {
   "id": "optimal stopping",
   "nombre_canonico": "optimal stopping",
   "tipo": "metodo",
   "nombres_vistos": [
    "optimal stopping"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    16
   ],
   "definiciones": [
    {
     "texto": "Problema matemático de encontrar el tiempo de parada óptimo que maximiza el valor esperado de un proceso; en este paper se resuelve incorporando incertidumbre de modelo para identificar el punto más divergente del valor medio de reversión (frontera de salida) de un spread.",
     "doc_id": 16
    }
   ],
   "citas": [
    {
     "texto": "we consider the following optimal stopping problem",
     "doc_id": 16
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Ornstein-Uhlenbeck process",
     "doc_id": 16,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "statistical arbitrage",
     "doc_id": 16,
     "revisar": false
    }
   ]
  },
  {
   "id": "optimal stopping boundary",
   "nombre_canonico": "optimal stopping boundary",
   "tipo": "concepto",
   "nombres_vistos": [
    "optimal stopping boundary"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    16
   ],
   "definiciones": [
    {
     "texto": "Frontera explícita bx(t) que identifica el punto más divergente del proceso respecto de la media de reversión y que sirve como disparador (trigger) para tomar posición; se deriva resolviendo el problema de parada óptima con incertidumbre de modelo.",
     "doc_id": 16
    }
   ],
   "citas": [
    {
     "texto": "The boundary bx(t) given in (4) identifies the maximum value since Vλ(t, bx(t)) = bx(t). Thus, bx(t) characterizes the most divergent point.",
     "doc_id": 16
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "optimal stopping boundary without model uncertainty",
     "doc_id": 16,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "optimal stopping",
     "doc_id": 16,
     "revisar": false
    }
   ]
  },
  {
   "id": "ambiguity aversion",
   "nombre_canonico": "ambiguity aversion",
   "tipo": "concepto",
   "nombres_vistos": [
    "ambiguity aversion"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    16
   ],
   "definiciones": [
    {
     "texto": "Grado de confianza del agente en su estimación del modelo, representado por la constante λ>0; a mayor λ, menor confianza y mayor exigencia de robustez frente a la especificación errónea de parámetros.",
     "doc_id": 16
    }
   ],
   "citas": [
    {
     "texto": "The constant λ > 0 represents the degree of agents' confidence in their estimation",
     "doc_id": 16
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "optimal stopping boundary",
     "doc_id": 16,
     "revisar": false
    }
   ]
  },
  {
   "id": "certainty equivalent",
   "nombre_canonico": "certainty equivalent",
   "tipo": "concepto",
   "nombres_vistos": [
    "certainty equivalent"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    16
   ],
   "definiciones": [
    {
     "texto": "Concepto de teoría de utilidad esperada que aquí se muestra estructuralmente análogo a la función de valor del problema de parada óptima con incertidumbre de modelo, dando lugar a una 'prima de ambigüedad' análoga a la prima de riesgo.",
     "doc_id": 16
    }
   ],
   "citas": [
    {
     "texto": "Vλ(t, x) may be called the certainty equivalent for ambiguity",
     "doc_id": 16
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "value function for optimal stopping under model uncertainty",
     "doc_id": 16,
     "revisar": false
    }
   ]
  },
  {
   "id": "parameter misspecification",
   "nombre_canonico": "parameter misspecification",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "parameter misspecification"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    16
   ],
   "definiciones": [
    {
     "texto": "Error en la estimación de los parámetros del proceso OU (velocidad de reversión α, volatilidad σ, media µ) que puede llevar a una regla de trading incorrecta si no se corrige con un margen de robustez.",
     "doc_id": 16
    }
   ],
   "citas": [
    {
     "texto": "the odds of the coin flip coming up heads or tails is incorrectly recognized, then this recognition could lead to a result opposite of that expected",
     "doc_id": 16
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "model uncertainty",
     "doc_id": 16,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "ambiguity aversion",
     "doc_id": 16,
     "revisar": false
    }
   ]
  },
  {
   "id": "finite time horizon",
   "nombre_canonico": "finite time horizon",
   "tipo": "concepto",
   "nombres_vistos": [
    "finite time horizon"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    16
   ],
   "definiciones": [
    {
     "texto": "Restricción temporal finita (T) bajo la cual se resuelve el problema de parada óptima, a diferencia de trabajos previos que lo formulan en horizonte infinito; es central porque en la práctica el spread no puede sostenerse indefinidamente.",
     "doc_id": 16
    }
   ],
   "citas": [
    {
     "texto": "we must construct this trading code so that it works well in a finite time horizon",
     "doc_id": 16
    }
   ],
   "relaciones_crudas": [
    {
