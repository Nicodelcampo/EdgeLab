   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    17
   ],
   "definiciones": [
    {
     "texto": "Filtro de ruido que exige que la señal persista K ventanas consecutivas antes de operar, con K adaptativo al régimen de volatilidad (K=2 en alta, 3 normal, 4 baja, con umbrales en percentiles 25/75 de la volatilidad).",
     "doc_id": 17
    }
   ],
   "citas": [
    {
     "texto": "the confirmation mechanism requires consistent signals across multiple windows before generating trading signals",
     "doc_id": 17
    }
   ],
