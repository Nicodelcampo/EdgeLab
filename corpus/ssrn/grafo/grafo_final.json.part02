   "tipo": "concepto",
   "nombres_vistos": [
    "managerial learning"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    41
   ],
   "definiciones": [
    {
     "texto": "Canal por el cual los gerentes extraen información nueva de los precios de las acciones para tomar decisiones de inversión; el paper argumenta que AT lo potencia al fomentar la producción de información nueva.",
     "doc_id": 41
    }
   ],
   "citas": [
    {
     "texto": "AT contributes to managerial learning by fostering the production of new information, thereby increasing firms’ investment-to-price sensitivity",
     "doc_id": 41
    }
   ],
