     "tipo_original": "MITIGA",
     "objeto_texto": "inventory risk",
     "doc_id": 22,
     "revisar": false
    }
   ]
  },
  {
   "id": "disposition effect",
   "nombre_canonico": "disposition effect",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "disposition effect"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    22
   ],
   "definiciones": [
    {
     "texto": "Tendencia documentada de los traders a realizar ganancias prematuramente y postergar el reconocimiento de pérdidas; el paper la usa como justificación para el trailing stop mecánico.",
     "doc_id": 22
    }
   ],
   "citas": [
    {
     "texto": "The disposition effect—the empirically documented tendency of traders to realise gains prematurely and defer loss recognition—is one of the most robust findings in behavioural finance",
     "doc_id": 22
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "early profit exits",
     "doc_id": 22,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "trailing stop",
     "doc_id": 22,
     "revisar": false
    }
   ]
  },
  {
   "id": "fire sale",
   "nombre_canonico": "fire sale",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "fire sale"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Liquidación forzada de activos ilíquidos por parte de bancos para cubrir un shortfall de caja, cuyo propio volumen deprime el precio obtenido (impacto de mercado endógeno).",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "We consider a network of banks that optimally choose a strategy of asset liquidations and borrowing in order to cover short term obligations.",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "market impact",
     "doc_id": 23,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "systemic risk",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "price mediated contagion",
   "nombre_canonico": "price-mediated contagion",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "price-mediated contagion"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Forma de contagio financiero que se propaga a través del impacto de las liquidaciones sobre los precios de mercado, en contraste con el contagio por obligaciones interbancarias directas.",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "This study focuses on a form of global contagion through asset prices, and investigates the existence and uniqueness of Nash equilibrium in a model of ﬁre sales and collateralized borrowing.",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "systemic risk",
     "doc_id": 23,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "market impact",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "limit order book based price",
   "nombre_canonico": "Limit Order Book Based Price",
   "tipo": "concepto",
   "nombres_vistos": [
    "Limit Order Book Based Price"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Esquema de pricing (denominado LOB en el paper) en el que todos los bancos colocan órdenes a la misma velocidad, por lo que quienes venden menos volumen terminan antes y obtienen mejor precio que quienes venden más y siguen erosionando el libro.",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "The LOB setting distinguishes prices by assuming all ﬁrms place orders at the same speed; banks with smaller order volumes will receive a higher price than those with a larger order volume.",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "VWAP",
     "doc_id": 23,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "limit order book",
     "doc_id": 23,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "order book density function",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "inverse demand function",
   "nombre_canonico": "inverse demand function",
   "tipo": "concepto",
   "nombres_vistos": [
    "inverse demand function"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Función que mapea el volumen liquidado al precio promedio obtenido por cada banco; generaliza tanto el esquema VWAP como el LOB y sirve de insumo para las condiciones de existencia/unicidad del equilibrio.",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "Let ¯fi : Rn + →[0, 1] denote the average price obtained by bank i = 1, ..., n given the set of system liquidations",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "market impact",
     "doc_id": 23,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "order book density function",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "order book density function",
   "nombre_canonico": "order book density function",
   "tipo": "dato",
   "nombres_vistos": [
    "order book density function"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Función f que describe el precio marginal del próximo trade infinitesimal a medida que se consume el libro; es el insumo primitivo del que se derivan tanto la función VWAP como la LOB, y se asume estrictamente decreciente y dos veces diferenciable.",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "Let this density be given by f : R+ →[0, 1]. Alternatively, this f can be viewed as a the price of the next inﬁnitely small trade.",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "limit order book",
     "doc_id": 23,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "market impact",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "haircut",
   "nombre_canonico": "haircut",
   "tipo": "concepto",
   "nombres_vistos": [
    "haircut"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Descuento sobre el valor de mercado del activo aplicado por el mercado repo como colateral; a diferencia del precio de liquidación, es único para todo el sistema y depende solo del volumen total liquidado por todos los bancos, no de la venta individual.",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "the function g encodes the haircut on the asset as a mapping of the total liquidations by all the banks",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "collateralized borrowing",
     "doc_id": 23,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "fire sale",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "collateralized borrowing",
   "nombre_canonico": "collateralized borrowing",
   "tipo": "concepto",
   "nombres_vistos": [
    "collateralized borrowing"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Financiamiento de corto plazo vía repo, colateralizado con el mismo activo ilíquido que se está liquidando; los bancos optimizan la combinación entre vender el activo y pedir prestado a la tasa repo r.",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "The borrowing is done in the form of collateralized repurchase agreements, the haircut level of which depends on the total liquidations of all the banks.",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "haircut",
     "doc_id": 23,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "systemic risk",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "nash equilibrium",
   "nombre_canonico": "Nash equilibrium",
   "tipo": "metodo",
   "nombres_vistos": [
    "Nash equilibrium"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Marco de solución del modelo: cada banco elige su estrategia de liquidación/préstamo óptima dada la estrategia de los demás; el paper prueba existencia vía teorema de punto fijo de Brouwer/Kakutani y condiciones de unicidad vía Banach y Tarski.",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "By nature of this setup, banks’ behavior is considered as a Nash equilibrium.",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "fire sale",
     "doc_id": 23,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "market impact",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "closing auction",
   "nombre_canonico": "closing auction",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "closing auction"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Mecanismo real de algunos mercados (México, India, Arabia Saudita) que calcula el precio de cierre de forma análoga al esquema VWAP del paper.",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "the VWAP example corresponds to how some exchanges calculate the closing price (e.g., in Mexico, India and Saudi Arabia",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "VWAP",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "fixed point theorem",
   "nombre_canonico": "fixed point theorem",
   "tipo": "metodo",
   "nombres_vistos": [
    "fixed point theorem"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Herramienta matemática (Brouwer/Kakutani para existencia, Tarski para el lattice de precios bajo VWAP, Banach para unicidad) usada para demostrar existencia y unicidad del equilibrio de liquidación/precio.",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "Thus a joint equilibrium (s∗∗, q∗∗, ¯q∗∗ 1 , ..., ¯q∗∗ n ) can be found via Kakutani’s ﬁxed point theorem.",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Nash equilibrium",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "monotonicity of clearing price",
   "nombre_canonico": "monotonicity of clearing prices",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "monotonicity of clearing prices"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Propiedad que sí se cumple bajo VWAP (permite construir un lattice de soluciones y garantizar convergencia de la iteración de Picard) pero falla bajo LOB, como muestra un contraejemplo numérico explícito del paper.",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "Importantly, Theorem 3.3 is not applied to the LOB structure. To demonstrate the lack of such a result for the LOB, we present here a counterexample to the monotonicity property",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Limit Order Book Based Price",
     "doc_id": 23,
     "revisar": false
    },
    {
     "tipo": "CONTRADICE_A",
     "tipo_original": "CONTRADICE_A",
     "objeto_texto": "VWAP",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "repo rate sensitivity",
   "nombre_canonico": "repo rate sensitivity",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "repo rate sensitivity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Relación por la que un aumento en la tasa repo r encarece el financiamiento y empuja a los bancos a liquidar más activo ilíquido y pedir menos prestado, reduciendo el precio terminal del activo; usada como palanca regulatoria para contener fire sales.",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "Intuitively, we expect that as the repo rate rises, and borrowing becomes more expensive the liquidation of the illiquid asset increase.",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "fire sale",
     "doc_id": 23,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "systemic risk",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "fundamentally solvent bank",
   "nombre_canonico": "fundamentally solvent bank",
   "tipo": "concepto",
   "nombres_vistos": [
    "fundamentally solvent bank"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Banco que puede cubrir su shortfall en cualquier escenario porque su shortfall es menor o igual al valor de todos sus activos al precio obtenido si liquidara todo; condición necesaria para la unicidad del equilibrio (Teorema 3.6).",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "we will say that bank i ∈{1, ..., n} is fundamentally solvent if it is able to cover its shortfall in any case, that is if hi ≤ai ¯fi(a)",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Nash equilibrium",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "picard iteration",
   "nombre_canonico": "Picard iteration",
   "tipo": "metodo",
   "nombres_vistos": [
    "Picard iteration"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Algoritmo de cómputo numérico de los precios de equilibrio (q, ¯q) por iteración desde un punto inicial; converge garantizado bajo VWAP (por el lattice) y empíricamente también bajo LOB en todos los casos probados por los autores, aunque no está probado formalmente.",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "these are computed via Picard iterations beginning from (q0, ¯q0) := 1n+1",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "monotonicity of clearing prices",
     "doc_id": 23,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Nash equilibrium",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "heterogeneou execution price",
   "nombre_canonico": "heterogeneous execution prices",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "heterogeneous execution prices"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    23
   ],
   "definiciones": [
    {
     "texto": "Bajo LOB, distintos participantes que liquidan volúmenes distintos obtienen precios promedio distintos entre sí; bajo VWAP todos obtienen el mismo precio promedio. Esta heterogeneidad es la novedad central del paper frente a la literatura previa de precio único.",
     "doc_id": 23
    }
   ],
   "citas": [
    {
     "texto": "This is a very interesting and novel example, as in this case, diﬀerent banks pay diﬀerent prices.",
     "doc_id": 23
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Limit Order Book Based Price",
     "doc_id": 23,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "VWAP",
     "doc_id": 23,
     "revisar": false
    }
   ]
  },
  {
   "id": "black schole merton model",
   "nombre_canonico": "Black-Scholes-Merton model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Black-Scholes-Merton model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    24
   ],
   "definiciones": [
    {
     "texto": "Modelo de valuación de opciones europeas que da una solución cerrada bajo supuestos de volatilidad constante, sin fricciones y difusión continua; es la base de la mayoría de los modelos de pricing de derivados posteriores.",
     "doc_id": 24
    }
   ],
   "citas": [
    {
     "texto": "The Black-Scholes-Merton model, published in 1973 by Fischer Black, Myron Scholes, and Robert Merton, revolutionized option pricing by providing a closed-form solution for European-style options.",
     "doc_id": 24
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "geometric Brownian motion",
     "doc_id": 24,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "risk-neutral valuation",
     "doc_id": 24,
     "revisar": false
    },
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "naive option pricing",
     "doc_id": 24,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "constant volatility",
     "doc_id": 24,
     "revisar": false
    }
   ]
  },
  {
   "id": "wiener process",
   "nombre_canonico": "Wiener process",
   "tipo": "concepto",
   "nombres_vistos": [
    "Wiener process"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    24
   ],
   "definiciones": [
    {
     "texto": "Movimiento browniano estándar con incrementos independientes normales de media cero y varianza igual al paso temporal; es el bloque básico de los modelos de precios en tiempo continuo.",
     "doc_id": 24
    }
   ],
   "citas": [
    {
     "texto": "Definition: Wt with W0 = 0, independent increments, and Wt −Ws ∼N(0, t −s)",
     "doc_id": 24
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "geometric Brownian motion",
     "doc_id": 24,
     "revisar": false
    }
   ]
  },
  {
   "id": "lognormal distribution",
   "nombre_canonico": "lognormal distribution",
   "tipo": "concepto",
   "nombres_vistos": [
    "lognormal distribution"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    24
   ],
   "definiciones": [
    {
     "texto": "Distribución que sigue el precio del activo bajo el supuesto de GBM, consecuencia de que el logaritmo del precio es normal.",
     "doc_id": 24
    }
   ],
   "citas": [
    {
     "texto": "ln St is normally distributed with: ... Therefore, St ∼Lognormal(. . . ).",
     "doc_id": 24
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "geometric Brownian motion",
     "doc_id": 24,
     "revisar": false
    }
   ]
  },
  {
   "id": "ito s lemma",
   "nombre_canonico": "Ito's Lemma",
   "tipo": "metodo",
   "nombres_vistos": [
    "Ito's Lemma"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    24
   ],
   "definiciones": [
    {
     "texto": "Regla de diferenciación estocástica que agrega un término de segundo orden proveniente de la varianza del proceso de Wiener; es la herramienta que permite derivar la dinámica de funciones del precio (como el log-precio o el valor de una opción).",
     "doc_id": 24
    }
   ],
   "citas": [
    {
     "texto": "For V (t, Xt), Ito’s Lemma states: dV = (∂V/∂t + a ∂V/∂X + 1/2 b2 ∂2V/∂X2) dt + b ∂V/∂X dWt.",
     "doc_id": 24
    }
   ],
   "relaciones_crudas": [
