  {
   "id": "nyse autoquote",
   "nombre_canonico": "NYSE Autoquote",
   "tipo": "dato",
   "nombres_vistos": [
    "NYSE Autoquote"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    41
   ],
   "definiciones": [
    {
     "texto": "Evento regulatorio/tecnológico de 2003 que reemplazó la diseminación manual del quote interno por specialists con un quote automatizado, aumentando el tráfico electrónico de mensajes en NYSE; usado como shock exógeno e instrumento.",
     "doc_id": 41
    }
   ],
   "citas": [
    {
     "texto": "The Autoquote replaced manual dissemination of the inside quote by specialists with a new automated quote and provided quicker feedback to algorithms, resulting in an increase in electronic message traffic in the NYSE",
     "doc_id": 41
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "algorithmic trading",
     "doc_id": 41,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "two-stage least squares",
     "doc_id": 41,
     "revisar": false
    }
   ]
  },
  {
   "id": "two stage least square",
   "nombre_canonico": "two-stage least squares",
   "tipo": "metodo",
   "nombres_vistos": [
    "two-stage least squares"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    41
   ],
   "definiciones": [
    {
     "texto": "Enfoque de variable instrumental usado para mitigar endogeneidad, empleando la implementación escalonada de Autoquote, el rezago de QT y el QT promedio por cuartil de tamaño como instrumentos.",
     "doc_id": 41
    }
   ],
   "citas": [
    {
     "texto": "We now use a two-stage least-squares (2SLS) instrumental variable (IV) approach with several instruments to mitigate endogeneity concerns",
     "doc_id": 41
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "reverse causality",
     "doc_id": 41,
