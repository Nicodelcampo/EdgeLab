  {
   "id": "bootstrap beta estimate",
   "nombre_canonico": "bootstrap beta estimate",
   "tipo": "metodo",
   "nombres_vistos": [
    "bootstrap beta estimate"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    29
   ],
   "definiciones": [
    {
     "texto": "Método no paramétrico de bootstrap (Baker et al., 2016) que estima el valor esperado de un beta independiente del día de referencia como aproximadamente igual al promedio de los 20 betas diarios no ajustados.",
     "doc_id": 29
    }
   ],
   "citas": [
    {
     "texto": "the mean value of the bootstrapped beta distribution therefore provides a reference-day independent estimate of systematic risk for a particular share",
     "doc_id": 29
    }
