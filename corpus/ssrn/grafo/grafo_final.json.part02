   "nombres_vistos": [
    "distribution volatility"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    56
   ],
   "definiciones": [
    {
     "texto": "Volatilidad efectiva que caracteriza la distribución del activo bajo la aproximación semi-clásica; se calcula como promedio armónico de la varianza de la volatilidad local a lo largo de la trayectoria recta entre spot y strike.",
     "doc_id": 56
    }
   ],
   "citas": [
    {
     "texto": "the square of the volatility of the distribution is the harmonic average of the square of the local volatility",
     "doc_id": 56
    }
   ],
   "relaciones_crudas": [
