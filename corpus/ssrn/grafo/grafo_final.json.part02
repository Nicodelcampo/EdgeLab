     "objeto_texto": "risk-on/risk-off",
     "doc_id": 48,
     "revisar": false
    }
   ]
  },
  {
   "id": "risk on risk off",
   "nombre_canonico": "risk-on/risk-off",
   "tipo": "concepto",
   "nombres_vistos": [
    "risk-on/risk-off"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    48
   ],
   "definiciones": [
    {
     "texto": "Enfoque binario de gestión de riesgo que el CMOS busca evitar, prefiriendo una adaptación continua y basada en datos por fases.",
     "doc_id": 48
    }
   ],
   "citas": [
    {
     "texto": "This framework avoids binary â€œrisk-on/risk-offâ€​ behavior and enables continuous, data-driven adaptation.",
     "doc_id": 48
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "post crisi recovery protocol",
   "nombre_canonico": "post-crisis recovery protocol",
   "tipo": "estrategia",
   "nombres_vistos": [
    "post-crisis recovery protocol"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    48
   ],
   "definiciones": [
    {
     "texto": "Protocolo de re-expansión gradual de exposición tras la resolución de una crisis, en tres fases (defensiva, reintroducción selectiva de tendencia, amplitud operativa completa), condicionado a que persistan señales de normalización en volatilidad, liquidez y correlación.",
     "doc_id": 48
    }
   ],
   "citas": [
    {
     "texto": "AlphaGen follows a three-stage re-entry framework",
     "doc_id": 48
    }
   ],
   "relaciones_crudas": [
