    "semi-classical approximation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    56
   ],
   "definiciones": [
    {
     "texto": "Expansión perturbativa alrededor de la trayectoria clásica (de volatilidad cero) que el paper aplica a la representación de integral de caminos del modelo de volatilidad local para obtener una fórmula analítica aproximada de la distribución.",
     "doc_id": 56
    }
   ],
   "citas": [
    {
     "texto": "The semi-classical approximation is applied to the Local Volatility model, and the approximated probability distribution of it is derived.",
     "doc_id": 56
    }
   ],
   "relaciones_crudas": [
