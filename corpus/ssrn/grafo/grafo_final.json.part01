    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "liquidity",
     "doc_id": 213,
     "revisar": false
    },
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "effective spread",
     "doc_id": 213,
     "revisar": false
    }
   ]
  },
  {
   "id": "momentum ignition",
   "nombre_canonico": "momentum ignition",
   "tipo": "estrategia",
   "nombres_vistos": [
    "momentum ignition"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    150,
    156
   ],
   "definiciones": [
    {
     "texto": "Práctica de ejecutar grandes volúmenes direccionales durante períodos de baja liquidez para instigar falsos quiebres e incitar compras/ventas de otros operadores por pánico o inercia.",
     "doc_id": 150
    },
    {
     "texto": "Ingreso de una serie de órdenes para iniciar o exacerbar una tendencia del precio, buscando que otros algoritmos la sigan.",
     "doc_id": 156
    }
   ],
   "citas": [
    {
     "texto": "prende una posizione aggressiva... che genera un forte movimento del prezzo e spinge gli altri trader a reagire al movimento; su questa reazione il momentum trader chiude la propria posizione",
     "doc_id": 150
    },
    {
     "texto": "Entry of orders or a series of orders intended to start or exacerbate a trend, and to encourage other participants to accelerate or extend the trend",
     "doc_id": 156
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
