  {
   "id": "t distribution beta adjustment",
   "nombre_canonico": "t-distribution beta adjustment",
   "tipo": "metodo",
   "nombres_vistos": [
    "t-distribution beta adjustment"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    29,
    30
   ],
   "definiciones": [
    {
     "texto": "Método (Cademartori et al., 2003) que sustituye la distribución normal estándar por una t de Student de colas más pesadas en la regresión de beta, para incorporar mejor outliers y reducir la sensibilidad al día de referencia.",
     "doc_id": 29
    },
    {
     "texto": "Método que reemplaza la distribución normal estándar por la t de Student, de colas más pesadas, para incorporar mejor el efecto de outliers al ajustar beta ante reference-day risk.",
     "doc_id": 30
    }
   ],
   "citas": [
    {
     "texto": "the t-distribution method for adjusting beta most significantly reduces reference-day variation when compared to Blume's (1971) method and the OLS method",
     "doc_id": 29
    },
    {
     "texto": "the t-distribution method for adjusting beta is better able to incorporate the influence of outliers in estimating beta",
     "doc_id": 30
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
