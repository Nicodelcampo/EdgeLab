  {
   "id": "delta hedging",
   "nombre_canonico": "delta hedging",
   "tipo": "metodo",
   "nombres_vistos": [
    "delta hedging"
   ],
   "menciones": 3,
   "doc_frecuencia": 3,
   "doc_ids": [
    10,
    24,
    81
   ],
   "definiciones": [
    {
     "texto": "Estrategia de cobertura de una posición en opción tomando una posición delta en el subyacente, usada en el algoritmo de simulación y cuyo costo de financiamiento afecta el precio final del trato.",
     "doc_id": 10
    },
    {
     "texto": "Argumento de cobertura que consiste en tomar una posición corta de ∆=∂V/∂S unidades del subyacente para eliminar la exposición de primer orden al movimiento del precio y construir un portafolio libre de riesgo.",
     "doc_id": 24
    },
    {
     "texto": "Técnica de gestión de riesgos basada en ajustar las posiciones en opciones y activos subyacentes para mantener la neutralidad ante los movimientos de precios del subyacente.",
     "doc_id": 81
    }
   ],
   "citas": [
    {
     "texto": "we assume that the investor delta-hedges the deal according to (4.22)",
     "doc_id": 10
    },
    {
     "texto": "Choose ∆= ∂V/∂S to eliminate exposure to dSt at first order.",
     "doc_id": 24
    },
    {
     "texto": "This model allows wealth managers to price options accurately and use them in strategies such as delta hedging and constructing options spreads.",
     "doc_id": 81
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "least-squares Monte Carlo",
     "doc_id": 10,
