     "doc_id": 386,
     "revisar": false
    },
    {
     "tipo": "MEJORADO_POR",
     "tipo_original": "MEJORADO_POR",
     "objeto_texto": "liquidity-supplying AT",
     "doc_id": 97,
     "revisar": true
    },
    {
     "tipo": "EMPEORADO_POR",
     "tipo_original": "EMPEORADO_POR",
     "objeto_texto": "liquidity-demanding AT",
     "doc_id": 97,
