    }
   ]
  },
  {
   "id": "error correction model ecm",
   "nombre_canonico": "error correction model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Error-Correction Model (ECM)",
    "error correction model"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    6,
    266
   ],
   "definiciones": [
    {
     "texto": "VECM que descompone la dinámica de un sistema cointegrado en un término de equilibrio de largo plazo estacionario y una dinámica de corto plazo de ajuste transitorio.",
     "doc_id": 6
    },
    {
     "texto": "Modelo que relaciona el cambio en el spread con su nivel rezagado, donde el parámetro α mide la velocidad de ajuste al equilibrio.",
     "doc_id": 266
    }
   ],
   "citas": [
    {
     "texto": "Long-run equilibrium: βTYt−1 are stationary error correction terms.",
     "doc_id": 6
    },
    {
     "texto": "Δϵt = −α ϵt−1 + ηt",
     "doc_id": 266
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
