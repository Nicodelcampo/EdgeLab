  {
   "id": "machine learning",
   "nombre_canonico": "machine learning",
   "tipo": "metodo",
   "nombres_vistos": [
    "Machine learning",
    "machine learning"
   ],
   "menciones": 4,
   "doc_frecuencia": 4,
   "doc_ids": [
    62,
    305,
    339,
    385
   ],
   "definiciones": [
    {
     "texto": "Algoritmos utilizados en el sector financiero para aprender patrones de datos históricos (como transacciones fraudulentas) y adaptarse a entornos dinámicos, superando a los sistemas tradicionales basados en reglas estáticas.",
     "doc_id": 62
    },
    {
     "texto": "ML, deep learning y NLP usados para analizar datos estructurados (precios, order books) y no estructurados (noticias, social media) en tiempo real, generando señales de trading y optimizando portfolios.",
     "doc_id": 305
    },
    {
     "texto": "AI como herramienta complementaria al analista humano: eficiente en predicción pero carece de comprensión contextual, consideraciones éticas y accountability. El paper argumenta que AI no reemplaza sino que colabora con analistas.",
     "doc_id": 339
    },
    {
     "texto": "Oportunidad para trading sistemático: procesar datos financieros y alternativos (social media) para generar señales superiores. Sistemas que pueden procesar y limpiar datos de social media tienen ventaja competitiva.",
     "doc_id": 385
    }
   ],
   "citas": [
    {
     "texto": "Machine learning algorithms trained on past transaction data can identify fraud patterns, and real-time monitoring flags and prevents fraud nearly instantly.",
     "doc_id": 62
    },
    {
     "texto": "AI-driven systems leverage machine learning, deep learning, and natural language processing to analyze vast volumes of structured and unstructured financial data in real time.",
     "doc_id": 305
    },
    {
     "texto": "AI is effective at prediction but lacks understanding of context, ethical considerations, and accountability.",
     "doc_id": 339
    },
    {
     "texto": "Systems that can both process and cleanse the vast amounts of financial and alternative data from social media have a distinct edge.",
     "doc_id": 385
    }
   ],
   "relaciones_crudas": [
    {
