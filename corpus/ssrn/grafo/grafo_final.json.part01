   ],
   "definiciones": [
    {
     "texto": "Generative Adversarial Networks aplicadas a generación de escenarios de mercado. El paper destaca TimeGAN, Tail-GAN y VolGAN como ejemplos que alinean el objetivo generativo con restricciones financieras (arbitrage-free surfaces, tail risk estimation).",
     "doc_id": 136
    },
    {
     "texto": "Redes generativas antagónicas utilizadas para detectar comportamientos inusuales del mercado y riesgos antes de que afecten el rendimiento de las operaciones.",
     "doc_id": 141
    }
   ],
   "citas": [
    {
     "texto": "VolGAN for arbitrage-free implied-volatility surface generation. This line of work is central because it treats arbitrage constraints as part of the generative target",
     "doc_id": 136
    },
    {
     "texto": "Advanced models, such as GANs (Generative Adversarial Networks), identify unusual market behaviors and potential risks before they disrupt trading performance.",
     "doc_id": 141
    }
   ],
