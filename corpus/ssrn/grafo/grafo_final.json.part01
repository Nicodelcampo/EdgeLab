     "doc_id": 10,
     "revisar": false
    }
   ]
  },
  {
   "id": "central bank fx intervention",
   "nombre_canonico": "central bank intervention",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Central bank FX intervention",
    "central bank intervention"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    11,
    341
   ],
   "definiciones": [
    {
     "texto": "Operaciones esterilizadas de compra/venta de divisas por parte de la autoridad monetaria, que el modelo trata como una señal parcialmente informativa sobre shocks futuros a los fundamentals; puede canalizarse vía mercado bilateral (directo) o vía mercado interdealer/broker (indirecto).",
     "doc_id": 11
    },
    {
     "texto": "Operaciones de compra/venta de divisas por bancos centrales del G-3 (Fed, Bundesbank, BOJ) para influir en niveles y varianza de tipos de cambio. La Fed intervino 273 días entre 1987-1995. Aunque oficialmente anónimas, los bancos centrales informan al mercado vía dealers en minutos. Cuatro motivos: influir tendencias, calmar mercados desordenados, rebalancear reservas, apoyar a otros bancos centrales.",
     "doc_id": 341
    }
   ],
   "citas": [
    {
     "texto": "sterilized intervention conditions currency values and exchange volatility",
     "doc_id": 11
    },
    {
     "texto": "The G-3 central banks intervened sporadically over the period 1987 through 1995. There are 273 days in the nine-year sample when the Fed intervened in the USD-DEM or the USD-JPY market.",
     "doc_id": 341
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "exchange rate volatility",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "trading volume",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "order flow",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Exchange rate level and variance",
     "doc_id": 341,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Portfolio balance channel",
     "doc_id": 341,
     "revisar": false
    }
   ]
  },
  {
   "id": "exchange rate volatility",
   "nombre_canonico": "exchange rate volatility",
   "tipo": "metrica",
   "nombres_vistos": [
    "exchange rate volatility"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    11,
    12
   ],
   "definiciones": [
    {
     "texto": "Desviación estándar incondicional de la variación del spot rate; el paper muestra que su respuesta a la intervención depende de la ruta elegida (directa vs indirecta) y no es necesariamente monótona en la intensidad de intervención.",
     "doc_id": 11
    },
    {
     "texto": "Grado de variación de la tasa de cambio VND/USD, mantenida artificialmente baja por la política oficial de estabilidad, en contraste con la mayor volatilidad de otras monedas bilaterales comparables.",
     "doc_id": 12
    }
   ],
   "citas": [
    {
     "texto": "foreign exchange intervention may either increase or reduce exchange rate volatility depending on the route chosen by the central bank to implement its intervention operations",
     "doc_id": 11
    },
    {
     "texto": "the VND/USD rate was kept very stable compared with other bilateral exchange rates",
     "doc_id": 12
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "central bank intervention",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "market liquidity",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "administered pricing",
     "doc_id": 12,
     "revisar": false
    }
   ]
  },
  {
   "id": "market concentration",
   "nombre_canonico": "market concentration",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "market concentration"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    12,
    54
   ],
   "definiciones": [
    {
     "texto": "Alta concentración de las transacciones interbancarias en pocos bancos, con el banco central dominando el segmento en un grado muy elevado, reduciendo la competencia y la formación de precios descentralizada.",
     "doc_id": 12
    },
    {
     "texto": "Concentración de la actividad de trading en pocas instituciones dominantes: una institución concentra casi 30% del volumen de préstamo (borrow) y la segunda más del 20%.",
     "doc_id": 54
    }
   ],
   "citas": [
    {
     "texto": "interbank transactions are also heavily concentrated among a small number of banks, with the SBV in particular dominating the scene to a very large degree",
     "doc_id": 12
    },
    {
     "texto": "On the borrowing side we note that one institution has almost 30% of trading volume and the second–largest more than 20%",
     "doc_id": 54
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "price discovery",
     "doc_id": 12,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "institution level order flow",
     "doc_id": 54,
     "revisar": false
    }
   ]
  },
  {
   "id": "market neutral strategy",
   "nombre_canonico": "market neutral strategy",
   "tipo": "estrategia",
   "nombres_vistos": [
    "market neutral strategy",
    "market-neutral strategy"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    13,
    117
   ],
   "definiciones": [
    {
     "texto": "Cartera long/short con beta prácticamente cero (10 largos y 10 cortos siempre en el paper), atractiva por su baja correlación con el mercado; aísla el efecto del arbitraje del riesgo direccional.",
     "doc_id": 13
    },
    {
     "texto": "Estrategia de trading admisible donde los pesos del portafolio y la riqueza del inversor dependen únicamente de la señal estacionaria del spread, lográndose mediante posiciones largas y cortas compensadas para neutralizar la no-estacionariedad del mercado.",
     "doc_id": 117
    }
   ],
   "citas": [
    {
     "texto": "A market neutral strategy is neutral to market movements, i.e. its β is\npractically zero.",
     "doc_id": 13
    },
    {
     "texto": "An admissible strategy π is market-neutral (M-N) if both π and X^π are (F_t^Z)-adapted.",
     "doc_id": 117
    }
   ],
   "relaciones_crudas": [
