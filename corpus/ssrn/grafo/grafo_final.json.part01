  {
   "id": "limit to arbitrage",
   "nombre_canonico": "Limits to Arbitrage",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Limits to Arbitrage"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    182,
    241
   ],
   "definiciones": [
    {
     "texto": "Restricciones como short-sale restrictions o funding illiquidity que limitan la capacidad del arbitrajista de actuar sobre pricing errors no triviales, particularmente cuando hay riesgo de convergencia.",
     "doc_id": 182
    },
    {
     "texto": "Fricciones que impiden que los arbitrajistas corrijan inmediatamente los precios incorrectos: costes de transacción, costes de mantenimiento, riesgo idiosincrático y restricciones de venta en corto.",
     "doc_id": 241
    }
   ],
   "citas": [
    {
     "texto": "The limits-to-arbitrage literature highlights widespread empirical deviations from no-arbitrage pricing, shedding light on how constraints drive persistent cross-sectional and time-series variation in pricing errors.",
     "doc_id": 182
    },
    {
     "texto": "arbitrage is limited to the extent that (i) both cognitive biases and constraints may impede information diffusion and (ii) transaction and holding costs make arbitrage costly",
     "doc_id": 241
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "no-arbitrage band",
     "doc_id": 182,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "arbitrage",
     "doc_id": 182,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Mispricing Persistence",
     "doc_id": 241,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Market Efficiency",
     "doc_id": 241,
     "revisar": false
    }
   ]
