   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    19,
    289
   ],
   "definiciones": [
    {
     "texto": "Correlaciones persistentes en el tiempo detectadas de forma clara en retornos absolutos o cuadrados aunque no en retornos crudos (con signo), motivando modelos de memoria larga en volatilidad (FIGARCH, MMAR).",
     "doc_id": 19
    },
    {
     "texto": "Propiedad de series financieras donde autocorrelaciones decaen lentamente (ley de potencia); ausente en retornos pero presente en volatilidad.",
     "doc_id": 289
    }
   ],
   "citas": [
    {
