   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    361,
    363
   ],
   "definiciones": [
    {
     "texto": "Presión inducida por el deadline anual de cumplimiento que convierte al EU ETS en un mercado periódicamente estresado, afectando frecuencia y estrategia de trading.",
     "doc_id": 361
    },
    {
     "texto": "Presión de deadline anual que afecta el comportamiento de trading de empresas, aumentando frecuencia transaccional y alterando estrategias hacia momentum.",
     "doc_id": 363
    }
   ],
   "citas": [
    {
     "texto": "This makes the EU ETS a 'periodically-stressed' market; the firms lacking allowances face annually a strict deadline to buy the necessary allowances.",
     "doc_id": 361
    },
    {
     "texto": "We find that firms in both EU ETS phases engaged more often in emissions allowances trading as the compliance deadline was approaching.",
     "doc_id": 363
    }
   ],
