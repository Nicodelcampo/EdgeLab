     "tipo_original": "CAUSA",
     "objeto_texto": "volatility",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "market dynamics",
     "doc_id": 222,
     "revisar": false
    }
   ]
  },
  {
   "id": "anomaly detection",
   "nombre_canonico": "anomaly detection",
   "tipo": "metodo",
   "nombres_vistos": [
    "anomaly detection"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    59,
    216
   ],
   "definiciones": [
    {
     "texto": "Proceso de identificación de valores atípicos o patrones inusuales en series temporales financieras que podrían indicar eventos significativos del mercado.",
     "doc_id": 59
    },
    {
     "texto": "Estrategia de identificación de flujo informado como anomalías estructurales en el libro de órdenes, no como predicción de precio futuro. El modelo emite una señal cuando la distancia de Mahalanobis St en el espacio latente supera un umbral, indicando que el punto se ha alejado del clúster de ruido por contener estructura que solo flujo informado puede generar.",
     "doc_id": 216
    }
   ],
   "citas": [
    {
     "texto": "The chi-square distribution is a powerful tool for detecting anomalies, such as outliers or unusual patterns, in financial time series data.",
     "doc_id": 59
    },
    {
     "texto": "the framework is designed to characterise anomalies, regime transitions, and structural deformations of the order book more effectively than classical approaches.",
     "doc_id": 216
    }
   ],
   "relaciones_crudas": [
