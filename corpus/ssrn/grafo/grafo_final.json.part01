  {
   "id": "trembling hand perfect nash equilibrium thpne",
   "nombre_canonico": "Trembling-Hand Perfect Nash Equilibrium (THPNE)",
   "tipo": "metodo",
   "nombres_vistos": [
    "Trembling-Hand Perfect Nash Equilibrium (THPNE)"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    350,
    351
   ],
   "definiciones": [
    {
     "texto": "Refinamiento de teoría de juegos que elimina equilibrios de Nash inestables o imperfectos asumiendo que los jugadores pueden cometer errores con pequeña probabilidad, aplicado al juego de tres niveles entre HFTs.",
     "doc_id": 350
    },
    {
     "texto": "Refinamiento de teoría de juegos que elimina equilibrios inestables; captura la tendencia de optimización en decisiones de HFTs bajo incertidumbre, siendo más restrictivo que el principio maximin.",
     "doc_id": 351
    }
   ],
   "citas": [
    {
     "texto": "We refine the complex game model based on the trembling-hand perfection framework to identify the optimal trembling-hand perfect Nash equilibrium (THPNE).",
     "doc_id": 350
    },
    {
     "texto": "Trembling-hand perfect refinement can capture the trend of decision-making optimization in HFTs under uncertainty, indicating THPNE is a tighter solution.",
     "doc_id": 351
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Nash Equilibrium",
