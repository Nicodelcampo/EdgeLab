  {
   "id": "vector autoregressive var model",
   "nombre_canonico": "vector-autoregressive model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Vector Autoregressive (VAR) model",
    "vector-autoregressive model"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    45,
    159
   ],
   "definiciones": [
    {
     "texto": "Representación alternativa VAR(1) de los log-precios de los activos co-integrados, usada para calibrar empíricamente el modelo por regresión multivariada sobre datos de mercado.",
     "doc_id": 45
    },
    {
     "texto": "Modelo econométrico implementado para evaluar simultáneamente y en ultra-alta frecuencia (intervalos de 1 segundo o de 5 minutos) las respuestas y asociaciones dinámicas entre la participación del HFT y la volatilidad realizada.",
     "doc_id": 159
    }
   ],
   "citas": [
    {
     "texto": "In this representation, we see that the log-prices are an order 1 vector-autoregressive model (VAR(1)).",
     "doc_id": 45
    },
    {
     "texto": "The association between volatility and HFT participation as well as HFT order imbalance is analyzed using a Vactor Autoregressive [VAR] model approach.",
     "doc_id": 159
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "cointegration",
     "doc_id": 45,
