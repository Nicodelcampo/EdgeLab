     "tipo_original": "PARTE_DE",
     "objeto_texto": "limit order book",
     "doc_id": 261,
     "revisar": false
    }
   ]
  },
  {
   "id": "order aggressiveness",
   "nombre_canonico": "order aggressiveness",
   "tipo": "concepto",
   "nombres_vistos": [
    "Order Aggressiveness",
    "order aggressiveness"
   ],
   "menciones": 4,
   "doc_frecuencia": 4,
   "doc_ids": [
    51,
    52,
    114,
    259
   ],
   "definiciones": [
    {
     "texto": "Nivel de agresividad de una orden clasificado en 9 categorías (1-5 límite, 6-9 mercado) según precio y volumen relativo a la cola disponible en el libro; modelado con probit ordenado en función del spread, profundidad y volatilidad.",
     "doc_id": 51
    },
    {
     "texto": "Nivel de agresividad de una orden clasificado en 9 (o 6) categorías según precio y volumen relativo al book; el paper modela sus determinantes con un probit ordenado.",
     "doc_id": 52
    },
    {
     "texto": "Clasificación de las estrategias de envío de órdenes según su inmediatez de ejecución: desde la más agresiva (órdenes de mercado) hasta la menos agresiva (cancelaciones de órdenes limitadas).",
     "doc_id": 114
    },
    {
     "texto": "Grado de urgencia/impacto de una orden: market orders que consumen múltiples niveles son las más agresivas; cancelaciones son las menos agresivas. Determinado por el estado del LOB y las expectativas de ejecución.",
     "doc_id": 259
    }
   ],
   "citas": [
    {
     "texto": "Orders are categorized into 9 aggressiveness levels according to the order price and volume relative to the price limit and shares available in the order book.",
     "doc_id": 51
    },
    {
     "texto": "we follow a classification of order submission strategy by aggressiveness... The most aggressive orders are market orders.",
     "doc_id": 114
    },
    {
     "texto": "the most aggressive order is a market order which is allowed to be matched with several price levels on the opposite side",
     "doc_id": 259
    }
   ],
   "relaciones_crudas": [
    {
