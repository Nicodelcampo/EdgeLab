  {
   "id": "mifid ii",
   "nombre_canonico": "MiFID II",
   "tipo": "concepto",
   "nombres_vistos": [
    "MiFID II"
   ],
   "menciones": 3,
   "doc_frecuencia": 3,
   "doc_ids": [
    149,
    232,
    349
   ],
   "definiciones": [
    {
     "texto": "Directiva europea de mercados financieros (Markets in Financial Instruments Directive II) que introduce requisitos específicos para HFT: autorización de firms, obligaciones de market making, circuit breakers, tick size regime, y registro de órdenes.",
     "doc_id": 149
    },
    {
     "texto": "Directiva europea (2014/65/EU) que regula los mercados de instrumentos financieros, introduciendo por primera vez definiciones y supervisión específica para algorithmic trading, high-frequency trading y direct electronic access, efectiva desde enero 2018.",
     "doc_id": 232
    },
    {
     "texto": "Directiva europea de instrumentos financieros II que define mercados regulados y establece requisitos para sistemas de trading algorítmico, incluyendo obligaciones de creación de mercado (market making) y controles de riesgo para HFT.",
     "doc_id": 349
    }
   ],
   "citas": [
    {
     "texto": "MiFID II: Tackling Challenges of High Frequency Trading through MiFID II",
     "doc_id": 149
    },
    {
     "texto": "MiFID II adopts a middle course: it does not prohibit high frequency trading, but it does subject it and other forms of algorithmic trading to specific supervision as they entail specific risks.",
     "doc_id": 232
    },
    {
     "texto": "MiFID II, Article 4.1(21).",
     "doc_id": 349
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "high-frequency trading",
     "doc_id": 149,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
