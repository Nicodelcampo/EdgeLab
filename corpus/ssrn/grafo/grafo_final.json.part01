  {
   "id": "lob convexity",
   "nombre_canonico": "LOB convexity",
   "tipo": "metrica",
   "nombres_vistos": [
    "LOB Convexity",
    "LOB convexity"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    65,
    246
   ],
   "definiciones": [
    {
     "texto": "Ratio entre la pendiente de los niveles altos y la pendiente de los niveles bajos del LOB. Se utiliza metodológicamente como un proxy intradía para detectar la predominancia de patient traders en un momento dado.",
     "doc_id": 65
    },
    {
     "texto": "Ratio de las pendientes en niveles superiores vs inferiores del LOB. Una mayor convexidad implica que órdenes grandes enfrentan impacto desproporcionadamente mayor, generando colas más gruesas en la distribución de retornos.",
     "doc_id": 246
    }
   ],
   "citas": [
    {
     "texto": "We use the convexity of the LOB as our proxy for traders' patience, motivated by Rosu’s finding relating the two.",
     "doc_id": 65
    },
    {
     "texto": "variance decreases and kurtosis increases with LOB convexity",
     "doc_id": 246
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Patient traders",
     "doc_id": 65,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Return Kurtosis",
     "doc_id": 246,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
