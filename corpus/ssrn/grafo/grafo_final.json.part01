  {
   "id": "hybrid carbon regulation",
   "nombre_canonico": "Hybrid carbon regulation",
   "tipo": "concepto",
   "nombres_vistos": [
    "Hybrid carbon regulation"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    325,
    332
   ],
   "definiciones": [
    {
     "texto": "Esquema donde el mercado de emisiones se segmenta en un mercado internacional (EU-ETS, sectores DIR) y múltiples mercados domésticos (sectores NDIR), destruyendo la eficiencia de mecanismos de mercado descentralizados porque el regulador debe conocer perfectamente el precio internacional y las curvas de abatimiento marginal.",
     "doc_id": 325
    },
    {
     "texto": "Esquema donde el mercado de emisiones se segmenta en internacional (EU-ETS, sectores DIR) y doméstico (NDIR), destruyendo la eficiencia de mecanismos descentralizados. El regulador debe conocer perfectamente el precio internacional y las curvas MAC para implementar la solución costo-mínima.",
     "doc_id": 332
    }
   ],
   "citas": [
    {
     "texto": "The segmentation of the emission market into multiple domestic markets and a single international market creates a fundamental information problem for environmental regulation.",
     "doc_id": 325
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
