   ],
   "definiciones": [
    {
     "texto": "Conjunto ciego separado (10% de los datos, 1.5 años) que incluye periodos de estrés extremo como el crash COVID-19 de 2020, usado para evaluar la robustez de las features descubiertas.",
     "doc_id": 1
    }
   ],
   "citas": [
    {
     "texto": "The blind test set included recent periods of extreme market stress, such as the 2020 COVID-19 market crash, highlighting the robustness and stability of the discovered features under high-volatility conditions.",
     "doc_id": 1
    }
   ],
