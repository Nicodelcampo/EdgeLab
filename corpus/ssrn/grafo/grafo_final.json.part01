    59,
    266
   ],
   "definiciones": [
    {
     "texto": "Modelos estadísticos flexibles empleados para capturar y representar las dependencias conjuntas complejas entre múltiples variables aleatorias financieras.",
     "doc_id": 59
    },
    {
     "texto": "Herramienta matemática que separa las distribuciones marginales de la estructura de dependencia entre variables aleatorias, permitiendo modelar dependencias no lineales.",
     "doc_id": 266
    }
   ],
   "citas": [
    {
     "texto": "Copulas are a class of statistical models that are particularly useful in capturing dependencies between random variables.",
     "doc_id": 59
    },
    {
     "texto": "Copulas offer a general toolkit for capturing such dependence by separating joint distributions into marginal distributions and a copula function",
     "doc_id": 266
    }
   ],
