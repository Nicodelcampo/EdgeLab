   "doc_ids": [
    17,
    28
   ],
   "definiciones": [
    {
     "texto": "Medida martingala de Stoikov que ajusta el mid-price según el imbalance del libro; el paper la usa como benchmark y le critica que solo mira el mejor bid/ask, ignorando niveles profundos y ejecuciones.",
     "doc_id": 17
    },
    {
     "texto": "En la reformulación del equilibrio de Kyle (Ec. 10), el precio se expresa como función lineal de la mejor estimación de la demanda informada, análoga a un precio ponderado por la creencia sobre información privada.",
     "doc_id": 28
    }
   ],
   "citas": [
    {
     "texto": "The micro-price theory introduced by Stoikov represents a significant advancement by creating a martingale measure that adjusts the mid-price based on order book imbalance",
     "doc_id": 17
    },
    {
     "texto": "the price function of the market maker aims to replicate the value function of the asset using the best guess for informed demand",
     "doc_id": 28
    }
   ],
   "relaciones_crudas": [
