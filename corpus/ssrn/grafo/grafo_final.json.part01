   ],
   "definiciones": [
    {
     "texto": "Estrategia donde cada acción se regresa contra el ETF de su sector (ej. BBH para biotech). Los residuos de la regresión son la señal: residuo negativo = acción barata (long), residuo positivo = acción cara (short). Generalización natural del pairs trading.",
     "doc_id": 317
    },
    {
     "texto": "Estrategia de pares generalizados donde cada acción se compara contra su ETF sectorial; los residuos indican si la acción está barata o cara relativa al sector.",
     "doc_id": 378
    }
   ],
   "citas": [
    {
     "texto": "Generalized pairs-trading, or trading groups of stocks against other groups of stocks, is a natural extension of pairs-trading. We perform a regression/cointegration analysis for each stock with respect to a benchmark sector index.",
     "doc_id": 317
    },
    {
     "texto": "A generalized pairs trading book, or statistical arbitrage book, consists of a collection of 'pair trades' of stocks relative to the ETF.",
     "doc_id": 378
    }
   ],
