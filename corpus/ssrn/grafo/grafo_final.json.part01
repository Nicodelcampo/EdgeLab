  {
   "id": "abnormal turnover",
   "nombre_canonico": "Abnormal turnover",
   "tipo": "metrica",
   "nombres_vistos": [
    "Abnormal turnover",
    "abnormal turnover"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    143,
    158
   ],
   "definiciones": [
    {
     "texto": "Diferencia entre la rotación (turnover) diaria de la acción durante la ventana del anuncio de ganancias y el promedio de rotación diaria de un periodo base de no-reporte.",
     "doc_id": 143
    },
    {
     "texto": "Porcentaje de desviación del volumen negociado intradía respecto de un perfil histórico esperado de 30 días para un intervalo específico.",
     "doc_id": 158
    }
   ],
   "citas": [
    {
     "texto": "For each day in the [-10,10] window, abnormal turnover for firm i is measured as the difference between turnover and the average daily non-report period turnover.",
     "doc_id": 143
    },
    {
     "texto": "the intraday abnormal turnover represents the deviation of intraday trade from that of an ordinary volume profile.",
     "doc_id": 158
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Governance through trading (grading)",
     "doc_id": 143,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "informed trading",
     "doc_id": 158,
     "revisar": false
    }
   ]
  },
  {
   "id": "herfindahl hirschman index",
   "nombre_canonico": "Herfindahl-Hirschman Index",
   "tipo": "metrica",
   "nombres_vistos": [
    "Herfindahl-Hirschman Index",
    "Herfindahl-Hirschman index"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    148,
    161
   ],
   "definiciones": [
    {
     "texto": "Métrica basada en participaciones de volumen para cuantificar el nivel en el que las transacciones están divididas entre los mercados primarios y alternativos.",
     "doc_id": 148
    },
    {
     "texto": "Medida de concentración competitiva calculada como la suma de la cuota de mercado del volumen diario elevada al cuadrado de cada firma HFT.",
     "doc_id": 161
    }
   ],
   "citas": [
    {
     "texto": "We use the Herfindahl-Hirschman Index (HHI)—the most commonly used definition of market concentration in literature—as the proxy of market fragmentation.",
     "doc_id": 148
    },
    {
     "texto": "The Herfindahl-Hirschman index is a measure of competition and is equal to the sum of the firms' squared market shares of daily trading volume",
     "doc_id": 161
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "market fragmentation",
     "doc_id": 148,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "HFT competition",
     "doc_id": 161,
     "revisar": false
    }
   ]
  },
  {
   "id": "realized spread",
   "nombre_canonico": "realized spread",
   "tipo": "metrica",
   "nombres_vistos": [
    "realized spread"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    148,
    213
   ],
   "definiciones": [
    {
     "texto": "Ingreso neto retenido por los proveedores de liquidez tras descontar el impacto en el precio posterior a la transacción.",
     "doc_id": 148
    },
    {
     "texto": "Medida de liquidez que captura el costo de transacción implícito como la diferencia de precio entre una transacción en t y el precio 5 minutos después, duplicada y con signo según dirección del trade. Usada como variable dependiente en el VAR.",
     "doc_id": 213
    }
   ],
   "citas": [
    {
     "texto": "On the other hand, realized spreads measures the revenue earned by liquidity providers.",
     "doc_id": 148
    },
    {
     "texto": "Realized Spread_it = 2(ln(P_itd) - ln(P_it+jd)) if the trade at t is a buy.",
     "doc_id": 213
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "effective spread",
     "doc_id": 148,
