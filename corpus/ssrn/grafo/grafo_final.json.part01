     "tipo_original": "CAUSA",
     "objeto_texto": "mispricing",
     "doc_id": 188,
     "revisar": false
    }
   ]
  },
  {
   "id": "twap",
   "nombre_canonico": "TWAP",
   "tipo": "estrategia",
   "nombres_vistos": [
    "TWAP"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    4,
    207
   ],
   "definiciones": [
    {
     "texto": "Liquidar el inventario restante en partes iguales sobre el tiempo restante; aparece como el componente base de la estrategia óptima POV y como el límite de ambas estrategias cerca del vencimiento, cuando el objetivo de completar la liquidación domina al de trackear el order-flow.",
     "doc_id": 4
    },
    {
     "texto": "Estrategia de ejecución donde la meta-orden se divide en órdenes hijas de tamaño constante a frecuencia fija, usada en el estudio de market impact variando Q_T (3000-24000 shares), T (15-120 segundos) y frecuencia de posting.",
     "doc_id": 207
    }
   ],
   "citas": [
    {
     "texto": "the so-called time-weighted-averageprice strategy which consists in liquidating shares by slicing the remaining inventory in equal parts over the remaining time to expiry",
     "doc_id": 4
    },
    {
     "texto": "we deploy a TWAP strategy (i.e. q(Q_T, T, f) = Q_T / (T * f)) with varying parameters Q_T in {3000, 6000, 12000, 24000} shares, T in {15, 30, 60, 120} seconds and f in {1, 1/3, 1/12, 1/20} sec^{-1}.",
     "doc_id": 207
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "percentage of volume strategy",
     "doc_id": 4,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "market impact",
     "doc_id": 207,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "optimal execution",
     "doc_id": 207,
     "revisar": false
    }
   ]
  },
  {
   "id": "permanent price impact",
   "nombre_canonico": "permanent price impact",
   "tipo": "concepto",
   "nombres_vistos": [
    "permanent price impact"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    4,
    166
   ],
   "definiciones": [
    {
     "texto": "Efecto duradero del order-flow sobre el midprice: el flujo neto (compras menos ventas) empuja el precio linealmente con parámetro b, porque el order-flow transmite información. A diferencia de trabajos previos, acá el impacto permanente incluye el flujo de todos los demás traders, no solo el del agente.",
     "doc_id": 4
    },
    {
     "texto": "Impacto duradero en el precio medio (midpoint) derivado de un evento en el libro de órdenes limitadas, estimado mediante funciones de respuesta al impulso (IRF) en un modelo SVAR a 20 eventos vista.",
     "doc_id": 166
    }
   ],
   "citas": [
    {
     "texto": "order-ﬂow conveys information that aﬀects the midprice of the asset",
     "doc_id": 4
    },
    {
     "texto": "The main purpose of IRFs is to describe how the variables react over time to a shock in one (or more) variable(s) in the system... to examine the reaction of rt with the impulses being one unit in one dummy per IRF.",
     "doc_id": 166
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "midprice drift",
     "doc_id": 4,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "net order flow",
     "doc_id": 4,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "price discovery",
     "doc_id": 166,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Structural Vector Autoregression (SVAR)",
     "doc_id": 166,
     "revisar": false
    }
   ]
  },
  {
   "id": "linear market impact model",
   "nombre_canonico": "linear market impact model",
   "tipo": "metodo",
   "nombres_vistos": [
    "linear market impact model"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    4,
    44
   ],
   "definiciones": [
    {
     "texto": "Supuesto de impacto (temporal y permanente) lineal, justificado porque los modelos de impacto tienen poder predictivo bajísimo (R² < 5%) y la complejidad de modelos no lineales no compensa la pérdida de tractabilidad analítica.",
     "doc_id": 4
    },
    {
     "texto": "Especificación del impacto de mercado como proporción lineal (parámetro γ) del tamaño de la operación sobre el precio eficiente, condición necesaria para evitar arbitraje.",
     "doc_id": 44
    }
   ],
   "citas": [
    {
     "texto": "given the extremely low predictive accuracy of market impact models (typically < 5% R2), the cost of increased complexity arising from moving away from a linear model would outweigh any gains",
     "doc_id": 4
    },
    {
     "texto": "The linear market impact model is Ppost −P / P = γZ",
     "doc_id": 44
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "market impact",
     "doc_id": 4,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
