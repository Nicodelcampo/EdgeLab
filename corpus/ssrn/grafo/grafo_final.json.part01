    114,
    222
   ],
   "definiciones": [
    {
     "texto": "Órdenes limitadas no mostradas en el libro público, que pierden prioridad temporal frente a las visibles, pero eliminan el riesgo de exposición prematura ante alta asimetría de información y pueden capturar rebates.",
     "doc_id": 114
    },
    {
     "texto": "Órdenes no mostrables (non-displayable) de NASDAQ que no se reportan en el libro de órdenes pero sí en ejecución. Su ID era accesible antes del 6 de octubre de 2010, pero posteriormente NASDAQ dejó de reportarlo, y desde el 14 de julio de 2014 tampoco reporta el tipo de matching para estas órdenes, limitando el análisis del libro.",
     "doc_id": 222
    }
   ],
   "citas": [
    {
     "texto": "traders had the option of submitting “non-displayed” limit orders that were not visible to the other participants and were not shown in the limit order book.",
     "doc_id": 114
    },
    {
     "texto": "NASDAQ exchange also has non–displayable (previously called \"hidden\") orders, that cost more to place and are not reported in order book",
     "doc_id": 222
    }
   ],
   "relaciones_crudas": [
    {
