  {
   "id": "jensen s alpha",
   "nombre_canonico": "Jensen's alpha",
   "tipo": "metrica",
   "nombres_vistos": [
    "Jensen's Alpha",
    "Jensen's alpha"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    69,
    375
   ],
   "definiciones": [
    {
     "texto": "Medida de performance ajustada por riesgo de mercado: retorno del portfolio menos el retorno esperado por CAPM dado su beta contra el benchmark.",
     "doc_id": 69
    },
    {
     "texto": "Alpha de Jensen positivo y significativo para hogares finlandeses e instituciones domésticas al comerciar con extranjeros, usando CAPM aumentado por Fama-French.",
     "doc_id": 375
    }
   ],
   "citas": [
    {
     "texto": "Jensen, 1968 introduced alpha (α) as a risk-adjusted performance measure.",
     "doc_id": 69
    },
    {
     "texto": "Both Finnish households and institutional investors generate sizable Jensen's Alphas and Internal Rates of Return.",
     "doc_id": 375
