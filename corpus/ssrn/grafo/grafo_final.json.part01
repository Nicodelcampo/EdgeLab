  {
   "id": "kelly criterion",
   "nombre_canonico": "Kelly criterion",
   "tipo": "metodo",
   "nombres_vistos": [
    "Kelly criterion"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    22,
    43
   ],
   "definiciones": [
    {
     "texto": "Fracción óptima de riesgo derivada de la distribución empírica de resultados (f* ≈ 0.164); se usa como referencia pero se opera con solo 1% de riesgo por trade, muy por debajo de la mitad de Kelly.",
     "doc_id": 22
    },
    {
     "texto": "Método usado en trading deportivo para determinar el tamaño óptimo de apuesta que maximiza el crecimiento a largo plazo del capital, dado el edge estimado y las odds netas.",
     "doc_id": 43
    }
   ],
   "citas": [
    {
     "texto": "A half-Kelly (f∗/2 ≈8.2%) represents the theoretically optimal risk fraction under the empirical distribution",
     "doc_id": 22
    },
    {
     "texto": "The Kelly Criterion is used to determine the optimal size of a series of bets to maximise the long-term growth of capital.",
     "doc_id": 43
    }
   ],
   "relaciones_crudas": [
