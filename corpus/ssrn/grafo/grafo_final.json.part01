  {
   "id": "fulfillment factor lambda",
   "nombre_canonico": "Fulfillment factor (lambda)",
   "tipo": "metrica",
   "nombres_vistos": [
    "Fulfillment factor (lambda)"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    325,
    332
   ],
   "definiciones": [
    {
     "texto": "Fracción de emisiones business-as-usual que se asigna gratuitamente como allowances a los sectores DIR. Lambda* es el valor eficiente; desviaciones generan pérdidas de eficiencia. Para Alemania, lambda negociado = 1, mientras que lambda* es menor para todos los precios de CO2 considerados.",
     "doc_id": 325
    },
    {
     "texto": "Fracción de emisiones business-as-usual asignada gratuitamente a sectores DIR. Para Alemania, lambda negociado = 1, mientras lambda* eficiente es menor para todos los precios de CO2. Desviaciones de lambda* generan pérdidas de eficiencia en forma de U alrededor de la línea de costo mínimo.",
     "doc_id": 332
    }
   ],
   "citas": [
    {
     "texto": "As to Germany, the fulfillment factor is 1, i.e., the DIR sectors are more or less endowed with their business-as-usual emissions.",
     "doc_id": 325
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
