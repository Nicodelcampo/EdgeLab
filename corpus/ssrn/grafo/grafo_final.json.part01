  {
   "id": "latency arbitrage",
   "nombre_canonico": "latency arbitrage",
   "tipo": "estrategia",
   "nombres_vistos": [
    "latency arbitrage"
   ],
   "menciones": 3,
   "doc_frecuencia": 3,
   "doc_ids": [
    41,
    60,
    168
   ],
   "definiciones": [
    {
     "texto": "Estrategia oportunista de AT que explota cotizaciones desactualizadas ('stale quotes') detectadas cuando el salto del mid-price entre t-1 y t excede el half-spread; medida como LAO (número de oportunidades) siguiendo la metodología de Budish et al. (2015).",
     "doc_id": 41
    },
    {
     "texto": "Práctica de HFT en mercados TradFi para anticiparse a órdenes aprovechando ventajas de velocidad, equivalente al MEV pero sin visibilidad pública.",
     "doc_id": 60
    },
    {
     "texto": "Explotación de pequeños rezagos temporales entre los flujos de precios de distintos exchanges, facilitada por la fragmentación del mercado.",
     "doc_id": 168
    }
   ],
   "citas": [
    {
     "texto": "the quote at time z −1 is considered as stale if the absolute value of mid-price changes from time z −1 to z exceeds half-spread... such stale quotes can be exploited (\"sniped\") by opportunistic ATs before being cancelled",
     "doc_id": 41
    },
    {
     "texto": "Economically, MEV functions as a structural analog to HFT latency arbitrage in TradFi: in both cases, a technically sophisticated participant extracts systematic rents",
     "doc_id": 60
    },
    {
     "texto": "Latency arbitrage, which exploits slight time lags between price feeds from different exchanges, is particularly relevant in cryptocurrency markets",
     "doc_id": 168
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "opportunistic algorithmic trading",
     "doc_id": 41,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "market making",
     "doc_id": 41,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "investment-to-price sensitivity",
     "doc_id": 41,
     "revisar": false
    },
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "maximal extractable value",
     "doc_id": 60,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "high-frequency trading",
     "doc_id": 168,
     "revisar": false
    }
   ]
