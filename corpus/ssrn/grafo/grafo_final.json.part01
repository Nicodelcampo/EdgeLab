  {
   "id": "volatility skew",
   "nombre_canonico": "volatility skew",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "volatility skew"
   ],
   "menciones": 3,
   "doc_frecuencia": 3,
   "doc_ids": [
    10,
    56,
    135
   ],
   "definiciones": [
    {
     "texto": "Asimetría negativa observada empíricamente en la superficie de volatilidad de acciones, que el modelo captura permitiendo saltos en la varianza total y un parámetro de skewness negativo.",
     "doc_id": 10
    },
    {
     "texto": "Dependencia del nivel de volatilidad implícita respecto del strike; el modelo de volatilidad local se usa para capturarla, y el paper analiza casos de skew positivo y negativo.",
     "doc_id": 56
    },
    {
     "texto": "Estructura por la cual opciones de distintos strikes transan con diferentes volatilidades, reflejando expectativas de riesgo del mercado o preferencias de cobertura.",
     "doc_id": 135
    }
   ],
   "citas": [
    {
     "texto": "allowing for the presence of jumps in V and letting c < 0 enables the model to capture the empirically-observed negative volatility skew",
     "doc_id": 10
    },
    {
     "texto": "the local volatility model is frequently used to capture the volatility skew",
     "doc_id": 56
    },
    {
     "texto": "This relative value is deﬁned as options skewness, or skew, and can be used to identify trading opportunities.",
     "doc_id": 135
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
