   "definiciones": [
    {
     "texto": "Asimetría de información entre la firma y el mercado que existe antes de un anuncio corporativo no programado y que es resuelta (parcial o totalmente) por la señal del evento.",
     "doc_id": 40
    },
    {
     "texto": "Brecha estructural donde el mercado (vía microestructura) integra información antes de que esté reflejada en el consenso público. Su firma empírica es P(|rt+∆t|>kσ | D(t)>τ) ≫ P(|rt+∆t|>kσ).",
     "doc_id": 205
    }
   ],
   "citas": [
    {
     "texto": "Abnormal algorithmic trading activity is associated with wider informational gaps before special dividend announcements",
     "doc_id": 40
    },
    {
     "texto": "The central empirical question is: does an increase of D(t) beyond a threshold τ statistically precede an abnormal return within a horizon ∆t?",
     "doc_id": 205
