  {
   "id": "relative spread",
   "nombre_canonico": "Relative Spread",
   "tipo": "metrica",
   "nombres_vistos": [
    "Relative Spread",
    "Relative spread"
   ],
   "menciones": 3,
   "doc_frecuencia": 3,
   "doc_ids": [
    187,
    293,
    328
   ],
   "definiciones": [
    {
     "texto": "Medida de liquidez externa del mercado. El informed trading puede consumir liquidez, ampliando el spread, mientras que simultáneamente contribuye a un proceso de formación de precios más informado.",
     "doc_id": 187
    },
    {
     "texto": "Quoted spread escalado por el midpoint de la cotización. Refleja el costo porcentual de transar y permite comparar liquidez entre acciones de distinto precio.",
     "doc_id": 293
    },
    {
     "texto": "Proxy de liquidez ex ante definido como (ask - bid) / midpoint. Junto con el effective spread, realized spread, dispersion y slope del order book, constituye el conjunto de métricas usadas para evaluar el impacto del análisis técnico sobre la calidad de mercado.",
     "doc_id": 328
    }
   ],
   "citas": [
    {
     "texto": "Informed trading could potentially decrease the depth of the LOB and widen the bid-ask spread while contributing to a more informed and efficient price formation process.",
     "doc_id": 187
    },
    {
     "texto": "Relative spread, sometimes referred to as percentage spread, more accurately reflects the percentage cost of trading by scaling the size of the spread to the fundamental value of the stock.",
     "doc_id": 293
    },
    {
     "texto": "Technical traders lower liquidity as proxied by the relative spread, the effective spread, the realized spread, the dispersion and the slope in the order book.",
     "doc_id": 328
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "external liquidity",
     "doc_id": 187,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "informed trading",
     "doc_id": 187,
     "revisar": false
    },
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "Percentage Spread",
     "doc_id": 293,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Trading Cost",
     "doc_id": 293,
     "revisar": false
    },
    {
