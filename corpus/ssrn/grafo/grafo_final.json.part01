   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    6
   ],
   "definiciones": [
    {
     "texto": "Regularidad empírica documentada por Black (1976): retornos negativos de acciones se asocian a incrementos de volatilidad subsiguiente mayores que retornos positivos de igual magnitud.",
     "doc_id": 6
    }
   ],
   "citas": [
    {
     "texto": "Black (1976) first documented the leverage effect: negative equity returns are associated with larger subsequent volatility increases than positive returns of equal magnitude.",
     "doc_id": 6
    }
   ],
