   ],
   "definiciones": [
    {
     "texto": "Bandas de Bollinger usadas como feature de entrada para detectar zonas de breakout y reversión; el modelo las utiliza para capturar cambios dinámicos de precio.",
     "doc_id": 99
    },
    {
     "texto": "Mencionado en la revisión de literatura como una de las estrategias de breakout tradicionales junto con moving averages y price levels.",
     "doc_id": 296
    }
   ],
   "citas": [
    {
     "texto": "the Bollinger Bands are essential input properties that the DWH-RRFC model uses to identify price reversals and breakout zones",
     "doc_id": 99
    },
    {
     "texto": "Prior studies on breakout trading strategies focus on moving averages, Bollinger bands, and price levels.",
     "doc_id": 296
    }
   ],
   "relaciones_crudas": [
