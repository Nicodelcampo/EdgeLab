   ],
   "definiciones": [
    {
     "texto": "Token on-chain cuyo valor rastrea el precio de un activo real sin otorgar propiedad directa, heredando riesgos de oráculo al operar 24/7 sobre mercados que no lo hacen.",
     "doc_id": 60
    },
    {
     "texto": "Combinación lineal de un grupo de activos cuyos coeficientes representan cantidades de cada activo en el portfolio, construido para exhibir reversión a la media con volatilidad finita.",
     "doc_id": 88
    }
   ],
   "citas": [
    {
     "texto": "HIP-3 tokens have no direct claim on the underlying equity – they are purely synthetic, with value contingent on the oracle feed and the protocol’s continued operation.",
     "doc_id": 60
    },
    {
     "texto": "The detection of mispricings is based upon the identification of a linear combination of assets, or else a “synthetic” asset, whose time series is mean-reverting and has finite variability.",
     "doc_id": 88
    }
   ],
