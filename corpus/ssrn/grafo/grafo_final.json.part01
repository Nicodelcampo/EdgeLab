  {
   "id": "principal component analysi",
   "nombre_canonico": "principal component analysis",
   "tipo": "metodo",
   "nombres_vistos": [
    "Principal Component Analysis",
    "principal component analysis",
    "principal components analysis"
   ],
   "menciones": 3,
   "doc_frecuencia": 3,
   "doc_ids": [
    42,
    92,
    183
   ],
   "definiciones": [
    {
     "texto": "Técnica usada sobre los spreads estandarizados de las 30 acciones del Dow Jones para estimar qué fracción de la variación total es explicada por factores comunes de liquidez, mostrando su crecimiento en el tiempo.",
     "doc_id": 42
    },
    {
     "texto": "Técnica multivariada usada para descomponer los retornos de las acciones en componentes sistemáticos y aislar el residuo idiosincrásico para operar.",
     "doc_id": 92
    },
    {
     "texto": "Técnica de descomposición aplicada al volumen intradía para separar el componente común (estacional, compartido entre todas las acciones del CAC40) del componente específico (stock-by-stock).",
     "doc_id": 183
    }
   ],
   "citas": [
    {
     "texto": "For each month, I do a principal components analysis on the 5 minute standardized spreads si,τ,t and calculate the fraction of the variance that the ﬁrst two principal components explain.",
     "doc_id": 42
    },
    {
     "texto": "Principal Component Analysis is an eigenvector based multivariate analysis. The purpose of the analysis is to reveal the internal structure of the data to help best explain the variance.",
     "doc_id": 92
    },
    {
     "texto": "We propose another method to extract the seasonal, or normal, volume based on principal component analysis.",
     "doc_id": 183
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "liquidity commonality",
     "doc_id": 42,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "eigenportfolio",
     "doc_id": 92,
     "revisar": false
    },
    {
     "tipo": "USA",
