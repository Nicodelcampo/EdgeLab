   "citas": [
    {
     "texto": "The process of trading in the same direction as an inferred institutional (informed) trade is known as back-running.",
     "doc_id": 40
    },
    {
     "texto": "a predator trader buys while a “victim” participant is buying (or sells when the “victim” is selling). The predator’s intention is to build a sizeable position before the victim is ﬁnished trading.",
     "doc_id": 163
    },
    {
     "texto": "We reject the hypothesis that they engage in back running, a predatory trading strategy.",
     "doc_id": 384
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "algorithmic trading deters information acquisition",
     "doc_id": 40,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "informed trading",
