   ],
   "definiciones": [
    {
     "texto": "Uso de datos históricos de precio y volumen para pronosticar movimientos futuros de precio; identificado como el marco de aplicación dominante entre 143 estudios revisados (2015-2023) sobre IA en trading financiero.",
     "doc_id": 3
    },
    {
     "texto": "Conjunto de indicadores basados en precio y volumen para generar señales de trading; el paper enumera las limitaciones estructurales de los indicadores de momentum.",
     "doc_id": 18
    },
    {
     "texto": "Uso de reglas de trading basadas en medias móviles, referenciado vía Brock, Lakonishok y LeBaron (1992) como evidencia de contenido predictivo estadísticamente significativo.",
     "doc_id": 22
    },
    {
     "texto": "Análisis técnico usado como base para el scanner de breakout basado en volumen y niveles de precio.",
     "doc_id": 296
    }
   ],
   "citas": [
    {
     "texto": "technical analysis—the use of historical price and volume data to forecast future price movements—remains the dominant application framework",
     "doc_id": 3
    },
    {
     "texto": "in general, momentum based indicators fail most of the time",
     "doc_id": 18
    },
    {
     "texto": "Brock, Lakonishok, and LeBaron (1992) provide foundational evidence that moving average-based trading rules capture statistically significant predictive content in financial price series",
     "doc_id": 22
    },
    {
     "texto": "Breakout strategies are widely used but often lack precision in timing and signal validation.",
     "doc_id": 296
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "random forest",
     "doc_id": 3,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "multiple time frame analysis",
     "doc_id": 18,
     "revisar": false
    },
    {
