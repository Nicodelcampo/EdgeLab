  {
   "id": "regime detection",
   "nombre_canonico": "regime detection",
   "tipo": "metodo",
   "nombres_vistos": [
    "regime detection"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    66,
    372
   ],
   "definiciones": [
    {
     "texto": "Inferencia de estados latentes del mercado (pasivo, acumulación, distribución, vacío de liquidez) a partir de datos de order flow; los regímenes se usan luego como overlay para filtrado de señales y dimensionamiento de posición.",
     "doc_id": 66
    },
    {
     "texto": "Clasificación discreta de regímenes: Rt = +1 (precio suficientemente sobre VWAP → tendencia alcista), Rt = -1 (bajo VWAP → tendencia bajista), Rt = 0 (dentro de banda ±k alrededor de VWAP → equilibrio/mean-reversion).",
     "doc_id": 372
    }
   ],
   "citas": [
    {
     "texto": "s1: Passive Liquidity Phase, s2: Aggressive Accumulation, s3: Aggressive Distribution, s4: Liquidity Vacuum",
     "doc_id": 66
    },
    {
     "texto": "The regime variable partitions market states into three categories: bullish trend, bearish trend, and neutral equilibrium.",
     "doc_id": 372
    }
   ],
   "relaciones_crudas": [
