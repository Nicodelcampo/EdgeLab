   ],
   "definiciones": [
    {
     "texto": "Algoritmo EM regularizado para estimar parámetros del HMM con restricciones asimétricas en la matriz de transición.",
     "doc_id": 66
    },
    {
     "texto": "Algoritmo EM usado para entrenar el HMM de dos estados con covarianza diagonal sobre los features del spread en cada ventana de entrenamiento.",
     "doc_id": 122
    }
   ],
   "citas": [
    {
     "texto": "We use the Baum-Welch algorithm for parameter estimation with regularized EM for asymmetric constraints.",
     "doc_id": 66
    },
    {
     "texto": "A two-state Gaussian HMM with diagonal covariance is fitted on the training-window feature matrix using the Baum–Welch EM algorithm",
