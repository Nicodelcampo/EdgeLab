   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    361,
    363
   ],
   "definiciones": [
    {
     "texto": "Sistema cap-and-trade europeo establecido en 2005 donde empresas reciben un límite anual de emisiones en forma de allowances; deben entregar allowances equivalentes a sus emisiones antes del 30 de abril de cada año o pagar multa de 100 euros por tonelada de CO2.",
     "doc_id": 361
    },
    {
     "texto": "Sistema cap-and-trade europeo de allowances de carbono donde empresas deben entregar permisos equivalentes a sus emisiones antes del deadline anual de abril.",
     "doc_id": 363
    }
   ],
   "citas": [
    {
     "texto": "Each firm has until the end of March each year to submit to the relevant authorities an externally verified report for the volume of their CO2 emissions over the previous calendar year, and until the end of April, to surrender the corresponding number of allowances for cancellation.",
     "doc_id": 361
    },
    {
     "texto": "Regulated firms under the EU Emissions Trading Scheme (EU ETS) face annually a strict deadline for buying any lacking emissions allowances and attain environmental compliance.",
     "doc_id": 363
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
