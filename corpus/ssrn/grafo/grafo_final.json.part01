   "definiciones": [
    {
     "texto": "Estimador del spread efectivo porcentual basado en la covarianza serial negativa de los cambios de precio relativos diarios.",
     "doc_id": 72
    },
    {
     "texto": "Medida de liquidez de mercado inferida de la covarianza de cambios sucesivos de precio. Cuantifica el bid-ask spread efectivo: Roll_t = 2 * sqrt(−cov(ΔP_t, ΔP_{t−1})). El signo negativo revierte la covarianza típicamente negativa causada por el bid-ask bounce.",
     "doc_id": 220
    },
    {
     "texto": "Métrica de liquidez basada en la autocorrelación serial de cambios de precio, que estima el bid-ask spread efectivo implícito. Valores elevados en crypto sugieren mayor trading basado en momentum.",
     "doc_id": 234
    }
   ],
   "citas": [
    {
     "texto": "The Roll (1984) measure for the percentage effective spread is SR = 200 sqrt(-Cov(∆pj/pj−1, ∆pj−1/pj−2))",
     "doc_id": 72
    },
    {
     "texto": "Rollt = 2 * sqrt(−cov(∆Pt, ∆Pt−1))",
     "doc_id": 220
    },
    {
     "texto": "The greater serial correlation in crypto prices is consistent with more momentum-based trading.",
     "doc_id": 234
    }
   ],
