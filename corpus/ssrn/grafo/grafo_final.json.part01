    107,
    396
   ],
   "definiciones": [
    {
     "texto": "Una clase de grafos definidos por un conjunto constante de vértices y un conjunto cambiante de aristas, cada uno conocido como un paso de tiempo (timestep).",
     "doc_id": 107
    },
    {
     "texto": "Grafos con vértices constantes y aristas que cambian en el tiempo (timesteps); motivados por redes de transporte público e infección.",
     "doc_id": 396
    }
   ],
   "citas": [
    {
     "texto": "Temporal graphs are a class of graphs defined by a constant set of vertices and a changing set of edges, each of which is known as a timestep.",
     "doc_id": 107
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "transaction price",
   "nombre_canonico": "transaction price",
   "tipo": "metrica",
   "nombres_vistos": [
    "Transaction Price",
    "transaction price"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    111,
    206
   ],
   "definiciones": [
    {
     "texto": "El precio real al que se ejecuta una transacción entre un comprador y un vendedor.",
     "doc_id": 111
    },
    {
     "texto": "Precio de transacción observado en trades, usado como medida de precio alternativa al midpoint; los precios de transacción de un activo lideran los retornos de midpoint de otros activos.",
     "doc_id": 206
    }
   ],
   "citas": [
    {
     "texto": "the actual price at which a trade is executed between a buyer and a seller.",
     "doc_id": 111
    },
    {
     "texto": "Transaction prices and the order book imbalance (OBI) at the best quotes of one asset provide information about future midpoint returns of another asset.",
     "doc_id": 206
    }
   ],
   "relaciones_crudas": [
    {
