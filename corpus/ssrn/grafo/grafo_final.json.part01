  {
   "id": "vasicek bayesian beta",
   "nombre_canonico": "Vasicek Bayesian beta",
   "tipo": "metodo",
   "nombres_vistos": [
    "Vasicek Bayesian beta"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    29,
    30
   ],
   "definiciones": [
    {
     "texto": "Estimador bayesiano de beta (Vasicek, 1973) que resultó ser, entre los métodos tradicionales de ajuste probados en la literatura previa, el único con resultados prometedores para reducir el rango de reference-day risk.",
     "doc_id": 29
    },
    {
     "texto": "Estimador bayesiano de beta que combina información previa a la muestra con la información muestral para minimizar la pérdida de precisión por mala estimación.",
     "doc_id": 30
    }
   ],
   "citas": [
    {
     "texto": "the Vasicek (1973) Bayesian adjustment method was the only estimation method yielding any promising results, with 35 out of the JSE Top 40 companies exhibiting lower reference-day ranges than unadjusted betas",
     "doc_id": 29
    },
    {
     "texto": "Bayesian estimates are preferred to the conventional beta estimates as the Bayesian procedure minimises the loss of accuracy arising from misestimation",
     "doc_id": 30
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "reference-day risk",
