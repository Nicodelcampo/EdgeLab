  {
   "id": "avellaneda stoikov model",
   "nombre_canonico": "Avellaneda-Stoikov model",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Avellaneda-Stoikov Model",
    "Avellaneda-Stoikov model"
   ],
   "menciones": 4,
   "doc_frecuencia": 4,
   "doc_ids": [
    63,
    104,
    170,
    237
   ],
   "definiciones": [
    {
     "texto": "Modelo de referencia para market making usado como baseline. El paper extiende este modelo incorporando ambigüedad sobre las intensidades de llegada de órdenes de mercado y la probabilidad de ejecución de limit orders.",
     "doc_id": 63
    },
    {
     "texto": "Mencionado como referencia para la probabilidad de price increase, una cantidad core en LOB que el paper relaciona con el análisis de hitting times de las colas.",
     "doc_id": 104
    },
    {
     "texto": "Modelo matemático de liquidez que vincula la distancia al precio mid con una intensidad de Poisson para el llenado de órdenes límite.",
     "doc_id": 170
    },
    {
     "texto": "Modelo estándar de market making basado en procesos de Poisson para llegadas de órdenes, usado como benchmark contra el cual se compara el modelo Hawkes propuesto.",
     "doc_id": 237
    }
   ],
   "citas": [
    {
     "texto": "a commonly used model for limit order and market order dynamics",
     "doc_id": 63
    },
    {
     "texto": "This is an important piece of information especially when combined with an estimate on the probability of a price increase. The latter is a core quantity for the LOB and has been studied in Avellaneda and Stoikov",
     "doc_id": 104
    },
    {
     "texto": "For the price/liquidity modeling, we consider a discrete-time variant of the AvellanedaStoikov model",
     "doc_id": 170
    },
    {
     "texto": "We model the dynamics of order book using Hawkes processes and benchmark it against the existing models such as Avellaneda-Stoikov that utilise Poisson processes.",
     "doc_id": 237
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "market making",
     "doc_id": 63,
     "revisar": false
    },
    {
     "tipo": "USA",
