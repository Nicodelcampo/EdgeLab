  {
   "id": "investment to price sensitivity",
   "nombre_canonico": "investment-to-price sensitivity",
   "tipo": "concepto",
   "nombres_vistos": [
    "investment-to-price sensitivity"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    41,
    97
   ],
   "definiciones": [
    {
     "texto": "Sensibilidad de la inversión corporativa futura (CAPEX, cambio en activos) al precio normalizado de la acción (Tobin's Q) hoy; se interpreta como medida del aprendizaje gerencial a partir de los precios de mercado.",
     "doc_id": 41
    },
    {
     "texto": "Medida de cuánto ajustan los directivos corporativos sus niveles de inversión de capital (CAPEX) en respuesta a variaciones en los precios de las acciones.",
     "doc_id": 97
    }
   ],
   "citas": [
    {
     "texto": "we investigate the empirical relationship between AT and the sensitivity of corporate investment to stock prices (investment-to-price sensitivity)",
     "doc_id": 41
    },
    {
     "texto": "Specifically, we investigate the empirical relation between liquidity-supplying and demanding AT strategies and the sensitivity of corporate investment to stock prices (investment-to-price sensitivity).",
     "doc_id": 97
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "managerial learning",
     "doc_id": 41,
     "revisar": false
    },
    {
     "tipo": "USA",
