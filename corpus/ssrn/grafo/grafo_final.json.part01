  {
   "id": "dispersion trading",
   "nombre_canonico": "dispersion trading",
   "tipo": "estrategia",
   "nombres_vistos": [
    "dispersion trading"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    19,
    135
   ],
   "definiciones": [
    {
     "texto": "Estrategia que toma una posición corta en volatilidad del índice contra posiciones largas en volatilidad de una canasta de sus componentes, aprovechando que la volatilidad del índice suele cotizar significativamente por debajo de la de sus constituyentes.",
     "doc_id": 19
    },
    {
     "texto": "Estrategia que intercambia volatilidad de un índice bursátil contra la volatilidad de sus componentes individuales, motivada por dislocaciones en la correlación implícita.",
     "doc_id": 135
    }
   ],
   "citas": [
    {
     "texto": "a short index volatility position is traded against a basket of long single stock volatility positions. Such a long dispersion trade is short implied correlation",
     "doc_id": 19
    },
    {
     "texto": "It trades the relative value relationship between the implied volatility of an Index option and the implied volatilities of the Component Stocks that comprise the Index.",
     "doc_id": 135
    }
   ],
