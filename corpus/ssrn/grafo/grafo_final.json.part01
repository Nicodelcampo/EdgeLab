  {
   "id": "shannon entropy",
   "nombre_canonico": "Shannon entropy",
   "tipo": "metrica",
   "nombres_vistos": [
    "Shannon entropy"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    66,
    216
   ],
   "definiciones": [
    {
     "texto": "Entropía del vector de probabilidades posteriores de los estados ocultos del HMM; usada para escalar el tamaño de posición: menor entropía implica mayor confianza y posiciones más agresivas.",
     "doc_id": 66
    },
    {
     "texto": "Entropía computada sobre la distribución empírica de signos de trading (buy/sell) en una ventana deslizante de N eventos de volumen. Bajo condiciones normales HS se aproxima a 1 bit (máximo desorden); una caída abrupta de entropía sin pico de volatilidad constituye la firma de un trader informado que inyecta estructura direccional.",
     "doc_id": 216
    }
   ],
   "citas": [
    {
     "texto": "Position Size ∝ 1 - H(γ)/log N. This normalization ensures the entropy term lies between 0 and 1.",
     "doc_id": 66
    },
    {
     "texto": "Shannon entropy computed on the empirical distribution of trade signs detects critical regime transitions.",
     "doc_id": 216
    }
   ],
   "relaciones_crudas": [
