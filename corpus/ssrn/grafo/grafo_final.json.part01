  {
   "id": "mispricing",
   "nombre_canonico": "mispricing",
   "tipo": "metrica",
   "nombres_vistos": [
    "Mispricing",
    "mispricing"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    125,
    230
   ],
   "definiciones": [
    {
     "texto": "Medida de divergencia del precio respecto de su valor fundamental, que indica ineficiencia temporal del mercado.",
     "doc_id": 125
    },
    {
     "texto": "Residuo de la regresión de cointegración que mide la desviación del precio del WTI respecto al valor del statistical portfolio. Su estacionariedad (reversión a la media) es la base de la señal de trading.",
     "doc_id": 230
    }
   ],
   "citas": [
    {
     "texto": "the mispricing measure is constructed by the absolute difference between actual stock prices and fundamental values, divided by the fundamental value",
     "doc_id": 125
    },
    {
     "texto": "Mispricings arise when West Texas Intermediate crude oil price diverges from the statistical portfolio value.",
     "doc_id": 230
    }
   ],
   "relaciones_crudas": [
    {
