  {
   "id": "trading volume",
   "nombre_canonico": "trading volume",
   "tipo": "metrica",
   "nombres_vistos": [
    "Trading Volume",
    "trading volume"
   ],
   "menciones": 4,
   "doc_frecuencia": 4,
   "doc_ids": [
    11,
    190,
    211,
    223
   ],
   "definiciones": [
    {
     "texto": "Volumen esperado de transacciones en el mercado bilateral e interdealer; aumenta con la intensidad de la intervención del banco central, más rápido en el mercado interdealer/brokered que en el bilateral.",
     "doc_id": 11
    },
    {
     "texto": "Volumen de negociación medido como turnover anual. Cambios en características de las acciones generan necesidades de rebalanceo que explican una porción considerable del volumen en el corte transversal.",
     "doc_id": 190
    },
    {
     "texto": "Volumen de transacciones. El modelo predice que tras el shock, el volumen es inicialmente muy bajo, luego aumenta gradualmente hasta un máximo y después muere progresivamente (patrón hump-shaped). Con monitoreo imperfecto, el volumen es menor que en el equilibrio Walrasiano.",
     "doc_id": 211
    },
    {
     "texto": "Volumen esperado de negociación en acciones por día calendario, denotado V. Se relaciona con el betting volume mediante el multiplicador de volumen ζ: el volumen total observado incluye tanto los bets originales como el volumen de intermediación. V := ζ/2 · γ · E|Q̃|.",
     "doc_id": 223
    }
   ],
   "citas": [
    {
     "texto": "trading volume increases very rapidly with the intensity of foreign exchange intervention",
     "doc_id": 11
    },
    {
     "texto": "Style investing is an important source of trading volume.",
     "doc_id": 190
    },
    {
     "texto": "Trading volume with imperfect monitoring is lower than its Walrasian counterpart.",
     "doc_id": 211
    },
    {
     "texto": "On a given calendar day, expected trading volume (in shares) is given by V := ζ/2 · γ · E|Q̃|; dividing by two implies that a buy-bet matched to a sell-bet is counted as one unit of volume, not two.",
     "doc_id": 223
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "central bank intervention",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "market liquidity",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "MIDE",
