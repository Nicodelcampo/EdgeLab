  {
   "id": "limit order book slope",
   "nombre_canonico": "Limit order book slope",
   "tipo": "metrica",
   "nombres_vistos": [
    "Limit Order Book Slope",
    "Limit order book slope"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    65,
    187
   ],
   "definiciones": [
    {
     "texto": "Medida que resume la forma y presión de distintas partes del LOB. Se calcula como la relación (ratio) entre la diferencia de precio y la diferencia en cantidad acumulada (profundidad) entre dos niveles de un lado del book.",
     "doc_id": 65
    },
    {
     "texto": "Medida de la relación entre profundidad del LOB y distancia al precio de mercado. Refleja la dispersión de creencias de los inversores: mayor pendiente indica mayor consenso sobre el valor fundamental entre los participantes del mercado.",
     "doc_id": 187
    }
   ],
   "citas": [
    {
     "texto": "To summarize the information in these different parts of the LOB, we use their slope, which is defined as the ratio of the change in price to the change in the cumulative quantity (depth) available between two given levels of a given side.",
     "doc_id": 65
    },
    {
     "texto": "The slope of the LOB, a measure that examines the relationship between the depth of the LOB and its distance from the prevailing market price, provides a more comprehensive view of market dynamics and information asymmetry.",
     "doc_id": 187
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "midquote return",
     "doc_id": 65,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "investor beliefs consensus",
     "doc_id": 187,
     "revisar": false
    },
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "volatility",
     "doc_id": 187,
     "revisar": false
    }
   ]
