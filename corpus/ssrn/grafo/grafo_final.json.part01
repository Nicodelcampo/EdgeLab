   ],
   "definiciones": [
    {
     "texto": "Diferencia entre el precio observado al generar la señal y el precio real de ejecución, inducida por tiempo y volumen; en la herramienta se especifica como porcentaje fijo y engloba también el bid-ask spread.",
     "doc_id": 69
    },
    {
     "texto": "Costo implícito de ejecución asociado a la falta de liquidez o latencia, mencionado como un factor que reduce el borde de las estrategias reactivas de corto plazo en RL.",
     "doc_id": 70
    }
   ],
   "citas": [
    {
     "texto": "Slippage25 is the time- and the volume-induced diﬀerence between the initially\nobserved price and the real execution price",
     "doc_id": 69
    },
    {
     "texto": "transaction cost and slippage: modest increases in transaction cost materially reduced short-term reactive strategies’ edge",
     "doc_id": 70
    }
   ],
