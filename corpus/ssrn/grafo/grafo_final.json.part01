     "objeto_texto": "revelatory price efficiency",
     "doc_id": 97,
     "revisar": true
    }
   ]
  },
  {
   "id": "difference in difference",
   "nombre_canonico": "difference-in-differences",
   "tipo": "metodo",
   "nombres_vistos": [
    "difference-in-differences"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    41,
    42
   ],
   "definiciones": [
    {
     "texto": "Estrategia de identificación causal que usa la introducción del NYSE Autoquote en 2003 como shock exógeno, comparando firmas NYSE (tratamiento) contra NASDAQ (control) antes/después del evento.",
     "doc_id": 41
    },
    {
     "texto": "Regresión con efectos fijos de stock y fecha sobre la variable hybrid (dummy de tratamiento escalonado) para identificar el efecto causal de la hibridización sobre correlaciones de spreads, controlando tendencias temporales comunes.",
     "doc_id": 42
    }
   ],
   "citas": [
    {
     "texto": "We first employ difference-in-differences estimation method to establish causality. We use the introduction of NYSE Autoquote in 2003 as an exogenous event",
     "doc_id": 41
    },
    {
     "texto": "Regression with stock and date ﬁxed eﬀects is essentially a diﬀerence-in-diﬀerence test.",
     "doc_id": 42
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "NYSE Autoquote",
     "doc_id": 41,
