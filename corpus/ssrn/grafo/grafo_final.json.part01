   "doc_ids": [
    40,
    128
   ],
   "definiciones": [
    {
     "texto": "Retorno anormal acumulado estimado mediante el modelo de cinco factores de Fama-French (2015) más momentum, usado para cuantificar la reacción del mercado a un anuncio de dividendo especial.",
     "doc_id": 40
    },
    {
     "texto": "Retorno acumulado que excede el rendimiento esperado por el modelo de mercado; se encontró que es consistentemente negativo para quienes compran tras la recomendación del finfluencer.",
     "doc_id": 128
    }
   ],
   "citas": [
    {
     "texto": "CARs reach 3.67% over the 11-day window [−5, +5], significant at the 1% level",
     "doc_id": 40
    },
    {
     "texto": "Cumulative abnormal returns over window [d₁, d₂] are CARᵢ[d₁, d₂] = Σ ARᵢₜ.",
     "doc_id": 128
    }
   ],
   "relaciones_crudas": [
