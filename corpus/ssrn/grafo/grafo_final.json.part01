  {
   "id": "risk neutral valuation",
   "nombre_canonico": "risk-neutral valuation",
   "tipo": "metodo",
   "nombres_vistos": [
    "Risk-Neutral Valuation",
    "risk-neutral valuation"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    24,
    274
   ],
   "definiciones": [
    {
     "texto": "Técnica de valuar un derivado como el valor esperado descontado de su payoff bajo una medida de probabilidad Q en la que el drift del activo es la tasa libre de riesgo, eliminando la necesidad de conocer las preferencias de riesgo de los agentes.",
     "doc_id": 24
    },
    {
     "texto": "Enfoque neutral al riesgo con tasa de descuento subjetiva r>0 y costo fijo por trade c>0.",
     "doc_id": 274
    }
   ],
   "citas": [
    {
     "texto": "The key idea is to price a derivative by taking the expected value of its discounted payoff under a risk-neutral measure Q.",
     "doc_id": 24
    },
    {
     "texto": "We consider a risk-neutral approach to evaluate the trading opportunities",
     "doc_id": 274
    }
   ],
   "relaciones_crudas": [
    {
