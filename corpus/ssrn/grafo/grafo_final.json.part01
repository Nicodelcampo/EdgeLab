  {
   "id": "tail risk",
   "nombre_canonico": "tail risk",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "tail risk"
   ],
   "menciones": 4,
   "doc_frecuencia": 4,
   "doc_ids": [
    35,
    59,
    324,
    373
   ],
   "definiciones": [
    {
     "texto": "Riesgo de eventos extremos en la distribución de retornos, capturado por skewness y kurtosis; el paper argumenta que la selección dinámica de pares lo mitiga respecto a la selección fija.",
     "doc_id": 35
    },
    {
     "texto": "Riesgo asociado a eventos extremos de baja probabilidad pero alto impacto en los mercados financieros, a menudo analizados mediante distribuciones de colas pesadas.",
     "doc_id": 59
    },
    {
     "texto": "Preservación de tail risk en datos sintéticos: VaR al 99% capturado con error de 34% (conservador). Los datos sintéticos tienden a sobreestimar VaR en colas extremas, lo cual es deseable para risk management.",
     "doc_id": 324
    },
    {
     "texto": "Colas pesadas en retornos financieros ilustradas mediante QQ-plots de retornos t-Student vs normal: las colas se desvían sistemáticamente de la línea de 45°, indicando eventos extremos más frecuentes que lo predicho por Gaussianidad.",
     "doc_id": 373
    }
   ],
   "citas": [
    {
     "texto": "dynamic pair selection through walk-forward optimization not only did not worsen risk-adjusted performance, but also mitigated tail risk as well as drawdowns",
     "doc_id": 35
    },
    {
     "texto": "Tail risk refers to the low-probability but high-impact extreme events that are often modeled using the chi-square distribution.",
     "doc_id": 59
    },
    {
     "texto": "Extreme tail (1st percentile): 34% error (conservative bias → good for risk mgmt)",
     "doc_id": 324
    },
    {
     "texto": "Deviations from the 45-degree line in the tails highlight the presence of heavier-than-Gaussian tails, a common feature of financial returns.",
     "doc_id": 373
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Walk-Forward Optimization",
     "doc_id": 35,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Value at Risk",
     "doc_id": 324,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "GARCH",
     "doc_id": 373,
     "revisar": false
    }
   ]
