  {
   "id": "sortino ratio",
   "nombre_canonico": "Sortino ratio",
   "tipo": "metrica",
   "nombres_vistos": [
    "Sortino ratio"
   ],
   "menciones": 4,
   "doc_frecuencia": 4,
   "doc_ids": [
    18,
    34,
    79,
    127
   ],
   "definiciones": [
    {
     "texto": "Variante del Sharpe ratio que penaliza solo la volatilidad a la baja; el paper muestra que sufre una anomalía análoga a la del Sharpe ratio bajo ciertas secuencias de retornos.",
     "doc_id": 18
    },
    {
     "texto": "Métrica de retorno ajustado por riesgo que penaliza solo la desviación a la baja; reportada en 0.6.",
     "doc_id": 34
    },
    {
     "texto": "Variante del ratio de Sharpe orientada a penalizar exclusivamente la varianza de los retornos negativos en la estrategia de reversión a la media.",
     "doc_id": 79
    },
    {
     "texto": "Ratio de retorno sobre desviación bajista; reportan 5.30, considerado excelente (>3.0).",
     "doc_id": 127
    }
   ],
   "citas": [
    {
     "texto": "this example leads to the same conclusions when the Sharpe ratio is replaced by the Sortino ratio",
     "doc_id": 18
    },
    {
     "texto": "The Sortino Ratio of 0.6 focuses on downside risk",
     "doc_id": 34
    },
    {
     "texto": "The Sortino ratio focuses on the downside risk of the portfolio with the intuition that high upside standard deviation does not negatively impact portfolios",
     "doc_id": 79
    },
    {
     "texto": "Sortino Ratio 5.30 — Excellent >3.0",
     "doc_id": 127
    }
   ],
   "relaciones_crudas": [
