  {
   "id": "beta",
   "nombre_canonico": "beta",
   "tipo": "metrica",
   "nombres_vistos": [
    "beta"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    29,
    30
   ],
   "definiciones": [
    {
     "texto": "Componente de riesgo sistemático del CAPM que mide la sensibilidad de los retornos en exceso esperados de un activo respecto a los del mercado, calculado como covarianza del activo con el mercado sobre la varianza del mercado.",
     "doc_id": 29
    },
    {
     "texto": "Parámetro de riesgo sistemático del CAPM, definido como la covarianza del retorno del activo con el retorno del mercado dividido la varianza del retorno del mercado; describe la sensibilidad de los retornos en exceso del activo a los del mercado.",
     "doc_id": 30
    }
   ],
   "citas": [
    {
     "texto": "βi = Cov (Ri, Rm) Var (Rm)",
     "doc_id": 29
    },
    {
     "texto": "βi is the \"beta\" (a term originally coined by Sharpe (1964)) and represents the systematic risk component of an asset, as specified by the CAPM",
     "doc_id": 30
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
