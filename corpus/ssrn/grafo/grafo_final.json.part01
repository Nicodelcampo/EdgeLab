  {
   "id": "micro price",
   "nombre_canonico": "micro-price",
   "tipo": "metrica",
   "nombres_vistos": [
    "Micro-Price",
    "micro-price"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    111,
    237
   ],
   "definiciones": [
    {
     "texto": "Medida de precio propuesta que incorpora los movimientos futuros esperados del precio como una función del spread bid-ask actual y el imbalance del order book, siendo un martingala por construcción.",
     "doc_id": 111
    },
    {
     "texto": "Precio ponderado por volumen al mejor bid y ask: (Vbid·Pask + Vask·Pbid)/(Vbid+Vask). Señal de muy baja latencia (30-50 µs) que indica dirección cuando el mid-price cruza el micro-price más un umbral.",
     "doc_id": 237
    }
   ],
   "citas": [
    {
     "texto": "incorporates expected future price movements and is... a function f of the current bid-ask spread and the order book imbalance.",
     "doc_id": 111
    },
    {
     "texto": "Micro-price looks at the volume weighted prices and checks if the current mid price exceeds micro price plus a threshold, indicating a signal to short.",
     "doc_id": 237
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "order book imbalance",
     "doc_id": 111,
