  {
   "id": "thin trading",
   "nombre_canonico": "thin trading",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "thin trading"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    30,
    221
   ],
   "definiciones": [
    {
     "texto": "Condición de negociación infrecuente de una acción que produce un sesgo a la baja en la covarianza estimada y por ende en beta, motivando el ajuste de Dimson.",
     "doc_id": 30
    },
    {
     "texto": "Fenómeno microestructural por el cual ciertos activos no negocian en todos los períodos, generando que los precios observados reflejen información con retraso respecto a los precios verdaderos. Es más prevalente en acciones de baja capitalización y en mercados emergentes.",
     "doc_id": 221
    }
   ],
   "citas": [
    {
     "texto": "Fisher (1966) suggests that a major source of bias in estimating beta emanates from the tendency of shares which are subject to thin trading having substantially underestimated covariances",
     "doc_id": 30
    },
    {
     "texto": "in general, smaller market capitalisation stocks are more thinly traded than stocks with larger market capitalisations",
     "doc_id": 221
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "beta instability",
     "doc_id": 30,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "market microstructure",
     "doc_id": 221,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "lead-lag effect",
     "doc_id": 221,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "autocorrelation",
     "doc_id": 221,
