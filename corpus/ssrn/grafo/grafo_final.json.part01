   "doc_ids": [
    29,
    30
   ],
   "definiciones": [
    {
     "texto": "Método de ajuste de beta mediante regresión (Blume, 1971) evaluado como corrector de reference-day risk; según el paper reduce solo la variabilidad más severa y no la reduce de forma consistente en muchas acciones.",
     "doc_id": 29
    },
    {
     "texto": "Método que estima betas \"predichas\" regresionando los valores de beta de un período sobre los del período anterior, ajustando hacia una media de 1.",
     "doc_id": 30
    }
   ],
   "citas": [
    {
     "texto": "the Blume (1971) regression method reduces only the most severe reference-day variability",
     "doc_id": 29
    },
    {
     "texto": "Blume then estimated the betas for the resultant portfolios across two, non-overlapping consecutive periods",
     "doc_id": 30
    }
   ],
