  {
   "id": "power law kernel",
   "nombre_canonico": "power-law kernel",
   "tipo": "metodo",
   "nombres_vistos": [
    "power-law kernel"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    207,
    208
   ],
   "definiciones": [
    {
     "texto": "Función de decaimiento phi(t) = alpha * (1 + gamma * t)^(-beta) usada como forma paramétrica para los kernels de excitación del Hawkes. El paper encuentra que la power-law es seleccionada el 100% de las veces sobre la exponencial según AIC para datos de AAPL.",
     "doc_id": 207
    },
    {
     "texto": "Función de decaimiento paramétrica ajustada sobre las estimaciones no paramétricas que captura la memoria larga en la llegada de órdenes mucho mejor que un kernel exponencial.",
     "doc_id": 208
    }
   ],
   "citas": [
    {
     "texto": "We see that the power-law kernel is selected 100% of the time for this dataset.",
     "doc_id": 207
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Hawkes process",
     "doc_id": 207,
     "revisar": false
    },
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "exponential kernel",
     "doc_id": 207,
     "revisar": false
    },
    {
