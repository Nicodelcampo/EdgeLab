   "definiciones": [
    {
     "texto": "Estrategia trend-following: compra 34% del cash restante cada día que el precio de Bitcoin está sobre su media móvil de 14 días y liquida toda la posición cuando cae debajo; el paper advierte sensibilidad al lookback y al holding period.",
     "doc_id": 69
    },
    {
     "texto": "Senal de compra cuando MA de 20 dias cruza por encima de MA de 50 dias; senal de venta en sentido opuesto.",
     "doc_id": 284
    }
   ],
   "citas": [
    {
     "texto": "This portfolio is based on one of the most straightforward trend-following strategies: simple moving average price crossover.",
     "doc_id": 69
