     "objeto_texto": "order flow",
     "doc_id": 185,
     "revisar": false
    },
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "returns",
     "doc_id": 185,
     "revisar": false
    }
   ]
  },
  {
   "id": "trade string",
   "nombre_canonico": "trade string",
   "tipo": "metodo",
   "nombres_vistos": [
    "Trade Strings",
    "trade string"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    163,
    384
   ],
   "definiciones": [
    {
     "texto": "Técnica heurística para reconstruir la ejecución de órdenes institucionales fragmentadas mediante la agrupación de transacciones consecutivas unidireccionales de un participante realizadas con poco tiempo de separación.",
     "doc_id": 163
    }
   ],
   "citas": [
    {
     "texto": "A “trade string” is deﬁned as at least four consecutive unidirectional (all buy or all sell) trades in which one participant builds a net position at least $2 million in size and with no more than a 20-minute gap between the participant’s trades.",
     "doc_id": 163
    },
    {
     "texto": "We locate 'trade strings' by a participant: sequences of trades that are nearby in time, are all in the same direction, and are for a position size of at least CAD $2 million.",
     "doc_id": 384
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "informed trading",
     "doc_id": 163,
     "revisar": false
    },
    {
     "tipo": "DEFINE",
     "tipo_original": "DEFINE",
     "objeto_texto": "Institutional Trading",
     "doc_id": 384,
     "revisar": true
    }
   ]
  },
  {
   "id": "minimum trading unit mtu",
   "nombre_canonico": "Minimum Trading Unit",
   "tipo": "concepto",
   "nombres_vistos": [
    "Minimum Trading Unit",
    "Minimum Trading Unit (MTU)"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    172,
    173
   ],
   "definiciones": [
    {
     "texto": "Unidad mínima de acciones o valor monetario necesario para realizar una transacción en un mercado. Actúa como barrera de entrada que afecta la accesibilidad del mercado subyacente y, por ende, al ETF correspondiente.",
     "doc_id": 172
    },
    {
     "texto": "El número o valor mínimo de acciones necesarias para poder ejecutar una transacción en el mercado. Actúa como una barrera de trading, especialmente limitando a los inversores minoristas.",
     "doc_id": 173
    }
   ],
   "citas": [
    {
     "texto": "MTUs represent the minimum number of shares or the minimum monetary value necessary for a transaction. They play a vital role in the efficient management and regulation of financial markets.",
     "doc_id": 172
    },
    {
     "texto": "MTUs represent the minimum number of shares that are required for a transaction and act as trading barriers for investors.",
     "doc_id": 173
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "tracking error",
     "doc_id": 172,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "probability of informed trading",
     "doc_id": 172,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "institutional trading activity",
     "doc_id": 172,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "market accessibility",
     "doc_id": 173,
     "revisar": false
    },
    {
     "tipo": "DISMINUYE",
     "tipo_original": "DISMINUYE",
     "objeto_texto": "institutional trading activity",
