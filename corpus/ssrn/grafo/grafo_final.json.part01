  {
   "id": "pigovian tax",
   "nombre_canonico": "Pigovian tax",
   "tipo": "metodo",
   "nombres_vistos": [
    "Pigovian tax"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    116,
    219
   ],
   "definiciones": [
    {
     "texto": "Impuesto Pigoviano sobre la inversión en tecnología rápida igual a la externalidad negativa marginal generada por un fast trader adicional. Es la política que maximiza el bienestar utilitarista, dominando tanto el laissez-faire como la prohibición total.",
     "doc_id": 116
    },
    {
     "texto": "Impuesto correctivo que grava a los fast traders para internalizar la externalidad negativa que imponen sobre los slow traders. En el modelo, un impuesto pigouviano de 0.121 ticks mejora el bienestar en 0.095 ticks respecto al caso sin regulación, aunque deteriora las medidas de calidad de mercado.",
     "doc_id": 219
    }
   ],
   "citas": [
    {
     "texto": "equating the tax to the negative externality generated by fast trading leads to the level of investment that maximizes utilitarian welfare",
     "doc_id": 116
    },
    {
     "texto": "the Pigovian tax is 0.121, which generates an improvement in social welfare of 0.095 (i.e., 3.763-3.668=0.095) relative to the case without regulation.",
     "doc_id": 219
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "adverse selection",
     "doc_id": 116,
     "revisar": false
    },
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "market efficiency",
     "doc_id": 116,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "overinvestment in HFT",
     "doc_id": 219,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "bid-ask spread",
     "doc_id": 219,
     "revisar": false
    }
   ]
