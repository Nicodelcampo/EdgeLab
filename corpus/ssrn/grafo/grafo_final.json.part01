     "tipo_original": "PREDICE",
     "objeto_texto": "future volatility",
     "doc_id": 135,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Black-Scholes model",
     "doc_id": 135,
     "revisar": false
    }
   ]
  },
  {
   "id": "quadratic variation",
   "nombre_canonico": "quadratic variation",
   "tipo": "metodo",
   "nombres_vistos": [
    "quadratic variation"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    19,
    200
   ],
   "definiciones": [
    {
     "texto": "Límite al que converge la varianza realizada cuando el número de fechas de muestreo tiende a infinito para un proceso de salto-difusión; el paper lo usa para derivar la valuación teórica del variance swap.",
     "doc_id": 19
    },
    {
     "texto": "Medida empleada para diagnosticar empíricamente si la función de volatilidad condicionada ajusta correctamente las variaciones de precio en regímenes de mercado detectados textualmente.",
     "doc_id": 200
    }
   ],
   "citas": [
    {
     "texto": "the price of the variance swap converge to the quadratic variation of the logarithm of the stock price denoted by Lt",
     "doc_id": 19
    },
    {
     "texto": "regime-wise quadratic variation becomes a direct diagnostic for how well σφ responds to embedding-defined regimes.",
     "doc_id": 200
    }
   ],
