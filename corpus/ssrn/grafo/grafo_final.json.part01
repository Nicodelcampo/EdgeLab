    317,
    378
   ],
   "definiciones": [
    {
     "texto": "Estrategia que descompone retornos accionarios en componentes sistemáticos (PCA) e idiosincráticos (residuos). Los residuos se modelan como procesos mean-reverting (Ornstein-Uhlenbeck) generando señales contrarian: long en residuos negativos, short en positivos. Portafolio market-neutral resultante.",
     "doc_id": 317
    },
    {
     "texto": "Estrategia que descompone retornos accionarios en componentes sistemáticos (PCA) e idiosincráticos, modelando el residuo como proceso de reversión a la media para generar señales contrarian.",
     "doc_id": 378
    }
   ],
   "citas": [
    {
     "texto": "Trading signals are generated in two ways: using Principal Component Analysis and using sector ETFs. In both cases, we consider the residuals and model them as a mean-reverting process.",
     "doc_id": 317
    },
    {
     "texto": "Trading signals are generated in two ways: using Principal Component Analysis and using sector ETFs. In both cases, we consider the residuals, or idiosyncratic components of stock returns, and model them as a mean-reverting process.",
     "doc_id": 378
    }
   ],
   "relaciones_crudas": [
