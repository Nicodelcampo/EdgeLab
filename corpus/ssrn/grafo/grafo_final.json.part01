  {
   "id": "state space model",
   "nombre_canonico": "state space model",
   "tipo": "metodo",
   "nombres_vistos": [
    "state space model"
   ],
   "menciones": 3,
   "doc_frecuencia": 3,
   "doc_ids": [
    6,
    95,
    122
   ],
   "definiciones": [
    {
     "texto": "Representación unificada para una amplia clase de modelos de series de tiempo (ARIMA, componentes no observados, volatilidad estocástica, regresiones con parámetros variables en el tiempo).",
     "doc_id": 6
    },
    {
     "texto": "Representación estado-espacio de la dinámica de equilibrio con variables observables (news trader net volume, precio) y estados latentes (vt, qt, dvt). Permite estimación por máxima verosimilitud vía Kalman filter.",
     "doc_id": 95
    },
    {
     "texto": "Formulación estado-espacio del Kalman filter para pairs trading: ecuación de observación log At = βt·log Bt + εt, ecuación de estado βt = βt-1 + ηt. El estado βt y su varianza posterior Pt se actualizan secuencialmente.",
     "doc_id": 122
    }
   ],
   "citas": [
    {
     "texto": "State space representations provide a unified framework for modeling a vast array of time series models, including ARIMA, unobserved components, stochastic volatility, and time-varying parameter regressions.",
     "doc_id": 6
    },
    {
     "texto": "The equilibrium dynamics can be represented by a Gaussian state space model",
     "doc_id": 95
    },
    {
     "texto": "Branch B models βt as a latent state in the scalar state-space system",
     "doc_id": 122
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Kalman filter",
     "doc_id": 95,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Kyle model",
     "doc_id": 95,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Kalman filter",
     "doc_id": 122,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "pairs trading",
     "doc_id": 122,
     "revisar": false
    }
   ]
