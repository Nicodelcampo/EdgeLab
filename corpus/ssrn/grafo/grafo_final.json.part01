   ],
   "definiciones": [
    {
     "texto": "Conjunto de decisiones permitidas para el agente en el entorno de trading, típicamente vender, mantener o comprar una cantidad específica de acciones.",
     "doc_id": 126
    },
    {
     "texto": "Conjunto de acciones permitidas: vender (-k), mantener (0) o comprar (+k) donde k es el número de acciones. El espacio puede ser discreto {-k,...,-1,0,1,...,k}.",
     "doc_id": 184
    }
   ],
   "citas": [
    {
     "texto": "The action space describes the allowed actions that the agent interacts with the environment.",
     "doc_id": 126
    },
    {
     "texto": "The action space describes the allowed actions that the agent interacts with the environment. Normally, a includes three actions: selling, holding, and buying.",
     "doc_id": 184
    }
   ],
