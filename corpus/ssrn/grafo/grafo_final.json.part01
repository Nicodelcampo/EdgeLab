    }
   ]
  },
  {
   "id": "stress testing",
   "nombre_canonico": "stress testing",
   "tipo": "metodo",
   "nombres_vistos": [
    "Stress Testing",
    "stress testing"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    59,
    215
   ],
   "definiciones": [
    {
     "texto": "Herramienta analítica empleada para medir la resiliencia de los portafolios de inversión frente a condiciones de mercado extremas simuladas.",
     "doc_id": 59
    },
    {
     "texto": "Proceso de evaluación de la resiliencia de una cartera bajo escenarios adversos hipotéticos pero plausibles —recesiones macroeconómicas, shocks de tasas, disrupciones sectoriales— generados mediante modelos macro-financieros. Bajo Basilea III es obligatorio e integra riesgo de cola, estructuras de dependencia y efectos no lineales. Se valida con backtesting (Kupiec, Christoffersen) y se incorpora como restricción activa en modelos de optimización.",
     "doc_id": 215
    }
   ],
   "citas": [
    {
     "texto": "Stress testing is a critical tool used by financial institutions to evaluate the resilience of their portfolios under adverse market conditions.",
     "doc_id": 59
    },
    {
     "texto": "Stress testing evaluates the resilience of credit portfolios under hypothetical but plausible adverse scenarios, assessing the impact on capital adequacy, liquidity, and earnings.",
     "doc_id": 215
    }
   ],
   "relaciones_crudas": [
