  {
   "id": "trailing stop",
   "nombre_canonico": "trailing stop",
   "tipo": "metodo",
   "nombres_vistos": [
    "trailing stop"
   ],
   "menciones": 2,
   "doc_frecuencia": 2,
   "doc_ids": [
    22,
    34
   ],
   "definiciones": [
    {
     "texto": "Stop dinámico anclado a la EMA de 50 periodos, que se activa exclusivamente cuando una vela cierra del lado adverso de la EMA, ignorando penetraciones intrabar (mechas).",
     "doc_id": 22
    },
    {
     "texto": "Modelo de riesgo que ajusta dinámicamente el nivel de stop-loss para asegurar ganancias mientras protege contra pérdidas, con parámetro δ típicamente entre 5% y 15%.",
     "doc_id": 34
    }
   ],
   "citas": [
    {
     "texto": "Exit the position if and only if a 15-minute candle closes beyond the 50-period EMA on the adverse side",
     "doc_id": 22
    },
    {
     "texto": "The trailing-stop model locks in profits in trending markets while providing downside protection.",
     "doc_id": 34
    }
   ],
   "relaciones_crudas": [
    {
