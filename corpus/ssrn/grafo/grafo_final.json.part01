    16,
    45
   ],
   "definiciones": [
    {
     "texto": "Incertidumbre sobre los supuestos del modelo, como la forma de la distribución de probabilidad asumida y los parámetros embebidos en ella, que puede llevar a una estimación incorrecta y a una regla de trading mal calibrada.",
     "doc_id": 16
    },
    {
     "texto": "Posibilidad de que el modelo de co-integración esté mal especificado; los autores mencionan como extensión el caso de un inversor con aversión a la ambigüedad que reconoce esta posibilidad.",
     "doc_id": 45
    }
   ],
   "citas": [
    {
     "texto": "Model uncertainty is the uncertainty affecting model assumptions, e.g., the assumed form of the probability distribution and the parameters embedded in the probability distribution",
     "doc_id": 16
    },
    {
     "texto": "recognises that the co-integration model might be misspeciﬁed and proceeds as in the work of Cartea et al. (2016)",
     "doc_id": 45
    }
   ],
   "relaciones_crudas": [
