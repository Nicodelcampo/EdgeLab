     "tipo_original": "MIDE",
     "objeto_texto": "fair value of WTI",
     "doc_id": 230,
     "revisar": false
    }
   ]
  },
  {
   "id": "west texa intermediate wti",
   "nombre_canonico": "West Texas Intermediate (WTI)",
   "tipo": "dato",
   "nombres_vistos": [
    "West Texas Intermediate (WTI)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    230
   ],
   "definiciones": [
    {
     "texto": "Crudo de referencia estadounidense usado como activo objetivo del arbitraje estadístico, cuyo precio se compara contra el statistical portfolio de Brent y Dubai para identificar desviaciones.",
     "doc_id": 230
    }
   ],
   "citas": [
    {
     "texto": "We focus on long-term pricing relationships between the West Texas Intermediate crude oil futures and a so-called statistical portfolio, composed by other two crude oils, Brent and Dubai.",
     "doc_id": 230
    }
   ],
   "relaciones_crudas": [
