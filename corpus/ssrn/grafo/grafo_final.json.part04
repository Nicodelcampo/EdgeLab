   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    274
   ],
   "definiciones": [
    {
     "texto": "Sistema de problemas de parada óptima donde V0 (sin posición) y V1 (con posición larga) están vinculadas: al entrar se paga Xτ+c y se obtiene V1; al salir se recibe Xτ-c y se obtiene V0.",
     "doc_id": 274
    }
   ],
   "citas": [
    {
     "texto": "V0(t,x) = sup E[e^{-r(τ-t)}(V1(τ,Xτ)-Xτ-c)+]",
     "doc_id": 274
    }
   ],
   "relaciones_crudas": [
