   "tipo": "fenomeno",
   "nombres_vistos": [
    "Turnover as Transmission Mechanism"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    244
   ],
   "definiciones": [
    {
     "texto": "Mecanismo clave que vincula frecuencia de observación con performance: intervalos más cortos generan más oportunidades de revisar exposición, que con costes de transacción pueden acumularse y erosionar retornos netos.",
     "doc_id": 244
    }
   ],
   "citas": [
    {
     "texto": "Shorter observation intervals create more opportunities for the agent to revise exposure. When transaction costs penalize exposure changes, more decision points can translate into higher cost accumulation",
     "doc_id": 244
    }
   ],
