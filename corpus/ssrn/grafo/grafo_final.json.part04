   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    286
   ],
   "definiciones": [
    {
     "texto": "Indicador Sprob normalizado por sector con tanh para estabilizar ranking cross-sectorial: Sprob_ij = sgn(Sdet_ij)*tanh(|Sdet_ij|/tau_ij).",
     "doc_id": 286
    }
   ],
   "citas": [
    {
     "texto": "Sprob normalizes sector heterogeneity, improving cross-sector comparability in tails",
     "doc_id": 286
    }
