     "tipo_original": "CONTRADICE_A",
     "objeto_texto": "Asymmetric Entry/Exit Strategies",
     "doc_id": 254,
     "revisar": false
    }
   ]
  },
  {
   "id": "renewal theory trade cycle",
   "nombre_canonico": "Renewal Theory (Trade Cycles)",
   "tipo": "metodo",
   "nombres_vistos": [
    "Renewal Theory (Trade Cycles)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    254
   ],
   "definiciones": [
    {
     "texto": "Marco teórico donde cada ciclo completo de trade (entrada→salida→entrada) se trata como una renovación, permitiendo aproximar el número esperado de trades por unidad de tiempo como 1/E[T] para horizontes largos.",
     "doc_id": 254
    }
   ],
   "citas": [
    {
     "texto": "The renewal function M(t) denotes the expected number of renewals by time t. Trades would reflect renewals in our case",
     "doc_id": 254
    }
   ],
   "relaciones_crudas": [
