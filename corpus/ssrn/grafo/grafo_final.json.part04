   "tipo": "dato",
   "nombres_vistos": [
    "Relative Volume Process"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    229
   ],
   "definiciones": [
    {
     "texto": "Proceso Yt = Vt/VT que representa el volumen acumulado normalizado por el volumen final total. Adaptado a la filtración G = F ∨ σ(VT), que incluye conocimiento del volumen final.",
     "doc_id": 229
    }
   ],
   "citas": [
    {
     "texto": "The relative volume process Y is defined as market cumulative volume Vt divided by market total final volume Yt = Vt/VT.",
     "doc_id": 229
    }
   ],
   "relaciones_crudas": [
