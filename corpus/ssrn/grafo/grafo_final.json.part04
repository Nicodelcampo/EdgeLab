  {
   "id": "execution slippage vs market impact",
   "nombre_canonico": "Execution Slippage vs Market Impact",
   "tipo": "concepto",
   "nombres_vistos": [
    "Execution Slippage vs Market Impact"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    258
   ],
   "definiciones": [
    {
     "texto": "Distinción entre dos componentes de coste: market impact (cambio permanente en precio de mercado por el trade) y execution slippage (diferencia entre precio de mercado y precio de ejecución, incluyendo bid-ask spread y profundidad del LOB).",
     "doc_id": 258
    }
   ],
   "citas": [
    {
     "texto": "Market impact is permanent and affects the market price of the stock following the trade. Execution slippage only affects the price received for a particular trade",
     "doc_id": 258
    }
   ],
   "relaciones_crudas": [
    {
