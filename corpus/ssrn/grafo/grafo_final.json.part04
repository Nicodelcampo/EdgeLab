  {
   "id": "expected delay ed i",
   "nombre_canonico": "Expected Delay (ED_i)",
   "tipo": "metrica",
   "nombres_vistos": [
    "Expected Delay (ED_i)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    287
   ],
   "definiciones": [
    {
     "texto": "Tiempo esperado hasta ejecucion: ED_i = Q_i/mu_i; en equilibrio ED_i = W/(mu*beta_i) proporcional al workload agregado.",
     "doc_id": 287
    }
   ],
   "citas": [
    {
     "texto": "the expected delay on exchange i is given by ED_i = W/(mu*beta_i)",
     "doc_id": 287
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Liquidity",
     "doc_id": 287,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Order Routing Decision",
     "doc_id": 287,
     "revisar": false
    }
   ]
  },
  {
   "id": "little s law for order book",
   "nombre_canonico": "Little's Law for Order Books",
   "tipo": "concepto",
   "nombres_vistos": [
    "Little's Law for Order Books"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    287
   ],
   "definiciones": [
    {
     "texto": "Q_i = (lambda_i + Lambda*chi_i) * ED_i; cada cola es igual a la tasa de llegada agregada por el expected delay de equilibrio.",
     "doc_id": 287
    }
   ],
   "citas": [
    {
     "texto": "each queue length is equal to the corresponding aggregate arrival rate times the equilibrium expected delay",
     "doc_id": 287
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Flow Balance Condition",
     "doc_id": 287,
     "revisar": false
    }
   ]
  },
  {
   "id": "market order attraction model",
   "nombre_canonico": "Market Order Attraction Model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Market Order Attraction Model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    287
   ],
   "definiciones": [
    {
     "texto": "Modelo reduced-form: mu_i(Q) = mu * (beta_i*Q_i)/(sum_j beta_j*Q_j); market orders se dirigen a exchanges con mas liquidez disponible.",
     "doc_id": 287
    }
   ],
   "citas": [
    {
     "texto": "mu_i(Q(t)) = mu * (beta_i*Q_i)/(sum_j beta_j*Q_j)",
     "doc_id": 287
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Fragmented Market Model",
     "doc_id": 287,
     "revisar": false
    }
   ]
  },
