  {
   "id": "infinite distributed lag idl model",
   "nombre_canonico": "Infinite Distributed Lag (IDL) Model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Infinite Distributed Lag (IDL) Model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    295
   ],
   "definiciones": [
    {
     "texto": "Modelo donde la variable dependiente está definida por valores actuales y todos los pasados de las variables independientes. La estimación requiere restricciones como la distribución de rezagos de Koyck, que reduce los coeficientes a solo dos parámetros.",
     "doc_id": 295
    }
   ],
   "citas": [
    {
     "texto": "An infinite distributed lag (IDL) model is when the dependent variable is defined by current and all past values of the independent variables.",
     "doc_id": 295
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
