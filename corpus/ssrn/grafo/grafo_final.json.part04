   "doc_frecuencia": 1,
   "doc_ids": [
    275
   ],
   "definiciones": [
    {
     "texto": "Volatilidad de pares con baja (alta) volatilidad tiende a aumentar (disminuir) entre periodo de identificacion y trading.",
     "doc_id": 275
    }
   ],
   "citas": [
    {
     "texto": "volatility increases are more likely for pairs with currently low pair volatility",
     "doc_id": 275
    }
