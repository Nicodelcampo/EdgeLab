  {
   "id": "trade anonymity problem",
   "nombre_canonico": "Trade Anonymity Problem",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "Trade Anonymity Problem"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    252
   ],
   "definiciones": [
    {
     "texto": "Barrera fundamental en investigación empírica de trading: los registros de transacciones no identifican al trader, impidiendo saber si trades en dos securities fueron ejecutados por la misma entidad.",
     "doc_id": 252
    }
   ],
   "citas": [
    {
     "texto": "One of the greatest challenges in empirical trading research is to overcome the anonymity of reported trades",
     "doc_id": 252
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
