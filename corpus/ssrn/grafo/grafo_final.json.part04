     "tipo_original": "PARTE_DE",
     "objeto_texto": "CARA Objective",
     "doc_id": 257,
     "revisar": false
    }
   ]
  },
  {
   "id": "optimal dynamic vwap tracking strategy",
   "nombre_canonico": "Optimal Dynamic VWAP Tracking Strategy",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Optimal Dynamic VWAP Tracking Strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    258
   ],
   "definiciones": [
    {
     "texto": "Estrategia en forma cerrada que minimiza la varianza de la diferencia entre VWAP personal y de mercado, dependiendo de correlación retorno-volumen, volumen esperado y varianza de retornos. No depende del VWAP corriente ni del precio de la acción.",
     "doc_id": 258
    }
   ],
   "citas": [
    {
     "texto": "the optimal trading strategy is independent of the stock's running VWAP, the stock's price, and the running VWAP of the trading strategy",
     "doc_id": 258
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MINIMIZA",
     "tipo_original": "MINIMIZA",
     "objeto_texto": "VWAP Tracking Error Variance",
