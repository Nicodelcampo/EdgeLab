   "doc_ids": [
    258
   ],
   "definiciones": [
    {
     "texto": "Coste típico de órdenes VWAP garantizadas ofrecidas por brokers: 10-20 bps. El estudio demuestra que la estrategia óptima propuesta consistentemente opera por debajo de este umbral, validando su utilidad práctica.",
     "doc_id": 258
    }
   ],
   "citas": [
