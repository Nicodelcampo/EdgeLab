   "tipo": "metodo",
   "nombres_vistos": [
    "Rolling Formation-Trading Windows"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    247
   ],
   "definiciones": [
    {
     "texto": "Estrategia con 12 meses de formación para seleccionar pares y estimar parámetros, seguidos de 6 meses de trading, con 6 carteras solapadas rotando cada mes para suavizar resultados.",
     "doc_id": 247
    }
   ],
