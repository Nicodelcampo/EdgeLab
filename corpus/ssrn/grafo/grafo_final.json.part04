   "doc_frecuencia": 1,
   "doc_ids": [
    294
   ],
   "definiciones": [
    {
     "texto": "Método de clustering particional que asigna datos a K clusters minimizando la suma de cuadrados intra-cluster. Requiere eliminación post-hoc de outliers mediante filtro de distancia al centroide versus distancia al vecino más cercano (percentil α=0.5).",
     "doc_id": 294
    }
   ],
   "citas": [
    {
     "texto": "K-means clustering assigns all data points into the specified number of clusters, it does not have the capability to identify outliers. Hence, we adopt and modify the method used by Hautamaki et al. (2005) to identify these stocks and remove them from the asset pool.",
     "doc_id": 294
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Within-Cluster Sum of Squares",
     "doc_id": 294,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "DBSCAN",
     "doc_id": 294,
     "revisar": false
    }
   ]
  },
  {
   "id": "contrarian strategy within cluster",
   "nombre_canonico": "Contrarian Strategy within Clusters",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Contrarian Strategy within Clusters"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    294
   ],
   "definiciones": [
    {
     "texto": "Dentro de cada cluster se ordenan stocks por retorno del mes anterior (mom1). Se forman pares emparejando el de mayor retorno con el de menor. Se abre long-short si la diferencia de retornos supera una desviación estándar cross-sectional de todas las diferencias.",
     "doc_id": 294
    }
   ],
   "citas": [
    {
     "texto": "Low (high) return stocks within the same cluster are deemed undervalued (overvalued), and a contrarian strategy is adopted by going long on the undervalued stocks and short on the overvalued stocks.",
     "doc_id": 294
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Short-Term Reversal",
     "doc_id": 294,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Mean Reversion",
     "doc_id": 294,
     "revisar": false
    }
   ]
  },
  {
   "id": "firm characteristic as forward looking feature",
   "nombre_canonico": "Firm Characteristics as Forward-Looking Features",
   "tipo": "concepto",
   "nombres_vistos": [
    "Firm Characteristics as Forward-Looking Features"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    294
   ],
   "definiciones": [
    {
     "texto": "Las características empresariales (78 variables de Green et al., 2017) son prospectivas y reducen la probabilidad de identificar pares espuriamente correlacionados. Su inclusión reduce significativamente la volatilidad y el drawdown de la estrategia.",
     "doc_id": 294
    }
   ],
   "citas": [
    {
     "texto": "We consider firm characteristics to be more forward-looking. This motivates us to use both momentum features and firm characteristics for clustering.",
     "doc_id": 294
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Pairs Trading Performance",
     "doc_id": 294,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Momentum Features",
     "doc_id": 294,
     "revisar": false
    }
   ]
  },
  {
   "id": "short term reversal factor",
   "nombre_canonico": "Short-Term Reversal Factor",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Short-Term Reversal Factor"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    294
   ],
   "definiciones": [
    {
     "texto": "Factor de reversión a corto plazo: acciones con bajo retorno en el mes anterior (mom1) tienden a rebotar, y acciones con alto retorno tienden a revertir. Es la base del momento contrarian dentro de clusters.",
     "doc_id": 294
    }
   ],
   "citas": [
    {
     "texto": "Our strategy is essentially a short-term reversal strategy with a carefully selected trading asset pool.",
     "doc_id": 294
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "Future Returns",
     "doc_id": 294,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Contrarian Strategy within Clusters",
     "doc_id": 294,
     "revisar": false
    }
   ]
  },
  {
   "id": "factor regression alpha analysi",
   "nombre_canonico": "Factor Regression Alpha Analysis",
   "tipo": "metodo",
   "nombres_vistos": [
    "Factor Regression Alpha Analysis"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    294
   ],
   "definiciones": [
    {
     "texto": "Regresión de retornos del portafolio long-short contra FF3, FF3+momentum+reversal, FF5 y q5 factors para verificar que el alpha no es explicado por factores de riesgo sistemáticos. El alpha mensual de 1.9% es estadísticamente significativo en todas las especificaciones.",
     "doc_id": 294
    }
   ],
   "citas": [
    {
     "texto": "The long-short portfolio constructed from agglomerative clustering yields an economically and statistically significant monthly alpha of 1.9% (t = 14.16) when regressed against FF3.",
     "doc_id": 294
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Fama-French Factors",
     "doc_id": 294,
