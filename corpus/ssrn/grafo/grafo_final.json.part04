  {
   "id": "smooth pasting condition",
   "nombre_canonico": "Smooth Pasting Condition",
   "tipo": "metodo",
   "nombres_vistos": [
    "Smooth Pasting Condition"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    274
   ],
   "definiciones": [
    {
     "texto": "Condición de optimalidad: ∂V0/∂x = ∂V1/∂x - 1 en b0(t) y ∂V1/∂x = ∂V0/∂x + 1 en b1(t).",
     "doc_id": 274
    }
   ],
   "citas": [
    {
     "texto": "The smooth pasting conditions are imposed due to the optimality of trading boundaries",
     "doc_id": 274
    }
   ],
