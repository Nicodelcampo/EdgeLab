    }
   ]
  },
  {
   "id": "leveraged etf letf",
   "nombre_canonico": "Leveraged ETF (LETF)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Leveraged ETF (LETF)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    235
   ],
   "definiciones": [
    {
     "texto": "ETF que busca generar un múltiplo β (ej. +2, −2) del retorno diario del subyacente, menos una comisión de gestión. Ejemplos: SSO (β=+2 sobre S&P500), SDS (β=−2). Sus opciones tienen dinámicas de implied volatility diferentes a las del ETF sin apalancar.",
     "doc_id": 235
    }
   ],
   "citas": [
    {
     "texto": "Leveraged ETFs (LETFs) are used to generate multiples or inverse multiples of returns on the underlying asset.",
     "doc_id": 235
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Moneyness Scaling",
