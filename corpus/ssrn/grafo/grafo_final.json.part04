   "tipo": "fenomeno",
   "nombres_vistos": [
    "Low Volatility Anomaly"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    270
   ],
   "definiciones": [
    {
     "texto": "Acciones de baja volatilidad mantienen relaciones de precio más estables y generan mejor performance en pairs trading.",
     "doc_id": 270
    }
   ],
   "citas": [
    {
     "texto": "The pairs-relation is not stable enough... a much simpler and also better working approach is to rely on the selection process of the ETF",
     "doc_id": 270
    }
   ],
   "relaciones_crudas": [
