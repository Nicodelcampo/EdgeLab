   "definiciones": [
    {
     "texto": "Aproximación basada en resultados de López y Sinusía (2004) donde procesos de llegada de órdenes desbalanceados (con drift) convergen a procesos de convección-difusión en el límite de alta frecuencia de órdenes.",
     "doc_id": 260
    }
   ],
   "citas": [
    {
     "texto": "heavy-traffic approximations of more general imbalanced (drifting) arrival processes with and without correlation",
     "doc_id": 260
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Central Limit Theorem",
     "doc_id": 260,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Imbalanced Order Flow",
     "doc_id": 260,
     "revisar": false
    }
   ]
  },
  {
   "id": "limit vs market order execution trade off",
   "nombre_canonico": "Limit vs Market Order Execution Trade-Off",
   "tipo": "concepto",
   "nombres_vistos": [
    "Limit vs Market Order Execution Trade-Off"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    260
   ],
   "definiciones": [
    {
     "texto": "Bajo market orders, las comisiones de BitMEX (0.075% taker fee) eliminan los beneficios del clasificador. Usando limit orders para salir (maker rebate de -0.025%), el trader obtiene beneficio neto, pero enfrenta riesgo de ejecución.",
     "doc_id": 260
    }
   ],
   "citas": [
    {
     "texto": "If we include transaction costs for market orders, the paid commission unfortunately more than offsets the obtained profits. When we assume the exit trades can be carried out using limit orders, a trader can earn commission rebates and still make profits",
     "doc_id": 260
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Execution Risk Management",
     "doc_id": 260,
     "revisar": false
    }
   ]
  },
  {
   "id": "functional central limit theorem for lob",
   "nombre_canonico": "Functional Central Limit Theorem for LOB",
   "tipo": "metodo",
   "nombres_vistos": [
    "Functional Central Limit Theorem for LOB"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    262
   ],
   "definiciones": [
    {
     "texto": "Teorema que establece que, en el límite de heavy traffic (alta frecuencia de órdenes), el proceso de colas del LOB converge a una difusión Markoviana con deriva y volatilidad determinadas por momentos del order flow.",
     "doc_id": 262
    }
   ],
   "citas": [
    {
     "texto": "we derive a functional central limit theorem for the joint dynamics of the bid and ask queues",
     "doc_id": 262
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Heavy Traffic Limit",
     "doc_id": 262,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Queueing Systems",
     "doc_id": 262,
     "revisar": false
    }
   ]
  },
  {
   "id": "jump diffusion approximation heavy traffic limit",
   "nombre_canonico": "Jump-Diffusion Approximation (Heavy Traffic Limit)",
   "tipo": "metodo",
   "nombres_vistos": [
    "Jump-Diffusion Approximation (Heavy Traffic Limit)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    262
   ],
   "definiciones": [
    {
     "texto": "Aproximación donde el LOB se modela como un proceso de salto-difusión en el ortante positivo R²₊, con deriva (tendencia neta de order flow) y volatilidad (variabilidad del order flow) derivadas de las propiedades estadísticas de las órdenes entrantes.",
     "doc_id": 262
    }
   ],
   "citas": [
    {
     "texto": "the intraday dynamics of the limit order book may be approximated by a Markovian jump-diffusion process in the positive orthant, whose characteristics are explicitly described in terms of the statistical properties of the underlying order flow",
     "doc_id": 262
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "LOB Continuum Limit",
     "doc_id": 262,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Separation of Time Scales",
     "doc_id": 262,
     "revisar": false
    }
   ]
  },
  {
   "id": "separation of time scale",
   "nombre_canonico": "Separation of Time Scales",
   "tipo": "concepto",
   "nombres_vistos": [
    "Separation of Time Scales"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    262
   ],
   "definiciones": [
    {
     "texto": "Argumento central: la escala de tiempo de eventos de microestructura (~1-10ms) es órdenes de magnitud menor que la escala de interés para trading (~1-100s), justificando la aproximación asintótica por difusión.",
     "doc_id": 262
    }
   ],
   "citas": [
    {
     "texto": "it is relevant to consider heavy-traffic limits in which the rate of arrival of orders is large for studying the dynamics of order books in liquid markets",
     "doc_id": 262
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Heavy Traffic Limit",
     "doc_id": 262,
     "revisar": false
    },
    {
     "tipo": "EXPLICA",
     "tipo_original": "EXPLICA",
     "objeto_texto": "Diffusion Approximation Validity",
     "doc_id": 262,
     "revisar": true
    }
   ]
  },
  {
   "id": "probability of price increase conditional on lob state",
   "nombre_canonico": "Probability of Price Increase (Conditional on LOB State)",
   "tipo": "metrica",
   "nombres_vistos": [
    "Probability of Price Increase (Conditional on LOB State)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    262
   ],
   "definiciones": [
    {
     "texto": "Probabilidad de que el próximo movimiento de precio sea al alza, condicionada al estado actual de las colas bid y ask. Se deriva analíticamente de la aproximación de difusión.",
     "doc_id": 262
    }
   ],
   "citas": [
    {
     "texto": "tractable analytical approximations for various quantities of interest, such as the probability of a price increase or the distribution of the duration until the next price move",
     "doc_id": 262
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Diffusion Approximation",
     "doc_id": 262,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Price Dynamics in Heavy Traffic",
     "doc_id": 262,
     "revisar": false
    }
   ]
  },
  {
   "id": "reduced form lob representation",
   "nombre_canonico": "Reduced-Form LOB Representation",
   "tipo": "concepto",
   "nombres_vistos": [
    "Reduced-Form LOB Representation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    262
   ],
   "definiciones": [
    {
     "texto": "Representación simplificada del LOB que solo considera los volúmenes en el mejor bid y ask, tratando las llegadas de órdenes como procesos puntuales con propiedades estadísticas generales (no necesariamente Poisson).",
     "doc_id": 262
    }
   ],
   "citas": [
    {
     "texto": "A reduced-form representation of a limit order book",
     "doc_id": 262
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Poisson LOB Models",
     "doc_id": 262,
     "revisar": false
    },
    {
     "tipo": "INCORPORA",
     "tipo_original": "INCORPORA",
     "objeto_texto": "Non-Poisson Order Flow",
     "doc_id": 262,
     "revisar": true
    }
   ]
  },
  {
   "id": "wentzell boundary condition",
   "nombre_canonico": "Wentzell Boundary Conditions",
   "tipo": "metodo",
   "nombres_vistos": [
    "Wentzell Boundary Conditions"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    262
   ],
   "definiciones": [
    {
     "texto": "Condiciones de frontera integro-diferenciales que describen cómo el proceso de difusión del LOB salta al interior del ortante cuando una de las colas se vacía (cambio de precio), preservando la propiedad de Feller del semigrupo.",
     "doc_id": 262
    }
   ],
   "citas": [
    {
     "texto": "This is a Wentzell boundary condition which corresponds to a jump to the interior whenever the process reaches the boundary of the quadrant",
     "doc_id": 262
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Markovian Limit Process",
     "doc_id": 262,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Feller Semigroup",
     "doc_id": 262,
     "revisar": false
    }
   ]
  },
  {
   "id": "non poisson order flow robustness",
   "nombre_canonico": "Non-Poisson Order Flow Robustness",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Non-Poisson Order Flow Robustness"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    262
   ],
   "definiciones": [
    {
     "texto": "Los resultados de la aproximación de difusión son robustos a desviaciones de los supuestos Poisson (dependencia temporal, heterogeneidad de tamaños, autocorrelación de duraciones), superando una limitación clave de modelos Markovianos previos.",
     "doc_id": 262
    }
   ],
   "citas": [
    {
     "texto": "it is indeed possible to restore analytical tractability without imposing restrictive assumptions on the order arrival process, by exploiting the separation of time scales involved in the problem",
     "doc_id": 262
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Cont-Stoikov-Talreja (2010) Model",
     "doc_id": 262,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Self-Exciting Point Processes",
     "doc_id": 262,
     "revisar": false
    }
   ]
  },
  {
   "id": "liquidity fluctuation liquidity well",
   "nombre_canonico": "Liquidity Fluctuations (Liquidity Wells)",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Liquidity Fluctuations (Liquidity Wells)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    263
   ],
   "definiciones": [
    {
     "texto": "Disminuciones severas e intermitentes en la capacidad del LOB para absorber market orders, causando aumentos del spread, tendencias locales de precios y eventos extremos como flash crashes.",
     "doc_id": 263
    }
   ],
   "citas": [
    {
     "texto": "severe intermittencies in liquidity affect the order book dynamics... significant and intermittent decreases in the OB's ability to absorb market orders",
     "doc_id": 263
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
