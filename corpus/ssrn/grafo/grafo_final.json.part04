   "tipo": "fenomeno",
   "nombres_vistos": [
    "Sentiment Trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    297
   ],
   "definiciones": [
    {
     "texto": "Demanda agregada de traders no estratégicos correlacionada parcialmente con las innovaciones del valor del activo (parámetro ρ). Combina un componente informativo (correlacionado con dvt) y un componente de ruido puro. No se modela su origen sino su efecto en el equilibrio.",
     "doc_id": 297
    }
   ],
   "citas": [
    {
     "texto": "The sentiment traders' demand for the risky asset consists of two parts. One part... is correlated with the gradually released information on the value of the risky asset, whereas the second part... is not.",
     "doc_id": 297
    }
   ],
