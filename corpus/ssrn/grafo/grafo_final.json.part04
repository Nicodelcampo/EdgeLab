   "doc_ids": [
    265
   ],
   "definiciones": [
    {
     "texto": "Técnica para construir series continuas de futuros: se usa el contrato más cercano al vencimiento y se rota al siguiente contrato 5 días antes del vencimiento, evitando efectos de baja liquidez en el período de entrega.",
     "doc_id": 265
    }
   ],
   "citas": [
    {
     "texto": "The closest-to-maturity contract is 'rolled over' into the second-closest-to-maturity contract five trading days before the expiration date",
     "doc_id": 265
