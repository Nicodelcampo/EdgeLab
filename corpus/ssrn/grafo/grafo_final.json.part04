  {
   "id": "spread entry band",
   "nombre_canonico": "Spread Entry Bands",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Spread Entry Bands"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    270
   ],
   "definiciones": [
    {
     "texto": "Entrada entre 2σ y 4σ del spread; stop-loss si supera 8σ; cierre forzado a los 30 días si no hay convergencia.",
     "doc_id": 270
    }
   ],
   "citas": [
    {
     "texto": "A position is only opened, if the spread is between 2 and 4 standard deviations",
     "doc_id": 270
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Pairs Trading",
