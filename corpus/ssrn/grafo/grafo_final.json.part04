  {
   "id": "market order as deterministic processe",
   "nombre_canonico": "Market Orders as Deterministic Processes",
   "tipo": "concepto",
   "nombres_vistos": [
    "Market Orders as Deterministic Processes"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    255
   ],
   "definiciones": [
    {
     "texto": "A diferencia de las limit orders (modeladas como procesos puntuales estocásticos), las market orders se ejecutan con 100% de probabilidad y se modelan como función Heaviside cuyo generador infinitesimal es una delta de Dirac: q̇_t = (M₁-M₂)δ(t-t_+).",
     "doc_id": 255
    }
   ],
   "citas": [
    {
     "texto": "Market orders are deterministic process in contrast to limit orders that are often modeled as stochastic point processes",
     "doc_id": 255
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
