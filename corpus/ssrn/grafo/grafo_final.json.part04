     "tipo_original": "MEJORA_A",
     "objeto_texto": "Numerical HJB Solution",
     "doc_id": 253,
     "revisar": false
    }
   ]
  },
  {
   "id": "free boundarie buying selling",
   "nombre_canonico": "Free Boundaries (Buying/Selling)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Free Boundaries (Buying/Selling)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    253
   ],
   "definiciones": [
    {
     "texto": "Fronteras dependientes de tiempo y spread que definen la región de no-trading. El agente compra (vende) cuando la posición alcanza la frontera de compra (venta) para mantener la posición dentro de la región óptima.",
     "doc_id": 253
    }
   ],
   "citas": [
    {
     "texto": "the associated free boundaries can be expressed as functions of time and the spread",
     "doc_id": 253
    }
   ],
   "relaciones_crudas": [
