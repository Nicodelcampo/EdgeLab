  {
   "id": "first passage time statistical arbitrage",
   "nombre_canonico": "First-Passage Time (Statistical Arbitrage)",
   "tipo": "metrica",
   "nombres_vistos": [
    "First-Passage Time (Statistical Arbitrage)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    254
   ],
   "definiciones": [
    {
     "texto": "Tiempo que tarda el spread en ir de un nivel de entrada 'a' a uno de salida 'm' (o viceversa). Bajo Lévy estable, E[T1] ∝ a^{α_L} donde α_L es el parámetro de estabilidad de la distribución.",
     "doc_id": 254
    }
   ],
   "citas": [
    {
     "texto": "The first-passage time T1 has a distribution related to the inverse of a Lévy stable distribution",
     "doc_id": 254
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Renewal Theory",
     "doc_id": 254,
     "revisar": false
    },
    {
     "tipo": "CALCULA",
     "tipo_original": "CALCULA",
     "objeto_texto": "Expected Return per Trade",
     "doc_id": 254,
     "revisar": true
    }
   ]
  },
  {
   "id": "symmetry of optimal entry exit",
   "nombre_canonico": "Symmetry of Optimal Entry/Exit",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Symmetry of Optimal Entry/Exit"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    254
   ],
   "definiciones": [
    {
     "texto": "Resultado clave: bajo distribuciones Lévy estables (con media cero), los niveles óptimos de entrada y salida son simétricos (m = -a), generalizando el hallazgo de Bertram (2010) para el caso Gaussiano.",
     "doc_id": 254
    }
   ],
   "citas": [
    {
     "texto": "we confirm that optimal entry and exit points lie symmetrically around the mean, consistent with previous Gaussian-based findings",
     "doc_id": 254
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "Bertram (2010) Symmetry Result",
     "doc_id": 254,
