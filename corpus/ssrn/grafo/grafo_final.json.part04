     "doc_id": 254,
     "revisar": false
    }
   ]
  },
  {
   "id": "stationary process transformation",
   "nombre_canonico": "Stationary Process Transformation",
   "tipo": "metodo",
   "nombres_vistos": [
    "Stationary Process Transformation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    254
   ],
   "definiciones": [
    {
     "texto": "Técnica que transforma un proceso OU no estacionario con media variable µ(t) en uno estacionario Zt mediante desviaciones ortogonales: Zt = Yt + f(t) donde f(t) compensa la variación temporal de la media.",
     "doc_id": 254
    }
   ],
   "citas": [
    {
     "texto": "we can use orthogonal deviations to construct a generalized OU process with stationary mean from one with a time varying mean",
     "doc_id": 254
    }
   ],
   "relaciones_crudas": [
