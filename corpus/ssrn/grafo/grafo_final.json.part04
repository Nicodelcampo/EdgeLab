  {
   "id": "sobol sequence",
   "nombre_canonico": "Sobol Sequence",
   "tipo": "metodo",
   "nombres_vistos": [
    "Sobol Sequence"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    295
   ],
   "definiciones": [
    {
     "texto": "Secuencia de muestreo determinístico construida a partir de Van Der Corput en forma binaria con polinomios primitivos. Converge más rápido que MATLAB, Halton y Faure en altas dimensiones y mantiene eficiencia computacional en problemas multidimensionales.",
     "doc_id": 295
    }
   ],
   "citas": [
    {
     "texto": "Sobol sequencing might be a better method to implement in the Monte Carlo simulation [for computational efficiency and faster convergence].",
     "doc_id": 295
    }
   ],
   "relaciones_crudas": [
