    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "System Imbalance",
     "doc_id": 313,
     "revisar": false
    }
   ]
  },
  {
   "id": "single vs dual price settlement",
   "nombre_canonico": "Single vs Dual Price Settlement",
   "tipo": "concepto",
   "nombres_vistos": [
    "Single vs Dual Price Settlement"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    313
   ],
   "definiciones": [
    {
     "texto": "Single price: un solo precio de liquidación para desbalances. Dual price: precios distintos para compra y venta del operador. Dual price desincentiva el imbalancing oportunista porque siempre es mejor transar en forward; single price es precondición para el arbitraje estadístico en balancing.",
     "doc_id": 313
    }
   ],
   "citas": [
    {
     "texto": "The first pre-condition to attract this statistical arbitrage is evidently a single price settlement process.",
     "doc_id": 313
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
