  {
   "id": "hybrid gfrp timber laminate",
   "nombre_canonico": "Hybrid GFRP-Timber Laminate",
   "tipo": "concepto",
   "nombres_vistos": [
    "Hybrid GFRP-Timber Laminate"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    231
   ],
   "definiciones": [
    {
     "texto": "Material compuesto laminado de bajo carbono que combina chapas de madera (timber veneers) con láminas de polímero reforzado con fibra de vidrio (GFRP), donde las fibras se orientan perpendicularmente a la dirección de la veta de la madera. Usado en miembros estructurales de pared delgada como alternativa sostenible al acero y aluminio.",
     "doc_id": 231
    }
   ],
   "citas": [
    {
     "texto": "Hybrid glass fibre reinforced polymer (GFRP)-timber (HFT) laminated thin-walled structural members are a new low carbon composite technology.",
     "doc_id": 231
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "finite element modelling fem",
   "nombre_canonico": "Finite Element Modelling (FEM)",
   "tipo": "metodo",
   "nombres_vistos": [
    "Finite Element Modelling (FEM)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    231
   ],
   "definiciones": [
    {
     "texto": "Técnica de simulación numérica implementada en ABAQUS/Explicit mediante subrutina VUMAT para modelar el comportamiento constitutivo de laminados HFT bajo cargas biaxiales de tracción-tracción.",
     "doc_id": 231
    }
   ],
   "citas": [
    {
     "texto": "The new failure theory was implemented in finite element (FE) software ABAQUS using a vectorized user material subroutine (VUMAT).",
     "doc_id": 231
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "false positive keyword hft",
   "nombre_canonico": "False Positive Keyword: HFT",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "False Positive Keyword: HFT"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    231
   ],
   "definiciones": [
    {
     "texto": "La sigla HFT en este contexto significa 'Hybrid Fibre-reinforced polymer and Timber', no 'High-Frequency Trading'. Es un paper de ingeniería de materiales/estructuras sin ninguna aplicabilidad financiera.",
     "doc_id": 231
    }
   ],
   "citas": [
    {
     "texto": "Hybrid glass fibre-reinforced polymer and timber (HFT) laminates and a new failure theory.",
     "doc_id": 231
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "flash crash may 6 2010",
   "nombre_canonico": "Flash Crash (May 6, 2010)",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Flash Crash (May 6, 2010)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    232
   ],
   "definiciones": [
    {
     "texto": "Evento donde el Dow Jones perdió casi el 10% en 36 minutos recuperándose inmediatamente. Investigaciones del CFTC concluyeron que HFTs no lo causaron pero contribuyeron demandando inmediatez; el trader Navinder Sarao fue arrestado en 2015 por manipulación vía spoofing.",
     "doc_id": 232
    }
   ],
   "citas": [
    {
     "texto": "In the space of just 36 minutes the Dow Jones Index lost almost a tenth of its value, only to rebound immediately as though nothing had happened. This event is commonly referred to as the 'flash crash'.",
     "doc_id": 232
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "MiFID II regulation",
     "doc_id": 232,
     "revisar": false
    },
    {
     "tipo": "ASOCIADO_CON",
     "tipo_original": "ASOCIADO_CON",
     "objeto_texto": "Spoofing",
     "doc_id": 232,
     "revisar": true
    }
   ]
  },
  {
   "id": "ghost liquidity",
   "nombre_canonico": "Ghost Liquidity",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Ghost Liquidity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    232
   ],
   "definiciones": [
    {
     "texto": "Liquidez aparente creada por órdenes HFT que desaparecen tan pronto como se ejecutan en una pata de un arbitraje, creando la ilusión de mayor profundidad del libro y dificultando la evaluación de la liquidez real.",
     "doc_id": 232
    }
   ],
   "citas": [
    {
     "texto": "HFT can lead to what is known as ghost liquidity ... the liquidity previously shown completely disappears as soon as the relevant orders of the arbitrage trade have been executed on one of the trading venues.",
     "doc_id": 232
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "HFT arbitrage strategies",
     "doc_id": 232,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "market transparency",
     "doc_id": 232,
     "revisar": false
    }
   ]
  },
  {
   "id": "direct electronic access dea",
   "nombre_canonico": "Direct Electronic Access (DEA)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Direct Electronic Access (DEA)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    232
   ],
   "definiciones": [
    {
     "texto": "Acceso electrónico directo que permite a clientes de una firma de inversión 'ponerse detrás de los controles' y enviar órdenes al mercado sin intermediación activa del broker. Sujeto a requisitos específicos de sistemas y controles de riesgo bajo MiFID II.",
     "doc_id": 232
    }
   ],
   "citas": [
    {
     "texto": "Providers of DEA are now required to ensure that this access complies with the appropriate systems and risk controls.",
     "doc_id": 232
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "MiFID II",
     "doc_id": 232,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "risk controls",
     "doc_id": 232,
     "revisar": false
    }
   ]
  },
  {
   "id": "market abuse regulation mar",
   "nombre_canonico": "Market Abuse Regulation (MAR)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Market Abuse Regulation (MAR)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    232
   ],
   "definiciones": [
    {
     "texto": "Regulación europea (Reg. 596/2014) que prohíbe explícitamente estrategias de manipulación de mercado como spoofing, incluyendo la colocación de grandes volúmenes de órdenes sin intención de ejecución que perturben el sistema de trading.",
     "doc_id": 232
    }
   ],
   "citas": [
    {
     "texto": "MAR prohibits a number of strategies carried out by algorithmic trading, in particular high frequency trading, which are not intended to result in the actual execution of a transaction.",
     "doc_id": 232
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "Spoofing",
     "doc_id": 232,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "MiFID II framework",
     "doc_id": 232,
     "revisar": false
    }
   ]
  },
  {
   "id": "van kervel and menkveld study on hft impact",
   "nombre_canonico": "Van Kervel and Menkveld Study on HFT Impact",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Van Kervel and Menkveld Study on HFT Impact"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    232
   ],
   "definiciones": [
    {
     "texto": "Estudio que muestra que HFTs se benefician principalmente de inversores institucionales que ejecutan órdenes grandes en períodos largos, haciendo que el costo de ejecución aumente hasta un 64% al 'ir con la orden' (front-running pasivo).",
     "doc_id": 232
    }
   ],
   "citas": [
    {
     "texto": "Van Kervel and Menkveld indicates that flash traders benefit mainly from institutional investors that take a long time to execute their order ... the execution of an order can become up to 64% more expensive.",
     "doc_id": 232
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "higher execution costs for institutional investors",
     "doc_id": 232,
     "revisar": false
    }
   ]
  },
  {
   "id": "microstructural pulse dislocation mpd",
   "nombre_canonico": "Microstructural Pulse Dislocation (MPD)",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Microstructural Pulse Dislocation (MPD)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    233
   ],
   "definiciones": [
    {
     "texto": "Secuencia segmentada de pulsos direccionales de precio dentro del primer segundo tras un shock informativo programado, reflejando la activación en capas de algoritmos de lectura de noticias, ejecución y gestión de riesgo.",
     "doc_id": 233
    }
   ],
   "citas": [
    {
     "texto": "A segmented sequence of directional price pulses within the first second after a scheduled information shock, reflecting the layered activation of news-reading, execution and risk-management algorithms.",
     "doc_id": 233
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Event-Driven Microstructure Collapse",
     "doc_id": 233,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "first-second microstructure regime",
     "doc_id": 233,
     "revisar": false
    }
   ]
  },
  {
   "id": "event driven microstructure collapse emc",
   "nombre_canonico": "Event-Driven Microstructure Collapse (EMC)",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Event-Driven Microstructure Collapse (EMC)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    233
   ],
   "definiciones": [
    {
     "texto": "Evaporación rápida y reformación asimétrica de la profundidad del libro de órdenes (top-of-book) y ampliación de spreads que acompaña y amplifica los pulsos MPD, permitiendo al precio recorrer grandes distancias con poco volumen.",
     "doc_id": 233
    }
   ],
   "citas": [
    {
     "texto": "A rapid, event-local collapse and reformation of top-of-book depth and spreads, through which price can travel long distances with relatively little volume.",
     "doc_id": 233
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "large price dislocations",
     "doc_id": 233,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Microstructural Pulse Dislocation",
     "doc_id": 233,
     "revisar": false
    }
   ]
  },
  {
   "id": "first second reaction window",
   "nombre_canonico": "First-Second Reaction Window",
   "tipo": "concepto",
   "nombres_vistos": [
    "First-Second Reaction Window"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    233
   ],
   "definiciones": [
    {
     "texto": "Intervalo W = [t0, t0+1s] donde t0 es el timestamp del anuncio. Propuesto como un régimen microestructural distinto con sus propias leyes, no reducible a ruido ni promediable en ventanas más largas.",
     "doc_id": 233
    }
   ],
   "citas": [
    {
     "texto": "The first second after a scheduled event is not the chaotic blur it is often assumed to be. Instead, it is a structured environment governed by the design of news-reading algorithms and the microstructural physics of order-book collapse.",
     "doc_id": 233
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Microstructural Pulse Dislocation",
     "doc_id": 233,
