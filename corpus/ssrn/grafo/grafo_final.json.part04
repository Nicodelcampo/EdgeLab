   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    259
   ],
   "definiciones": [
    {
     "texto": "Clasificación de órdenes como agresivas si su volumen excede el cuantil 75%: market orders que exceden el volumen en el primer nivel opuesto son agresivas; limit orders y cancelaciones con volumen alto también se consideran agresivas.",
     "doc_id": 259
    }
   ],
   "citas": [
    {
     "texto": "These are market orders whose posted volume exceeds the standing volume on the first level of the opposite queue and whose volume is equal or higher than the 75%-quantile of all order volumes",
     "doc_id": 259
    }
   ],
