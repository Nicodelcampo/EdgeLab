   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    246
   ],
   "definiciones": [
    {
     "texto": "Ratio entre las pendientes de las funciones de price impact de los lados ask y bid del LOB. Un imbalance positivo (mayor pendiente ask) genera presión compradora de limit orders y skewness positivo en retornos.",
     "doc_id": 246
    }
   ],
   "citas": [
