     "tipo_original": "MIDE",
     "objeto_texto": "Risk-Adjusted Performance",
     "doc_id": 294,
     "revisar": false
    }
   ]
  },
  {
   "id": "outlier removal in clustering",
   "nombre_canonico": "Outlier Removal in Clustering",
   "tipo": "metodo",
   "nombres_vistos": [
    "Outlier Removal in Clustering"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    294
   ],
   "definiciones": [
    {
     "texto": "Procedimiento para k-means: se mide distancia al centroide y distancia al vecino más cercano. Se usa la distancia al vecino en el percentil α=0.5 como umbral; cualquier stock con distancia al centroide mayor que ese umbral es outlier.",
     "doc_id": 294
    }
   ],
   "citas": [
    {
     "texto": "Any stock whose distance to its centroid is greater than ϵ is regarded as an outlier and removed. We set α = 0.5.",
     "doc_id": 294
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "k-Means Clustering",
     "doc_id": 294,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Cluster Contamination",
     "doc_id": 294,
     "revisar": false
    }
   ]
  },
  {
   "id": "experimental design",
   "nombre_canonico": "Experimental Design",
   "tipo": "metodo",
   "nombres_vistos": [
    "Experimental Design"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    295
   ],
   "definiciones": [
    {
     "texto": "Diseño de investigación con cuatro componentes: comparación, manipulación, control y generalización. Es el método más potente para establecer causalidad pero puede comprometer la validez externa. Incluye cinco tipos: experimentación controlada, Solomon four-group, post-test-only, efectos temporales y diseño factorial.",
     "doc_id": 295
    }
   ],
   "citas": [
    {
     "texto": "Controlled experimentation is the strongest method of establishing causation but external validity can be compromised.",
     "doc_id": 295
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Random Assignment",
     "doc_id": 295,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Control Group",
     "doc_id": 295,
     "revisar": false
    }
   ]
  },
  {
   "id": "cross sectional design",
   "nombre_canonico": "Cross-Sectional Design",
   "tipo": "metodo",
   "nombres_vistos": [
    "Cross-Sectional Design"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    295
   ],
   "definiciones": [
    {
     "texto": "Diseño basado en encuestas donde se recolectan datos de una muestra aleatoria en un punto del tiempo. Menos potente que el experimental porque no permite comparaciones antes-después. Útil en finanzas conductuales pero inadecuado para finanzas cuantitativas puras.",
     "doc_id": 295
    }
   ],
   "citas": [
    {
     "texto": "Cross-section designs are not as powerful of a research tool as traditional experimental designs because before-and-after comparisons are not possible.",
     "doc_id": 295
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Survey Research",
