     "tipo_original": "USA",
     "objeto_texto": "High-Frequency Pairs Trading",
     "doc_id": 252,
     "revisar": false
    }
   ]
  },
  {
   "id": "one way arbitrage",
   "nombre_canonico": "One-Way Arbitrage",
   "tipo": "concepto",
   "nombres_vistos": [
    "One-Way Arbitrage"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    252
   ],
   "definiciones": [
    {
     "texto": "Concepto de Deardorff (1979): el arbitraje puede realizarse con una sola operación direccional (no round-trip) si el precio de un activo está lo suficientemente desalineado, explicando por qué el volumen de single-sided trades puede superar al de round-trip trades.",
     "doc_id": 252
    }
   ],
   "citas": [
    {
     "texto": "the single-sided trades being more important in enforcing the prices than round-trip arbitrage trades, a concept described earlier by Deardorff (1979) as 'one-way arbitrage'",
     "doc_id": 252
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
