   "tipo": "dato",
   "nombres_vistos": [
    "Short-Spread (ECM Residuals)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    247
   ],
   "definiciones": [
    {
     "texto": "Serie temporal construida como ΔX_{2,t} - αΔX_{1,t} + λ·ecm_{t-1} que captura desviaciones de corto plazo del equilibrio. El ECM usa la distribución de sus residuos vt para generar señales de trading.",
     "doc_id": 247
    }
   ],
   "citas": [
    {
     "texto": "the spread in the ECM method relates to the distribution of residuals in ECM",
