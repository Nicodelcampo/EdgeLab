    "Workload (W)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    287
   ],
   "definiciones": [
    {
     "texto": "Suma ponderada de colas W=sum(beta_i*Q_i) donde beta_i captura atractividad del exchange; estadistico suficiente para expected delays en equilibrio.",
     "doc_id": 287
    }
   ],
   "citas": [
    {
     "texto": "the workload is a sufficient statistic that summarizes the state of the market",
     "doc_id": 287
    }
   ],
