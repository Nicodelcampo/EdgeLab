  {
   "id": "continuou semimartingale price",
   "nombre_canonico": "Continuous Semimartingale Price",
   "tipo": "concepto",
   "nombres_vistos": [
    "Continuous Semimartingale Price"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    229
   ],
   "definiciones": [
    {
     "texto": "Modelo del precio X como semimartingala continua cuadrado-integrable X ∈ S²(P, F) que permite representar VWAP como integral de Itô con integrando ξV,G = 1−Yt−.",
     "doc_id": 229
    }
   ],
   "citas": [
    {
     "texto": "The price process X is assumed to be a F continuous square integrable semimartingale X ∈ S²(P, F).",
     "doc_id": 229
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
