  {
   "id": "comparison continuou rebalancing vs optimal switching",
   "nombre_canonico": "Comparison: Continuous Rebalancing vs Optimal Switching",
   "tipo": "concepto",
   "nombres_vistos": [
    "Comparison: Continuous Rebalancing vs Optimal Switching"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    253
   ],
   "definiciones": [
    {
     "texto": "Taxonomía de enfoques de pairs trading óptimo: (i) modelos de rebalanceo continuo que ignoran costes de transacción, (ii) modelos de switching óptimo con costes pero con tamaño fijo de trade. Este paper unifica ambas limitaciones.",
     "doc_id": 253
    }
   ],
   "citas": [
    {
     "texto": "we overcome the drawbacks of continuous rebalancing models which neglect transaction costs... and optimal switching models which impose fixed transaction shares",
     "doc_id": 253
    }
   ],
   "relaciones_crudas": [
