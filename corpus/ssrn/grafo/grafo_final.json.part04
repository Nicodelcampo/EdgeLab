   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    275
   ],
   "definiciones": [
    {
     "texto": "Pares con alta (baja) correlacion tienden a experimentar disminuciones (aumentos) de correlacion entre periodos.",
     "doc_id": 275
    }
   ],
   "citas": [
    {
     "texto": "correlation decreases are more likely for pairs with a currently high correlation",
