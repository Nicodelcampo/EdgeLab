   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    245
   ],
   "definiciones": [
    {
     "texto": "Estado donde todos los osciladores convergen a la misma frecuencia (derivadas de fase iguales asintóticamente). En sistemas de potencia, esto significa estabilidad de frecuencia de red.",
     "doc_id": 245
    }
   ],
   "citas": [
    {
     "texto": "the third-order model exhibits a frequency synchronization and the derivatives of amplitudes converge to zero",
     "doc_id": 245
    }
   ],
   "relaciones_crudas": []
  },
