  {
   "id": "unit root testing",
   "nombre_canonico": "Unit Root Testing",
   "tipo": "metodo",
   "nombres_vistos": [
    "Unit Root Testing"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    295
   ],
   "definiciones": [
    {
     "texto": "Prueba de raíz unitaria (Dickey-Fuller simple y aumentado) para determinar si una serie temporal es estacionaria o tiene deriva (random walk con o sin drift). Si ρ=1 y α=0 la serie es random walk sin drift; con α≠0 es random walk con drift.",
     "doc_id": 295
    }
   ],
   "citas": [
    {
     "texto": "If α=0 and ρ=1 then the time series is a random walk without drift, but when α≠0 and ρ=1 the time series is a random walk with drift.",
     "doc_id": 295
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Augmented Dickey-Fuller Test",
     "doc_id": 295,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Time Series Stationarity",
     "doc_id": 295,
     "revisar": false
    }
   ]
  },
  {
   "id": "quasi experimental design",
   "nombre_canonico": "Quasi-Experimental Design",
   "tipo": "metodo",
   "nombres_vistos": [
    "Quasi-Experimental Design"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    295
   ],
   "definiciones": [
    {
     "texto": "Diseño que permite selección aleatoria de la población pero no asignación aleatoria a grupos de comparación, reduciendo la validez interna. Incluye cuatro tipos: contrasted-groups, planned variation, panels/time-series y control-series.",
     "doc_id": 295
    }
   ],
   "citas": [
    {
     "texto": "A quasi-experimental design allows for random selection from the population but does not require the random assignment to comparison groups, reducing the internal validity compared to classical experimental designs.",
     "doc_id": 295
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
