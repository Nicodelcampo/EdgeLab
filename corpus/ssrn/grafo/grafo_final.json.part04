   "doc_ids": [
    256
   ],
   "definiciones": [
    {
     "texto": "Función de utilidad con aversión absoluta al riesgo constante (Constant Absolute Risk Aversion) usada para incorporar preferencias de riesgo directamente en el objetivo de ejecución, transformando el problema en control risk-sensitive.",
     "doc_id": 256
    }
   ],
   "citas": [
