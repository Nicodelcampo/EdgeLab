   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    272
   ],
   "definiciones": [
    {
     "texto": "Las implied volatilities son series estacionarias (ADF test rechaza raíz unitaria al 95%), permitiendo regresión OLS directa sin tests de cointegración.",
     "doc_id": 272
    }
   ],
   "citas": [
    {
     "texto": "using implied volatilities, which are stationary time series, allows correct measurement of their association via OLS regression without the need for further tests",
