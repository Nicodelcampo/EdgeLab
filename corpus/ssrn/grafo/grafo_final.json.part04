   "tipo": "metodo",
   "nombres_vistos": [
    "Statistical Portfolio"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    230
   ],
   "definiciones": [
    {
     "texto": "Combinación lineal de Brent y Dubai que replica el valor fair del WTI según la relación de cointegración. La diferencia entre el WTI observado y el valor del statistical portfolio constituye el mispricing.",
     "doc_id": 230
    }
   ],
   "citas": [
    {
     "texto": "A so-called statistical portfolio, composed by other two crude oils, Brent and Dubai.",
     "doc_id": 230
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Cointegration",
