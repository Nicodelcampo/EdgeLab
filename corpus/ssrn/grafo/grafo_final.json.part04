  {
   "id": "skorokhod problem",
   "nombre_canonico": "Skorokhod Problem",
   "tipo": "metodo",
   "nombres_vistos": [
    "Skorokhod Problem"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    253
   ],
   "definiciones": [
    {
     "texto": "Formulación matemática del control singular donde la posición se mantiene dentro de la región de no-trading mediante reflexión en las fronteras, transformando el problema de control en un problema de reflexión estocástica.",
     "doc_id": 253
    }
   ],
   "citas": [
    {
     "texto": "we reformulate the singular control problem as a Skorokhod problem, the solution of which yields a nearly optimal trading strategy",
     "doc_id": 253
    }
   ],
