   ],
   "definiciones": [
    {
     "texto": "Indicadores construidos a partir de la diferencia entre la distribución empírica de diferencias temporales entre trades y una distribución uniforme (que sería esperable bajo trading no relacionado). La magnitud de la desviación es el proxy de trading relacionado inferido.",
     "doc_id": 252
