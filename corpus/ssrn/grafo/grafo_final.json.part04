     "doc_id": 252,
     "revisar": true
    }
   ]
  },
  {
   "id": "merger arbitrage detection",
   "nombre_canonico": "Merger Arbitrage Detection",
   "tipo": "metodo",
   "nombres_vistos": [
    "Merger Arbitrage Detection"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    252
   ],
   "definiciones": [
    {
     "texto": "Aplicación de APTIs para encontrar pares involucrados en arbitraje de fusiones entre conjuntos masivos de pares formados por constituyentes de índices, demostrando que la metodología escala a grandes universos.",
     "doc_id": 252
    }
   ],
   "citas": [
    {
     "texto": "APTIs... are shown to be capable of finding securities involved in merger arbitrage and pairs trading from amongst massively large sets of security pairs",
     "doc_id": 252
    }
