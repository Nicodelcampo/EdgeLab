   "doc_ids": [
    247
   ],
   "definiciones": [
    {
     "texto": "β (coeficiente de cointegración) captura la elasticidad de largo plazo entre dos acciones; α (coeficiente ECM) captura la elasticidad de corto plazo. El ECM usa ambos simultáneamente.",
     "doc_id": 247
    }
   ],
   "citas": [
