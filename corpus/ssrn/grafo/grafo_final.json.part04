   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    275
   ],
   "definiciones": [
    {
     "texto": "El retorno por trade exitoso = 2sigma_hist + overshooting; sigma_hist depende positivamente de la volatilidad de cada accion y negativamente de su correlacion.",
     "doc_id": 275
    }
   ],
   "citas": [
    {
     "texto": "Return per natural trade = 2sigma_hist + overshooting",
     "doc_id": 275
    }
