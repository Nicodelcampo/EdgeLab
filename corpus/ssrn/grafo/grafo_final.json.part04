   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    235
   ],
   "definiciones": [
    {
     "texto": "Técnica no paramétrica que construye bandas de confianza simultáneas para funciones de implied volatility usando M-smoothing local lineal con remuestreo bootstrap de residuos, permitiendo evaluar si dos curvas IV son estadísticamente diferentes.",
     "doc_id": 235
    }
   ],
   "citas": [
    {
     "texto": "We construct bootstrap uniform confidence bands which allow for more flexible error analysis.",
     "doc_id": 235
    }
   ],
