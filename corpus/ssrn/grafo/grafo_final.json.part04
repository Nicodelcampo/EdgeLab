    }
   ]
  },
  {
   "id": "moving average reversion inferred strategy",
   "nombre_canonico": "Moving Average Reversion (Inferred Strategy)",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Moving Average Reversion (Inferred Strategy)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    252
   ],
   "definiciones": [
    {
     "texto": "Estrategia de trading inferida empíricamente que revierte el precio relativo a una media móvil de N trades en lugar de a la paridad de precios. Dominante en BHP Billiton con score 0.98 para media móvil de ~1,000 trades (~40 min).",
     "doc_id": 252
    }
   ],
   "citas": [
    {
     "texto": "The rejection of empirical evidence of a price equalisation strategy makes sense given the persistent 20% price difference, while the strong compatibility with the 40-minute moving average strategy suggests pairs trading is occurring on a high-frequency basis",
     "doc_id": 252
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
