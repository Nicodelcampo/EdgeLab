     "doc_id": 313,
     "revisar": false
    }
   ]
  },
  {
   "id": "robust cointegration test",
   "nombre_canonico": "Robust Cointegration Tests",
   "tipo": "metodo",
   "nombres_vistos": [
    "Robust Cointegration Tests"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    314
   ],
   "definiciones": [
    {
     "texto": "Dos tests alternativos al Engle-Granger: (1) rank-based usando regresión weighted-Wilcoxon; (2) least absolute deviation (LAD). Son robustos a violaciones de normalidad en series de precios de acciones, que típicamente tienen colas pesadas (Mandelbrot, 1963; Fama, 1965).",
     "doc_id": 314
    }
   ],
   "citas": [
    {
     "texto": "This paper develops two robust tests for cointegration by using rank-based and least absolute deviation regression to modify the seminal Engle-Granger test.",
     "doc_id": 314
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Engle-Granger Cointegration Test",
     "doc_id": 314,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Non-Normality of Returns",
     "doc_id": 314,
     "revisar": false
    }
   ]
  },
  {
   "id": "weighted wilcoxon rank based regression",
   "nombre_canonico": "Weighted Wilcoxon (Rank-Based) Regression",
   "tipo": "metodo",
   "nombres_vistos": [
    "Weighted Wilcoxon (Rank-Based) Regression"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    314
   ],
   "definiciones": [
    {
     "texto": "Regresión basada en rangos que reemplaza los valores observados por sus rangos, haciéndola robusta a outliers y distribuciones de cola pesada. En el contexto de cointegración, produce residuos cuya estacionariedad se testea con estadísticos modificados.",
     "doc_id": 314
    }
   ],
   "citas": [
    {
     "texto": "The rank-based cointegration test has superior qualities in that context, suggesting one application of this new statistical test.",
     "doc_id": 314
    }
   ],
   "relaciones_crudas": [
