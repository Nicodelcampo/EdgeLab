   "doc_ids": [
    272
   ],
   "definiciones": [
    {
     "texto": "La moneyness de las opciones al cierre (ITM/ATM/OTM) es el principal driver de los retornos de la estrategia, más que el time-to-maturity o períodos de crisis.",
     "doc_id": 272
    }
   ],
   "citas": [
    {
     "texto": "returns are instead mostly driven by the moneyness of the options traded",
     "doc_id": 272
    }
