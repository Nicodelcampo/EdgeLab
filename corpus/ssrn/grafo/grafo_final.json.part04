   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    247
   ],
   "definiciones": [
    {
     "texto": "Método de dos pasos: (1) identificar pares cointegrados con mínima suma de diferencias al cuadrado, (2) abrir posiciones cuando el spread normalizado excede ±2 desviaciones estándar de su media histórica, cerrando al retornar a cero.",
     "doc_id": 247
    }
   ],
   "citas": [
    {
     "texto": "I simultaneously open and close long and short positions when the normalized spread diverges beyond 2",
     "doc_id": 247
