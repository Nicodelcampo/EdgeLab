     "objeto_texto": "Experimental Design",
     "doc_id": 295,
     "revisar": false
    }
   ]
  },
  {
   "id": "simultaneou equation model sem",
   "nombre_canonico": "Simultaneous Equation Models (SEM)",
   "tipo": "metodo",
   "nombres_vistos": [
    "Simultaneous Equation Models (SEM)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    295
   ],
   "definiciones": [
    {
     "texto": "Sistema de ecuaciones donde variables dependientes de una ecuación aparecen como explicativas en otra. Requiere condiciones de identificación (orden y rango) y exclusion restrictions. Esencial para modelar sistemas económicos complejos con endogeneidad.",
     "doc_id": 295
    }
   ],
   "citas": [
    {
     "texto": "Simultaneous equation models (SEM) are important in understanding complex dynamic systems.",
     "doc_id": 295
    }
   ],
   "relaciones_crudas": [
