     "doc_id": 245
    }
   ],
   "citas": [
    {
     "texto": "both systems indeed exhibit Lyapunov functions",
     "doc_id": 245
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "lob imbalance",
