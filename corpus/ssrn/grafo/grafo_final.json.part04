    272
   ],
   "definiciones": [
    {
     "texto": "Ventanas de 1 año de estimación seguidas de 6 meses de trading, desplazadas mensualmente generando 6 portafolios solapados.",
     "doc_id": 272
    }
   ],
   "citas": [
