   "tipo": "fenomeno",
   "nombres_vistos": [
    "Information Asymmetry in REITs"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    293
   ],
   "definiciones": [
    {
     "texto": "Los REITs tienen menor asimetría de información que acciones comunes debido a que los requisitos regulatorios de distribución de dividendos los obligan a levantar capital frecuentemente en mercados públicos, haciéndolos más transparentes.",
     "doc_id": 293
    }
   ],
   "citas": [
    {
     "texto": "The regulatory distribution requirements force REITs to frequently raise capital in the public markets, which makes REITs more transparent (having lower information asymmetry) as compared to non-REIT stocks.",
     "doc_id": 293
    }
   ],
