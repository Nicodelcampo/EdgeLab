   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    248
   ],
   "definiciones": [
    {
     "texto": "Método que selecciona pares minimizando la suma de diferencias al cuadrado entre series de precios normalizadas durante el período de formación, y abre posiciones cuando el spread excede 2 desviaciones estándar históricas.",
     "doc_id": 248
    }
   ],
   "citas": [
