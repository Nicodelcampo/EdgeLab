    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Event-Driven Microstructure Collapse",
     "doc_id": 233,
     "revisar": false
    }
   ]
  },
  {
   "id": "hedged event strategy",
   "nombre_canonico": "Hedged Event Strategy",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Hedged Event Strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    233
   ],
   "definiciones": [
    {
     "texto": "Estrategia simple que abre posiciones long y short simétricas antes del evento (straddle nocional) con stops y take-profits fijos, sin predecir dirección. Explota MPD y EMC para que la pierna sobreviviente genere ganancia neta consistente.",
     "doc_id": 233
    }
   ],
   "citas": [
    {
     "texto": "A symmetric hedged structure was deployed before each of several major NFP and CPI releases ... The net result was a sequence of gains in which the winning leg of the straddle consistently outweighed the losing leg.",
     "doc_id": 233
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Microstructural Pulse Dislocation",
     "doc_id": 233,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Event-Driven Microstructure Collapse",
     "doc_id": 233,
     "revisar": false
    }
   ]
  },
  {
   "id": "pulse atla",
   "nombre_canonico": "Pulse Atlas",
   "tipo": "metodo",
   "nombres_vistos": [
    "Pulse Atlas"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    233
   ],
   "definiciones": [
    {
     "texto": "Taxonomía de arquetipos de primer segundo que agrupa eventos según su estructura MPD/EMC: Single-Dominant Burst, Staircase Repricing, Vacuum Collapse, Clustered Earnings Pulses, Contested Interpretation.",
     "doc_id": 233
    }
   ],
   "citas": [
    {
     "texto": "The Pulse Atlas groups events into archetypes such as Single-Dominant Burst, Staircase Repricing, Vacuum Collapse, Clustered Earnings Pulses, and Contested Interpretation.",
     "doc_id": 233
    }
   ],
   "relaciones_crudas": [
