     "revisar": false
    }
   ]
  },
  {
   "id": "sharpe ratio optimization levy context",
   "nombre_canonico": "Sharpe Ratio Optimization (Lévy Context)",
   "tipo": "metodo",
   "nombres_vistos": [
    "Sharpe Ratio Optimization (Lévy Context)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    254
   ],
   "definiciones": [
    {
     "texto": "Optimización numérica del Sharpe ratio S(a, m, c) = (µ(a,m,c) - rf)/σ(a,m,c) bajo el proceso OU generalizado, incorporando la tasa libre de riesgo rf y el parámetro de coste c.",
     "doc_id": 254
    }
   ],
   "citas": [
    {
     "texto": "Numerical methods such as gradient descent or other optimization algorithms can be used to find the optimal values that maximize the expected return and the Sharpe ratio",
     "doc_id": 254
    }
   ],
