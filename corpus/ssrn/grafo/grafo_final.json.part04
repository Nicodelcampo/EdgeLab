   "doc_ids": [
    242
   ],
   "definiciones": [
    {
     "texto": "Rasgo de personalidad que motiva tanto el juego tradicional como el trading excesivo en bolsa. Individuos con alta búsqueda de sensaciones son más propensos a ambas actividades.",
     "doc_id": 242
    }
   ],
   "citas": [
    {
     "texto": "Grinblatt and Keloharju (2009) suggest that both traditional forms of gambling and highly active stock trading are motivated by a drive for 'sensation seeking'",
     "doc_id": 242
    }
   ],
   "relaciones_crudas": [
