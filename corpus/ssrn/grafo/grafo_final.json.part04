  {
   "id": "jarque bera statistic change",
   "nombre_canonico": "Jarque-Bera Statistic Change",
   "tipo": "metrica",
   "nombres_vistos": [
    "Jarque-Bera Statistic Change"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    234
   ],
   "definiciones": [
    {
     "texto": "Target binario que indica si la normalidad de los retornos aumenta o disminuye; su incremento señala retornos no-normales que sugieren que las estimaciones de implementation shortfall pueden ser demasiado pequeñas.",
     "doc_id": 234
    }
   ],
   "citas": [
    {
     "texto": "The Jarque-Bera statistic captures normality of returns, so its increase signals non-normal returns, suggesting that estimates of implementation shortfall may be too small.",
     "doc_id": 234
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "return normality",
     "doc_id": 234,
