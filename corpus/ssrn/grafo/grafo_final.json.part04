  {
   "id": "market impact cost",
   "nombre_canonico": "Market Impact Cost",
   "tipo": "concepto",
   "nombres_vistos": [
    "Market Impact Cost"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    229
   ],
   "definiciones": [
    {
     "texto": "Movimiento adverso de precio debido a la ejecución de un trade grande, componente principal del execution cost. La fragmentación de órdenes grandes reduce el impacto al distribuir la demanda de liquidez en el tiempo.",
     "doc_id": 229
    }
   ],
   "citas": [
    {
     "texto": "Market impact cost results from the liquidity demand of large trades and information signalled to other market participants by the presence of a large trade in the market.",
     "doc_id": 229
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
