  {
   "id": "hjb variational inequality",
   "nombre_canonico": "HJB Variational Inequality",
   "tipo": "metodo",
   "nombres_vistos": [
    "HJB Variational Inequality"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    253
   ],
   "definiciones": [
    {
     "texto": "Ecuación de Hamilton-Jacobi-Bellman modificada para control singular con costes de transacción, donde el estado se divide en tres regiones: compra, venta y no-trading. Las fronteras libres separan estas regiones.",
     "doc_id": 253
    }
   ],
   "citas": [
    {
     "texto": "the frictional value function is a continuous viscosity solution to a Hamilton-Jacobi-Bellman (HJB) variational inequality",
     "doc_id": 253
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Stochastic Optimal Control",
     "doc_id": 253,
     "revisar": false
    },
    {
     "tipo": "DEFINE",
