  {
   "id": "one second bar",
   "nombre_canonico": "One-Second Bar",
   "tipo": "dato",
   "nombres_vistos": [
    "One-Second Bar"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    233
   ],
   "definiciones": [
    {
     "texto": "Barra de precio de 1 segundo obtenida de feeds de brokers retail, usada como unidad mínima de observación para identificar MPD (cuerpo largo, mecha mínima, expansión abrupta de rango) y EMC (velas grandes tras el pulso inicial).",
     "doc_id": 233
    }
   ],
   "citas": [
    {
     "texto": "One-second bar data were obtained from a combination of retail broker feeds and charting platforms used in live trading.",
     "doc_id": 233
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Microstructural Pulse Dislocation",
     "doc_id": 233,
