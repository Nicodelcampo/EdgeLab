   "tipo": "concepto",
   "nombres_vistos": [
    "Chen Identity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    276
   ],
   "definiciones": [
    {
     "texto": "Propiedad multiplicativa: S(X)a,b = S(X)a,c x S(X)c,b, permitiendo composicion eficiente de signatures sobre intervalos concatenados.",
     "doc_id": 276
    }
   ],
   "citas": [
    {
     "texto": "Chens identity states that S(X)a,b = S(X)a,c x S(X)c,b",
     "doc_id": 276
    }
   ],
