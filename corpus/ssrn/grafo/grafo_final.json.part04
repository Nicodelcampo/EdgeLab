     "objeto_texto": "Dual Price Settlement",
     "doc_id": 313,
     "revisar": false
    }
   ]
  },
  {
   "id": "conditional distribution forecasting for imbalance",
   "nombre_canonico": "Conditional Distribution Forecasting for Imbalance",
   "tipo": "metodo",
   "nombres_vistos": [
    "Conditional Distribution Forecasting for Imbalance"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    313
   ],
   "definiciones": [
    {
     "texto": "Pronóstico de la distribución condicional del desbalance del sistema usado por agentes para decidir posiciones óptimas de arbitraje. La incertidumbre proviene de errores de pronóstico eólico y solar que aumentan los desbalances, creando más oportunidades de arbitraje.",
     "doc_id": 313
    }
   ],
   "citas": [
    {
     "texto": "We consider optimal real-time decisions by generators and speculators based upon forecasts of the conditional distribution of the system imbalance.",
     "doc_id": 313
    }
   ],
   "relaciones_crudas": [
