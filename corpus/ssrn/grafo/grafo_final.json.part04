   "doc_ids": [
    247
   ],
   "definiciones": [
    {
     "texto": "Estrategia de pairs trading que incorpora el término de corrección de error (λ·ecm_{t-1}) para explotar tanto la relación de largo plazo (cointegración) como las desviaciones de corto plazo, generando señales de entrada/salida basadas en el short-spread.",
     "doc_id": 247
    }
   ],
   "citas": [
    {
     "texto": "the ECM method has the potential to capture more short-term opportunities",
     "doc_id": 247
    }
