     "tipo_original": "CAUSA",
     "objeto_texto": "Spread Widening",
     "doc_id": 263,
     "revisar": false
    }
   ]
  },
  {
   "id": "population process with uniform catastrophe",
   "nombre_canonico": "Population Process with Uniform Catastrophes",
   "tipo": "concepto",
   "nombres_vistos": [
    "Population Process with Uniform Catastrophes"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    263
   ],
   "definiciones": [
    {
     "texto": "Modelo Markoviano donde el spread (como población) crece por incrementos unitarios y decrece por catástrofes uniformes (saltos hacia valores más bajos según distribución uniforme), capturando la dinámica de reversión del spread.",
     "doc_id": 263
    }
   ],
   "citas": [
    {
     "texto": "belonging to the class of processes known as a population processes with uniform catastrophes",
     "doc_id": 263
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "Spread Dynamics Model",
     "doc_id": 263,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Highly Competitive Regime",
     "doc_id": 263,
     "revisar": false
    }
   ]
  },
  {
   "id": "large deviation flash crash mechanism",
   "nombre_canonico": "Large Deviations (Flash Crash Mechanism)",
   "tipo": "metodo",
   "nombres_vistos": [
    "Large Deviations (Flash Crash Mechanism)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    263
   ],
   "definiciones": [
    {
     "texto": "Teoría de grandes desviaciones aplicada al modelo para caracterizar trayectorias óptimas que conducen a eventos raros de spread extremo, proporcionando una explicación mecanicista de flash crashes y mini flash crashes.",
     "doc_id": 263
    }
   ],
   "citas": [
    {
     "texto": "we present these large deviations in the form of 'optimal trajectories' that give us relevant information about their occurrence",
     "doc_id": 263
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EXPLICA",
     "tipo_original": "EXPLICA",
     "objeto_texto": "Flash Crash Dynamics",
     "doc_id": 263,
     "revisar": true
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Optimal Trajectories",
     "doc_id": 263,
     "revisar": false
    }
   ]
  },
  {
   "id": "three liquidity regime hc nc llg",
   "nombre_canonico": "Three Liquidity Regimes (HC, NC, LLG)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Three Liquidity Regimes (HC, NC, LLG)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    263
   ],
   "definiciones": [
    {
     "texto": "Taxonomía de regímenes de baja liquidez: Highly Competitive (spread cierra rápido, un tick a la vez), Non-Competitive (spread cierra gradualmente), Low Liquidity with Gaps (spread puede abrirse múltiples ticks por gaps en el LOB).",
     "doc_id": 263
    }
   ],
   "citas": [
    {
     "texto": "we consider three low liquidity regimes: Highly competitive, Non-competitive and Low liquidity with gaps",
     "doc_id": 263
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Liquidity Fluctuations Framework",
     "doc_id": 263,
     "revisar": false
    }
   ]
  },
  {
   "id": "micro jump and local price trend",
   "nombre_canonico": "Micro-Jumps and Local Price Trends",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Micro-Jumps and Local Price Trends"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    263
   ],
   "definiciones": [
    {
     "texto": "Relación entre micro-saltos de precios de corto plazo y tendencias locales de más largo plazo, mediada por el spread. El modelo muestra que la tendencia local y la volatilidad son funciones de los parámetros de los micro-saltos y del spread típico.",
     "doc_id": 263
    }
   ],
   "citas": [
    {
     "texto": "our model successfully explains the local trends in the prices and the volatility around these trends expressed as function of parameters of the micro-jumps of the prices",
     "doc_id": 263
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Local Price Trends",
     "doc_id": 263,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Spread-Price Relationship",
     "doc_id": 263,
     "revisar": false
    }
   ]
  },
  {
   "id": "law of large number lln for lob",
   "nombre_canonico": "Law of Large Numbers (LLN) for LOB",
   "tipo": "metodo",
   "nombres_vistos": [
    "Law of Large Numbers (LLN) for LOB"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    263
   ],
   "definiciones": [
    {
     "texto": "Resultado asintótico que establece que el comportamiento promedio del spread y precios converge a una dinámica determinista gobernada por los parámetros medios del order flow en el régimen de alta frecuencia de eventos.",
     "doc_id": 263
    }
   ],
   "citas": [
    {
     "texto": "The law of large numbers (LLN), central limit theorem (CLT) and large deviations (LD) are proved for our model",
     "doc_id": 263
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Limit Theorems",
     "doc_id": 263,
     "revisar": false
    }
   ]
  },
  {
   "id": "order dynamic theoretical physic framework",
   "nombre_canonico": "Order Dynamics (Theoretical Physics Framework)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Order Dynamics (Theoretical Physics Framework)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    264
   ],
   "definiciones": [
    {
     "texto": "Marco conceptual no-financiero que postula que el orden cósmico emerge de la tensión asimétrica entre Fuerza Causal y Fuerza Entrópica. Sin relación con 'order book dynamics' o 'order flow' en finanzas; la keyword 'order dynamics' es un falso positivo en el corpus de trading.",
     "doc_id": 264
    }
   ],
   "citas": [
    {
     "texto": "Order Dynamics (OD), a unifying framework for explaining the origin and evolution of cosmic order",
     "doc_id": 264
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "causal entropic law cel",
   "nombre_canonico": "Causal-Entropic Law (CEL)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Causal-Entropic Law (CEL)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    264
   ],
   "definiciones": [
    {
     "texto": "Principio especulativo: la evolución de cualquier sistema está gobernada por la tensión asimétrica entre Fuerza Causal (genera/sostiene orden) y Fuerza Entrópica (dispersa/disuelve). Sin validación empírica ni formalización matemática rigurosa.",
     "doc_id": 264
    }
   ],
   "citas": [
    {
     "texto": "The evolution of any system is fundamentally driven by Causal Force, which generates and sustains order, and by Entropic Force, which disperses and dissolves it",
     "doc_id": 264
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "volume volatility relation",
   "nombre_canonico": "Volume-Volatility Relation",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Volume-Volatility Relation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    265
   ],
   "definiciones": [
    {
     "texto": "Relación empírica positiva entre volumen de negociación y volatilidad de precios, explicada por tres hipótesis: Mixture of Distributions Hypothesis (llegada de información como factor latente), modelos de información asimétrica (Kyle 1985), y modelos de diferencias de opinión.",
     "doc_id": 265
    }
   ],
   "citas": [
    {
     "texto": "A positive relation between trading volume and volatility is often observed in prior empirical studies",
     "doc_id": 265
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EXPLICA",
     "tipo_original": "EXPLICA",
     "objeto_texto": "Information Arrival",
     "doc_id": 265,
     "revisar": true
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Market Activity",
     "doc_id": 265,
     "revisar": false
    }
   ]
  },
  {
   "id": "number of trade vs trade size",
   "nombre_canonico": "Number of Trades vs Trade Size",
   "tipo": "concepto",
   "nombres_vistos": [
    "Number of Trades vs Trade Size"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    265
   ],
   "definiciones": [
    {
     "texto": "Descomposición del volumen en dos componentes: número de transacciones y tamaño medio. Jones et al. (1994) mostró que el número de trades domina sobre el tamaño en explicar volatilidad, consistente con modelos de trading estratégico donde el informado divide órdenes grandes.",
     "doc_id": 265
    }
   ],
   "citas": [
    {
     "texto": "the number of trades has a more significant impact on volatility than the average trade size",
     "doc_id": 265
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Volatility",
     "doc_id": 265,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Strategic Order Splitting",
     "doc_id": 265,
     "revisar": false
    }
   ]
  },
  {
   "id": "order book slope",
   "nombre_canonico": "Order Book Slope",
   "tipo": "metrica",
   "nombres_vistos": [
    "Order Book Slope"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    265
   ],
   "definiciones": [
    {
     "texto": "Pendiente del LOB, proxy de la divergencia de opiniones entre inversores. Una mayor pendiente indica menor profundidad de mercado y está negativamente relacionada con la volatilidad, el volumen y la relación volumen-volatilidad.",
     "doc_id": 265
    }
   ],
   "citas": [
    {
