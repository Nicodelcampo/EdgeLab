  {
   "id": "state space collapse ssc",
   "nombre_canonico": "State Space Collapse (SSC)",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "State Space Collapse (SSC)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    287
   ],
   "definiciones": [
    {
     "texto": "Propiedad donde el estado N-dimensional del mercado (colas en cada exchange) se reduce a un proceso unidimensional de workload W=sum(beta_i*Q_i).",
     "doc_id": 287
    }
   ],
   "citas": [
    {
     "texto": "the behavior of the multi-dimensional market reduces to that of a one-dimensional system expressed in terms of workload",
     "doc_id": 287
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
