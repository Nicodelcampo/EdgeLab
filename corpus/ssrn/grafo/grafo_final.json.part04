   "tipo": "estrategia",
   "nombres_vistos": [
    "breakout detection"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    296
   ],
   "definiciones": [
    {
     "texto": "Detección de breakouts basada en spikes de volumen: se genera señal cuando el volumen de cualquiera de los últimos 5 días es al menos 4x el promedio de 20 días y el high del día supera el high previo.",
     "doc_id": 296
    }
   ],
   "citas": [
    {
     "texto": "def breakout = (volume[1] >= 4 * avgVol[1] and high > high[1]) or (volume[2] >= 4 * avgVol[2] and high > high[2]) ...",
