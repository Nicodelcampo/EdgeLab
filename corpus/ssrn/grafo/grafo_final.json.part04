    287
   ],
   "definiciones": [
    {
     "texto": "Exchanges pagan rebate r_i a liquidity makers y cobran fee a takers; diferencias en fees/rebates generan trade-off entre delay y retorno monetario.",
     "doc_id": 287
    }
   ],
   "citas": [
    {
     "texto": "exchanges typically offer a rebate to liquidity providers... simultaneously, exchanges charge a fee to takers of liquidity",
