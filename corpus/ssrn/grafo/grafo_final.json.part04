     "tipo_original": "INDEPENDE_DE",
     "objeto_texto": "Running VWAP",
     "doc_id": 258,
     "revisar": true
    }
   ]
  },
  {
   "id": "invariance of expected vwap difference",
   "nombre_canonico": "Invariance of Expected VWAP Difference",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Invariance of Expected VWAP Difference"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    258
   ],
   "definiciones": [
    {
     "texto": "Resultado teórico fundamental: bajo los tres supuestos del modelo (market orders, sin impacto en precio, martingala condicional), la diferencia esperada entre VWAP personal y de mercado no depende de la estrategia de trading.",
     "doc_id": 258
    }
   ],
   "citas": [
    {
     "texto": "the difference between the VWAP achieved by an arbitrary, personal, trading strategy and the market VWAP does not depend on the choice of strategy",
     "doc_id": 258
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Variance Minimization Focus",
