   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    242
   ],
   "definiciones": [
    {
     "texto": "Fenómeno donde distintas formas de juego (lotería, casino, trading especulativo) actúan como sustitutas: un aumento en una reduce la participación en otra, evidenciado en reducciones de volumen bursátil cuando crecen los botes de lotería.",
     "doc_id": 242
    }
   ],
   "citas": [
    {
     "texto": "individuals with such a drive will attempt to satisfy their 'gambling-fix' but are willing to substitute among different forms of gambling",
     "doc_id": 242
    }
