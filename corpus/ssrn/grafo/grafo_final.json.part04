     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "Market-Neutral Strategy",
     "doc_id": 312,
     "revisar": false
    }
   ]
  },
  {
   "id": "opportunistic imbalancing statistical arbitrage in power market",
   "nombre_canonico": "Opportunistic Imbalancing (Statistical Arbitrage in Power Markets)",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Opportunistic Imbalancing (Statistical Arbitrage in Power Markets)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    313
   ],
   "definiciones": [
    {
     "texto": "Estrategia donde participantes anticipan la dirección del desbalance del sistema y toman posiciones contrarias: si el sistema está corto (precio real-time > forward), un generador spillea potencia extra para vender al precio de desbalance más alto. Reduce necesidades de balance del operador.",
     "doc_id": 313
    }
   ],
   "citas": [
    {
     "texto": "Market participants that correctly anticipate the direction of imbalance for the whole system can profit by being out of balance in the opposite direction.",
     "doc_id": 313
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
