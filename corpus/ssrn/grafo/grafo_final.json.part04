  {
   "id": "hypercube sampling",
   "nombre_canonico": "Hypercube Sampling",
   "tipo": "metodo",
   "nombres_vistos": [
    "Hypercube Sampling"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    295
   ],
   "definiciones": [
    {
     "texto": "Muestreo completamente aleatorio (no determinístico) que divide cada dimensión en N secciones y genera una variable uniforme aleatoria en cada sección. En dimensiones bajas tiene distribución similar a MATLAB con homogeneidad ligeramente superior.",
     "doc_id": 295
    }
   ],
   "citas": [
    {
     "texto": "Hypercube sampling differs from the previous sequencing methods by being completely random, whereas the other sequencing methods were deterministic through the use of the Van Der Corput sequences.",
     "doc_id": 295
    }
   ],
   "relaciones_crudas": [
