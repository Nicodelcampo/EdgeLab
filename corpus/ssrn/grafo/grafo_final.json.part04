     "objeto_texto": "execution cost",
     "doc_id": 229,
     "revisar": false
    }
   ]
  },
  {
   "id": "trade size parameter β",
   "nombre_canonico": "Trade Size Parameter β",
   "tipo": "concepto",
   "nombres_vistos": [
    "Trade Size Parameter β"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    229
   ],
   "definiciones": [
    {
     "texto": "Proporción del volumen total de mercado VT que un trader VWAP intenta negociar. A mayor β, menor aversión efectiva al riesgo (1−β)λ, lo que hace óptimo aumentar el tamaño del trade direccional.",
     "doc_id": 229
    }
   ],
   "citas": [
    {
     "texto": "It is optimal for large 0 < β < 1 mean-variance VWAP traders to increase the size of the price 'directional' trade for additional return.",
     "doc_id": 229
    }
   ],
   "relaciones_crudas": [
