     "tipo_original": "USA",
     "objeto_texto": "Variance Optimal Martingale Measure",
     "doc_id": 229,
     "revisar": false
    }
   ]
  },
  {
   "id": "variance optimal martingale measure",
   "nombre_canonico": "Variance Optimal Martingale Measure",
   "tipo": "concepto",
   "nombres_vistos": [
    "Variance Optimal Martingale Measure"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    229
   ],
   "definiciones": [
    {
     "texto": "Medida martingala que minimiza la varianza del error de hedging en mercados incompletos, usada para determinar la varianza adicional y el retorno esperado de la estrategia direccional de precio.",
     "doc_id": 229
    }
   ],
   "citas": [
    {
     "texto": "The 'directional' price strategy uses the properties of the Variance Optimal Martingale Measure.",
     "doc_id": 229
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
