  {
   "id": "fluid model approximation",
   "nombre_canonico": "Fluid Model Approximation",
   "tipo": "metodo",
   "nombres_vistos": [
    "Fluid Model Approximation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    287
   ],
   "definiciones": [
    {
     "texto": "Modelo determinista continuo como limite asintotico del sistema estocastico cuando las tasas de llegada crecen y el tamano de orden es infinitesimal.",
     "doc_id": 287
    }
   ],
   "citas": [
    {
     "texto": "a deterministic fluid model where the discrete and stochastic order arrival processes are replaced by continuous and deterministic analogues",
     "doc_id": 287
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
