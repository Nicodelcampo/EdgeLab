   "tipo": "fenomeno",
   "nombres_vistos": [
    "Implied Volatility Smile"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    235
   ],
   "definiciones": [
    {
     "texto": "Patrón de implied volatility en función de moneyness y tiempo a vencimiento que forma una 'sonrisa'. Los smiles de LETFs y ETFs son estadísticamente diferentes incluso tras aplicar moneyness scaling.",
     "doc_id": 235
