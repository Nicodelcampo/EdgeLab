     "objeto_texto": "Free Boundaries",
     "doc_id": 253,
     "revisar": true
    }
   ]
  },
  {
   "id": "asymptotic expansion method",
   "nombre_canonico": "Asymptotic Expansion Method",
   "tipo": "metodo",
   "nombres_vistos": [
    "Asymptotic Expansion Method"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    253
   ],
   "definiciones": [
    {
     "texto": "Técnica que trata los costes de transacción como perturbaciones pequeñas de un benchmark sin fricciones, expandiendo la función de valor en potencias del parámetro de coste escalado para obtener expresiones explícitas de las fronteras óptimas.",
     "doc_id": 253
    }
   ],
   "citas": [
    {
     "texto": "we adopt an asymptotic approach to expand the value function and derive explicit asymptotic expressions for the free boundaries",
     "doc_id": 253
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Homogenization",
