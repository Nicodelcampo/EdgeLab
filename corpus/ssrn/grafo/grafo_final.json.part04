  {
   "id": "kuramoto model synchronization",
   "nombre_canonico": "Kuramoto Model (Synchronization)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Kuramoto Model (Synchronization)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    245
   ],
   "definiciones": [
    {
     "texto": "Modelo matemático de osciladores acoplados que describe fenómenos de sincronización en sistemas físicos y biológicos. En este paper se aplica a generadores eléctricos (power systems), no a mercados financieros. La keyword es probablemente un falso positivo en la búsqueda.",
     "doc_id": 245
    }
   ],
   "citas": [
    {
     "texto": "the classical generator model, known as the networked second-order Kuramoto model in the power system",
     "doc_id": 245
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "frequency synchronization",
   "nombre_canonico": "Frequency Synchronization",
   "tipo": "concepto",
