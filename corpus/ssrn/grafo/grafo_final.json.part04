   "doc_ids": [
    272
   ],
   "definiciones": [
    {
     "texto": "Hipótesis de que los precios de opciones reflejan toda la información disponible; el estudio la apoya al no encontrar beneficios significativos del arbitraje estadístico.",
     "doc_id": 272
    }
   ],
   "citas": [
    {
     "texto": "the statistical arbitrage does not produce significant positive returns, thus providing evidence in support of Index Option market efficiency",
     "doc_id": 272
    }
