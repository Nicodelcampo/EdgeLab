   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    270
   ],
   "definiciones": [
    {
     "texto": "Riesgo de que la relación entre dos acciones se rompa permanentemente; spreads >4σ se interpretan como señal de divorcio.",
     "doc_id": 270
    }
   ],
   "citas": [
    {
     "texto": "A very large spread is a sign that the pair is in divorce",
     "doc_id": 270
    }
   ],
