  {
   "id": "stochastic spread method",
   "nombre_canonico": "Stochastic Spread Method",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Stochastic Spread Method"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    248
   ],
   "definiciones": [
    {
     "texto": "Método de pares propuesto por Elliott, van der Hoek y Malcolm que modela el spread como un proceso estocástico de reversión a la media con parámetros estimados, siendo el único que propone una estrategia de salida completa (stop-loss).",
     "doc_id": 248
    }
   ],
   "citas": [
    {
     "texto": "only the stochastic spread method proposes a detailed exit strategy - a complete set of rules for winning and losing cases",
     "doc_id": 248
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Distance Method",
     "doc_id": 248,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
