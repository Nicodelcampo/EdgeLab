   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    255
   ],
   "definiciones": [
    {
     "texto": "Fórmula cerrada para la cantidad óptima de market orders que maximiza las partes controlables de la ecuación HJB, dada como función del estado actual del mercado y de las preferencias del trader, intuitiva y directamente implementable.",
     "doc_id": 255
    }
   ],
   "citas": [
    {
     "texto": "an optimal number of market order which takes current status of market as well as a trader's preference into account is given in a simple but intuitive and reasonable form",
     "doc_id": 255
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "HJB Equation",
     "doc_id": 255,
     "revisar": false
    },
    {
     "tipo": "PRODUCE",
     "tipo_original": "PRODUCE",
     "objeto_texto": "Positive PnL with Risk Control",
     "doc_id": 255,
     "revisar": true
    }
   ]
  },
  {
   "id": "anzat utility decomposition",
   "nombre_canonico": "Anzats: Utility Decomposition",
   "tipo": "metodo",
   "nombres_vistos": [
    "Anzats: Utility Decomposition"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    255
   ],
   "definiciones": [
    {
     "texto": "Suposición de forma funcional u(t,s_t,q_t,x_t) = e^{-ω(T-t)}x_t + θ₀(t,s_t) + q_t·θ₁(t,s_t) + q²_t·θ₂(t,s_t) que separa la utilidad en riqueza terminal descontada más términos lineales y cuadráticos en inventario.",
     "doc_id": 255
    }
   ],
   "citas": [
    {
     "texto": "We solve the HJB equation by assuming the following ansatz u(t,s_t,q_t,x_t) = e^{-ω(T-t)}x_t + θ₀(t,s_t) + q_tθ₁(t,s_t) + q²_tθ₂(t,s_t)",
     "doc_id": 255
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "HJB Solution Method",
     "doc_id": 255,
     "revisar": false
    }
   ]
  },
  {
   "id": "feynman kac theorem in hjb context",
   "nombre_canonico": "Feynman-Kac Theorem (in HJB Context)",
   "tipo": "metodo",
   "nombres_vistos": [
    "Feynman-Kac Theorem (in HJB Context)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    255
   ],
   "definiciones": [
    {
     "texto": "Teorema que vincula EDPs parabólicas con esperanzas de procesos estocásticos, usado para resolver θ₁(t,s_t) = E[s_T|Π_t], el precio esperado terminal condicionado a la información actual.",
     "doc_id": 255
    }
   ],
   "citas": [
    {
     "texto": "The Feynman-Kac theorem gives θ₁(t,s_t) = E[s_T|Π_t]",
     "doc_id": 255
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Terminal Price Expectation",
     "doc_id": 255,
     "revisar": false
    },
    {
