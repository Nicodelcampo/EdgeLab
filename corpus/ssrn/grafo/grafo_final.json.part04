  {
   "id": "change in realized volatility sign",
   "nombre_canonico": "Change in Realized Volatility Sign",
   "tipo": "metrica",
   "nombres_vistos": [
    "Change in Realized Volatility Sign"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    234
   ],
   "definiciones": [
    {
     "texto": "Variable target binaria (+1/−1) que indica si la volatilidad realizada aumentará o disminuirá en el siguiente período, relevante para ajustar velocidad de ejecución algorítmica.",
     "doc_id": 234
    }
   ],
   "citas": [
    {
     "texto": "If realized volatility is expected to increase, then increasing the speed of algo execution would be expected to reduce fill price uncertainty.",
     "doc_id": 234
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PREDICE",
