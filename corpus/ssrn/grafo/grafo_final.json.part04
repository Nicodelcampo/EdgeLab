   ],
   "definiciones": [
    {
     "texto": "Profundidad de contraste entre baskets A y B basada en numero de tags jerarquicos compartidos; mayor profundidad produce reversion mas rapida y confiable.",
     "doc_id": 286
    }
   ],
   "citas": [
    {
     "texto": "More hierarchical contrast leads to larger absolute beta difference and smaller sigma_xi, resulting in faster pair mean reversion",
