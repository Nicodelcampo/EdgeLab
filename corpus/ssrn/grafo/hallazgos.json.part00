 },
 {
  "afirmacion": "El modelo propuesto con fusión multimodal y atención al riesgo de cola supera a los modelos base en términos de estabilidad de retornos y control de riesgo, logrando un balance favorable entre rentabilidad y exposición.",
  "mercado": "Stock index and commodity futures",
