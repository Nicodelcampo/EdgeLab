  "periodo": "1999-2023 (train), 252 días held-out test",
  "magnitud": "Full Cross-Attn: Return +4.52%, Sharpe 0.77, MaxDD -1.64%, Sortino 1.24, Calmar 2.23, Omega 1.14. Concat: Return -7.98%, Sharpe -5.45. Price-Only: Return -7.41%, Sharpe -5.29. Text-Only: Return -4.68%, Sharpe -5.06.",
  "condiciones": "Inference-only ablation con strict=False loading; RTX 5070 Ti; 100K capital inicial; 10 bps transaction costs + 5 bps slippage; 50 tickers iterados",
  "robustez": "baja",
