 {
  "hallazgo": "Se demuestra formalmente que las probabilidades de transición condicionadas por el texto generan una matriz de Markov válida, con entradas estrictamente positivas y filas que suman uno.",
  "doc_id": 197,
  "doc_titulo": "LLM-Augmented Quantitative Finance: A Rigorous Structural Framework for Market State Inference and Forecasting"
 },
 {
  "hallazgo": "Se establece que el marco permite recursiones de filtrado bayesiano exacto en tiempo discreto, integrando la inferencia del estado latente del régimen con las observaciones del mercado y los estados semánticos del LLM.",
  "doc_id": 197,
  "doc_titulo": "LLM-Augmented Quantitative Finance: A Rigorous Structural Framework for Market State Inference and Forecasting"
 },
 {
  "hallazgo": "Se demuestra que la sensibilidad de las transiciones de régimen frente a alteraciones en los embeddings de los LLMs está matemáticamente acotada (Lipschitz stability), lo cual aporta gran robustez ante variaciones en la extracción de texto o pequeños cambios de preprocesamiento.",
  "doc_id": 197,
  "doc_titulo": "LLM-Augmented Quantitative Finance: A Rigorous Structural Framework for Market State Inference and Forecasting"
 },
 {
  "hallazgo": "Se prueba que los parámetros de transición que incorporan el texto son plenamente identificables si se aplica una normalización respecto a un régimen de referencia.",
  "doc_id": 197,
  "doc_titulo": "LLM-Augmented Quantitative Finance: A Rigorous Structural Framework for Market State Inference and Forecasting"
 },
 {
  "descripcion": "Se prueba teóricamente que añadir features generadas por LLM (sentimiento, embeddings, regímenes) a un modelo lineal basado en variables numéricas nunca incrementa el riesgo in-sample (RSS hibrido <= RSS numérico).",
  "relevancia": "Provee una garantía matemática básica de que los modelos lineales pueden incorporar señales semánticas sin degradar el ajuste in-sample, apoyando su inclusión.",
  "doc_id": 198,
  "doc_titulo": "LLM-Augmented Quantitative Finance: A Simple but Rigorous Framework for Market Understanding and Forecasting"
 },
 {
  "descripcion": "Si el sentimiento de un LLM es incrementalmente informativo, la proyección L2 demuestra que el predictor que incluye el sentimiento tendrá un Error Cuadrático Medio estrictamente menor.",
  "relevancia": "Justificación teórica de por qué el NLP puede mejorar la precisión de los pronósticos cuantitativos.",
  "doc_id": 198,
  "doc_titulo": "LLM-Augmented Quantitative Finance: A Simple but Rigorous Framework for Market Understanding and Forecasting"
 },
 {
  "descripcion": "Las posiciones dependientes del régimen derivadas de los clústeres de embeddings pueden alcanzar una utilidad esperada estrictamente mayor que las estrategias de ponderación constante si existe dispersión en los ratios de Sharpe entre regímenes.",
  "relevancia": "Respalda matemáticamente la aplicación de asignación dinámica de activos (dynamic asset allocation) basada en macro-regímenes identificados por procesamiento de lenguaje natural.",
  "doc_id": 198,
  "doc_titulo": "LLM-Augmented Quantitative Finance: A Simple but Rigorous Framework for Market Understanding and Forecasting"
 },
 {
  "descripcion": "La adición de un drift guiado por LLM a un SDE preserva la unicidad de las soluciones fuertes y permite la valoración riesgo-neutral mediante la transformación de Girsanov.",
  "doc_id": 199,
  "doc_titulo": "LLM-Driven Drift Models for Brownian Motion in Quantitative Finance"
 },
 {
  "descripcion": "El condicionamiento a representaciones LLM no solo mejora la exactitud direccional en la proyección de retornos, sino que aproxima mucho mejor las dinámicas de variación cuadrática segmentadas por regímenes textuales y la función de densidad acumulada (CDF) de los tiempos de cruce que los GARCH y baselines DL clásicos.",
  "doc_id": 199,
  "doc_titulo": "LLM-Driven Drift Models for Brownian Motion in Quantitative Finance"
 },
 {
  "afirmacion": "La inclusión del estado textual (embeddings de un LLM) en el drift de una SDE no destruye las propiedades de martingala ni la existencia de soluciones fuertes, siempre que se cumplan condiciones clásicas de Lipschitz y de crecimiento lineal.",
