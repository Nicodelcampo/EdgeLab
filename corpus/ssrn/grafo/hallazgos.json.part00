 },
 {
  "hallazgo": "La codificación del LLM estabiliza la convergencia del aprendizaje por refuerzo y la dinámica del equilibrio en mercados de alta frecuencia.",
  "explicacion": "Al comprimir el estado de microestructura del mercado en un embedding regular, se obtienen gradientes más suaves y estables. Esto permite que las políticas de RL converjan con mayor facilidad y asegura la existencia matemática de un equilibrio continuo y robusto frente a pequeñas perturbaciones en la codificación.",
  "doc_id": 201,
  "doc_titulo": "LLM-Driven Market Microstructure Representation Learning and Game-Theoretic Reinforcement Dynamics"
 },
 {
  "afirmacion": "El modelo LSTM-DQN supera sistemáticamente al modelo DQN puro y a la estrategia de Buy-and-Hold en retornos acumulados, anualizados y ratio Sharpe para la acción China Merchants Securities.",
  "mercado": "Acciones clase A de China (China Merchants Securities)",
  "periodo": "Noviembre 2023 - Enero 2025",
  "magnitud": "Retorno acumulado (CR): 35.39% (LSTM-DQN) vs 26.52% (B&H) y 18.98% (DQN). Ratio Sharpe: 2.06 (LSTM-DQN) vs 1.63 (B&H) y 1.27 (DQN).",
  "condiciones": "Backtest con 10% de los datos (fuera de muestra temporal), datos diarios, sin apalancamiento.",
  "robustez": "media",
  "cita_textual": "the LSTM-DQN model demonstrates a substantial lead with a cumulative return of 35.39%... Sharpe ratio is 2.06",
  "doc_id": 204,
  "doc_titulo": "LSTM-Augmented DQN for Quantitative Trading in Partially Observable Markets"
 },
 {
  "afirmacion": "La inclusión del extractor LSTM aumenta notablemente el retorno del sistema de trading, pero también eleva significativamente el drawdown máximo y la volatilidad comparado con estrategias base en condiciones de rebote o tendencia fuertemente direccional.",
  "mercado": "Acciones clase A de China (GF Securities y Wuliangye)",
  "periodo": "2023/2024 - Enero 2025",
  "magnitud": "GF Securities: CR 12.45% (LSTM-DQN) vs 10.98% (B&H); Volatilidad 19.33% vs 12.69%. Wuliangye: CR 14.37% vs 3.13% (B&H); Max Drawdown 25.49% vs 15.19%.",
  "condiciones": "Backtest con datos diarios. Las estrategias DRL asumen perfiles de mayor riesgo que comprar y mantener.",
  "robustez": "media",
  "cita_textual": "the proposed algorithm has significant advantages in terms of returns, but at the cost of bearing certain risks and fluctuations in returns.",
  "doc_id": 204,
  "doc_titulo": "LSTM-Augmented DQN for Quantitative Trading in Partially Observable Markets"
 },
 {
  "afirmacion": "Los indicadores técnicos de volumen discretizado (VPT y VEMA) resultan imprescindibles para la eficacia del sistema, su remoción causa una severa caída en los retornos ajustados al riesgo.",
  "mercado": "Acciones clase A de China",
