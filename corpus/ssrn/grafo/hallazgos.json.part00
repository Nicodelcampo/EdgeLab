  "doc_id": 42,
  "doc_titulo": "Algorithmic Trading and Liquidity Commonality"
 },
 {
  "afirmacion": "Tras la hibridización, el tamaño promedio de las operaciones cae y el número de operaciones sube abruptamente, consistente con mayor participación de algorithmic trading.",
