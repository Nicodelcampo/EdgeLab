 },
 {
  "afirmacion": "Los order flows y retornos de acciones de competidores no-anunciantes contienen información para los retornos de la empresa anunciante, incluso controlando por retornos y order flow propios rezagados y contemporáneos.",
  "mercado": "759 anuncios de earnings en 128 industrias (NYSE/AMEX/NASDAQ)",
  "periodo": "Ventanas de evento: pre-evento (días -2 y -1), evento (día 0), post-evento (días +1 y +2)",
