 },
 {
  "afirmacion": "La implementación teórica del modelo PCA-SETAR supera al enfoque clásico de VWAP, reduciendo el execution risk medido por MAPE. Para la acción TOTAL, el MAPE del enfoque clásico es 0.0528 frente a 0.0496 del PCA-SETAR teórico, una reducción de 0.0032.",
  "mercado": "CAC40 (40 acciones, Euronext Paris)",
