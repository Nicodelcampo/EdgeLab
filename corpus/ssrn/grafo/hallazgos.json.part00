 },
 {
  "afirmacion": "La actividad de trading de alta frecuencia (HFT) mejora la liquidez al reducir de manera sistémica tanto los spreads cotizados como los spreads efectivos.",
  "mercado": "Equities europeos (LSE y MTFs)",
  "periodo": "2005-2016",
  "magnitud": "1% de incremento en HFT reduce el spread base en aproximadamente 0.27%, estadísticamente robusto en OLS e IV-GMM.",
  "condiciones": "Basado en tick data de milisegundos aislando el efecto cruzado temporal.",
  "robustez": "alta",
  "cita_textual": "The results showing the individual effect suggest that HFT improves liquidity, whereas market fragmentation is detrimental to the same.",
  "doc_id": 148,
  "doc_titulo": "The Intersectionality of High Frequency Trading (HFT) and Market Fragmentation, and their Impact on Liquidity: New Evidence"
 },
 {
  "afirmacion": "La fragmentación pura de órdenes en distintos mercados (lit) erosiona la liquidez disponible, penalizando tanto los spreads de mercado como las profundidades.",
  "mercado": "Equities europeos",
  "periodo": "2005-2016",
  "magnitud": "Estimador IV-GMM confirma que el aumento del HHI expande los costos (efecto neto ~+0.045 en spreads efectivos).",
  "condiciones": "Analizando cuotas de mercado independientes y aislando el crecimiento del HFT.",
  "robustez": "alta",
  "cita_textual": "higher fragmentation is associated with higher quoted and effective spreads. In fact, the estimates appear to be stronger for IV-GMM.",
  "doc_id": 148,
  "doc_titulo": "The Intersectionality of High Frequency Trading (HFT) and Market Fragmentation, and their Impact on Liquidity: New Evidence"
 },
 {
  "afirmacion": "El HFT interacciona positivamente con la fragmentación: la inyección adicional de liquidez por algoritmos es mayor en aquellos activos cuyas transacciones están muy fragmentadas entre plataformas.",
  "mercado": "Equities europeos",
  "periodo": "2005-2016",
  "magnitud": "Significancia negativa del término interactivo HFT*LFrag, indicando reducción adicional del spread.",
  "condiciones": "Este efecto se intensifica especialmente en las acciones de gran capitalización bursátil.",
  "robustez": "alta",
  "cita_textual": "The evidence suggests that a rise in HFT in a highly fragmented stock improves liquidity more than that of its low fragmented counterpart.",
  "doc_id": 148,
  "doc_titulo": "The Intersectionality of High Frequency Trading (HFT) and Market Fragmentation, and their Impact on Liquidity: New Evidence"
 },
 {
  "afirmacion": "A diferencia de la creencia general de que el HFT seca el mercado durante el pánico, las evidencias muestran que aportó liquidez extra durante los shocks volátiles.",
  "mercado": "Equities europeos",
  "periodo": "2008-2010",
  "magnitud": "Coeficiente dummy de interacción confirma una reducción incremental de 0.03% adicional en spreads.",
  "condiciones": "Medido durante la crisis global caracterizada por altas caídas y volatilidad.",
  "robustez": "alta",
  "cita_textual": "HFT even appears to provide liquidity in a high volatility period of financial crisis, 2008-2010 , an evidence which goes against the popular belief.",
  "doc_id": 148,
  "doc_titulo": "The Intersectionality of High Frequency Trading (HFT) and Market Fragmentation, and their Impact on Liquidity: New Evidence"
 },
 {
  "afirmacion": "El aprendizaje de órdenes por parte de HFT reduce la cantidad de información fundamental disponible en el mercado y altera su microestructura al monetizar flujos de liquidez predecibles.",
