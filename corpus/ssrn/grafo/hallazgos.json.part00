 {
  "afirmacion": "La decimalización redujo la varianza observada de la volatilidad al disminuir drásticamente el ruido de la microestructura del mercado, incrementando por ende el ratio señal/ruido, especialmente para acciones muy transadas.",
  "mercado": "NYSE (acciones DJIA, y otras de control)",
  "periodo": "2000-2001",
  "magnitud": "La varianza del ruido disminuyó marcadamente en el grupo de prueba (Dow Jones) mientras que el ratio señal/ruido (SNR) aumentó.",
  "condiciones": "Uso de datos TAQ intradía, estimadores KERN/TSRV/MSRV y test pareados controlando por saltos atípicos (Jan 3, 2001).",
  "robustez": "alta",
  "cita_textual": "decimalization decreased observed volatility by decreasing noise variance and, consequently, increased the significance of the true signal especially in trade price data for the highly active Dow Jones stocks.",
  "doc_id": 82,
  "doc_titulo": "Decimalization, Realized Volatility, and Market Microstructure Noise"
 },
 {
  "afirmacion": "El modelo completo de deep learning statistical arbitrage (IPCA + convolutional transformer + NN allocation optimizada a Sharpe) logra Sharpe ratio anual >4.0 out-of-sample sobre ~550 acciones líquidas de US, duplicando el mejor benchmark paramétrico y cuadruplicando estrategias convencionales.",
  "mercado": "US equities (largest ~550 most liquid stocks)",
  "periodo": "1998-2016",
  "magnitud": "Sharpe >4.0 anual OOS (modelo completo); Sharpe ~3.2 con FF5/PCA como factores; Sharpe 4.2 con IPCA condicional; retorno medio anual ~20% con restricción de short-selling",
  "condiciones": "Rolling window estimation; trading diario; costos de transacción y holding costs incluidos; estrategia ortogonal a factores de riesgo convencionales",
  "robustez": "alta",
  "cita_textual": "our model can achieve an impressive annual Sharpe ratio larger than four... This performance is four times better than one of the best parametric arbitrage models",
  "doc_id": 83,
  "doc_titulo": "Deep Learning Statistical Arbitrage"
 },
 {
  "afirmacion": "El convolutional transformer es el componente más diferenciador: duplica el Sharpe (~4.0 vs ~2.0) respecto a un modelo deep learning idéntico pero con filtro de frecuencia pre-especificado (Fourier) en vez del transformer aprendido. La elección del modelo de factores de asset pricing tiene un efecto sorprendentemente menor.",
  "mercado": "US equities",
  "periodo": "1998-2016",
  "magnitud": "Conv-transformer: Sharpe ~4.0 vs Fourier filter: Sharpe ~2.0 (2x mejora); FF5/PCA: Sharpe ~3.2 vs IPCA: Sharpe 4.2 (diferencia ~1.0)",
  "condiciones": "Comparación controlada manteniendo idénticos los otros dos componentes del framework; evaluación OOS rolling window",
  "robustez": "alta",
  "cita_textual": "The convolutional transformer doubles the performance relative to an identical deep learning model with a pre-specified frequency filter",
  "doc_id": 83,
  "doc_titulo": "Deep Learning Statistical Arbitrage"
 },
 {
  "afirmacion": "Las estrategias de statistical arbitrage generan retornos ortogonales a factores de riesgo convencionales (mercado, momentum, reversal). Los retornos no representan una prima de riesgo sistemática sino explotación de mispricing temporal de corto plazo. La señal de arbitraje es persistente en horizontes cortos (~1 semana) pero decae en horizontes más largos (~1 mes).",
  "mercado": "US equities",
  "periodo": "1998-2016",
  "magnitud": "~50% del Sharpe persiste con holding period de 1 semana; la mayor parte del mispricing se corrige en ~1 mes; estrategia robusta a través de subperíodos",
  "condiciones": "Regresiones de retornos de estrategia contra factores Fama-French + momentum + reversal; análisis de persistencia de señal variando el holding period",
  "robustez": "alta",
  "cita_textual": "the profitability of our strategies is orthogonal to market movements and conventional risk factors including momentum and reversal factors",
  "doc_id": 83,
  "doc_titulo": "Deep Learning Statistical Arbitrage"
 },
 {
  "afirmacion": "Los patrones de trading aprendidos son asimétricos: el modelo reacciona rápido a movimientos bajistas (últimos 10 días en ventana de 30 días) pero es más cauteloso en tendencias alcistas (primeros 20 días). Los building blocks son patrones suaves de tendencia y reversión.",
  "mercado": "US equities",
  "periodo": "1998-2016",
  "magnitud": "Downturn patterns: focus en últimos 10 días; upturn patterns: focus en primeros 20 días de ventana de 30 días",
  "condiciones": "Análisis de interpretabilidad de los attention patterns del transformer; visualización de filtros convolucionales aprendidos",
  "robustez": "media",
  "cita_textual": "the global dependency patterns which are the most active in downturn movements focus only on the most recent 10 days, while those for upward movements focus on the first 20 days in a 30-day window",
  "doc_id": 83,
  "doc_titulo": "Deep Learning Statistical Arbitrage"
 },
