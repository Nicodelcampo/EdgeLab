 {
  "afirmacion": "El news trading más preciso desplaza (crowds out) al value trading: cuando σ²e disminuye (noticias más precisas), la intensidad de trading del news trader aumenta (∂βN/∂σ²e < 0) y la del value trader disminuye (∂βV/∂σ²e > 0). Sin embargo, esto mejora la liquidez (∂λ/∂σ²e > 0).",
  "mercado": "EURO STOXX 50 Index Futures",
  "periodo": "2013-2023",
  "magnitud": "Precisión de news: 35.3% (2013) → 46.8% (2018, pico) → 29.9% (2023) de la varianza del cambio de valor aprendida vía news. Price impact λ: 0.55 bps/1000 lots (2017, mínimo) → 1.22 bps/1000 lots (2022, máximo)",
  "condiciones": "Estimación estructural por máxima verosimilitud año por año; interpretación de principal trades como news trading y agency trades como value+noise; intervalo de 1 minuto; trading hours 9:00-17:30 CET",
  "robustez": "alta",
  "cita_textual": "news became steadily more precise from revealing 35.3% of the value change in 2013 to revealing 46.8% of it in 2018. Then it declined to 29.9% at the end of the sample in 2023",
  "doc_id": 95,
  "doc_titulo": "Does News Trading Crowd Out Value Trading? Evidence from a Structural Estimation"
 },
 {
  "afirmacion": "La eficiencia de mercado (velocidad de revelación de información en precios) es invariante a la composición del informed trading: el pricing error Σt = (1-t)Σ0 decae linealmente a cero al final de la sesión independientemente de la precisión de las noticias.",
  "mercado": "EURO STOXX 50 Index Futures",
  "periodo": "Modelo teórico (no depende del período empírico)",
  "magnitud": "Σt = (1-t)Σ0; la derivada de Σt respecto a cualquier parámetro es cero",
  "condiciones": "Resultado analítico del modelo en equilibrio lineal único; no depende de supuestos distribucionales específicos más allá de normalidad",
  "robustez": "alta",
  "cita_textual": "Market inefficiency declines linearly in time with the price becoming fully revealing of the fundamental value at the end of trading",
  "doc_id": 95,
  "doc_titulo": "Does News Trading Crowd Out Value Trading? Evidence from a Structural Estimation"
 },
 {
  "afirmacion": "La mayoría de la información descubierta en un día de trading llega durante la sesión: SD de la información que llega intradía (σv) = 23.26 bps, mientras que la información privada al inicio (σ0) = 1.29 bps. Esto implica que >94% del value discovery ocurre intradía.",
  "mercado": "EURO STOXX 50 Index Futures",
