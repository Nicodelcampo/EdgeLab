 },
 {
  "afirmacion": "El Kalman filter reduce el fold-mean maximum drawdown en 71% respecto a OLS estático (-0.31% vs -1.07%) pero degrada el Sharpe ratio de -0.157 a -2.080 debido a un 54% más de turnover (932 vs 607 trades) que amplifica el costo de transacción de 28 bps round-trip.",
  "mercado": "S&P 500 equities (50 large-cap stocks, 8 sectores GICS)",
  "periodo": "2020-2024 (1,258 trading days, 14 OOS folds)",
  "magnitud": "Fold-mean MaxDD: OLS -1.07%, Kalman -0.31% (reducción 71%); Fold-mean Sharpe: OLS -0.157, Kalman -2.080; Trades: OLS 607, Kalman 932; Win rate: OLS 53.0%, Kalman 46.7%; Avg hold: OLS 9.6d, Kalman 2.3d; Wilcoxon W=7, p=0.002 (OLS dominante en 12/14 folds)",
  "condiciones": "Walk-forward con 14 folds OOS; costos 28 bps round-trip; 10 pares por fold seleccionados por double cointegration screen; z-score entry ±2.0, exit ±1.0",
  "robustez": "alta",
  "cita_textual": "Static OLS achieves a fold-mean Sharpe of −0.157 versus −2.080 for Kalman (OLS dominant in 12 of 14 folds)... Kalman reduces fold-mean maximum drawdown by 71% relative to OLS (−0.31% vs. −1.07%)",
  "doc_id": 122,
  "doc_titulo": "Hedge Ratio Estimation and Risk-Return Dissociation in Pairs Trading: Kalman Filtering under Structural Instability"
 },
 {
  "afirmacion": "El filtro HMM de dos estados sobre features del spread reduce el fold-mean MaxDD en 30% adicional respecto a Kalman solo (de -0.31% a -0.22%, Wilcoxon p<0.001), y reduce el número de trades en 45% (de 932 a 508) al suprimir entradas en régimen turbulento.",
  "mercado": "S&P 500 equities",
  "periodo": "2020-2024",
  "magnitud": "Fold-mean MaxDD: Kalman+HMM -0.22% vs Kalman -0.31% (reducción 30%); Trades: 508 vs 932 (-45%); Fold-mean Sharpe: Kalman+HMM -1.671 vs Kalman -2.080",
  "condiciones": "HMM entrenado con Baum-Welch EM sobre features pair-specific (spread volatility, autocorrelation, ADF p-value); Viterbi global decoding sobre OOS completo",
  "robustez": "alta",
  "cita_textual": "HMM conditioning further reduces fold-mean MaxDD by 30% (to −0.22%, Wilcoxon p < 0.001) while cutting trade frequency by 45%",
  "doc_id": 122,
  "doc_titulo": "Hedge Ratio Estimation and Risk-Return Dissociation in Pairs Trading: Kalman Filtering under Structural Instability"
 },
 {
  "afirmacion": "La ventaja de drawdown del Kalman no es explicable por menores holding periods: un OLS con cap de 3 días (Branch D, igualando el holding promedio de Kalman) empeora el MaxDD a -1.24% (peor que OLS estándar a -1.07%), sugiriendo que la reducción de drawdown proviene de adaptación genuina del hedge ratio, no de acortar posiciones.",
  "mercado": "S&P 500 equities",
  "periodo": "2020-2024",
  "magnitud": "Fold-mean MaxDD: Branch D (OLS 3d cap) -1.24% vs OLS estándar -1.07% vs Kalman -0.31%; 81.5% de exits forzados por time-limit en Branch D generan 3.5x turnover estándar",
  "condiciones": "Branch D: OLS con max holding 3 días; resto de parámetros idénticos a Branch A; mecanismo de salida cambia simultáneamente con holding period",
  "robustez": "media",
  "cita_textual": "A 3-day OLS holding cap worsens fold-mean MaxDD to −1.24% (worse than standard OLS at −1.07%). This result is consistent with a structural explanation: Kalman's 71% drawdown advantage cannot be explained by shorter holding periods alone",
  "doc_id": 122,
  "doc_titulo": "Hedge Ratio Estimation and Risk-Return Dissociation in Pairs Trading: Kalman Filtering under Structural Instability"
 },
 {
  "afirmacion": "El Kalman spread sufre un 'signal quality paradox': la contaminación por β-drift (εKalman = εOLS + (β̂-βt)·log Bt) introduce un término no estacionario que degrada la win rate de signal-exit a 52.7% (vs 85.3% OLS). Un posterior variance entry gate (Branch F) repara parcialmente la señal subiendo la win rate a 54.8% y el Sharpe a -1.38.",
  "mercado": "S&P 500 equities",
  "periodo": "2020-2024",
  "magnitud": "Win rate (signal exits): OLS 85.3%, Kalman 52.7%, Kalman+Variance gate (Branch F) 54.8%; Sharpe: Kalman -2.080 → Branch F -1.38",
  "condiciones": "Branch F: zentry = 2.0 + α·Pt/P̄₂₀ con α=0.5; entrada más exigente cuando la incertidumbre del Kalman es alta",
  "robustez": "media",
  "cita_textual": "the Kalman spread decomposes as εKalman = εOLS + (β̂−βt) log Bt, where the contamination term renders the standard z-score non-stationary under active hedge ratio drift",
  "doc_id": 122,
  "doc_titulo": "Hedge Ratio Estimation and Risk-Return Dissociation in Pairs Trading: Kalman Filtering under Structural Instability"
 },
 {
  "afirmacion": "En presencia de alta selección adversa, tener baja aversión al riesgo de inventario puede reducir los retornos, ya que expone a la estrategia por más tiempo a movimientos perjudiciales en los precios.",
