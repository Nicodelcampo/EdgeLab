 },
 {
  "afirmacion": "La simulación computacional basada en tiradas de dados aleatorias logra replicar 5 de 7 características estilizadas clave, incluyendo una curtosis excesiva de 11.07 y memoria prolongada de agrupamiento de volatilidad (ACF cayendo de 0.48 a 0.03 a 100 lags), sin requerir modelos GARCH o lógica compleja intrínseca en los agentes.",
  "mercado": "Simulación Multi-Agente (DiceStock)",
  "periodo": "3,600,000 ticks (~36.6 años simulados)",
  "magnitud": "Curtosis 11.07; índice de Hill 2.74; ACF(lag1) = 0.48",
  "condiciones": "Grid estocástico de 10,000 dados divididos en 10 bandas para parametrización temporal y funcional. Limit order book con prioridad de precio-tiempo.",
  "robustez": "alta",
  "cita_textual": "DiceStock reproduces fat tails (k = 11.07), volatility clustering (ACF = 0.48), and power-law tails (a = 2.74) without kt ever deviating from 1.0. Agent heterogeneity alone... is sufficient.",
  "doc_id": 90,
  "doc_titulo": "DiceStock: Emergent Market Microstructure from Stochastic Dice Mechanics"
 },
 {
  "afirmacion": "La interacción direccional de los agentes en múltiples marcos temporales puede agotar la liquidez del lado comprador, llevando endógenamente a ciclos de colapso extremo (crashes) y largas depresiones en los precios, seguidas de recuperaciones sostenidas, sin requerir shocks externos más allá del ruido estocástico subyacente.",
  "mercado": "Simulación Multi-Agente (DiceStock)",
