 {
  "nombre": "Decreasing fit at deeper LOB levels",
  "descripcion": "El ajuste de datos del modelo Hawkes decrece para órdenes y cancelaciones que ocurren más allá del nivel 6 del LOB, donde la contribución de los efectos de Hawkes decae y el componente de Poisson cobra mayor relevancia.",
  "cita_textual": "we find that beyond depth levels 1 to 6 where our descriptive models offer a satisfactory data fitting performance for order submissions and cancellations, this performance shows a general decreasing trend as we move in events depth level of events occurrence.",
  "doc_id": 85,
  "doc_titulo": "Deep limit order book events dynamics"
 },
 {
  "nombre": "Influence of best price impact events on deep LOB",
  "descripcion": "Los eventos que impactan el mejor precio (trades y envíos de órdenes limitadas) afectan significativamente la llegada de envíos y cancelaciones de órdenes limitadas hasta en los niveles más profundos del libro, mientras que los eventos sin impacto en el mejor precio tienen un efecto más limitado.",
  "cita_textual": "We show that while both trades and limit order submissions with best price impact may affect limit order book submissions and cancellation up to the highest depth levels, the effect of their counterpart events without best price impact is less extended.",
  "doc_id": 85,
  "doc_titulo": "Deep limit order book events dynamics"
 },
 {
  "nombre": "Strong triggering of cancellations by price impact",
  "descripcion": "Las cancelaciones de órdenes limitadas se ven particularmente afectadas (activadas) por eventos que tienen un impacto en el mejor precio, posiblemente debido a estrategias de cancelación sistemática basadas en el ranking de profundidad de la orden.",
  "cita_textual": "We also find that both in terms of individual occurrence effects and global contribution, limit order cancellations appear particularly affected by the events having a best price impact.",
  "doc_id": 85,
  "doc_titulo": "Deep limit order book events dynamics"
 },
 {
