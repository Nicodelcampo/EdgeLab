 },
 {
  "afirmacion": "Eliminar la prueba estadística de cointegración (ADF test) en la selección de pares aumenta la frecuencia de trades e incrementa significativamente la rentabilidad, ya que captura eventos de reversión local a corto plazo (propios del mercado cripto) a expensas de mayor volatilidad.",
  "mercado": "Futuros Perpetuos de Criptomonedas (Binance)",
  "periodo": "Training (2023-02-28 a 2025-02-28)",
  "magnitud": "Annual Return sube de 41.66% a 91.12%, mejorando el Sharpe ratio de 2.68 a 2.98. Trades incrementan un 29%.",
  "condiciones": "Backtest de desarrollo in-sample, sin optimización hiperparamétrica final out-of-sample.",
  "robustez": "media",
  "cita_textual": "Removing the ADF filter increases the number of completed trades... annual return more than doubles from 41.66% to 91.12%. This asymmetry indicates that the additional trades... include several high-impact mean-reversion events that the ADF filter would otherwise exclude.",
  "doc_id": 100,
  "doc_titulo": "Pairs Trading in Crypto"
 },
 {
  "afirmacion": "Un pipeline puramente estadístico enfocado en Z-scores y reglas de control de riesgo es capaz de producir una estrategia de portafolio out-of-sample altamente rentable y estable a pesar de incurrir en fuertes costos de taker fees en un mercado fragmentado.",
  "mercado": "Futuros Perpetuos de Criptomonedas (Binance, top 100 pares)",
  "periodo": "Validación Out-of-Sample (2025-03-01 a 2025-09-30)",
  "magnitud": "Sharpe Ratio 3.44, Max Drawdown 10.97%, Retorno anualizado 102.29%. Taker fees representan el 17.6% del gross profit.",
  "condiciones": "Apalancamiento 5x, taker fee asumido de 5 bps, ejecución asincrónica (simulada) a precios de cierre horarios, control portfolio 100 assets.",
  "robustez": "alta",
  "cita_textual": "Despite this sizable fee drag, the portfolio maintains strong out-of-sample performance, achieving a Sharpe ratio of 3.44 with a maximum drawdown of 10.97%.",
  "doc_id": 100,
  "doc_titulo": "Pairs Trading in Crypto"
 },
