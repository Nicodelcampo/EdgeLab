 },
 {
  "afirmacion": "El modelo DWH-RRFC reporta 97.21% de accuracy en predicción de tendencias de corto plazo en criptomonedas, superando a XGBoost (92.40%), XAI (91.20%) y Reinforcement Learning (70%).",
  "mercado": "Cryptocurrency markets (dataset de Kaggle: Stock Market Dataset for Financial Analysis)",
  "periodo": "no especificado claramente",
  "magnitud": "Accuracy 97.21% (DWH-RRFC) vs 92.40% (XGBoost) vs 91.20% (XAI) vs 70% (RL); Precision 98.03%; Recall 98.53%; F1 97.11%; MAE 0.32; RMSE 0.51; MAPE 1.21",
  "condiciones": "Dataset único de Kaggle; sin split temporal IS/OOS reportado; sin mención de costos de transacción; sin validación cruzada temporal; métricas sospechosamente altas",
  "robustez": "baja",
  "cita_textual": "The DWH-RRFC model produced 97.21% accuracy, compared to Reinforcement Learning (70%), XGBoost (92.40%), and XAI (91.20%)",
