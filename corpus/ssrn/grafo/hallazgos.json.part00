 },
 {
  "afirmacion": "En mercados transparentes, la especulación de los traders estabiliza el mercado y una mayor proporción de HFTs mejora la liquidez.",
  "mercado": "no especificado",
  "periodo": "no especificado",
  "magnitud": "",
  "condiciones": "extraido por Gemini sin desglose de condiciones",
  "robustez": "baja",
  "cita_textual": "",
  "doc_id": 152,
  "doc_titulo": "High frequency trading and fragility"
 },
 {
  "afirmacion": "En mercados opacos, con fricciones informativas, la especulación incrementa la incertidumbre, provocando complementariedades estratégicas donde una menor liquidez lleva a los traders a demandar más liquidez (feedback loop).",
  "mercado": "no especificado",
  "periodo": "no especificado",
  "magnitud": "",
  "condiciones": "extraido por Gemini sin desglose de condiciones",
  "robustez": "baja",
  "cita_textual": "",
  "doc_id": 152,
  "doc_titulo": "High frequency trading and fragility"
 },
 {
  "afirmacion": "La presencia combinada de HFTs y opacidad de la información puede hacer que la liquidez tenga forma de U respecto a la proporción de HFTs y al nivel de transparencia, sugiriendo que facilitar la entrada a más HFTs no siempre mejora la liquidez.",
  "mercado": "no especificado",
  "periodo": "no especificado",
  "magnitud": "",
  "condiciones": "extraido por Gemini sin desglose de condiciones",
  "robustez": "baja",
  "cita_textual": "",
  "doc_id": 152,
  "doc_titulo": "High frequency trading and fragility"
 },
 {
  "afirmacion": "La desconexión temporal de tan solo el 6% de los operadores de alta frecuencia en un entorno opaco provoca un cambio a un equilibrio inferior, reduciendo la liquidez global en un factor de 16.",
  "mercado": "Teórico (simulación matemática)",
  "periodo": "no especificado",
  "magnitud": "16-fold liquidity decrease tras la caída de 6% en FDs",
  "condiciones": "Mercado opaco con información imperfecta sobre flujos pasados.",
  "robustez": "media",
  "cita_textual": "Suppose that a technical “glitch” disconnects 6% of the FDs. In this new situation... a new, unique equilibrium obtains... which corresponds to a 16-fold liquidity decrease.",
  "doc_id": 153,
  "doc_titulo": "High Frequency Trading and Fragility"
 },
 {
  "afirmacion": "La relación entre la liquidez y la cantidad de algoritmos de alta frecuencia (HFT) no es lineal: en mercados asimétricos forma una U invertida, siendo excesiva automatización perjudicial si hay poca transparencia.",
  "mercado": "Teórico (simulación matemática)",
  "periodo": "no especificado",
  "magnitud": "Relación con forma de U invertida (hump-shaped)",
  "condiciones": "Presencia de asimetrías de información y fuerte complementariedad estratégica.",
  "robustez": "media",
  "cita_textual": "in an opaque market strategic complementarities can make liquidity U-shaped in this proportion as well as in the degree of transparency.",
  "doc_id": 153,
  "doc_titulo": "High Frequency Trading and Fragility"
 },
 {
  "afirmacion": "Un pequeño incremento de entre 5% y 7% en la incertidumbre sobre los shocks de volumen de órdenes elimina el régimen de alta liquidez y desencadena un vaciado casi absoluto del libro de órdenes.",
  "mercado": "Teórico (simulación matemática)",
  "periodo": "no especificado",
  "magnitud": "5-7% de shock negativo al endowment precision elimina el equilibrio óptimo",
  "condiciones": "Aumento del riesgo asumido por los traders ante shocks imprevistos en cobertura.",
  "robustez": "media",
  "cita_textual": "a 5% negative shock to τ u1... leads to a downward shift... large enough to eliminate the HLE and move the market towards a new equilibrium with low liquidity",
  "doc_id": 153,
  "doc_titulo": "High Frequency Trading and Fragility"
 },
 {
  "afirmacion": "La mayor actividad HFT induce un aumento significativo del herding de acciones bajo condiciones de mercado extremas.",
  "mercado": "US equities (S&P 100)",
  "periodo": "2015-2017",
  "magnitud": "El coeficiente asociado a la interacción de HFT (HFT_trades) y retornos de mercado cuadrados es -6.595, estadísticamente significativo al 1%.",
  "condiciones": "Regresiones empleando CSAD con proxies de HFT_trades y QuoteUpdates controlando por retornos de mercado absolutos y al cuadrado.",
  "robustez": "alta",
  "cita_textual": "we find that increases in HFT activity lead to a significant increase in stock herding.",
  "doc_id": 155,
  "doc_titulo": "High Frequency Trading and Stock Herding"
 },
 {
  "afirmacion": "El efecto del HFT sobre el herding es notablemente más pronunciado en acciones de gran capitalización (large-cap stocks).",
  "mercado": "US equities (S&P 100 top 30%)",
  "periodo": "2015-2017",
  "magnitud": "El coeficiente de herding inducido por HFT es entre 3.3 (HFT_trades) y 5 veces (QuoteUpdates) mayor para las acciones de gran capitalización en comparación con la muestra total.",
  "condiciones": "Análisis replicado únicamente sobre el decil/top 30% superior de acciones por capitalización de mercado.",
  "robustez": "alta",
  "cita_textual": "The effect of HFT on herding is more pronounced for large-cap stocks",
  "doc_id": 155,
  "doc_titulo": "High Frequency Trading and Stock Herding"
 },
 {
  "afirmacion": "El herding inducido por HFT es más fuerte y prevalente durante días de alta volatilidad del mercado.",
  "mercado": "US equities (S&P 100)",
  "periodo": "2015-2017",
  "magnitud": "Se observa evidencia de herding significativa solo en días del cuartil superior de volatilidad. En días de baja volatilidad, no hay herding inducido e incluso se observa cierto anti-herding con actividad baja de HFT.",
  "condiciones": "La muestra total se divide entre el 25% de días con mayor y menor volatilidad según el índice VIX.",
  "robustez": "alta",
  "cita_textual": "HFT-related herding is more pronounced during more volatile periods and periods of higher liquidity.",
  "doc_id": 155,
  "doc_titulo": "High Frequency Trading and Stock Herding"
 },
 {
  "afirmacion": "El HFT está fuertemente asociado con el herding no fundamental (imitación/ruido), y no muestra relación significativa con el herding fundamental.",
  "mercado": "US equities (S&P 100)",
  "periodo": "2015-2017",
  "magnitud": "Coeficientes de interacción significativamente negativos (-6.18 a -6.74) para CSAD no fundamental; pero estadísticamente insignificantes para el CSAD fundamental.",
  "condiciones": "Descomposición de la métrica CSAD total en componentes fundamentales (vía factores de Fama-French) y no fundamentales (residuales).",
  "robustez": "alta",
  "cita_textual": "We show that HFT-related herding is strongly associated with nonfundamental herding.",
  "doc_id": 155,
  "doc_titulo": "High Frequency Trading and Stock Herding"
 },
 {
  "afirmacion": "La introducción de servicios de 'colocation' y las fechas efectivas de inicio de HFT a nivel internacional generaron un aumento significativo en el herding del mercado.",
  "mercado": "10 international exchanges",
  "periodo": "3 años antes y después del evento por exchange (2000-2013)",
  "magnitud": "Coeficiente significativo de herding de -8.084 (t=-7.14) tras el HFT start date, y -1.32 (t=-3.15) tras la colocation start date.",
  "condiciones": "Regresión en panel internacional con dummies de fechas de evento y efectos fijos de año y de exchange.",
  "robustez": "alta",
  "cita_textual": "we show that HFT effective start dates, and colocation dates are associated with stock herding.",
  "doc_id": 155,
  "doc_titulo": "High Frequency Trading and Stock Herding"
 },
 {
  "afirmacion": "Una infraestructura dedicada (NYSE Technologies) alcanza latencias de procesamiento extremadamente bajas y estables, posibilitando respuestas en microsegundos.",
  "mercado": "US equities",
  "periodo": "2013",
  "magnitud": "Latencia end-to-end de 70 microsegundos, inbound de ~50 microsegundos y outbound de ~21 microsegundos a 36,925 paquetes/seg.",
  "condiciones": "Prueba de simulador utilizando hardware de baja latencia propietario de NYSE, sin incluir latencia de red WAN externa.",
  "robustez": "media",
  "cita_textual": "The total end-to-end latency introduced by the NYSE Technologies platform, including inter-process and inter-server communications, was approximately 70 microseconds (1/1000.000 sec).",
  "doc_id": 156,
  "doc_titulo": "High Frequency Trading and the risk monitoring of automated trading."
 },
 {
  "afirmacion": "La heterogeneidad en las velocidades de los FTs aumenta su poder de mercado agregado y sus ganancias; una pequeña mejora en el ranking de velocidad aumenta exponencialmente la ganancia.",
  "mercado": "Teórico",
  "periodo": "no especificado",
  "magnitud": "Las ganancias esperadas se pueden quintuplicar al subir un puesto en el ranking.",
  "condiciones": "Modelo teórico secuencial de múltiples FTs frente a un liquidity provider lento.",
  "robustez": "baja",
  "cita_textual": "An FT could more than quintuple her expected trading profits by moving up one spot in the speed ranking.",
  "doc_id": 157,
  "doc_titulo": "High Frequency Trading with Speed Hierarchies"
 },
 {
  "afirmacion": "La anticipación de órdenes por parte de los HFT perjudica a los demandantes de liquidez y resulta en precios finales menos informativos.",
  "mercado": "Teórico",
  "periodo": "no especificado",
  "magnitud": "Disminución teórica de la informatividad del precio ex post.",
  "condiciones": "Asume que los HFT capturan señales ruidosas del order flow antes de su ejecución y que los traders informados reaccionan reduciendo su tamaño de orden.",
  "robustez": "baja",
  "cita_textual": "Despite accelerating price discovery, FTs’ trading makes prices ultimately less informative as a result of FTs’ trading.",
  "doc_id": 157,
  "doc_titulo": "High Frequency Trading with Speed Hierarchies"
 },
 {
  "afirmacion": "Aumentar el número de FTs no necesariamente diluye su poder de mercado; si los nuevos participantes son mucho más rápidos, el poder agregado de los FTs puede incluso aumentar.",
  "mercado": "Teórico",
  "periodo": "no especificado",
  "magnitud": "El Herfindahl index (HHI) de los FTs puede caer mientras que su poder de mercado gamma aumenta.",
  "condiciones": "Depende de la jerarquía de velocidad de los nuevos participantes frente a los incumbentes.",
  "robustez": "baja",
  "cita_textual": "If the entrant is faster than all incumbent FTs (t′ < t1), FTs’ market power γ may increase or decrease.",
  "doc_id": 157,
  "doc_titulo": "High Frequency Trading with Speed Hierarchies"
 },
 {
  "afirmacion": "El parámetro de forma de Weibull (indicador de alta frecuencia) y el volumen anormal intradía predicen significativamente si una firma recibirá una oferta de takeover en horizontes de 5 a 20 días.",
  "mercado": "ASX equities",
  "periodo": "1998-2008",
  "magnitud": "Coeficiente logit positivo (p < 0.01) para la probabilidad de takeover, por ej. 7.412 para la predicción a 20 días con ventana de 30 días.",
  "condiciones": "Modelos logit con controles anuales y clustering por sector (GICS), ajustando por tamaño, volatilidad, ratio book-to-market y ROA.",
  "robustez": "media",
  "cita_textual": "The key result is that the Weibull shape parameter significantly predicts takeover events. Further, the intraday abnormal trunover is positive and significant at 1% in most models.",
  "doc_id": 158,
  "doc_titulo": "High Frequency Trading, Information, and Takeovers"
 },
 {
  "afirmacion": "El pre-anuncio de trading informado, representado por la combinación de una oferta inminente y un alto parámetro Weibull intradía, aumenta significativamente el retorno de la acción objetivo.",
  "mercado": "ASX equities",
  "periodo": "1998-2008",
  "magnitud": "Término de interacción de Weibull por indicador de Bid es 0.182 (significativo al 1%).",
  "condiciones": "Regresión de efectos fijos de panel para todo el mercado, controlando por factores específicos de la firma.",
  "robustez": "media",
  "cita_textual": "Here, the interaction term is positive and significant at 1% in all models. This implies that stock returns increase especially with a combination of (a) a bid and (b) pre-takeover informed trade.",
  "doc_id": 158,
  "doc_titulo": "High Frequency Trading, Information, and Takeovers"
 },
 {
  "afirmacion": "A nivel de resoluciones muy cortas (1-5 segundos), los algoritmos de HFT tienden a retirar su provisión de liquidez ante los repuntes de volatilidad, pudiendo agravar de forma ultra-rápida perturbaciones temporales en el precio.",
  "mercado": "no especificado",
  "periodo": "no especificado",
  "magnitud": "",
  "condiciones": "extraido por Gemini sin desglose de condiciones",
  "robustez": "baja",
  "cita_textual": "",
  "doc_id": 159,
  "doc_titulo": "High Frequency Trading, Market Volatility and Trading Counterparty Performance"
 },
 {
  "afirmacion": "A frecuencias de minutos o diarias, una mayor participación de HFT está estadísticamente correlacionada con menor volatilidad en general, actuando como reductor de ineficiencias transitorias de precios.",
  "mercado": "no especificado",
  "periodo": "no especificado",
  "magnitud": "",
  "condiciones": "extraido por Gemini sin desglose de condiciones",
  "robustez": "baja",
  "cita_textual": "",
  "doc_id": 159,
  "doc_titulo": "High Frequency Trading, Market Volatility and Trading Counterparty Performance"
 },
 {
  "afirmacion": "Las contrapartes que más sufren costos a corto plazo frente a los grandes y veloces HFTs, suministrándoles sus rentabilidades recurrentes, son otras firmas HFT más lentas o menores, y operadores fundamentales o institucionales.",
  "mercado": "no especificado",
  "periodo": "no especificado",
  "magnitud": "",
  "condiciones": "extraido por Gemini sin desglose de condiciones",
  "robustez": "baja",
  "cita_textual": "",
  "doc_id": 159,
  "doc_titulo": "High Frequency Trading, Market Volatility and Trading Counterparty Performance"
 },
 {
  "descripcion": "Los resultados demuestran empíricamente que los portafolios basados en ETFs cointegrados muestran fuertes propiedades de reversión a la media, que pueden modelarse eficazmente con un proceso de Ornstein-Uhlenbeck.",
  "cita_textual": "Our results have shown that the sample of ETF pairs-traded portfolios selected exhibit mean-reversion properties that are well modeled as an Ornstein-Uhlenbeck process.",
  "doc_id": 160,
  "doc_titulo": "High-Frequency ETF Pairs Trading"
 },
 {
  "descripcion": "El uso de períodos de optimización y trading más cortos (ej. 5 días) genera mayores retornos globales pero aumenta sustancialmente la exposición a shocks del mercado, por lo que ventanas más amplias (ej. 42 días) brindan un perfil de riesgo más estable.",
  "cita_textual": "while higher total trading returns were correlated with shorter optimization and trading periods, they also carried considerable risk and as such more stable results were found using longer optimization and trading windows.",
  "doc_id": 160,
  "doc_titulo": "High-Frequency ETF Pairs Trading"
 },
 {
  "afirmacion": "La competencia de traders de alta frecuencia (HFT) mejora la liquidez del mercado, especialmente cuando entran HFT pasivos, logrando que los spreads de Alpha converjan con los del TSX.",
  "mercado": "no especificado",
  "periodo": "no especificado",
  "magnitud": "",
  "condiciones": "extraido por Gemini sin desglose de condiciones",
  "robustez": "baja",
  "cita_textual": "",
  "doc_id": 161,
  "doc_titulo": "High-Frequency Trading Competition"
 },
 {
  "afirmacion": "El comportamiento de los HFT se alinea con los modelos de 'quantity competition', caracterizados por un aumento en el volumen total, pérdida de volumen de los HFT ya establecidos e incrementos en la liquidez a medida que entra un nuevo competidor.",
  "mercado": "no especificado",
  "periodo": "no especificado",
  "magnitud": "",
  "condiciones": "extraido por Gemini sin desglose de condiciones",
  "robustez": "baja",
  "cita_textual": "",
  "doc_id": 161,
  "doc_titulo": "High-Frequency Trading Competition"
 },
 {
  "afirmacion": "La entrada agresiva de HFT genera efectos neutrales o levemente positivos para los traders tradicionales, desmintiendo el riesgo teórico de que la competencia HFT deteriore fuertemente la liquidez debido a selección adversa.",
  "mercado": "no especificado",
  "periodo": "no especificado",
  "magnitud": "",
  "condiciones": "extraido por Gemini sin desglose de condiciones",
  "robustez": "baja",
  "cita_textual": "",
  "doc_id": 161,
  "doc_titulo": "High-Frequency Trading Competition"
 },
 {
  "afirmacion": "La abrumadora mayoría de la adaptación inicial del precio de un activo a los movimientos de otro activo relacionado es propulsada de forma directa por transacciones exclusivas de firmas HFT.",
  "mercado": "US equities (NASDAQ, 40 large-cap stocks)",
  "periodo": "Febrero 2010 vs 2000 y 2005",
  "magnitud": "Ventanas temporales decrecen de tomar varios minutos en el año 2000 a sub-10 segundos en el 2010",
  "condiciones": "Analizado aislando algorítmicamente el tipo de participantes detrás de la orden causante del cambio de mid-price.",
  "robustez": "alta",
  "cita_textual": "As seen in the figure, an overwhelming majority of the initial price response is due to HFT activity.",
  "doc_id": 162,
  "doc_titulo": "High-Frequency Trading Synchronizes Prices in Financial Markets"
 },
 {
  "afirmacion": "Existe un nexo estructural fuerte que vincula directamente a la actividad algorítmica con la fuerza cohesiva del mercado: a mayor grado de penetración de HFT, más vigorosa es la correlación del activo.",
  "mercado": "US equities (120 stocks representativos de distintos caps)",
  "periodo": "Febrero 22-26, 2010",
  "magnitud": "Correlación de Pearson de 0.80 y coeficiente de determinación de 0.64",
  "condiciones": "Correlación transversal entre métricas estáticas utilizando franjas discretas de retornos en barras de 30 segundos.",
  "robustez": "alta",
  "cita_textual": "The correlation between these variables is 0.80, and the R2 from a linear fit is 0.64. HFT activity varies significantly from security to security, and synchronization explains the majority of this variance.",
  "doc_id": 162,
  "doc_titulo": "High-Frequency Trading Synchronizes Prices in Financial Markets"
 },
 {
  "afirmacion": "Una sincronía total de los precios neutraliza el edge aislado bajando consistentemente los costos transaccionales agregados, a la vez que fuerza a los flujos informados direccionales puros a licuar drásticamente sus expectativas de ganancia.",
  "mercado": "Teórico (Modelo de Glosten-Milgrom multivariable)",
  "periodo": "no especificado",
  "magnitud": "Baja documentada en la ganancia por unidad transaccional simulada (ej. de 0.5 absoluto baja al entorno del 0.46875)",
  "condiciones": "Estudiado algebraicamente condicionado en combinatoria simple de prioridades en el arribo estocástico de las órdenes.",
  "robustez": "media",
  "cita_textual": "When prices are synchronized, information diffuses rapidly from security to security and informed investors who trade different but related securities are forced to compete with one another. They make less profit as a result.",
  "doc_id": 162,
  "doc_titulo": "High-Frequency Trading Synchronizes Prices in Financial Markets"
 },
 {
  "afirmacion": "Los operadores de alta frecuencia asumen posiciones agregadas en la dirección opuesta a las órdenes de los inversores institucionales, actuando como proveedores de liquidez de corto plazo y descartando comportamientos predatorios.",
  "mercado": "Canadian bond futures",
  "periodo": "2009-2015",
  "magnitud": "Las posiciones retenidas por HFTs raramente exceden $100K de nocional en un momento dado, incluso cuando proveen liquidez a secuencias institucionales de más de $100M.",
  "condiciones": "Evidencia extraída en un mercado consolidado sin fragmentación a nivel de exchanges para el activo, lo que evita la posibilidad de arbitraje transfronterizo no observado.",
  "robustez": "alta",
  "cita_textual": "HFT cumulative order ﬂow is always in the opposite direction of the trade string, meaning HFTs, in net, are sellers to buy trade strings and buyers from sell trade strings. They take the counterparty position.",
  "doc_id": 163,
  "doc_titulo": "High-frequency trading and institutional trading costs"
 },
 {
  "afirmacion": "La mayor competencia entre operadores de alta frecuencia disminuye los costos de transacción para las instituciones, pero el efecto positivo está acotado a posiciones pequeñas y de ejecución rápida.",
  "mercado": "Canadian bond futures",
  "periodo": "Noviembre 2011",
  "magnitud": "El implementation shortfall mejoró significativamente en 31 puntos básicos para secuencias operativas pequeñas ($2-10M) tras la entrada de nuevos HFTs.",
  "condiciones": "Estimado a través de un modelo de diferencia en diferencias alrededor de un evento exógeno de entrada/salida de participantes, empleando como grupo de control a los futuros de tasas de interés.",
  "robustez": "alta",
  "cita_textual": "we ﬁnd HFT competition improved implementation shortfall, eﬀective spreads, and certain per-trade price-impact metrics in the bond future relative to the interest-rate future.",
  "doc_id": 163,
  "doc_titulo": "High-frequency trading and institutional trading costs"
 },
 {
  "afirmacion": "Las acciones con mayor intensidad de HFT generan retornos ajustados por riesgo menores; el quintil más intenso en HFT bajo-rinde al quintil menos intenso en un 6.12% anual (FFC-4 alpha). Esta diferencia deja de ser estadísticamente significativa al controlar por el factor IML (prima de iliquidez).",
  "mercado": "US equities (acciones comunes CRSP)",
  "periodo": "2003-2018",
  "magnitud": "-0.51% mensual (-6.12% anual) bajo FFC-4; no significativo bajo FFC-IML",
  "condiciones": "Acciones ordenadas mensualmente en quintiles de intensidad de HFT, controlando previamente por volatilidad en los últimos 3 meses.",
  "robustez": "media",
  "cita_textual": "the top quintile (highest HFT intensity) significantly underperforms the bottom quintile by a risk-adjusted return of 6.12% per year. ... largely reduced and becomes statistically insignificant once the IML factor is controlled.",
  "doc_id": 165,
  "doc_titulo": "Effect of high-frequency trading on mutual fund performance"
 },
 {
  "afirmacion": "Los fondos mutuos que mantienen carteras sobreponderadas en acciones con alta intensidad de HFT presentan un menor rendimiento ajustado por riesgo comparado con fondos con menor exposición (2.64% anual de underperformance).",
  "mercado": "US active equity mutual funds",
  "periodo": "2003-2018",
  "magnitud": "Diferencia de alpha FFC-4 mensual pre-fee de -0.22% (t-value = 2.40)",
  "condiciones": "Quintiles de fondos formados por la intensidad de HFT promedio ponderada en sus tenencias del trimestre calendario previo.",
  "robustez": "media",
  "cita_textual": "when sorted by HFTH, funds in the top quintile significantly underperform funds in the bottom quintile by a monthly pre-fee alpha of 0.22% (t-value = 2.40), or roughly 2.64% annually.",
  "doc_id": 165,
  "doc_titulo": "Effect of high-frequency trading on mutual fund performance"
 },
 {
  "afirmacion": "La subperformance de los fondos mutuos expuestos al HFT no se debe a mayores costos de transacción institucionales impuestos por los HFTs.",
  "mercado": "US active equity mutual funds",
  "periodo": "2003-2018",
  "magnitud": "La relación negativa persiste incluso usando el retorno de las tenencias simuladas (cero costos).",
  "condiciones": "Reemplazo del NAV-based return por estimación teórica del retorno de las tenencias sin incluir fricciones comerciales.",
  "robustez": "media",
  "cita_textual": "the negative relation between HFT intensity and fund performance exists even if returns of fund holdings, which are not affected by trading costs, are used to replace the net asset value (NAV)–based fund returns",
  "doc_id": 165,
  "doc_titulo": "Effect of high-frequency trading on mutual fund performance"
 },
 {
  "afirmacion": "Los eventos del libro de órdenes que forman parte de un strategic run tienen un impacto permanente en precio significativamente menor que los eventos no pertenecientes a un run, manteniéndose robusto al controlar por tamaño de orden e imbalance del libro.",
  "mercado": "XETRA (10 acciones alemanas más líquidas, ej. SAP, Siemens, Allianz)",
  "periodo": "Enero a Marzo 2023",
  "magnitud": "Impacto de market order: no SR (0.848 bps) vs SR 10+ (0.544 bps). Improving limit order: no SR (0.603 bps) vs SR 10+ (0.277 bps).",
  "condiciones": "Estimado vía SVAR, controlando retardos y categorizado en 9 clases de agresividad.",
  "robustez": "alta",
  "cita_textual": "The results show that the permanent price impact of non-strategic run events is significantly larger than the impact of strategic run events for almost every event type.",
  "doc_id": 166,
  "doc_titulo": "High-Frequency Trading and Price Discovery: The Role of Strategic Runs"
 },
 {
  "afirmacion": "Los dos primeros eventos de un strategic run contribuyen desproporcionadamente más al price discovery que los eventos subsecuentes del mismo run, lo que indica que una vez detectado, el mercado le asigna menor valor informativo.",
  "mercado": "XETRA (10 acciones alemanas más líquidas)",
  "periodo": "Enero a Marzo 2023",
  "magnitud": "Eventos 1-2 contribuyen un 8.187% a la varianza, mientras que los eventos 3+ (detectables) contribuyen 7.228%, pese a ser la inmensa mayoría de los mensajes.",
  "condiciones": "Descomposición de varianza del SVAR dividiendo eventos de runs largos (SR 10+) en iniciales (indetectables a priori) y subsecuentes.",
  "robustez": "media",
  "cita_textual": "According to the estimated SVAR, strategic run activity contributes 15.4% to overall price discovery. Interestingly, more than half of this discovery is impounded via the first two events of the strategic run.",
  "doc_id": 166,
  "doc_titulo": "High-Frequency Trading and Price Discovery: The Role of Strategic Runs"
 },
 {
  "afirmacion": "Las re-sumisiones dentro de un strategic run que modifican su agresividad (particularmente aumentándola) tienen un mayor impacto permanente en el precio, sugiriendo que actualizan información valiosa sobre futuros movimientos del midpoint.",
  "mercado": "XETRA (10 acciones alemanas más líquidas)",
  "periodo": "Enero a Marzo 2023",
  "magnitud": "Impacto de limit order al BBO que incrementa agresividad: 0.115 bps, frente a 0.068 bps si no cambia la agresividad (diferencia de +0.046 bps).",
  "condiciones": "Subdivisión de los runs largos (SR 10+) según el cambio en agresividad (incremento, sin cambio, disminución).",
  "robustez": "media",
  "cita_textual": "The column (I - II) shows the difference between the price impact of limit orders increasing the aggressiveness of the run and those that do not affect the run's aggressiveness. For each event type this difference is positive and statistically significant.",
  "doc_id": 166,
  "doc_titulo": "High-Frequency Trading and Price Discovery: The Role of Strategic Runs"
 },
 {
  "afirmacion": "La actividad de HFT y sus beneficios asociados (estrechamiento de spreads y aumento de liquidez) se concentran significativamente en criptomonedas de gran capitalización, siendo ineficaces en altcoins ilíquidas.",
  "mercado": "Exchanges de criptomonedas (Binance, Coinbase, Kraken)",
  "periodo": "Ventana de 12 meses",
  "magnitud": "No reporta métricas numéricas exactas (estudio descriptivo)",
  "condiciones": "Aplica a activos altamente líquidos versus altcoins menos líquidas",
  "robustez": "baja",
  "cita_textual": "Empirical analysis of major exchanges such as Binance, Coinbase, and Kraken reveals that HFT participation is highest in large-cap cryptocurrencies like Bitcoin and Ethereum, which offer sufficient liquidity and narrow bid-ask spreads",
  "doc_id": 168,
  "doc_titulo": "High-Frequency Trading in Cryptocurrency Exchanges: Benefits and Risks"
 },
 {
  "afirmacion": "La actividad algorítmica de alta frecuencia presenta una correlación positiva con los picos de volatilidad en los precios durante períodos de estrés o baja liquidez en el mercado.",
  "mercado": "Exchanges de criptomonedas (Binance, Coinbase, Kraken)",
  "periodo": "Ventana de 12 meses",
  "magnitud": "Correlación positiva (sin coeficientes específicos)",
  "condiciones": "Momentos de iliquidez o sentimiento extremo en los que intervienen algoritmos automatizados",
  "robustez": "baja",
  "cita_textual": "Evidence from major cryptocurrency exchanges suggests that HFT activity is positively correlated with spikes in price volatility during periods of low liquidity or extreme market sentiment",
  "doc_id": 168,
  "doc_titulo": "High-Frequency Trading in Cryptocurrency Exchanges: Benefits and Risks"
 },
 {
  "afirmacion": "Los HFTs orientados a tomar liquidez emplean intensamente momentum a ultra-corto plazo cuando detectan tensión en el mercado, dominando numéricamente a los proveedores pasivos y amplificando la volatilidad intradiaria real.",
  "mercado": "Bund futures",
  "periodo": "Marzo y Junio 2014",
  "magnitud": "Ratio de Momentum positivo en HFT activos (0.5541 en la semana de alta volatilidad)",
  "condiciones": "Muestra separada por umbral de volatilidad exógeno (VDAX) computada sobre ventanas de 1 minuto.",
  "robustez": "media",
  "cita_textual": "active HFTs tend to follow momentum strategies, implying that they trade in the direction of the market return, which can increase intraday price movements.",
  "doc_id": 169,
  "doc_titulo": "High-frequency trading in the Bund futures market"
 },
 {
  "afirmacion": "En el lapso de escasos milisegundos posterior a la emisión de una novedad macroeconómica clave, la contribución del algoritmo rápido (HFT) al descubrimiento de precios domina al grueso de participantes del mercado.",
  "mercado": "Bund futures",
  "periodo": "Julio 2013 a Junio 2014",
  "magnitud": "Impacto residual vía funciones de impulso-respuesta al décimo tick de ~0.607 (HFT) vs 0.120 (NHFT).",
  "condiciones": "Modelo Vectorial Autorregresivo de ordenamientos tick a tick anclado en datos de empleo y tasas BCE.",
  "robustez": "alta",
  "cita_textual": "The impulse response function for HFTs after 10 ticks is around ﬁve times as high as for NHFTs. This implies that an innovation in HFT trading induces a 400% greater price change than an innovation in NHFT trading",
  "doc_id": 169,
  "doc_titulo": "High-frequency trading in the Bund futures market"
 },
 {
  "afirmacion": "A pesar de integrar información valiosa, el violento 'information arbitrage' del HFT genera altísimo ruido transitorio; los tics de estas ráfagas sobre-corrigen produciendo una varianza ruidosa que erosiona la eficiencia al cortísimo plazo.",
  "mercado": "Bund futures",
  "periodo": "Julio 2013 a Junio 2014",
  "magnitud": "HFTs imponen 33.4% a la varianza transitoria vs apenas un 9.2% en el factor permanente a los 10 ticks (ratio < 1).",
  "condiciones": "Descomposición ortogonal asintótica (Hasbrouck, 1993) aplicada al componente direccional neto y retornos.",
  "robustez": "alta",
  "cita_textual": "HFT trades add a large amount to noise, which is about 33% after 10 ticks... indicating that HFTs’ fast trading after the news release contributes much more to transitory volatility than to information.",
  "doc_id": 169,
  "doc_titulo": "High-frequency trading in the Bund futures market"
 },
 {
  "afirmacion": "Los participantes rápidos pasivos extraen proactivamente una masiva cantidad de liquidez (mediante cancelaciones de órdenes directas) inmediatamente antes de releases calendarizados o tras repuntes abruptos de volatilidad para sortear exposición adversa.",
  "mercado": "Bund futures",
  "periodo": "Julio 2013 a Junio 2014 (eventos) y Marzo/Junio 2014",
  "magnitud": "Incremento de cancelaciones sostenido que duplica holgadamente la inactividad natural durante los cinco minutos previos al anuncio NFP.",
  "condiciones": "Filtro de ratio de deleción en exceso respecto al nivel promedio diario para eventos determinísticos y choques aleatorios.",
  "robustez": "alta",
  "cita_textual": "passive HFTs increasingly cancel limit orders already several minutes before the data are released and scale back their order submission activity at the same time due to the known risk of being adversely selected.",
  "doc_id": 169,
  "doc_titulo": "High-frequency trading in the Bund futures market"
 },
 {
  "afirmacion": "Los algoritmos de alta frecuencia generan beneficios rentables consistentemente superiores a los inversores tradicionales (no-HFT) al arbitrar sistemáticamente ineficiencias menores.",
  "mercado": "Borsa Istanbul (BIST)",
  "periodo": "Junio 2024",
  "magnitud": "1.1163 de diferencia significativa a favor de HFT",
  "condiciones": "Simulación con 100 ciclos y costos de transacción fijos de 3.5 puntos base (bps)",
  "robustez": "baja",
  "cita_textual": "As a result, there is a significant difference of 1.1163 between HFT and Non-HFT. HFT transactions have more profit than non-HFT transactions.",
  "doc_id": 171,
  "doc_titulo": "High-Frequency Trading; Price Discovery and Efficient Market Hypothesis"
 },
 {
  "afirmacion": "La penetración de flujos HFT impacta negativamente la divergencia de precios de los activos, contribuyendo a la convergencia a su valor fundamental (price discovery).",
  "mercado": "Borsa Istanbul (BIST)",
  "periodo": "Junio 2024",
  "magnitud": "Coeficiente estadísticamente significativo negativo (p<0.01)",
  "condiciones": "Estimación mediante regresión Pooled OLS que controla por beneficios y conteos de transacciones",
  "robustez": "baja",
  "cita_textual": "The first model (column 1) indicates that HFT has a statistically significant negative effect on price discovery. [...] This signifies that HFT serves to improve market efficiency by reducing price discrepancies.",
  "doc_id": 171,
  "doc_titulo": "High-Frequency Trading; Price Discovery and Efficient Market Hypothesis"
 },
 {
  "afirmacion": "Los inversores institucionales negocian menos en ETFs cuyos mercados subyacentes tienen MTU elevadas. El coeficiente de MTU sobre el volumen institucional de 20K shares es 3.1581 con t-stat de 19.65 (Panel C) incluyendo EWY y DXJ.",
  "mercado": "40 US-listed country ETFs",
  "periodo": "Panel completo con 2,273-2,893 observaciones",
  "magnitud": "Coeficiente MTU sobre 20K INST #: 3.1581*** (t=19.65); R-squared hasta 0.164",
  "condiciones": "Panel regression con variables de control y efectos fijos de ETF",
  "robustez": "alta",
  "cita_textual": "3.1581*** (19.65) ... R-squared 0.162 Obs 2,893",
  "doc_id": 172,
  "doc_titulo": "How Trading Barriers in Underlying Asset Markets Impact ETF Trading and Characteristics"
 },
 {
  "afirmacion": "La actividad de arbitraje institucional es menor, el tracking error mayor y el PIN menor en ETFs con barreras de entrada elevadas en sus subyacentes.",
  "mercado": "US-listed country ETFs",
  "periodo": "Muestra completa",
  "magnitud": "No se reportan magnitudes exactas de arbitraje y PIN en la sección visible, pero los coeficientes son estadísticamente significativos",
  "condiciones": "Modelos con efectos fijos de ETF y variables de control",
  "robustez": "alta",
  "cita_textual": "Those that have high entry barriers exhibit a lower institutional arbitrage activity, a greater spread between the ETF price and the net asset value (NAV), greater tracking errors, and a lower probability of informed trading (PIN).",
  "doc_id": 172,
  "doc_titulo": "How Trading Barriers in Underlying Asset Markets Impact ETF Trading and Characteristics"
 },
 {
  "afirmacion": "Tras la reducción de MTU en Japón, Singapur y Vietnam, el trading institucional en ETFs aumenta gradualmente, el tracking error disminuye y el PIN aumenta de forma persistente.",
