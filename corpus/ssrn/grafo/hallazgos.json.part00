 {
  "afirmacion": "Aplicar la transformada wavelet (MODWT, sym22) a las series de precios mejora de forma considerable los retornos del pairs trading, revirtiendo la tendencia de retornos negativos de los métodos estándar y obteniendo entre un 9.66% y un 11.82% anual antes de costos.",
  "mercado": "US equities (S&P 500 constituents)",
  "periodo": "2010 - 2018",
  "magnitud": "Mejora de retornos promedio de -1.81% a 9.66% (cointegración) y de -0.55% a 11.82% (distancia mínima). Tras costos, los retornos anormales van de 8.5% a 11.7% anual.",
  "condiciones": "Período de formación 1 año, período de trading 1 año out-of-sample, umbrales fijos a 2 desviaciones estándar.",
  "robustez": "alta",
  "cita_textual": "we observe a substantial increase in the returns of the pairs-trading strategy... even after the transaction costs, abnormal returns remain persistent.",
  "doc_id": 146,
  "doc_titulo": "Pairs Trading with Wavelet Transform"
 },
 {
  "afirmacion": "El filtrado del ruido reduce drásticamente las métricas de riesgo a la baja (downside risk), minimizando tanto el Maximum Drawdown como el CVaR, y aumentando el Ratio de Sharpe en las estrategias de pares.",
  "mercado": "US equities (S&P 500 constituents)",
  "periodo": "2010 - 2018",
  "magnitud": "Sharpe Ratio medio mejora de -0.40 a 2.81 (cointegración). Max Drawdown cae a menos de la mitad (ej. 5.59% a 2.30%). Porcentaje de trades positivos sube de ~49% a ~66%.",
  "condiciones": "Medición diaria de retornos out-of-sample.",
  "robustez": "alta",
  "cita_textual": "wavelet filtering the prices reduces the downside risk of the trades considerably.",
  "doc_id": 146,
  "doc_titulo": "Pairs Trading with Wavelet Transform"
 },
 {
  "afirmacion": "La principal fuente de mejora se debe a que el filtrado de ruido permite una estimación de parámetros (pesos) mucho más precisa y robusta para el spread, logrando que mantengan su validez y propiedades de reversión a la media durante el año out-of-sample.",
  "mercado": "US equities (S&P 500 constituents)",
  "periodo": "2010 - 2018",
  "magnitud": "Duplica la proporción de trades totalmente convergentes y hace que el remanente de trades no-convergentes (forzados a cerrar al final del período) promedie leves ganancias en lugar de pérdidas fuertes (-16.7% sin filtrar).",
  "condiciones": "Descomposición de beneficios por tipo de cierre de trade (Full Convergent, Partial, Non-Convergent).",
  "robustez": "alta",
  "cita_textual": "Without filtering, the parameters estimated in the training period lose relevance in the trading period. However, when prices are filtered from common noise, the parameters maintain relevance much longer",
  "doc_id": 146,
  "doc_titulo": "Pairs Trading with Wavelet Transform"
 },
 {
  "afirmacion": "La estrategia de trading direccional basada en la trayectoria causal térmica óptima logra hit ratios de entre 54.4% y 66.5% operando en pares de acciones de NYSE en frecuencia de segundos.",
  "mercado": "no especificado",
  "periodo": "no especificado",
