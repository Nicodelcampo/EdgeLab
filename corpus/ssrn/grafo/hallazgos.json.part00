 {
  "afirmacion": "Co-location no es un buen proxy para el inicio de AT y HFT. Las reducciones pronunciadas en trade size ocurrieron al menos 8 meses antes de la introducción de servicios de co-location en la mayoría de las bolsas.",
  "mercado": "24 bolsas internacionales",
  "periodo": "Período alrededor de fechas de co-location en cada bolsa",
  "magnitud": "Al menos 8 meses de anticipación del HFT respecto a la co-location",
  "condiciones": "Muestra manual de fechas de co-location de múltiples bolsas",
  "robustez": "alta",
  "cita_textual": "Our empirical results show pronounced reductions in trade size that occurred long before the introduction of colocation services (we estimate it was at least 8 months across the exchanges in our sample).",
  "doc_id": 178,
  "doc_titulo": "Trade Size, High Frequency Trading, and Co-Location Around the World"
 },
 {
  "afirmacion": "Un exchange tiene entre 27.6% y 44.5% más de probabilidad de ofrecer servicios de co-location cuando HFT está presente (resultados estadísticamente significativos al menos al 5%).",
  "mercado": "Bolsas internacionales (24 exchanges)",
  "periodo": "Muestra de 2,542-2,544 observaciones",
  "magnitud": "27.6% (estimación conservadora) a 44.5% (estimación menos conservadora); Pseudo R2 0.0822-0.3303",
  "condiciones": "Modelos probit controlando por variables macro, legales y de mercado",
  "robustez": "alta",
  "cita_textual": "In our most conservative estimate, an exchange is 27.6% more likely to offer colocation services when HFT is present. In our least conservative estimate, an exchange is 44.5% more likely.",
  "doc_id": 178,
  "doc_titulo": "Trade Size, High Frequency Trading, and Co-Location Around the World"
 },
 {
  "afirmacion": "No se encuentra evidencia consistente de que la introducción de co-location cause cambios significativos en el trade size, contradiciendo estudios previos que usan co-location como proxy de AT/HFT.",
  "mercado": "24 bolsas internacionales",
  "periodo": "Ventanas alrededor de fechas de co-location",
  "magnitud": "Resultados mixtos, sin evidencia consistente",
  "condiciones": "Análisis univariante y multivariante con controles",
  "robustez": "alta",
  "cita_textual": "We do not find consistent evidence in support of the view that colocation causes trade size changes.",
  "doc_id": 178,
  "doc_titulo": "Trade Size, High Frequency Trading, and Co-Location Around the World"
 },
 {
