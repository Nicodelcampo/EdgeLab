     "objeto_texto": "adverse selection",
     "doc_id": 28,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Glosten-Milgrom model",
     "doc_id": 28,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "revelatory price efficiency",
     "doc_id": 41,
     "revisar": false
    },
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "order book depth",
     "doc_id": 51,
     "revisar": false
    },
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "order aggressiveness",
     "doc_id": 51,
     "revisar": false
