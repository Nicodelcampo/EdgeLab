     "doc_id": 57,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Tail Dependence",
     "doc_id": 215,
     "revisar": false
    },
    {
     "tipo": "MEJORA_A",
