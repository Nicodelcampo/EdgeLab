  {
   "id": "market making",
   "nombre_canonico": "market making",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Market Making",
    "market making"
   ],
   "menciones": 23,
   "doc_frecuencia": 23,
   "doc_ids": [
    11,
