  {
   "id": "limit order book lob",
   "nombre_canonico": "limit order book",
   "tipo": "concepto",
   "nombres_vistos": [
    "Limit Order Book",
    "Limit Order Book (LOB)",
    "limit order book"
   ],
   "menciones": 26,
   "doc_frecuencia": 26,
   "doc_ids": [
    11,
