    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "walk-forward validation",
     "doc_id": 7,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "market microstructure model",
     "doc_id": 11,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "spurious correlation",
     "doc_id": 18,
     "revisar": false
    },
