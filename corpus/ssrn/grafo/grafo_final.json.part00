     "doc_id": 115,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "market impact",
     "doc_id": 118,
     "revisar": false
    },
    {
     "tipo": "USA",
