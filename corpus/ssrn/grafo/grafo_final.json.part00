  {
   "id": "effective spread",
   "nombre_canonico": "effective spread",
   "tipo": "metrica",
   "nombres_vistos": [
    "Effective Spread",
    "effective spread"
   ],
   "menciones": 6,
   "doc_frecuencia": 6,
   "doc_ids": [
    12,
    60,
    148,
    163,
    174,
    293
   ],
   "definiciones": [
    {
     "texto": "Costo de transacción real pagado por clientes finales, sustancialmente mayor que el spread cotizado entre ask y bid oficiales; en episodios de exceso de demanda llegó a superar el 10%.",
     "doc_id": 12
    },
    {
     "texto": "Medida central del costo de ejecución de una operación. En venues TradFi/CEX captura el spread efectivo; en AMMs suma la tarifa base y el impacto en precio.",
     "doc_id": 60
    },
    {
     "texto": "Costo transaccional real para los demandantes de liquidez, medido como la desviación del precio del trade respecto al punto medio (midprice).",
     "doc_id": 148
    },
    {
     "texto": "Medida de costo de transacción inmediato de un trade particular, calculada como la diferencia con signo entre el precio ejecutado y el punto medio del spread (midquote) contemporáneo.",
     "doc_id": 163
    },
    {
     "texto": "Diferencia calculada basándose en el doble del valor absoluto entre el precio de transacción y el precio intermedio entre el bid y el ask.",
     "doc_id": 174
    },
    {
     "texto": "Diferencia entre el precio al que un trader compra/vende y el valor fundamental reflejado por el midpoint. Cuantifica el costo real de ejecución incluyendo movimiento de precio e impacto de mercado.",
     "doc_id": 293
    }
   ],
   "citas": [
    {
     "texto": "The effective bid-ask spread at times increased to more than 10 percent",
     "doc_id": 12
    },
    {
     "texto": "Effective spread is the primary execution cost metric. In equity and CEX order book markets it is calculated as twice the absolute difference between the transaction price and the prevailing mid-quote",
     "doc_id": 60
    },
    {
     "texto": "We use the relative quoted spread and the effective-half spread which measure the transaction costs dimension of liquidity.",
     "doc_id": 148
    },
    {
     "texto": "Eﬀective spread is the signed diﬀerence between the trade price and contemporaneous midquote",
     "doc_id": 163
    },
    {
     "texto": "ESPR – effective spread defined as 2 x |PT - PMidpoint|, where PT is the trade price,",
     "doc_id": 174
    },
    {
     "texto": "Effective spread can be considered an estimate of the trader's actual execution cost and the gross revenue earned by the liquidity provider.",
     "doc_id": 293
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "bid-ask spread",
     "doc_id": 12,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "liquidity",
