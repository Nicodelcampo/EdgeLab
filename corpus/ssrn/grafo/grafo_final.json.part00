     "doc_id": 210,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Rolling Window Backtest",
     "doc_id": 267,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
