   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    136
   ],
   "definiciones": [
    {
     "texto": "Modelos de volatilidad estocástica (Heston 1993) y rough volatility (Gatheral et al., 2018) que imponen restricciones de calibración. Deep calibration puede acelerarlos pero debe preservar las relaciones modelo-implied entre paths, precios y superficies.",
     "doc_id": 136
    }
   ],
   "citas": [
    {
     "texto": "Rough volatility illustrates why this distinction matters. Deep calibration can make them operational, yet the learned system must still preserve the model-implied relation",
