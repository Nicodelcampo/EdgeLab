    "trading stop"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    154
   ],
   "definiciones": [
    {
     "texto": "Niveles predefinidos para salir de una operación, calculados teóricamente para maximizar la utilidad descontada esperada de la posición.",
     "doc_id": 154
    }
   ],
   "citas": [
    {
     "texto": "we show how to derive optimal trading stops for generic algorithmic trading strategies when the P&L of the position is modelled by a Markov modulated diﬀusion.",
     "doc_id": 154
    }
   ],
   "relaciones_crudas": [
