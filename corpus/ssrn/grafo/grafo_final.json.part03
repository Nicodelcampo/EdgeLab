  {
   "id": "double debiased machine learning",
   "nombre_canonico": "Double/Debiased Machine Learning",
   "tipo": "metodo",
   "nombres_vistos": [
    "Double/Debiased Machine Learning"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    192
   ],
   "definiciones": [
    {
     "texto": "Método econométrico de Chernozhukov et al. (2018) que construye Neyman-orthogonal scores y usa sample splitting (cross-fitting) para reducir sesgo de regularización, permitiendo inferencia asintóticamente normal con parámetros de baja dimensión en presencia de funciones nuisance de alta dimensión.",
     "doc_id": 192
    }
   ],
   "citas": [
    {
     "texto": "Chernozhukov et al. develop double/debiased machine learning (DML), which constructs Neyman-orthogonal score functions and uses sample splitting (cross-fitting) to reduce regularization bias.",
     "doc_id": 192
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "causal inference",
     "doc_id": 192,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "regularization bias",
     "doc_id": 192,
     "revisar": false
    }
   ]
  },
  {
   "id": "causal inference",
   "nombre_canonico": "Causal Inference",
   "tipo": "metodo",
   "nombres_vistos": [
    "Causal Inference"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    192
   ],
   "definiciones": [
    {
     "texto": "Estimación de efectos causales (de cambios de política, reglas de ejecución o disclosures) sobre liquidez y volatilidad usando DML cuando el parámetro admite representación de score ortogonal con funciones nuisance de alta dimensión.",
     "doc_id": 192
    }
   ],
   "citas": [
    {
     "texto": "DML can be used when the causal parameter admits an orthogonal score representation with high-dimensional nuisance functions.",
     "doc_id": 192
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
