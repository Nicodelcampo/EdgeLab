   "doc_frecuencia": 1,
   "doc_ids": [
    180
   ],
   "definiciones": [
    {
     "texto": "Modelo econométrico utilizado para estimar y modelar la volatilidad condicional que varía en el tiempo en el mercado accionario, permitiendo evaluar la eficacia de las estrategias frente al riesgo.",
     "doc_id": 180
    }
   ],
   "citas": [
    {
     "texto": "The GARCH(1,1) model captures time-varying volatility... where σt² is conditional variance at time t",
     "doc_id": 180
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "market volatility",
     "doc_id": 180,
     "revisar": false
    }
   ]
  },
  {
   "id": "value at risk var",
   "nombre_canonico": "Value at Risk (VaR)",
   "tipo": "metrica",
   "nombres_vistos": [
    "Value at Risk (VaR)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    180
   ],
   "definiciones": [
    {
     "texto": "Medida de riesgo que estima la pérdida potencial máxima a un nivel de confianza del 95%, empleada para demostrar que las restricciones de riesgo en estrategias cuantitativas reducen significativamente las pérdidas en la cola de distribución.",
     "doc_id": 180
    }
   ],
   "citas": [
    {
     "texto": "Value at Risk at confidence level (1-α) is defined as: VaRα = min{v : P(Rp < -v) ≤ α}",
     "doc_id": 180
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "tail risk",
     "doc_id": 180,
     "revisar": false
    }
   ]
  },
  {
   "id": "volatility regime",
   "nombre_canonico": "volatility regimes",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "volatility regimes"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    180
   ],
   "definiciones": [
    {
     "texto": "Clasificación de estados de mercado en base a cuartiles de desviación estándar móvil a 30 días, que demuestra cómo el desempeño relativo de las estrategias de trading varía fuertemente según el régimen.",
     "doc_id": 180
    }
   ],
   "citas": [
    {
     "texto": "Volatility regimes defined based on rolling 30-day standard deviation quartiles: Low Vol (Q1), Medium Vol (Q2-Q3), High Vol (Q4).",
     "doc_id": 180
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "strategy performance patterns",
     "doc_id": 180,
     "revisar": false
    }
   ]
  },
  {
   "id": "fama french 3 factor regression",
   "nombre_canonico": "Fama-French 3-Factor Regression",
   "tipo": "metodo",
   "nombres_vistos": [
    "Fama-French 3-Factor Regression"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    180
   ],
   "definiciones": [
    {
     "texto": "Análisis utilizado para desglosar el origen de los retornos, confirmando que la estrategia momentum en mercados indios genera alfa genuino tras ajustar por mercado, tamaño y valor.",
     "doc_id": 180
    }
   ],
   "citas": [
    {
     "texto": "The Fama-French 3-factor regression results (Table 4) reveal that momentum strategy alpha... is economically substantial",
     "doc_id": 180
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "abnormal returns",
     "doc_id": 180,
     "revisar": false
    }
   ]
  },
  {
   "id": "price clustering",
   "nombre_canonico": "price clustering",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "price clustering"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    181
   ],
   "definiciones": [
    {
     "texto": "Tendencia de los precios a agruparse en números específicos (ej. terminados en 00, 99 o 01), facilitando la negociación táctica pero distorsionando la distribución uniforme.",
     "doc_id": 181
    }
   ],
   "citas": [
    {
     "texto": "Studies have found similar price clustering patterns in Bitcoin markets [6–11], with prices clustering most at 00, followed by 99, 01, or 50.",
     "doc_id": 181
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "transaction costs",
     "doc_id": 181,
     "revisar": false
    }
   ]
  },
  {
   "id": "zero fee trading",
   "nombre_canonico": "zero-fee trading",
   "tipo": "concepto",
   "nombres_vistos": [
    "zero-fee trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    181
   ],
   "definiciones": [
    {
     "texto": "Estructura de mercado sin comisiones por transacción, lo cual altera el comportamiento de los participantes y disminuye los precios agrupados artificialmente.",
     "doc_id": 181
    }
   ],
   "citas": [
    {
     "texto": "Results suggest that zerofee trading has a signiﬁcant impact on price clustering, highlighting the need to consider this factor in analyzing market dynamics.",
     "doc_id": 181
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "price clustering",
     "doc_id": 181,
     "revisar": false
    }
   ]
  },
  {
   "id": "strategic trading",
   "nombre_canonico": "strategic trading",
   "tipo": "estrategia",
   "nombres_vistos": [
    "strategic trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    181
   ],
   "definiciones": [
    {
     "texto": "Colocación táctica de órdenes en niveles específicos de precio (ej. usando 99 en lugar de 00) para ganar prioridad en el limit order book o aprovechar zonas de liquidez.",
     "doc_id": 181
    }
   ],
   "citas": [
    {
     "texto": "The presence of strategic trading [5] also plays a role in the occurrence of price clustering.",
     "doc_id": 181
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "price clustering",
     "doc_id": 181,
     "revisar": false
    }
   ]
  },
  {
   "id": "convergence risk",
   "nombre_canonico": "Convergence Risk",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "Convergence Risk"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    182
   ],
   "definiciones": [
    {
     "texto": "Riesgo de que el pricing error entre pares no converja dentro del horizonte esperado, exponiendo al arbitrajista a pérdidas intermedias que pueden forzar liquidación anticipada por margin calls.",
     "doc_id": 182
    }
   ],
   "citas": [
    {
     "texto": "Interim losses may trigger margin calls and force early liquidation. Since arbitrageurs are often capital-constrained and use leverage, they are especially sensitive to convergence risk.",
     "doc_id": 182
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "limits to arbitrage",
     "doc_id": 182,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "no-arbitrage band",
     "doc_id": 182,
     "revisar": false
    }
   ]
  },
  {
   "id": "no arbitrage band",
   "nombre_canonico": "No-Arbitrage Band",
   "tipo": "concepto",
   "nombres_vistos": [
    "No-Arbitrage Band"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    182
   ],
   "definiciones": [
    {
     "texto": "Banda alrededor del equilibrio de pricing error dentro de la cual el arbitraje no es rentable tras costes. En el MGST se determina endógenamente con nivel y ancho de banda específicos para cada par.",
     "doc_id": 182
    }
   ],
   "citas": [
    {
     "texto": "The MGST strategy's ability to tailor arbitrage mechanisms to individual pairs is what drives its superior returns.",
     "doc_id": 182
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "convergence risk",
     "doc_id": 182,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "MGST function",
     "doc_id": 182,
     "revisar": false
    }
   ]
  },
  {
   "id": "modified generalized smooth transition",
   "nombre_canonico": "Modified Generalized Smooth-Transition",
   "tipo": "metodo",
   "nombres_vistos": [
    "Modified Generalized Smooth-Transition"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    182
   ],
   "definiciones": [
    {
     "texto": "Función que modela la transición suave entre estados de arbitraje y no-arbitraje, incorporando un proceso DeTGARCH para la volatilidad condicional del pricing error. Sus parámetros se asemejan a un GARCH-in-Mean.",
     "doc_id": 182
    }
   ],
   "citas": [
    {
     "texto": "We introduce a Modified Generalized Smooth-Transition (MGST) function, whose parameters resemble those of a GARCH-in-Mean process, to estimate pair-specific convergence risk.",
     "doc_id": 182
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "GST function",
     "doc_id": 182,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "DeTGARCH",
     "doc_id": 182,
     "revisar": false
    }
   ]
  },
  {
   "id": "double endogenou threshold garch",
   "nombre_canonico": "Double-Endogenous Threshold GARCH",
   "tipo": "metodo",
   "nombres_vistos": [
    "Double-Endogenous Threshold GARCH"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    182
   ],
   "definiciones": [
    {
     "texto": "Especificación GARCH con umbrales separados para pricing errors positivos y negativos, permitiendo volatilidad asimétrica sin asumir direccionalidad. Los umbrales se estiman endógenamente.",
     "doc_id": 182
    }
   ],
   "citas": [
    {
     "texto": "DeTGARCH offers three advantages over standard GARCH. First, separate thresholds for positive and negative omega allow for arbitrage asymmetry, resulting in a skewed no-arbitrage band.",
     "doc_id": 182
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "GARCH",
     "doc_id": 182,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "MGST function",
     "doc_id": 182,
     "revisar": false
    }
   ]
  },
  {
   "id": "pricing error",
   "nombre_canonico": "Pricing Error",
   "tipo": "metrica",
   "nombres_vistos": [
    "Pricing Error"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    182
   ],
   "definiciones": [
    {
     "texto": "Desalineación en precios normalizados entre pares de valores en el tiempo t. Representa la desviación del equilibrio de no-arbitraje y sigue un proceso de corrección de error con volatilidad condicional.",
     "doc_id": 182
    }
   ],
   "citas": [
    {
     "texto": "The pricing error omega refers to the misalignment in normalized prices between paired securities i at time t.",
     "doc_id": 182
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "mispricing",
     "doc_id": 182,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "pairs trading",
     "doc_id": 182,
     "revisar": false
    }
   ]
  },
  {
   "id": "vector error correction model",
   "nombre_canonico": "Vector Error-Correction Model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Vector Error-Correction Model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    182
   ],
   "definiciones": [
    {
     "texto": "Modelo bivariante que relaciona los retornos de dos activos cointegrados con el pricing error rezagado, incorporando la función MGST para modelar la corrección de error con transición suave entre regímenes.",
     "doc_id": 182
    }
   ],
   "citas": [
    {
     "texto": "We embed a modified generalized smooth transition (MGST) function in a Vector Error-Correction Model (VECM), allowing the error-correction process to transition between arbitrage and no-arbitrage states.",
     "doc_id": 182
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "cointegration",
     "doc_id": 182,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "MGST function",
     "doc_id": 182,
     "revisar": false
    }
   ]
  },
  {
   "id": "vwap strategy",
   "nombre_canonico": "VWAP Strategy",
   "tipo": "estrategia",
   "nombres_vistos": [
    "VWAP Strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    183
   ],
   "definiciones": [
    {
     "texto": "Estrategia de ejecución que busca comprar o vender un número fijo de acciones a un precio promedio que siga el VWAP. Solo requiere predecir el volumen intradía, no el precio.",
     "doc_id": 183
    }
   ],
   "citas": [
    {
     "texto": "VWAP strategies are defined as buying and selling a fixed number of shares at an average price that tracks the VWAP.",
     "doc_id": 183
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "VWAP",
     "doc_id": 183,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "intraday volume forecasting",
     "doc_id": 183,
     "revisar": false
    }
   ]
  },
  {
   "id": "intraday volume",
   "nombre_canonico": "Intraday Volume",
   "tipo": "dato",
   "nombres_vistos": [
    "Intraday Volume"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    183
   ],
   "definiciones": [
    {
     "texto": "Volumen de negociación dentro del día, que exhibe un patrón estacional en forma de U. Se decompone en componente común (cross-stock, no estacionario, extraído por PCA) y componente específico (stock-by-stock, estacionario).",
     "doc_id": 183
    }
   ],
   "citas": [
    {
     "texto": "Intraday volume moves around a U-shape seasonal pattern.",
     "doc_id": 183
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "VWAP strategy",
     "doc_id": 183,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "principal component analysis",
     "doc_id": 183,
     "revisar": false
    }
   ]
  },
  {
   "id": "setar model",
   "nombre_canonico": "SETAR Model",
   "tipo": "metodo",
   "nombres_vistos": [
    "SETAR Model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    183
   ],
   "definiciones": [
    {
     "texto": "Modelo Self-Exciting Threshold Autoregressive usado para capturar dinámicas no lineales en el componente específico del volumen. Permite diferentes regímenes de comportamiento del volumen intradía.",
     "doc_id": 183
    }
   ],
   "citas": [
    {
     "texto": "The dynamics of the specific part of volume is depicted by ARMA, and SETAR models.",
     "doc_id": 183
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "ARMA model",
     "doc_id": 183,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "specific volume component",
     "doc_id": 183,
     "revisar": false
    }
   ]
  },
  {
   "id": "volume decomposition",
   "nombre_canonico": "Volume Decomposition",
   "tipo": "metodo",
   "nombres_vistos": [
    "Volume Decomposition"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    183
   ],
   "definiciones": [
    {
     "texto": "Separación del volumen observado en dos partes: una que refleja cambios por evoluciones del mercado (componente común) y otra que describe el patrón específico de cada acción (componente específico).",
     "doc_id": 183
    }
   ],
   "citas": [
    {
     "texto": "The idea of considered models is based on the decomposition of traded volume into two parts: one reflects volume changes due to market evolutions, the second describes the stock specific volume pattern.",
     "doc_id": 183
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "principal component analysis",
     "doc_id": 183,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "intraday volume",
     "doc_id": 183,
     "revisar": false
    }
   ]
  },
  {
   "id": "execution risk",
   "nombre_canonico": "Execution Risk",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "Execution Risk"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    183
   ],
   "definiciones": [
    {
     "texto": "Riesgo de que el precio de ejecución se desvíe del benchmark VWAP. Se mide mediante el MAPE (Mean Absolute Percentage Error) entre el precio de ejecución y el VWAP.",
     "doc_id": 183
    }
   ],
   "citas": [
    {
     "texto": "We present a new methodology for modeling intraday volume which allows for a reduction of the execution risk in VWAP orders.",
     "doc_id": 183
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "VWAP strategy",
     "doc_id": 183,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "MAPE",
     "doc_id": 183,
     "revisar": false
    }
   ]
  },
  {
   "id": "common volume component",
   "nombre_canonico": "Common Volume Component",
   "tipo": "concepto",
   "nombres_vistos": [
    "Common Volume Component"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    183
   ],
   "definiciones": [
    {
     "texto": "Parte del volumen intradía que es común a todas las acciones del índice, capturando la estacionalidad intraday (patrón U-shape). Es no estacionario y se extrae mediante PCA del panel de acciones del CAC40.",
     "doc_id": 183
    }
   ],
   "citas": [
    {
     "texto": "The identification of such components of volume comes from the observation that seasonal fluctuation is common across stocks whereas dynamics is a stock by stock feature.",
     "doc_id": 183
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "volume decomposition",
     "doc_id": 183,
     "revisar": false
    },
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "seasonal volume",
     "doc_id": 183,
     "revisar": false
    }
   ]
  },
  {
   "id": "specific volume component",
   "nombre_canonico": "Specific Volume Component",
   "tipo": "concepto",
   "nombres_vistos": [
    "Specific Volume Component"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    183
   ],
   "definiciones": [
    {
     "texto": "Parte del volumen intradía específica de cada acción, estacionaria, que mide cambios anormales o inesperados. Se modela con ARMA y SETAR para capturar su dinámica y mejorar las predicciones VWAP.",
     "doc_id": 183
    }
   ],
   "citas": [
    {
     "texto": "The second component measures the abnormal or unexpected changes of volume.",
     "doc_id": 183
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "volume decomposition",
     "doc_id": 183,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "SETAR model",
     "doc_id": 183,
     "revisar": false
    }
   ]
  },
  {
   "id": "dqn",
   "nombre_canonico": "DQN",
   "tipo": "metodo",
   "nombres_vistos": [
    "DQN"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    184
   ],
   "definiciones": [
    {
     "texto": "Deep Q-Network, algoritmo DRL basado en valor que aproxima la función Q mediante redes neuronales profundas. Es uno de los algoritmos fine-tuned disponibles en FinRL.",
     "doc_id": 184
    }
   ],
   "citas": [
    {
     "texto": "FinRL provides fine-tuned state-of-the-art DRL algorithms (DQN, DDPG, PPO, SAC, A2C, TD3, etc.).",
     "doc_id": 184
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "deep reinforcement learning",
     "doc_id": 184,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Q-learning",
     "doc_id": 184,
     "revisar": false
    }
   ]
  },
  {
   "id": "backtesting",
   "nombre_canonico": "Backtesting",
   "tipo": "metodo",
   "nombres_vistos": [
    "Backtesting"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    184
   ],
   "definiciones": [
    {
     "texto": "Evaluación del rendimiento de estrategias de trading usando datos históricos. FinRL proporciona backtesting extensivo con métricas estándar y fricciones de mercado incorporadas.",
     "doc_id": 184
    }
   ],
   "citas": [
    {
     "texto": "Extensive backtesting is analyzed via trading performance. Moreover, it incorporates important trading constraints such as transaction cost, market liquidity.",
     "doc_id": 184
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "trading strategies",
     "doc_id": 184,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "evaluation metrics",
     "doc_id": 184,
     "revisar": false
    }
   ]
  },
  {
   "id": "product market competition",
   "nombre_canonico": "Product Market Competition",
   "tipo": "concepto",
   "nombres_vistos": [
    "Product Market Competition"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    185
   ],
   "definiciones": [
    {
     "texto": "Estructura de competencia Cournot con costes marginales asimétricos que determina los valores de los activos. Vincula explícitamente el informed trading en mercados de acciones con la estructura de competencia en mercados de productos.",
     "doc_id": 185
    }
   ],
   "citas": [
    {
     "texto": "This paper adds to existing research by explicitly linking informed trading in stock markets to the structure of competition in product markets.",
     "doc_id": 185
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "competitor trading incentives",
     "doc_id": 185,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Cournot duopoly",
     "doc_id": 185,
     "revisar": false
    }
   ]
  },
  {
   "id": "cross stock price impact",
   "nombre_canonico": "Cross-Stock Price Impact",
   "tipo": "metrica",
   "nombres_vistos": [
    "Cross-Stock Price Impact"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    185
   ],
   "definiciones": [
    {
     "texto": "Impacto del order flow y retornos de una acción competidora sobre los retornos de la empresa anunciante. Se usa para inferir transmisión de información entre acciones de una misma industria.",
     "doc_id": 185
    }
   ],
   "citas": [
    {
     "texto": "I use aggregate transaction data and estimate cross-stock price impacts of net order flow to infer information content of trades and information transmission.",
     "doc_id": 185
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "information transmission",
     "doc_id": 185,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "order flow",
     "doc_id": 185,
     "revisar": false
    }
   ]
  },
  {
   "id": "earning announcement",
   "nombre_canonico": "Earnings Announcements",
   "tipo": "dato",
   "nombres_vistos": [
    "Earnings Announcements"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    185
   ],
   "definiciones": [
    {
     "texto": "Momentos de alta asimetría de información donde se espera mayor actividad de informed trading. El estudio analiza 759 anuncios trimestrales en 128 industrias como ventanas de evento.",
     "doc_id": 185
    }
   ],
   "citas": [
    {
     "texto": "In the context of 759 quarterly earnings announcements (times in which information asymmetry is likely to be high) in 128 industries, I examine information transmission across stocks.",
     "doc_id": 185
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "event study",
     "doc_id": 185,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "information asymmetry",
     "doc_id": 185,
     "revisar": false
    }
   ]
  },
  {
   "id": "market share",
   "nombre_canonico": "Market Share",
   "tipo": "metrica",
   "nombres_vistos": [
    "Market Share"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    185
   ],
   "definiciones": [
    {
     "texto": "Cuota de mercado de la empresa en su industria. El modelo predice que el informed trading disminuye con la cuota de mercado: empresas pequeñas tienen mayor sensibilidad a shocks y ofrecen mayores retornos a informed traders.",
     "doc_id": 185
    }
   ],
   "citas": [
    {
     "texto": "The amount of information-based trading in a company's stock is predicted to decrease in firm market share.",
     "doc_id": 185
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "informed trading intensity",
     "doc_id": 185,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "industry concentration",
     "doc_id": 185,
     "revisar": false
    }
   ]
  },
  {
   "id": "risk premium",
   "nombre_canonico": "Risk Premium",
   "tipo": "metrica",
   "nombres_vistos": [
    "Risk Premium"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    186
   ],
   "definiciones": [
    {
     "texto": "Exceso de retorno requerido por los inversores. Es no-monotónico en los delays, alcanzando su máximo cuando los delays son lo suficientemente severos para eliminar toda adquisición de información pero aún moderados para permitir trading antes de revelación pública.",
     "doc_id": 186
    }
   ],
   "citas": [
    {
     "texto": "We find that price dispersion and average risk premium tend to reach their maximum when trading delays are just severe enough to preclude all information acquisition in equilibrium.",
     "doc_id": 186
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "trading delays",
     "doc_id": 186,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "equilibrium pricing",
     "doc_id": 186,
     "revisar": false
    }
   ]
  },
  {
   "id": "corporate bond market",
   "nombre_canonico": "Corporate Bond Market",
   "tipo": "concepto",
   "nombres_vistos": [
    "Corporate Bond Market"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    186
   ],
   "definiciones": [
    {
     "texto": "Mercado OTC que es un ejemplo canónico de mercado con trading delays. Se usa como laboratorio empírico con datos de ~3.8 millones de transacciones en bonos corporativos del Reino Unido (2011-2017).",
     "doc_id": 186
    }
   ],
   "citas": [
    {
     "texto": "With its over-the-counter (OTC) structure, the corporate bond market is a textbook example of markets with trading delays.",
     "doc_id": 186
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "OTC markets",
     "doc_id": 186,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "trading delays",
     "doc_id": 186,
     "revisar": false
    }
   ]
  },
  {
   "id": "grossman stiglitz model",
   "nombre_canonico": "Grossman-Stiglitz Model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Grossman-Stiglitz Model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    186
   ],
   "definiciones": [
    {
     "texto": "Modelo canónico de adquisición de información en mercados competitivos que este paper anida como caso especial cuando los trading delays son cero o la información privada tiene vida infinita.",
     "doc_id": 186
    }
   ],
   "citas": [
    {
     "texto": "We develop a competitive asset trading model that nests Grossman and Stiglitz (1980) as a special case.",
     "doc_id": 186
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "rational expectations equilibrium",
     "doc_id": 186,
     "revisar": false
    },
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "benchmark model",
     "doc_id": 186,
     "revisar": false
    }
   ]
  },
  {
   "id": "trade frequency",
   "nombre_canonico": "Trade Frequency",
   "tipo": "metrica",
   "nombres_vistos": [
    "Trade Frequency"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    186
   ],
   "definiciones": [
    {
     "texto": "Proxy del inverso del trading delay en el análisis empírico, medido como la frecuencia de transacciones de un bono en los datos del mercado de bonos corporativos del Reino Unido.",
     "doc_id": 186
    }
   ],
   "citas": [
    {
     "texto": "We proxy (the inverse of) a bond's trading delay with its trade frequency measured in the data.",
     "doc_id": 186
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "trading delays",
     "doc_id": 186,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "panel regression",
     "doc_id": 186,
     "revisar": false
    }
   ]
  },
  {
   "id": "information depreciation",
   "nombre_canonico": "Information Depreciation",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Information Depreciation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    186
   ],
   "definiciones": [
    {
     "texto": "Tasa a la que la información privada se vuelve pública. Un aumento en la tasa de depreciación (ej. por tecnología big data que permite extraer información ajena) reduce la RPE a pesar de facilitar acceso a datos.",
     "doc_id": 186
    }
   ],
   "citas": [
    {
     "texto": "We contrast two possible scenarios: a decline in the information acquisition cost vs. an increase in the rate of information depreciation.",
     "doc_id": 186
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "revelatory price efficiency",
     "doc_id": 186,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "information acquisition cost",
     "doc_id": 186,
     "revisar": false
    }
   ]
  },
  {
   "id": "investor belief consensu",
   "nombre_canonico": "Investor Beliefs Consensus",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Investor Beliefs Consensus"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    187
   ],
   "definiciones": [
    {
     "texto": "Grado de acuerdo entre inversores sobre el valor fundamental de un activo. Mayor consenso se asocia con órdenes límite más informadas y agrupadas cerca del precio de mercado, reflejando menor dispersión en el LOB.",
     "doc_id": 187
    }
   ],
   "citas": [
    {
     "texto": "A lower dispersion of beliefs (higher consensus) could be associated with a higher proportion of informed limit orders, implying that informed traders are active, integrating their private information into the order book.",
     "doc_id": 187
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "informed trading",
     "doc_id": 187,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "volatility",
     "doc_id": 187,
     "revisar": false
    }
   ]
  },
  {
   "id": "short selling ban",
   "nombre_canonico": "Short-Selling Ban",
   "tipo": "concepto",
   "nombres_vistos": [
    "Short-Selling Ban"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    187
   ],
   "definiciones": [
    {
     "texto": "Prohibición regulatoria de ventas en corto impuesta sobre algunos componentes del IBEX-35 durante COVID-19, que afecta la dinámica entre informed trading, liquidez y volatilidad al restringir a informed traders.",
     "doc_id": 187
    }
   ],
   "citas": [
    {
     "texto": "This study investigates the interactive dynamics between informed trading, beliefs distribution on the Limit Order Book, liquidity and volatility, and examines the changes in these dynamics observed during the COVID-19 event, along with the short selling ban.",
     "doc_id": 187
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "market liquidity reduction",
     "doc_id": 187,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "IBEX-35 components",
     "doc_id": 187,
     "revisar": false
    }
   ]
  },
  {
   "id": "market toxicity",
   "nombre_canonico": "Market Toxicity",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Market Toxicity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    187
   ],
   "definiciones": [
    {
     "texto": "Desequilibrio entre informed y uninformed traders que puede aumentar la volatilidad inducida por liquidez. Se mide mediante la CDF de VPIN, donde valores extremos (>0.99) indican toxicidad elevada.",
     "doc_id": 187
    }
   ],
   "citas": [
    {
     "texto": "High levels of informed trading, which lead to an imbalance between informed and uninformed traders, often referred to as market toxicity, can increase liquidity-induced volatility.",
     "doc_id": 187
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "adverse selection risk",
     "doc_id": 187,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "volatility",
     "doc_id": 187,
     "revisar": false
    }
   ]
  },
  {
   "id": "corrective demand",
   "nombre_canonico": "Corrective Demand",
   "tipo": "concepto",
   "nombres_vistos": [
    "Corrective Demand"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    188
   ],
   "definiciones": [
    {
     "texto": "Componente de la demanda del informed trader motivado por la típica optimización mean-variance como price-taker, buscando corregir el mispricing y obtener beneficios del exceso de retorno esperado.",
     "doc_id": 188
    }
   ],
   "citas": [
    {
     "texto": "The informed trader's demand for the risky asset could be decomposed into two separate components: (1) a corrective demand which is coming from a typical mean-variance demand for the excess return as a price-taker.",
     "doc_id": 188
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "informed trader demand decomposition",
     "doc_id": 188,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "manipulative demand",
     "doc_id": 188,
     "revisar": false
    }
   ]
  },
  {
   "id": "manipulative demand",
   "nombre_canonico": "Manipulative Demand",
   "tipo": "concepto",
   "nombres_vistos": [
    "Manipulative Demand"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    188
   ],
   "definiciones": [
    {
     "texto": "Componente de la demanda del informed trader motivado por price-controlling: opera en la misma dirección que el error de forecasting de los market makers para aumentar el ruido y obtener beneficios a largo plazo.",
     "doc_id": 188
    }
   ],
   "citas": [
    {
     "texto": "A manipulative demand which is driven by price-controlling motives.",
     "doc_id": 188
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "informed trader demand decomposition",
     "doc_id": 188,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "market manipulation",
     "doc_id": 188,
     "revisar": false
    }
   ]
  },
  {
   "id": "public signal",
   "nombre_canonico": "Public Signals",
   "tipo": "dato",
   "nombres_vistos": [
    "Public Signals"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    188
   ],
   "definiciones": [
    {
     "texto": "Señales sobre el valor de liquidación del activo riesgoso observadas por todos los participantes del mercado. Pueden forzar al informed trader a corregir el mispricing en lugar de amplificarlo, mitigando la manipulación.",
     "doc_id": 188
    }
   ],
   "citas": [
    {
     "texto": "It may force the informed trader to correct the mispricing instead of riding on it.",
     "doc_id": 188
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "market manipulation",
     "doc_id": 188,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "information revelation",
     "doc_id": 188,
     "revisar": false
    }
   ]
  },
  {
   "id": "linear filtering",
   "nombre_canonico": "Linear Filtering",
   "tipo": "metodo",
   "nombres_vistos": [
    "Linear Filtering"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    188
   ],
   "definiciones": [
    {
     "texto": "Técnica de aprendizaje dinámico usada por los market makers para estimar el componente sistemático del noise trading a partir del aggregate order flow observado en cada período.",
     "doc_id": 188
    }
   ],
   "citas": [
    {
     "texto": "This new reinterpretation also reveals that the informed trader's demand could be decomposed into two separate components according to their trading motives.",
     "doc_id": 188
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "market maker learning",
     "doc_id": 188,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "order flow",
     "doc_id": 188,
     "revisar": false
    }
   ]
  },
  {
   "id": "moving average",
   "nombre_canonico": "moving averages",
   "tipo": "metodo",
   "nombres_vistos": [
    "moving averages"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    189
   ],
   "definiciones": [
    {
     "texto": "Estrategia de análisis técnico donde las señales de compra o venta se generan por el cruce de una media móvil de corto plazo y una de largo plazo.",
     "doc_id": 189
    }
   ],
   "citas": [
    {
     "texto": "One of the most popular strategies is Moving Averages (MA). In MA, a buy signal is generated when short term MA is bigger than a long term MA and a sell signal is generated when short term MA is smaller than a long term MA.",
     "doc_id": 189
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "market tendency",
     "doc_id": 189,
     "revisar": false
    }
   ]
  },
  {
   "id": "day of the week effect",
   "nombre_canonico": "day of the week effect",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "day of the week effect"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    189
   ],
   "definiciones": [
    {
     "texto": "Anomalía de calendario que postula que los retornos diarios varían sistemáticamente de acuerdo al día de la semana.",
     "doc_id": 189
    }
   ],
   "citas": [
    {
     "texto": "It has been well documented that returns on many securities vary by the day of the week. In particular, Friday returns are generally high and Monday returns (the return from Friday close to Monday close) are even negative.",
     "doc_id": 189
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "calendar anomalies",
     "doc_id": 189,
     "revisar": false
    }
   ]
  },
  {
   "id": "buy and hold strategy",
   "nombre_canonico": "buy-and-hold strategy",
   "tipo": "metodo",
   "nombres_vistos": [
    "buy-and-hold strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    189
   ],
   "definiciones": [
    {
     "texto": "Estrategia de inversión pasiva o de indexación que se usa como benchmark para evaluar el desempeño relativo de reglas de trading técnicas.",
     "doc_id": 189
    }
   ],
   "citas": [
    {
     "texto": "In an informal test, results are contrasted with the return of a simple of buy-and-hold strategy... So, finally, indexing is the best option compared with these trading strategies.",
     "doc_id": 189
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
