    }
   ]
  },
  {
   "id": "cross sectional absolute deviation",
   "nombre_canonico": "Cross-Sectional Absolute Deviation",
   "tipo": "metrica",
   "nombres_vistos": [
    "Cross-Sectional Absolute Deviation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    155
   ],
   "definiciones": [
    {
     "texto": "Desviación absoluta transversal de los retornos accionarios (CSAD), una métrica estadística estándar utilizada en la literatura para detectar el grado de agrupación y dispersión que evidencia el herding.",
     "doc_id": 155
    }
   ],
   "citas": [
    {
     "texto": "CSAD denoting the Cross-Sectional Absolute Deviation of returns",
     "doc_id": 155
    }
   ],
   "relaciones_crudas": [
