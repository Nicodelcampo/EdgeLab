    }
   ]
  },
  {
   "id": "committed capital",
   "nombre_canonico": "committed capital",
   "tipo": "metodo",
   "nombres_vistos": [
    "committed capital"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    218
   ],
   "definiciones": [
    {
     "texto": "Esquema de ponderación conservador que asigna la misma cantidad de capital a cada par, independientemente de si el par está abierto o cerrado durante el período de trading, asumiendo retorno cero en pares no abiertos.",
     "doc_id": 218
    }
   ],
   "citas": [
    {
     "texto": "The committed capital scheme essentially commits equal amounts of capital to each one of the pairs. If the pair is not opened, or it is closed during the trading period, the capital is still committed to the pair.",
     "doc_id": 218
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "fully invested",
     "doc_id": 218,
     "revisar": false
    }
   ]
  },
  {
   "id": "fully invested",
   "nombre_canonico": "fully invested",
   "tipo": "metodo",
   "nombres_vistos": [
    "fully invested"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    218
   ],
   "definiciones": [
    {
     "texto": "Esquema de ponderación menos conservador que divide el capital solo entre los pares que están abiertos, asumiendo que el dinero de pares cerrados se reinvierte en los pares abiertos restantes.",
     "doc_id": 218
    }
   ],
   "citas": [
    {
     "texto": "The fully invested scheme is less conservative as it assumes capital is always divided between the pairs that are open.",
     "doc_id": 218
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "committed capital",
     "doc_id": 218,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "value-weighted approach",
     "doc_id": 218,
     "revisar": false
    }
   ]
  },
  {
   "id": "value weighted approach",
   "nombre_canonico": "value-weighted approach",
   "tipo": "metodo",
   "nombres_vistos": [
    "value-weighted approach"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    218
   ],
   "definiciones": [
    {
     "texto": "Método de ponderación pasiva que calcula pesos relativos para cada par según su retorno acumulado (wpt = wpt-1(1+rpt-1)) comenzando con valor uno, evitando la necesidad de rebalanceo frecuente entre pares.",
     "doc_id": 218
    }
   ],
   "citas": [
    {
     "texto": "Our second approach, labeled as the value-weighted approach, utilizes equation (2) to calculate relative weights for each pair where weights for each pair follows wpt=wpt-1(1+rpt-1) with a starting value of one.",
     "doc_id": 218
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "equally weighted approach",
     "doc_id": 218,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "fully invested",
     "doc_id": 218,
     "revisar": false
    }
   ]
  },
  {
   "id": "market neutral",
   "nombre_canonico": "market neutral",
   "tipo": "estrategia",
   "nombres_vistos": [
    "market neutral"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    218
   ],
   "definiciones": [
    {
     "texto": "Propiedad deseable de estrategias de hedge funds donde los retornos no están correlacionados con el mercado; la estrategia de pares muestra betas de CAPM no significativos en el período completo.",
     "doc_id": 218
    }
   ],
   "citas": [
    {
     "texto": "The beta is not found significant in any of the cases at the five percent significance level over the full sample period. This means that over the long term, the pairs strategy has also been market neutral, which is often a desirable property for many hedge funds strategies.",
     "doc_id": 218
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "pairs trading",
     "doc_id": 218,
     "revisar": false
    }
   ]
  },
  {
   "id": "make take decision",
   "nombre_canonico": "make-take decisions",
   "tipo": "concepto",
   "nombres_vistos": [
    "make-take decisions"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    219
   ],
   "definiciones": [
    {
     "texto": "Decisión endógena de los agentes entre proveer liquidez (make) mediante órdenes límite, capturando el coste de inmediatez pagado por otros, o tomar liquidez (take) mediante órdenes de mercado, potencialmente pickeando órdenes límite mal posicionadas de otros agentes.",
     "doc_id": 219
    }
   ],
   "citas": [
    {
     "texto": "the make-take preferences of investors depend on high-frequency trading (HFT) competition, under which HFT firms endogenously acquire speed and informational advantages.",
     "doc_id": 219
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "limit order book",
     "doc_id": 219,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "high-frequency trading",
     "doc_id": 219,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "bid-ask spread",
     "doc_id": 219,
     "revisar": false
    }
   ]
  },
  {
   "id": "competition",
   "nombre_canonico": "competition",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "competition"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    219
   ],
   "definiciones": [
    {
     "texto": "La competencia entre HFT firms se manifiesta en dos dimensiones: compiten en provisión de liquidez mediante órdenes límite y en toma de liquidez mediante órdenes de mercado. El nivel de competencia (proporción β de fast traders) determina endógenamente si predomina el comportamiento predatorio (pocos HFT) o la provisión competitiva de liquidez (muchos HFT).",
     "doc_id": 219
    }
   ],
   "citas": [
    {
     "texto": "in the case where there are many HFT firms in the market, they compete more through limit orders; meanwhile, in the case with few HFT firms, they compete more through market orders that 'pickoff' limit orders coming from the big crowd of slow traders.",
     "doc_id": 219
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "informational efficiency",
     "doc_id": 219,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "microstructure noise",
     "doc_id": 219,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "overinvestment in HFT",
     "doc_id": 219,
     "revisar": false
    }
   ]
  },
  {
   "id": "predatory trading",
   "nombre_canonico": "predatory trading",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "predatory trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    219
   ],
   "definiciones": [
    {
     "texto": "Comportamiento de los HFT firms cuando son pocos en el mercado: compiten principalmente mediante órdenes de mercado que pickean (depredan) órdenes límite de la gran masa de traders lentos, en lugar de usar su tecnología para proveer liquidez. Este comportamiento daña la liquidez del mercado.",
     "doc_id": 219
    }
   ],
   "citas": [
    {
     "texto": "Fast traders exhibit predatory behavior when there is low HFT competition, by competing more through market orders that pick off limit orders coming from the big crowd of traditional slow agents in the market.",
     "doc_id": 219
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "liquidity taking",
     "doc_id": 219,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "bid-ask spread",
     "doc_id": 219,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "liquidity provision",
     "doc_id": 219,
     "revisar": false
    }
   ]
  },
  {
   "id": "free riding",
   "nombre_canonico": "free-riding",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "free-riding"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    219
   ],
   "definiciones": [
    {
     "texto": "Comportamiento de los slow traders que se benefician pasivamente de las mejoras en eficiencia informacional y reducción de fricciones generadas por los fast traders. Al haber más HFT, los precios son más informativos y las fricciones menores, lo que reduce el gross expected payoff diferencial entre FTs y STs.",
     "doc_id": 219
    }
   ],
   "citas": [
    {
     "texto": "slow traders can 'free ride' on the improvements in informational efficiency and reductions in market frictions, since there are more fast traders in the market.",
     "doc_id": 219
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "overinvestment in HFT",
     "doc_id": 219,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "informational efficiency",
     "doc_id": 219,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "high-frequency trading",
     "doc_id": 219,
     "revisar": false
    }
   ]
  },
  {
   "id": "overinvestment in hft",
   "nombre_canonico": "overinvestment in HFT",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "overinvestment in HFT"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    219
   ],
   "definiciones": [
    {
     "texto": "El equilibrio privado de inversión en tecnología HFT implica una proporción de fast traders (β) mayor que la socialmente óptima (β_opt), porque los FTs no internalizan la externalidad negativa que generan sobre los STs. Existen incentivos para ser FT incluso cuando es socialmente ineficiente.",
     "doc_id": 219
    }
   ],
   "citas": [
    {
     "texto": "there is overinvestment in HFT technology, as there are incentives to be a fast trader even in scenarios in which fast trading is socially wasteful.",
     "doc_id": 219
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Pigovian tax",
     "doc_id": 219,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "free-riding",
     "doc_id": 219,
     "revisar": false
    }
   ]
  },
  {
   "id": "option trading",
   "nombre_canonico": "options trading",
   "tipo": "estrategia",
   "nombres_vistos": [
    "options trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    220
   ],
   "definiciones": [
    {
     "texto": "Negociación de opciones (calls europeas en este estudio) formando carteras long-short de pares, donde la rentabilidad depende exclusivamente de la diferencia de volatilidades de los activos subyacentes. Se construyen pares de opciones con el mismo ratio S/K (moneyness) y vencimiento para simplificar el cómputo de Black-Scholes.",
     "doc_id": 220
    }
   ],
   "citas": [
    {
     "texto": "we create alternative volatility-managed portfolios via options pairs trading. Using the seminal Black-Scholes model, we construct pairwise options portfolios that are only dependent on market volatility.",
     "doc_id": 220
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "pairs trading",
     "doc_id": 220,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "implied volatility",
     "doc_id": 220,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Black-Scholes",
     "doc_id": 220,
     "revisar": false
    }
   ]
  },
  {
   "id": "microstructure effect",
   "nombre_canonico": "microstructure effects",
   "tipo": "concepto",
   "nombres_vistos": [
    "microstructure effects"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    220
   ],
   "definiciones": [
    {
     "texto": "Efectos de microestructura del mercado (bid-ask bounce, price dispersion, price impact, realized volatility intradía) que influyen significativamente en la volatilidad del subyacente y, por ende, en el desempeño de los pares de opciones. Exhiben persistencia y pueden aprovecharse para construir estrategias rentables de predicción de volatilidad.",
     "doc_id": 220
    }
   ],
   "citas": [
    {
     "texto": "microstructure factors exhibit persistence and can be effectively utilized to create profitable strategies",
     "doc_id": 220
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "volatility",
     "doc_id": 220,
     "revisar": false
    },
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "volatility residual",
     "doc_id": 220,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "realized volatility",
     "doc_id": 220,
     "revisar": false
    }
   ]
  },
  {
   "id": "range volatility",
   "nombre_canonico": "range volatility",
   "tipo": "metrica",
   "nombres_vistos": [
    "range volatility"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    220
   ],
   "definiciones": [
    {
     "texto": "Medida de volatilidad calculada como (High_t − Low_t) / Open_t para cada día de trading. Los autores la eligen para localizar los datos y evitar contaminación de otros días, siguiendo a Alizadeh, Brandt y Diebold (2002). La normalización por Open permite comparar volatilidad entre activos con distintos niveles de precio.",
     "doc_id": 220
    }
   ],
   "citas": [
    {
     "texto": "RangeV olt = Hight − Lowt / Opent",
     "doc_id": 220
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "volatility",
     "doc_id": 220,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "volatility",
     "doc_id": 220,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "volatility residual",
     "doc_id": 220,
     "revisar": false
    }
   ]
  },
  {
   "id": "cross correlation",
   "nombre_canonico": "cross-correlation",
   "tipo": "metrica",
   "nombres_vistos": [
    "cross-correlation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    221
   ],
   "definiciones": [
    {
     "texto": "Medida de la relación lineal entre los rendimientos de dos índices en distintos rezagos temporales. Las correlaciones contemporáneas elevadas entre índices reflejan factores comunes subyacentes; la asimetría entre lead y lag evidencia el efecto liderazgo.",
     "doc_id": 221
    }
   ],
   "citas": [
    {
     "texto": "the contemporaneous cross-correlations are all relatively high, indicative of the presence of common factors underpinning the return generating processes for each of these indices",
     "doc_id": 221
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "lead-lag effect",
     "doc_id": 221,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "autocorrelation",
     "doc_id": 221,
     "revisar": false
    }
   ]
  },
  {
   "id": "intrinsic value process",
   "nombre_canonico": "intrinsic value process",
   "tipo": "concepto",
   "nombres_vistos": [
    "intrinsic value process"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    221
   ],
   "definiciones": [
    {
     "texto": "Proceso estocástico que gobierna la evolución del valor intrínseco o fundamental de un activo. Típicamente se asume random walk (γ=1), pero el paper permite γ≠1 para capturar mean reversion o sobrecreacción en el proceso subyacente.",
     "doc_id": 221
    }
   ],
   "citas": [
    {
     "texto": "The intrinsic value process may vary with market capitalisation and, indeed, as between developed and emerging markets.",
     "doc_id": 221
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "partial adjustment with noise model",
     "doc_id": 221,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "overreaction",
     "doc_id": 221,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "market efficiency",
     "doc_id": 221,
     "revisar": false
    }
   ]
  },
  {
   "id": "partial adjustment with noise model",
   "nombre_canonico": "partial adjustment with noise model",
   "tipo": "metodo",
   "nombres_vistos": [
    "partial adjustment with noise model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    221
   ],
   "definiciones": [
    {
     "texto": "Modelo en el que los precios de mercado se ajustan parcialmente hacia sus valores intrínsecos con ruido i.i.d. La ecuación P(i,t)-P(i,t-1)=g(i){V(i,t)-P(i,t-1)}+u(i,t) captura la velocidad de ajuste g(i). Combinado con un proceso general para V(i,t) permite estimar conjuntamente g(i) y γ(i).",
     "doc_id": 221
    }
   ],
   "citas": [
    {
     "texto": "Market prices are assumed to partially adjust towards their intrinsic values",
     "doc_id": 221
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "intrinsic value process",
     "doc_id": 221,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "speed of adjustment",
     "doc_id": 221,
     "revisar": false
    },
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "ARMA(1,X) model",
     "doc_id": 221,
     "revisar": false
    }
   ]
  },
  {
   "id": "emerging market",
   "nombre_canonico": "emerging markets",
   "tipo": "concepto",
   "nombres_vistos": [
    "emerging markets"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    221
   ],
   "definiciones": [
    {
     "texto": "Mercados financieros de países en desarrollo, menos profundos y con menor liquidez que los mercados desarrollados. En este estudio, India representa un mercado emergente donde el thin trading es mayor que en EE.UU., lo que amplifica el efecto lead/lag respecto a lo documentado en mercados desarrollados.",
     "doc_id": 221
    }
   ],
   "citas": [
    {
     "texto": "the extent of thin trading in a less developed market such as the Indian market is somewhat larger than that encountered in a more developed market such as the U.S.",
     "doc_id": 221
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "thin trading",
     "doc_id": 221,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "lead-lag effect",
     "doc_id": 221,
     "revisar": false
    }
   ]
  },
  {
   "id": "arma 1 x model",
   "nombre_canonico": "ARMA(1,X) model",
   "tipo": "metodo",
   "nombres_vistos": [
    "ARMA(1,X) model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    221
   ],
   "definiciones": [
    {
     "texto": "Modelo autorregresivo de media móvil con orden óptimo X determinado por el Schwartz Information Criterion. La componente MA de orden superior captura los efectos de thin trading, permitiendo estimar velocidades de ajuste depuradas de dichos efectos. Es el estimador preferido cuando coexisten thin trading y ajuste parcial.",
     "doc_id": 221
    }
   ],
   "citas": [
    {
     "texto": "the ARMA (1,X) model will provide the most appropriate estimates of the speeds of adjustment coefficients since the higher order moving average component will be a manifestation of thin trading effects",
     "doc_id": 221
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "cross-covariance ratio estimator",
     "doc_id": 221,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "thin trading",
     "doc_id": 221,
     "revisar": false
    },
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "partial adjustment with noise model",
     "doc_id": 221,
     "revisar": false
    }
   ]
  },
  {
   "id": "cross covariance ratio estimator",
   "nombre_canonico": "cross-covariance ratio estimator",
   "tipo": "metodo",
   "nombres_vistos": [
    "cross-covariance ratio estimator"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    221
   ],
   "definiciones": [
    {
     "texto": "Estimador de la velocidad de ajuste g(i) basado en el cociente entre la covarianza cruzada rezagada y la contemporánea: g(S)=cov[R(L,t-1),R(S,t)]/cov[R(L,t),R(S,t)]. Derivado por Theobald y Yallup (1998), asume ausencia de thin trading y proceso intrínseco random walk.",
     "doc_id": 221
    }
   ],
   "citas": [
    {
     "texto": "the cross-covariance ratio estimator (Theobald and Yallup (1998)) where the speed of adjustment, g(i), i=S,L, is given by g(S) = cov [R(L,t-1), R(S,t)] {cov [R(L,t), R(S,t)]}-1",
     "doc_id": 221
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "speed of adjustment",
     "doc_id": 221,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "partial adjustment with noise model",
     "doc_id": 221,
     "revisar": false
    }
   ]
  },
  {
   "id": "execution rate",
   "nombre_canonico": "execution rate",
   "tipo": "metrica",
   "nombres_vistos": [
    "execution rate"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    222
   ],
   "definiciones": [
    {
     "texto": "Tasa de ejecución I = dv/dt: número de acciones negociadas por unidad de tiempo. Es el concepto central de la teoría de dinámica de mercado de los autores, considerado el factor clave que define la dinámica del mercado de renta variable estadounidense y la driving force detrás de movimientos de precios.",
     "doc_id": 222
    }
   ],
   "citas": [
    {
     "texto": "the trading rate (1) is the most important characteristics affecting price dynamics",
     "doc_id": 222
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "volatility",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "liquidity",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "price support",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "P&L dynamics",
     "doc_id": 222,
     "revisar": false
    }
   ]
  },
  {
   "id": "market dynamic",
   "nombre_canonico": "market dynamics",
   "tipo": "concepto",
   "nombres_vistos": [
    "market dynamics"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    222
   ],
   "definiciones": [
    {
     "texto": "Enfoque de estudio del mercado centrado en variables dependientes del tiempo (precios, medias móviles, spreads, volatilidad) tal como lo usan los practitioners, en contraposición al enfoque estadístico que calcula características agregadas sobre escalas temporales fijas. Los autores argumentan que la dinámica de mercado contiene información en atributos con spikes y carece de estado estacionario.",
     "doc_id": 222
    }
   ],
   "citas": [
    {
     "texto": "there is no any \"stationary case\" on the market and typical market dynamics is a \"fast excitation and then slow relaxation\" type of behavior with a wide distribution of excitation frequencies and relaxation times",
     "doc_id": 222
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "statistical equilibrium",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "execution rate",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "limit order book",
     "doc_id": 222,
     "revisar": false
    }
   ]
  },
  {
   "id": "midprice",
   "nombre_canonico": "midprice",
   "tipo": "metrica",
   "nombres_vistos": [
    "midprice"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    222
   ],
   "definiciones": [
    {
     "texto": "Precio medio entre el mejor bid y el mejor offer del libro de órdenes: Pm = (Psell + Pbuy)/2. Los autores demuestran empíricamente que se vuelve irrelevante durante los momentos de alta tasa de ejecución I0, que son precisamente los de mayor volatilidad de precios, porque el trading ocurre típicamente en un solo lado del libro.",
     "doc_id": 222
    }
   ],
   "citas": [
    {
     "texto": "This make the midprice (2) irrelevant during most interesting moments of high I0 (correspond to the moments of high price volatility)",
     "doc_id": 222
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "bid-ask spread",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "CONTRADICE_A",
     "tipo_original": "CONTRADICE_A",
     "objeto_texto": "price formation",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "limit order book",
     "doc_id": 222,
     "revisar": false
    }
   ]
  },
  {
   "id": "volume disbalance",
   "nombre_canonico": "volume disbalance",
   "tipo": "metrica",
   "nombres_vistos": [
    "volume disbalance"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    222
   ],
   "definiciones": [
    {
     "texto": "Indicador de desbalance relativo de volumen en los mejores niveles del libro: η = (Vbest_sell − Vbest_buy)/(Vbest_sell + Vbest_buy). Los autores muestran que tiene una normalización defectuosa porque elimina los spikes (la información más relevante), y su interpretación es ambivalente: puede funcionar tanto como price support como liquidity attractor.",
     "doc_id": 222
    }
   ],
   "citas": [
    {
     "texto": "widely used in academic study best price level volume disbalance indicator (3) has a bad normalizing (spikes are the most informative features) and volume disbalance should be interpreted ambivalently: both as \"price support\" and as \"liquidity attractor\"",
     "doc_id": 222
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "order book depth",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "price support",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "liquidity attractor",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "CONTRADICE_A",
     "tipo_original": "CONTRADICE_A",
     "objeto_texto": "price formation",
     "doc_id": 222,
     "revisar": false
    }
   ]
  },
  {
   "id": "time in order book",
   "nombre_canonico": "time in order book",
   "tipo": "metrica",
   "nombres_vistos": [
    "time in order book"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    222
   ],
   "definiciones": [
    {
     "texto": "Tiempo promedio ponderado por tamaño que una orden pasa en el mejor nivel de precio del libro, calculado como diferencia entre tiempo actual y tiempo de originación de la orden. Los autores lo consideran uno de los pocos buenos indicadores extraíbles del libro de órdenes, más difícil de manipular que el volumen y con naturaleza de rate-like attribute.",
     "doc_id": 222
    }
   ],
   "citas": [
    {
     "texto": "the time spent in order book is one of a few good indicators obtained out of the order book data. The reasons may be: difficulty to calculate (the order book is required), harder to manipulate (time is not possible to \"fix\", but the volume is easy) and being rate–like attribute",
     "doc_id": 222
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "volume disbalance",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "order flow",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "limit order book",
     "doc_id": 222,
     "revisar": false
    }
   ]
  },
  {
   "id": "liquidity attractor",
   "nombre_canonico": "liquidity attractor",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "liquidity attractor"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    222
   ],
   "definiciones": [
    {
     "texto": "Fenómeno por el cual un gran volumen en el mejor nivel del libro de órdenes atrae ejecuciones inmediatas en lugar de servir como soporte de precio: los participantes ven la liquidez disponible como una oportunidad y la toman al instante. Es el efecto opuesto al price support y hace ambivalente la interpretación del volumen en el libro.",
     "doc_id": 222
    }
   ],
   "citas": [
    {
     "texto": "market participants see large liquidity on the best price level, and, if this price is acceptable to them, take it immediately, considering best level liquidity as an opportunity. This \"liquidity attractor\" effect is opposite to the \"price support\"",
     "doc_id": 222
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "price support",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "order flow",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "market microstructure",
     "doc_id": 222,
     "revisar": false
    }
   ]
  },
  {
   "id": "price support",
   "nombre_canonico": "price support",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "price support"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    222
   ],
   "definiciones": [
    {
     "texto": "Interpretación tradicional del volumen en el libro de órdenes como soporte de precio: el lado con mayor volumen en el mejor nivel proporciona resistencia al movimiento de precio en esa dirección, requiriendo mayor volumen negociado para atravesarlo. Los autores muestran que esta interpretación es ambivalente y no siempre se cumple.",
     "doc_id": 222
    }
   ],
   "citas": [
    {
     "texto": "the side with the biggest best level volume providing \"price support\"; price move in this direction requires a bigger volume traded",
     "doc_id": 222
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "liquidity attractor",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "volume disbalance",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "market impact",
     "doc_id": 222,
     "revisar": false
    }
   ]
  },
  {
   "id": "p l dynamic",
   "nombre_canonico": "P&L dynamics",
   "tipo": "metodo",
   "nombres_vistos": [
    "P&L dynamics"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    222
   ],
   "definiciones": [
    {
     "texto": "Propuesta de los autores para evaluar la calidad de modelos de trading mediante la dinámica de pérdidas y ganancias (P&L) en lugar de la predicción de precios. El P&L separa el movimiento de precio de las acciones del trader (Enter Long, Exit Long, Enter Short, Exit Short), siendo the ultimate criteria de cualquier estrategia.",
     "doc_id": 222
    }
   ],
   "citas": [
    {
     "texto": "the P&L, that is \"the ultimate criteria\" of any trading strategy quality",
     "doc_id": 222
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "price formation",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "execution rate",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "market dynamics",
     "doc_id": 222,
     "revisar": false
    }
   ]
  },
  {
   "id": "liquidity deficit",
   "nombre_canonico": "liquidity deficit",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "liquidity deficit"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    222
   ],
   "definiciones": [
    {
     "texto": "Teoría alternativa a Supply-Demand propuesta por los autores, donde oferta y demanda se consideran siempre matched pero la tasa a la que se matchean (I) varía. Un evento de liquidity deficit corresponde a momentos de alta I donde se deben abrir posiciones; el liquidity excess corresponde a momentos de baja I donde se deben cerrar.",
     "doc_id": 222
    }
   ],
   "citas": [
    {
     "texto": "our alternative to Supply–Demand theory, the Liquidity Deficit theory[10], where supply and demand are considered as always matched, but the rate of their matching I varies",
     "doc_id": 222
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "execution rate",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "price formation",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "P&L dynamics",
     "doc_id": 222,
     "revisar": false
    }
   ]
  },
  {
   "id": "statistical equilibrium",
   "nombre_canonico": "statistical equilibrium",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "statistical equilibrium"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    222
   ],
   "definiciones": [
    {
     "texto": "Supuesto implícito en muchos estudios académicos del libro de órdenes de que existe un estado estacionario o caso cuasi-estacionario sobre el cual calcular características estadísticas. Los autores lo consideran un error metodológico fundamental porque el mercado nunca tiene estado estacionario y la información relevante está en los spikes no estacionarios.",
     "doc_id": 222
    }
   ],
   "citas": [
    {
     "texto": "there is no any stationary state for these variables; the data supported fact is that most of observable variables are severely non–stationary",
     "doc_id": 222
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "non-stationarity",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "CONTRADICE_A",
     "tipo_original": "CONTRADICE_A",
     "objeto_texto": "market dynamics",
     "doc_id": 222,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "limit order book",
     "doc_id": 222,
     "revisar": false
    }
   ]
  },
  {
   "id": "market microstructure invariant",
   "nombre_canonico": "market microstructure invariants",
   "tipo": "concepto",
   "nombres_vistos": [
    "market microstructure invariants"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    223
   ],
   "definiciones": [
    {
     "texto": "Principio de modelización que postula que las características microestructurales que varían en tiempo calendario se vuelven constantes ('invariantes') cuando se miden en tiempo de negocio. Implica que la distribución de transferencias de riesgo, costos de transacción, precisión de precios y resiliencia son las mismas por unidad de tiempo de negocio a través de todos los activos y períodos.",
     "doc_id": 223
    }
   ],
   "citas": [
    {
     "texto": "Market microstructure invariance hypothesizes that microstructure characteristics, which vary when measured in units of calendar time, become constants—'microstructure invariants'—when measured in units of business time.",
     "doc_id": 223
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "market microstructure",
     "doc_id": 223,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "business time",
     "doc_id": 223,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "trading activity",
     "doc_id": 223,
     "revisar": false
    },
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "square-root law",
     "doc_id": 223,
     "revisar": false
    }
   ]
  },
  {
   "id": "business time",
   "nombre_canonico": "business time",
   "tipo": "concepto",
   "nombres_vistos": [
    "business time"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    223
   ],
   "definiciones": [
    {
     "texto": "Tiempo medido por la tasa de llegada de nuevos bets (γ) al mercado. Para activos muy negociados el tiempo de negocio pasa rápido; para activos poco negociados pasa lento. La velocidad del mercado (market velocity) es precisamente la tasa γ de llegada de bets.",
     "doc_id": 223
    }
   ],
   "citas": [
    {
     "texto": "Market microstructure invariance begins with the intuition that these risk transfers, which we call 'bets,' take place in business time. The rate at which business time passes—market 'velocity'—is the rate at which new bets arrive into the market.",
     "doc_id": 223
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "market microstructure invariants",
     "doc_id": 223,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "trading activity",
     "doc_id": 223,
     "revisar": false
    },
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "market velocity",
     "doc_id": 223,
     "revisar": false
    }
   ]
  },
  {
   "id": "trading activity",
   "nombre_canonico": "trading activity",
   "tipo": "metrica",
   "nombres_vistos": [
    "trading activity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    223
   ],
   "definiciones": [
    {
     "texto": "Producto del volumen esperado en dólares (P·V), la volatilidad de retornos (σ) y el precio de la acción, definido como W := σ · P · V. Mide el riesgo agregado en dólares transferido por todos los bets durante un día calendario. Es la variable macroscópica observable a partir de la cual se infieren todas las cantidades microscópicas mediante las leyes de invarianza.",
     "doc_id": 223
    }
   ],
   "citas": [
    {
     "texto": "Trading activity measures the aggregate dollar risk transferred by all bets during one calendar day. [...] define 'trading activity' W as the product of expected dollar trading volume P · V and calendar returns volatility σ, i.e., W := σ · P · V.",
     "doc_id": 223
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "market microstructure invariants",
     "doc_id": 223,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "business time",
     "doc_id": 223,
     "revisar": false
    },
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "betting volume",
     "doc_id": 223,
     "revisar": false
    },
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "order size distribution",
     "doc_id": 223,
     "revisar": false
    }
   ]
  },
  {
   "id": "betting volume",
   "nombre_canonico": "betting volume",
   "tipo": "metrica",
   "nombres_vistos": [
    "betting volume"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    223
   ],
   "definiciones": [
    {
     "texto": "Volumen esperado de bets, definido como V̄ := γ · E{|Q̃|} = (2/ζ) · V. Representa el volumen que resultaría si todo el trading fueran bets sin intermediación. Es una variable no observable que se infiere del volumen observado V mediante el multiplicador ζ.",
     "doc_id": 223
    }
   ],
   "citas": [
    {
     "texto": "We define expected 'betting volume' V̄ by V̄ := γ · E{|Q̃|} = (2/ζ) · V.",
     "doc_id": 223
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "trading volume",
     "doc_id": 223,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "business time",
     "doc_id": 223,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "order size distribution",
     "doc_id": 223,
     "revisar": false
    }
   ]
  },
  {
   "id": "meta order",
   "nombre_canonico": "meta-order",
   "tipo": "concepto",
   "nombres_vistos": [
    "meta-order"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    223
   ],
   "definiciones": [
    {
     "texto": "Orden de gran tamaño que un inversor institucional decide ejecutar, típicamente durante varios días y fragmentada en múltiples trades pequeños. En el contexto del paper, los portfolio transition orders funcionan como proxies de bets (que a su vez son meta-orders), ya que se conoce el tamaño total deseado desde el inicio de la transición, antes de que comience la ejecución, evitando el sesgo de selección que afecta a otras bases de datos de trades.",
     "doc_id": 223
    }
   ],
   "citas": [
    {
     "texto": "Consider an asset manager who places one bet by purchasing 100,000 shares of IBM stock. The bet might be implemented by placing orders over several days, and each of the orders might be 'shredded' into many small trades. Since bets represent independent increments in the intended order flow, the various trades which implement the bet must all be added together to recover the size of the original bet.",
     "doc_id": 223
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "transaction costs",
     "doc_id": 223,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "order size distribution",
     "doc_id": 223,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "market impact",
     "doc_id": 223,
     "revisar": false
    }
   ]
  },
  {
   "id": "intermediation",
   "nombre_canonico": "intermediation",
   "tipo": "concepto",
   "nombres_vistos": [
    "intermediation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    224
   ],
   "definiciones": [
    {
     "texto": "Comercio indirecto donde compradores y vendedores no interactúan directamente, sino que intercambian a través de market-makers que fijan precios bid y ask y obtienen un margen. La intermediación externaliza el proceso de formación de precios, permitiendo que los demás agentes economícen en información.",
     "doc_id": 224
    }
   ],
   "citas": [
    {
     "texto": "Our paper then argues that the intermediating agent who sets prices plays a fundamental role in a market economy by allowing other agents to economize on information.",
     "doc_id": 224
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "market making",
     "doc_id": 224,
     "revisar": false
    },
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "informational efficiency",
     "doc_id": 224,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "random matching and bargaining",
     "doc_id": 224,
     "revisar": false
    }
   ]
  },
  {
   "id": "competitive allocation mechanism",
   "nombre_canonico": "competitive allocation mechanism",
   "tipo": "concepto",
   "nombres_vistos": [
    "competitive allocation mechanism"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    224
   ],
   "definiciones": [
    {
     "texto": "Mecanismo de asignación de referencia (triple µc, Mc, gc) donde los precios se toman como dados y se determinan por el subastador walrasiano. Su espacio de mensajes es N-dimensional, donde N es el número de tipos de consumidores, y es el único mecanismo informacionalmente eficiente que satisface la restricción de participación voluntaria.",
     "doc_id": 224
    }
   ],
   "citas": [
    {
     "texto": "The competitive mechanism is a triple (µc, Mc, gc). The message space Mc is described by Mc = {(p, y) ∈ R2++ × Y : py(i) = 0 ∀i}.",
     "doc_id": 224
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "Walrasian auctioneer",
     "doc_id": 224,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "message space dimensionality",
     "doc_id": 224,
     "revisar": false
    }
   ]
  },
  {
   "id": "message space dimensionality",
   "nombre_canonico": "message space dimensionality",
   "tipo": "metrica",
   "nombres_vistos": [
    "message space dimensionality"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    224
   ],
   "definiciones": [
    {
     "texto": "Número de dimensiones del espacio de mensajes que un oráculo debe comunicar a los agentes para verificar que la asignación es óptima. El mecanismo competitivo tiene dimensión N; el market-maker con k intermediarios, aproximadamente kN; y el matching aleatorio, 2(N/2)².",
     "doc_id": 224
    }
   ],
   "citas": [
    {
     "texto": "The size of the messages is interpreted as a measure of the complexity of a verification protocol.",
     "doc_id": 224
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "informational efficiency",
     "doc_id": 224,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "privacy-preserving mechanism",
     "doc_id": 224,
     "revisar": false
    }
   ]
  },
  {
   "id": "random matching and bargaining",
   "nombre_canonico": "random matching and bargaining",
   "tipo": "concepto",
   "nombres_vistos": [
    "random matching and bargaining"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    224
   ],
   "definiciones": [
    {
     "texto": "Mecanismo de asignación descentralizado basado en Mortensen y Wright (2002), donde compradores y vendedores se encuentran aleatoriamente según una función de matching M(B,S) y negocian el precio mediante un protocolo de oferta take-it-or-leave-it o solución de Nash generalizada. Converge en asignación al equilibrio competitivo cuando los costos de búsqueda tienden a cero, pero es informacionalmente ineficiente.",
     "doc_id": 224
    }
   ],
   "citas": [
    {
     "texto": "Random matching may be too informationally complex in large economies to be practical.",
     "doc_id": 224
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "intermediation",
     "doc_id": 224,
     "revisar": false
    },
    {
     "tipo": "CONTRADICE_A",
     "tipo_original": "CONTRADICE_A",
     "objeto_texto": "informational efficiency",
     "doc_id": 224,
     "revisar": false
    }
   ]
  },
  {
   "id": "privacy preserving mechanism",
   "nombre_canonico": "privacy-preserving mechanism",
   "tipo": "concepto",
   "nombres_vistos": [
    "privacy-preserving mechanism"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    224
   ],
   "definiciones": [
    {
     "texto": "Propiedad de un proceso de mensajes (message process) donde cada individuo responde a un mensaje utilizando exclusivamente su información privada (preferencias y dotaciones), sin requerir conocimiento de la información de otros agentes.",
     "doc_id": 224
    }
   ],
   "citas": [
    {
     "texto": "A message process (µ, M) is privacy-preserving if for each i there exists a correspondence µi : Ei ⇒ M such that for each e = (e1, e2, . . . , eN) ∈ E, the profile of correspondences (µi)i∈{1,...,N} satisfies µ(e) = ∩i∈{1,...,N}µi(ei).",
     "doc_id": 224
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "competitive allocation mechanism",
     "doc_id": 224,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "informational efficiency",
     "doc_id": 224,
     "revisar": false
    }
   ]
  },
  {
   "id": "contestable market baumol monopoly deterrence",
   "nombre_canonico": "contestable markets (Baumol monopoly deterrence)",
   "tipo": "estrategia",
   "nombres_vistos": [
    "contestable markets (Baumol monopoly deterrence)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    224
   ],
   "definiciones": [
    {
     "texto": "Extensión dinámica del modelo de market-maker donde un monopolista incumbente fija precios para disuadir la entrada de un competidor potencial que debe incurrir un costo fijo E. Con una tasa de descuento suficientemente baja, el equilibrio de disuasión converge al equilibrio competitivo, requiriendo solo N+1 dimensiones.",
     "doc_id": 224
    }
   ],
   "citas": [
    {
     "texto": "As the discount rate r converges to zero, the present value of any positive profit stream diverges to infinity, which implies that the monopoly deterrence equilibrium converges to the competitive equilibrium as the discount rate converges to zero.",
     "doc_id": 224
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "informational efficiency",
     "doc_id": 224,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "market making",
     "doc_id": 224,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "bid-ask spread",
     "doc_id": 224,
     "revisar": false
    }
   ]
  },
  {
   "id": "walrasian auctioneer",
   "nombre_canonico": "Walrasian auctioneer",
   "tipo": "concepto",
   "nombres_vistos": [
    "Walrasian auctioneer"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    224
   ],
   "definiciones": [
    {
     "texto": "Entidad ficticia del modelo competitivo que anuncia precios de equilibrio y asignaciones, permitiendo que los agentes verifiquen el equilibrio sin conocer la información de otros. El modelo de market-maker lo reemplaza por intermediarios estratégicos que fijan precios endógenamente.",
     "doc_id": 224
    }
   ],
   "citas": [
    {
     "texto": "The role of the oracle is played by the 'Walrasian auctioneer' who announces the equilibrium prices and allocation.",
     "doc_id": 224
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "competitive allocation mechanism",
     "doc_id": 224,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "market making",
     "doc_id": 224,
     "revisar": false
    }
   ]
  },
  {
   "id": "hayek hypothesi",
   "nombre_canonico": "Hayek Hypothesis",
   "tipo": "concepto",
   "nombres_vistos": [
    "Hayek Hypothesis"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    224
   ],
   "definiciones": [
    {
     "texto": "Hipótesis articulada por Vernon Smith (1982) que sostiene que mercados competitivos con privacidad estricta (cada agente solo conoce su propia valoración) pueden alcanzar resultados competitivos, es decir, los precios agregan y comunican la información dispersa de manera eficiente.",
     "doc_id": 224
    }
   ],
   "citas": [
    {
     "texto": "Vernon Smith (1982) called this concept the 'Hayek Hypothesis'.",
     "doc_id": 224
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "informational efficiency",
     "doc_id": 224,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "competitive allocation mechanism",
     "doc_id": 224,
     "revisar": false
    }
   ]
  },
  {
   "id": "friction of trading constrained consideration set",
   "nombre_canonico": "frictions of trading (constrained consideration sets)",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "frictions of trading (constrained consideration sets)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    224
   ],
   "definiciones": [
    {
     "texto": "Supuesto de que los consumidores tienen acceso limitado e independiente a los market-makers; cada consumidor conoce un subconjunto propio de intermediarios. Esto genera poder de mercado, dispersión de precios y spreads no nulos en equilibrio.",
     "doc_id": 224
    }
   ],
   "citas": [
    {
     "texto": "We represent the frictions of trading by the assumption that consumers have constrained access regarding the market-makers that they can trade with.",
     "doc_id": 224
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "bid-ask spread",
     "doc_id": 224,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "market making",
     "doc_id": 224,
     "revisar": false
    }
   ]
  },
  {
   "id": "non fungible token",
   "nombre_canonico": "non-fungible tokens",
   "tipo": "concepto",
   "nombres_vistos": [
    "non-fungible tokens"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    225
   ],
   "definiciones": [
    {
     "texto": "Coleccionables digitales únicos y escasos asegurados sobre una blockchain, que proveen autenticidad de origen, propiedad, unicidad (escasez) y permanencia para un ítem particular. Su oferta máxima es 1.",
     "doc_id": 225
    }
   ],
   "citas": [
    {
     "texto": "NFTs are unique and rare digital collectibles which are secured over a blockchain. An NFT provides authenticity of origin, ownership, uniqueness (scarcity), and permanence for any particular item.",
     "doc_id": 225
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "blockchain",
     "doc_id": 225,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "fungible cryptocurrencies",
     "doc_id": 225,
     "revisar": false
    }
   ]
  },
  {
   "id": "price formation",
   "nombre_canonico": "price formation",
   "tipo": "concepto",
   "nombres_vistos": [
    "price formation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    225
   ],
   "definiciones": [
    {
     "texto": "Proceso por el cual los precios incorporan nueva información. En NFTs se realiza mediante dos mecanismos principales: precio fijo (7 a 180 días) y subasta cronometrada (inglesa u holandesa).",
     "doc_id": 225
    }
   ],
   "citas": [
    {
     "texto": "Price formation is the process by which prices confine new information. NFTs are generally traded in two ways - Fixed Price and Timed Auction.",
     "doc_id": 225
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "market microstructure",
     "doc_id": 225,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "English auction",
     "doc_id": 225,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Dutch auction",
     "doc_id": 225,
     "revisar": false
    }
   ]
  },
  {
   "id": "gas fee",
   "nombre_canonico": "gas fees",
   "tipo": "concepto",
   "nombres_vistos": [
    "gas fees"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    225
   ],
   "definiciones": [
    {
     "texto": "Tarifa de minería inherente para realizar transacciones descentralizadas entre dos partes, distinta de la comisión institucional. No es consumida por el marketplace sino que sirve como fee de minería en la blockchain. Plataformas como Polygon intentan anular este costo.",
     "doc_id": 225
    }
   ],
   "citas": [
    {
     "texto": "Gas fee is something different from institutional commission as it is a fee that is not consumed by the marketplace for facilitating NFT trade but serves as an inherent mining fee for actually making the decentralized transaction between two parties.",
     "doc_id": 225
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "decentralized exchange",
     "doc_id": 225,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Ethereum",
     "doc_id": 225,
     "revisar": false
    }
   ]
  },
  {
   "id": "transparency",
   "nombre_canonico": "transparency",
   "tipo": "concepto",
   "nombres_vistos": [
    "transparency"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    225
   ],
   "definiciones": [
    {
     "texto": "Disponibilidad de información de mercado para los participantes. Tiene dos dimensiones: pre-trade (difusión de cotizaciones bid-ask actuales y desequilibrios de órdenes grandes) y post-trade (divulgación pública oportuna de información sobre transacciones pasadas). Mayor transparencia se asocia con precios más informativos, pero la transparencia total no siempre es beneficiosa.",
     "doc_id": 225
    }
   ],
   "citas": [
    {
     "texto": "Transparency deals with the availability of market information to the market participants. Greater transparency, both pre- and posttrade, is generally associated with more informative prices. Complete transparency is not always beneficial to the operation of the market.",
     "doc_id": 225
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
