   "doc_frecuencia": 1,
   "doc_ids": [
    100
   ],
   "definiciones": [
    {
     "texto": "Filtro inicial cualitativo que restringe el universo de pares candidatos a aquellos en donde ambos tokens pertenecen al mismo ecosistema blockchain, asumiendo mayor estabilidad estructural y flujos de liquidez compartidos.",
     "doc_id": 100
    }
   ],
   "citas": [
    {
     "texto": "we assign each asset in our universe to its corresponding underlying chain and restrict attention to pairs whose constituents originate from the same blockchain.",
