  {
   "id": "information coefficient ic",
   "nombre_canonico": "Information Coefficient (IC)",
   "tipo": "metrica",
   "nombres_vistos": [
    "Information Coefficient (IC)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    138
   ],
   "definiciones": [
    {
     "texto": "Medida utilizada para evaluar la calidad del factor; computada como la correlación de rangos de Spearman entre la señal de alpha diaria y los retornos a futuro.",
     "doc_id": 138
    }
   ],
   "citas": [
    {
     "texto": "The Information Coefficient (IC) measures the rank correlation between generated alpha signals and realized forward returns, with higher values indicating stronger factor quality.",
     "doc_id": 138
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "alpha ranking strength",
     "doc_id": 138,
