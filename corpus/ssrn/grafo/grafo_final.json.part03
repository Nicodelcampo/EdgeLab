   "tipo": "metodo",
   "nombres_vistos": [
    "DiceStock architecture"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    90
   ],
   "definiciones": [
    {
     "texto": "Simulador de mercado basado en agentes donde todo comportamiento se deriva de una cuadrícula de dados de 100x100 lanzados de forma independiente cada tick, dividida en 10 bandas funcionales para generar señales estadísticas (dirección, volatilidad, liquidez, etc.).",
     "doc_id": 90
    }
   ],
   "citas": [
    {
     "texto": "All agent behavior derives from a single shared stochastic mechanism: a 100x100 grid of dice, each rolled independently every tick",
     "doc_id": 90
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
