   "tipo": "metodo",
   "nombres_vistos": [
    "Data proxying"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    177
   ],
   "definiciones": [
    {
     "texto": "Uso de datos proxy para imitar datos históricos necesarios para el backtesting cuando hay falta de suficiente información en un mercado determinado.",
     "doc_id": 177
    }
   ],
   "citas": [
    {
     "texto": "When there is not enough historical data in one market to calibrate a system, a developer may utilize data proxying, to imitate the historical data needed for 'Back Testing'.",
     "doc_id": 177
    }
   ],
