     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "time and information unfairness",
     "doc_id": 151,
     "revisar": false
    }
   ]
  },
  {
   "id": "kyle s two stage model",
   "nombre_canonico": "Kyle's two-stage model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Kyle's two-stage model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    151
   ],
   "definiciones": [
    {
     "texto": "Modelo de microestructura financiera modificado en este estudio para incluir subastas secuenciales donde inversores fundamentales y minoristas introducen órdenes en la primera etapa, y el HFT actúa en la segunda etapa con base en señales imperfectas aprendidas previamente.",
     "doc_id": 151
    }
   ],
   "citas": [
    {
     "texto": "Methodologically, this study employs the two-stage model proposed by Kyle (1985), assuming the existence of two stages of centralized auctions. In each stage, fundamental investors and retail traders submit orders to MM, who aggregate the orders and determine prices.",
     "doc_id": 151
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EVALUA",
     "tipo_original": "EVALUA",
     "objeto_texto": "market stability",
     "doc_id": 151,
     "revisar": true
    }
   ]
  },
  {
   "id": "high frequency trading hft full dealer",
   "nombre_canonico": "High Frequency Trading (HFT) / Full Dealers",
   "tipo": "concepto",
   "nombres_vistos": [
    "High Frequency Trading (HFT) / Full Dealers"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    152
   ],
   "definiciones": [
    {
     "texto": "Dealers adversos al riesgo que proveen liquidez y tienen una presencia continua en el mercado a través de múltiples períodos de trading, en contraste con los dealers estándar que solo participan limitadamente.",
     "doc_id": 152
    }
   ],
   "citas": [
    {
     "texto": "Full dealers, like stylized high frequency traders (HFTs), are continuously in the market and can therefore accommodate the reverting orders of the first traders' cohort",
     "doc_id": 152
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "participation friction",
     "doc_id": 152,
     "revisar": false
    }
   ]
  },
  {
   "id": "informational friction",
   "nombre_canonico": "Informational friction",
   "tipo": "concepto",
   "nombres_vistos": [
    "Informational friction"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    152
   ],
   "definiciones": [
    {
     "texto": "Fricción generada cuando no todos los traders tienen acceso a información oportuna y transparente sobre el mercado (como los desbalances de órdenes pasados), lo que exacerba la incertidumbre.",
     "doc_id": 152
    }
   ],
   "citas": [
    {
     "texto": "an informational friction (not all traders have access to timely market information)",
     "doc_id": 152
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "liquidity fragility",
     "doc_id": 152,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "strategic complementarities",
     "doc_id": 152,
     "revisar": false
    }
   ]
  },
  {
   "id": "participation friction",
   "nombre_canonico": "Participation friction",
   "tipo": "concepto",
   "nombres_vistos": [
    "Participation friction"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    152
   ],
   "definiciones": [
    {
     "texto": "Situación en la cual no todos los proveedores de liquidez están presentes continuamente en el mercado, dificultando la absorción de shocks a lo largo del tiempo.",
     "doc_id": 152
    }
   ],
   "citas": [
    {
     "texto": "a participation friction (not all liquidity suppliers are continuously present in the market)",
     "doc_id": 152
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "endowment shock propagation",
     "doc_id": 152,
     "revisar": false
    }
   ]
  },
  {
   "id": "strategic complementaritie in liquidity demand",
   "nombre_canonico": "Strategic complementarities in liquidity demand",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Strategic complementarities in liquidity demand"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    152
   ],
   "definiciones": [
    {
     "texto": "Dinámica por la cual los traders demandan más inmediatez/liquidez cuando perciben que el mercado es menos líquido, generando un bucle de retroalimentación que puede detonar una crisis de liquidez.",
     "doc_id": 152
    }
   ],
   "citas": [
    {
     "texto": "traders demand more liquidity when the market becomes less liquid, which in turn makes the market more illiquid, fostering the initial demand hike.",
     "doc_id": 152
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "flash crash",
     "doc_id": 152,
     "revisar": false
    }
   ]
  },
  {
   "id": "flash event flash crash",
   "nombre_canonico": "Flash event / Flash crash",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Flash event / Flash crash"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    152
   ],
   "definiciones": [
    {
     "texto": "Episodio de inestabilidad extrema y rápida del mercado donde los precios caen y se recuperan bruscamente, impulsado por retiros de liquidez que generan pánico.",
     "doc_id": 152
    }
   ],
   "citas": [
    {
     "texto": "an episode in which the price of a contract moved at least 200 basis points within a trading hour but returned to within 75 basis points of the original or starting price within that same hour.",
     "doc_id": 152
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "liquidity withdrawal",
     "doc_id": 152,
     "revisar": false
    }
   ]
  },
  {
   "id": "limited market participation",
   "nombre_canonico": "limited market participation",
   "tipo": "concepto",
   "nombres_vistos": [
    "limited market participation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    153
   ],
   "definiciones": [
    {
     "texto": "Restricción temporal en la que ciertos creadores de mercado solo operan en algunas rondas, obligando a propagar el inventario residual a los siguientes periodos.",
     "doc_id": 153
    }
   ],
   "citas": [
    {
     "texto": "dealers’ limited market participation favors the propagation of the endowment shock across time, inducing a predictable price pressure.",
     "doc_id": 153
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "order flow imbalance",
     "doc_id": 153,
