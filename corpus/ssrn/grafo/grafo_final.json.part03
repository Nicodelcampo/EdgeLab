   "nombres_vistos": [
    "fat-tailed return distributions"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    90
   ],
   "definiciones": [
    {
     "texto": "Retornos extremos mucho más probables que en una distribución normal. En la simulación se observa una curtosis excesiva de 11.07 y un índice de cola de Hill de 2.74, congruentes con los mercados reales.",
     "doc_id": 90
    }
   ],
   "citas": [
    {
     "texto": "Excess kurtosis of 11.07 indicates extremely heavy tails. The Jarque-Bera test decisively rejects normality",
     "doc_id": 90
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
