   "tipo": "concepto",
   "nombres_vistos": [
    "Market Accessibility"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    172
   ],
   "definiciones": [
    {
     "texto": "Grado de facilidad con que los inversores pueden participar en un mercado, medido a través de la MTU como proxy. Afecta los patrones de inversión y características de los ETFs.",
     "doc_id": 172
    }
   ],
   "citas": [
    {
     "texto": "We adopt the minimum trading unit (MTU) as a proxy for market accessibility.",
     "doc_id": 172
    }
   ],
