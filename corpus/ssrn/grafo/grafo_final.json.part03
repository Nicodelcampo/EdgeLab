   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    147
   ],
   "definiciones": [
    {
     "texto": "Esquema heurístico que subdivide las series de tiempo en segmentos más grandes (coarse grid) y calcula límites superiores e inferiores de energía para filtrar rápidamente pares sin relación.",
     "doc_id": 147
    }
   ],
   "citas": [
    {
     "texto": "In order to reduce the computational time, we propose an upper bounding measure that is similar to the lower bound of the fast search method for dynamic time warping (FTW).",
     "doc_id": 147
    }
   ],
