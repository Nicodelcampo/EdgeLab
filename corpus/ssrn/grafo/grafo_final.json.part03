     "doc_id": 93
    }
   ],
   "citas": [
    {
     "texto": "PLS-SEM allows the explanatory power of multiple interconnected factors to be assessed within a single framework.",
     "doc_id": 93
    }
   ],
   "relaciones_crudas": []
  },
  {
