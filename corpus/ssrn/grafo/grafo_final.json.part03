  {
   "id": "volatility skewness",
   "nombre_canonico": "volatility skewness",
   "tipo": "metrica",
   "nombres_vistos": [
    "volatility skewness"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    93
   ],
   "definiciones": [
    {
     "texto": "Medida de la asimetría proyectada en los retornos capturada a partir de opciones; refleja las expectativas adelantadas de los traders de opciones.",
     "doc_id": 93
    }
   ],
   "citas": [
    {
     "texto": "The composite price construct combines spot exchange rates with risk reversals (volatility skewness), capturing both realised movements and forward-looking asymmetry derived from options markets.",
     "doc_id": 93
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
