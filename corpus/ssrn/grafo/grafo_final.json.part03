   "nombres_vistos": [
    "nirvana strategies"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    117
   ],
   "definiciones": [
    {
     "texto": "Estrategias de inversión en modelos teóricos que resultan en utilidad esperada infinita en un horizonte temporal finito, una anomalía que empujaría al mercado fuera del equilibrio si los agentes existieran.",
     "doc_id": 117
    }
   ],
   "citas": [
    {
     "texto": "[KO96] and [KK04] has observed this phenomenon and coined the terms “nirvana strategies” and “I-unstable” for investment strategies that yield infinite expected utility in finite investment horizon.",
     "doc_id": 117
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "ill-posed optimal investment problem",
     "doc_id": 117,
     "revisar": false
    }
   ]
  },
  {
   "id": "critical relative risk aversion",
   "nombre_canonico": "critical relative risk aversion",
   "tipo": "metrica",
   "nombres_vistos": [
    "critical relative risk aversion"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    117
   ],
   "definiciones": [
    {
     "texto": "Umbral del parámetro de aversión relativa al riesgo (γ0) por debajo del cual los agentes más propensos al riesgo consiguen utilidad infinita, indicando que el modelo de inversión está mal formulado.",
     "doc_id": 117
    }
   ],
   "citas": [
    {
     "texto": "We introduce the “critical relative risk aversion”, γ0",
     "doc_id": 117
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "well-posedness",
     "doc_id": 117,
     "revisar": false
    }
   ]
  },
  {
   "id": "quality arbitrage",
   "nombre_canonico": "quality arbitrage",
   "tipo": "estrategia",
   "nombres_vistos": [
    "quality arbitrage"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    119
   ],
   "definiciones": [
    {
     "texto": "Estrategia donde un participante del mercado automatizado conoce el comportamiento determinista de otros y obtiene beneficios explotando dicho comportamiento o la menor calidad tecnológica de los sistemas competidores.",
     "doc_id": 119
    }
   ],
   "citas": [
    {
     "texto": "Quality arbitrage occurs when one automated market participant knows the automated (therefore, deterministic) behavior of other market participants—trading firm, clearing firm, exchange—and profits by exploiting that behavior.",
     "doc_id": 119
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "deterministic behavior",
     "doc_id": 119,
     "revisar": false
    }
   ]
  },
  {
   "id": "quality management system qms",
   "nombre_canonico": "quality management system (QMS)",
   "tipo": "metodo",
   "nombres_vistos": [
    "quality management system (QMS)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    119
   ],
   "definiciones": [
    {
     "texto": "Técnicas y controles operativos de software y gestión de lanzamientos propuestos como base para un nuevo estándar ético transdisciplinario en el desarrollo de sistemas automatizados.",
     "doc_id": 119
    }
   ],
   "citas": [
    {
     "texto": "Better release management, software operational controls, and testing, that is, Quality Management System (QMS) should have prevented it.",
     "doc_id": 119
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "system failure",
     "doc_id": 119,
     "revisar": false
    }
   ]
  },
  {
   "id": "direct market access dma",
   "nombre_canonico": "direct market access (DMA)",
   "tipo": "concepto",
   "nombres_vistos": [
    "direct market access (DMA)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    119
   ],
   "definiciones": [
    {
     "texto": "Facilidades que permiten a una institución rutear órdenes directamente al libro del exchange sin pasar por los controles pre-trade del bróker o miembro compensador.",
     "doc_id": 119
    }
   ],
   "citas": [
    {
     "texto": "DMA describes the facilities that allow a financial institution to route orders to the exchange order book without first passing through its clearing member or broker’s technology for pre-trade approvals.",
     "doc_id": 119
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "exchange order book",
     "doc_id": 119,
     "revisar": false
    }
   ]
  },
  {
   "id": "implicit ethical agent",
   "nombre_canonico": "implicit ethical agents",
   "tipo": "concepto",
   "nombres_vistos": [
    "implicit ethical agents"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    119
   ],
   "definiciones": [
    {
     "texto": "Sistemas automatizados programados para comportarse éticamente o evitar comportamiento poco ético sin tener una representación explícita de los principios éticos, implementando las reglas de sus diseñadores humanos.",
     "doc_id": 119
    }
   ],
   "citas": [
    {
     "texto": "An implicit ethical agent is “programmed to behave ethically, or at least avoid unethical behavior, though without explicit representation of ethical principles”—much as a safety catch on a gun may prevent unintended killing.",
     "doc_id": 119
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "automated trading systems",
     "doc_id": 119,
     "revisar": false
    }
   ]
  },
  {
   "id": "flipping",
   "nombre_canonico": "flipping",
   "tipo": "metodo",
   "nombres_vistos": [
    "flipping"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    120
   ],
   "definiciones": [
    {
     "texto": "Técnica de manipulación que involucra colocar una orden grande en un lado del libro para forzar un movimiento de precios y ejecutar en el otro.",
     "doc_id": 120
    }
   ],
   "citas": [
    {
     "texto": "they would put a very large order on the other side of the book, to make the price move that way, and then they pull in all of a sudden and put an order on the other side. That’s called ‘flipping’.",
     "doc_id": 120
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "churning",
   "nombre_canonico": "churning",
   "tipo": "metodo",
   "nombres_vistos": [
    "churning"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    120
   ],
   "definiciones": [
    {
     "texto": "Práctica de realizar transacciones sin una ventaja económica particular, a menudo por razones ilegales o espurias.",
     "doc_id": 120
    }
   ],
   "citas": [
    {
     "texto": "churning is a classic way in high frequency trading, when you are trading for no particular economic advantage",
     "doc_id": 120
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "constructive trade",
   "nombre_canonico": "constructive trade",
   "tipo": "estrategia",
   "nombres_vistos": [
    "constructive trade"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    121
   ],
   "definiciones": [
    {
     "texto": "Estrategia que permite a un insider obtener exposición económica a las acciones de una empresa sin transferir su propiedad legal, evitando así las leyes contra el insider trading.",
     "doc_id": 121
    }
   ],
   "citas": [
    {
     "texto": "Our purpose in this article is to demonstrate how constructive trades circumvent the insider trading law by allowing an insider to obtain economic exposure over a share of stock without obtaining or divesting his title over the stock.",
     "doc_id": 121
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "put-call parity",
     "doc_id": 121,
     "revisar": false
    }
   ]
  },
  {
   "id": "put call parity",
   "nombre_canonico": "put-call parity",
   "tipo": "concepto",
   "nombres_vistos": [
    "put-call parity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    121
   ],
   "definiciones": [
    {
     "texto": "Teorema financiero que establece que el retorno de una acción más el de una opción de venta es igual al de un préstamo más el de una opción de compra, usado aquí para sintetizar posiciones largas en acciones.",
     "doc_id": 121
    }
   ],
   "citas": [
    {
     "texto": "The theorem provides that, given a particular time period, the return on a share of stock plus the payoff from an option to sell the share of stock is equivalent to the return on a loan agreement plus the payoff from an option to buy the share of stock.",
     "doc_id": 121
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "cash netting arrangement",
   "nombre_canonico": "cash netting arrangement",
   "tipo": "metodo",
   "nombres_vistos": [
    "cash netting arrangement"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    121
   ],
   "definiciones": [
    {
     "texto": "Modo de liquidación de opciones en el que el vendedor paga el valor de mercado en efectivo en lugar de entregar físicamente las acciones, lo cual es vital para eludir la transferencia de propiedad.",
     "doc_id": 121
    }
   ],
   "citas": [
    {
     "texto": "Cash netting arrangement, on the other hand, is a mode of settlement whereby the seller, who promised to deliver the shares to the buyer, will instead pay the fair market value of the said shares.",
     "doc_id": 121
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "derivative",
   "nombre_canonico": "derivative",
   "tipo": "concepto",
   "nombres_vistos": [
    "derivative"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    121
   ],
   "definiciones": [
    {
     "texto": "Instrumentos financieros (opciones, swaps, forwards) utilizados para separar el interés económico de la propiedad legal de un activo subyacente.",
     "doc_id": 121
    }
   ],
   "citas": [
    {
     "texto": "Through the proliferation of derivative contracts in the financial system, investors and market players acquire the tools to unbundle economic interest from stock ownership.",
     "doc_id": 121
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "constructive trade",
     "doc_id": 121,
     "revisar": false
    }
   ]
  },
  {
   "id": "call option",
   "nombre_canonico": "call option",
   "tipo": "concepto",
   "nombres_vistos": [
    "call option"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    121
   ],
   "definiciones": [
    {
     "texto": "Contrato que otorga el derecho, pero no la obligación, de comprar un activo a un precio fijo en el futuro, utilizado en conjunto con préstamos y opciones put para replicar la exposición a acciones.",
     "doc_id": 121
    }
   ],
   "citas": [
    {
     "texto": "Under a call option, the owner has the unconditional obligation to sell the property the moment the option-holder exercises his option to buy.",
     "doc_id": 121
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "derivative",
     "doc_id": 121,
     "revisar": false
    }
   ]
  },
  {
   "id": "put option",
   "nombre_canonico": "put option",
   "tipo": "concepto",
   "nombres_vistos": [
    "put option"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    121
   ],
   "definiciones": [
    {
     "texto": "Contrato que otorga al titular el derecho de vender un activo en el futuro, utilizado en este esquema de evasión legal para proteger la posición contra bajas en el precio del activo.",
     "doc_id": 121
    }
   ],
   "citas": [
    {
     "texto": "Under a put option, the non-owner has the unconditional obligation to buy the property the moment the owner (who is the option-holder) exercises his option to sell.",
     "doc_id": 121
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "derivative",
     "doc_id": 121,
     "revisar": false
    }
   ]
  },
  {
   "id": "swap contract",
   "nombre_canonico": "swap contract",
   "tipo": "concepto",
   "nombres_vistos": [
    "swap contract"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    121
   ],
   "definiciones": [
    {
     "texto": "Acuerdo donde dos partes intercambian los flujos de caja de sus respectivos valores, lo que permite asumir el riesgo de una acción sin transferir su título de propiedad.",
     "doc_id": 121
    }
   ],
   "citas": [
    {
     "texto": "Through a swap contract, one party who holds a security agrees with another party holding another security to exchange the cash flow of their respective securities.",
     "doc_id": 121
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "derivative",
     "doc_id": 121,
     "revisar": false
    }
   ]
  },
  {
   "id": "forward contract",
   "nombre_canonico": "forward contract",
   "tipo": "concepto",
   "nombres_vistos": [
    "forward contract"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    121
   ],
   "definiciones": [
    {
     "texto": "Contrato que obliga a las partes a comprar o vender un valor a un precio fijo en el futuro, que puede ser liquidado en efectivo para obtener exposición económica sin adquirir el título.",
     "doc_id": 121
    }
   ],
   "citas": [
    {
     "texto": "Through a forward contract, one party obligates himself to purchase or sell a security at a fixed price to be paid at a fixed future date.",
     "doc_id": 121
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "derivative",
     "doc_id": 121,
     "revisar": false
    }
   ]
  },
  {
   "id": "material non public information",
   "nombre_canonico": "material non-public information",
   "tipo": "dato",
   "nombres_vistos": [
    "material non-public information"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    121
   ],
   "definiciones": [
    {
     "texto": "Información confidencial que de publicarse afectaría el precio de mercado de un valor, la cual es la base para las ventajas ilegítimas explotadas en el insider trading.",
     "doc_id": 121
    }
   ],
   "citas": [
    {
     "texto": "If the option-holder is an insider, he has unfair advantage in the market because he possesses material non-public information that share prices will considerably increase at a future date.",
     "doc_id": 121
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "insider trading",
     "doc_id": 121,
     "revisar": false
    }
   ]
  },
  {
   "id": "eigenfactor",
   "nombre_canonico": "eigenfactors",
   "tipo": "metodo",
   "nombres_vistos": [
    "eigenfactors"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    123
   ],
   "definiciones": [
    {
     "texto": "Variables auxiliares ortogonales derivadas de la descomposición de valores propios que se utilizan para superar los problemas de colinealidad en la estimación OLS.",
     "doc_id": 123
    }
   ],
   "citas": [
    {
     "texto": "To overcome this problem, we propose to use auxiliary variables that are orthogonal to each other by construction. These variables are often referred to as eigenfactors...",
     "doc_id": 123
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "collinearity",
     "doc_id": 123,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "OLS regression",
     "doc_id": 123,
     "revisar": false
    }
   ]
  },
  {
   "id": "exogenou factor",
   "nombre_canonico": "exogenous factors",
   "tipo": "dato",
   "nombres_vistos": [
    "exogenous factors"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    123
   ],
   "definiciones": [
    {
     "texto": "Variables externas, como indicadores macroeconómicos y yields de bonos, que se introducen en modelos de pares para explicar ineficiencias de información y mejorar la estabilidad de la estrategia.",
     "doc_id": 123
    }
   ],
   "citas": [
    {
     "texto": "Specifically, we enhance the classic co-integration model developed by Vidyamurthy (2004) by introducing exogenous variables.",
     "doc_id": 123
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "pairs trading",
     "doc_id": 123,
     "revisar": false
    }
   ]
  },
  {
   "id": "collinearity",
   "nombre_canonico": "collinearity",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "collinearity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    123
   ],
   "definiciones": [
    {
     "texto": "Alta correlación entre variables independientes que impide que exista suficiente variabilidad matemática para calcular la matriz inversa en modelos OLS.",
     "doc_id": 123
    }
   ],
   "citas": [
    {
     "texto": "If {x} and {z} variables are highly correlated, however, there is not enough variability in the X and the necessary inverse of XTX may not exist, and β cannot be estimated.",
     "doc_id": 123
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "OLS failure",
     "doc_id": 123,
