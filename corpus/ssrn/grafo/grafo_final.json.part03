   "tipo": "estrategia",
   "nombres_vistos": [
    "risk-averse strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    89
   ],
   "definiciones": [
    {
     "texto": "Regla estricta donde solo se entra largo en una acción si la predicción de precio para el siguiente día es estrictamente positiva.",
     "doc_id": 89
    }
   ],
   "citas": [
    {
     "texto": "In the risk-averse strategy, the decision for the trader will be BUY only if the change in the stock price is positive and hold if it is negative.",
     "doc_id": 89
    }
   ],
   "relaciones_crudas": [
