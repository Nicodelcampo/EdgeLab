   "doc_ids": [
    86
   ],
   "definiciones": [
    {
     "texto": "Simulación de entradas aleatorias al mercado para construir una distribución empírica de métricas como el ratio de Sharpe y comparar si los retornos de la estrategia son un mero accidente estadístico.",
     "doc_id": 86
    }
   ],
   "citas": [
    {
     "texto": "The bootstrap method represents a way to compare the trading signals of the strategy against pure chance. The basic idea is to simulate random entries in the market",
     "doc_id": 86
    }
