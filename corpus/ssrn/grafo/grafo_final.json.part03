   "tipo": "metodo",
   "nombres_vistos": [
    "conditional density forecasts"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    88
   ],
   "definiciones": [
    {
     "texto": "Predicciones a múltiples pasos simulando escenarios de error mediante muestreo (bootstrap) de los residuos estandarizados, usadas para generar bandas de confianza dinámicas para señales de trading.",
     "doc_id": 88
    }
   ],
   "citas": [
    {
     "texto": "Forecasts are given in the form of a conditional probability density from which confidence bounds on the future value of the mispricing are derived. The estimation of an h-step-ahead conditional density is based on the simulation of 800 error scenarios.",
     "doc_id": 88
    }
   ],
   "relaciones_crudas": [
    {
