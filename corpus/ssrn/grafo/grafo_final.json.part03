  {
   "id": "finfluencer attention cycle",
   "nombre_canonico": "finfluencer attention cycle",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "finfluencer attention cycle"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    128
   ],
   "definiciones": [
    {
     "texto": "Ciclo en el cual los finfluencers suben contenido sobre acciones que ya se están moviendo, atrayendo volumen adicional de inversores retail, quienes sistemáticamente entran cuando la acción ya pasó su pico de precio, resultando en pérdidas.",
     "doc_id": 128
    }
   ],
   "citas": [
    {
     "texto": "The four-stage attention cycle: pre-existing volume elevation selects stocks into finfluencer content; content amplifies retail volume; retail late-entry buying coincides with negative post-event returns as informed traders exit.",
     "doc_id": 128
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "negative abnormal returns",
     "doc_id": 128,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "attention hypothesis",
     "doc_id": 128,
     "revisar": false
    }
   ]
  },
  {
   "id": "attention hypothesi",
   "nombre_canonico": "attention hypothesis",
   "tipo": "concepto",
   "nombres_vistos": [
    "attention hypothesis"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    128
   ],
   "definiciones": [
    {
     "texto": "Hipótesis que sostiene que los inversores retail tienen atención limitada y compran desproporcionadamente acciones que atraen su atención (ej. por recomendaciones de finfluencers), independientemente de su valor fundamental.",
     "doc_id": 128
    }
   ],
   "citas": [
    {
     "texto": "Under the attention hypothesis (Barber and Odean, 2008), retail investors are attention-constrained and disproportionately buy stocks that attract their attention, regardless of fundamental value.",
     "doc_id": 128
    }
   ],
   "relaciones_crudas": [
    {
