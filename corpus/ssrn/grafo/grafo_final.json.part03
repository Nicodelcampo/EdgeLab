   "tipo": "concepto",
   "nombres_vistos": [
    "Structural Failure Chain"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    134
   ],
   "definiciones": [
    {
     "texto": "Sucesión de rupturas históricas en modelos cuantitativos, desde la simple predicción estadística hasta modelos estocásticos y geométricos complejos, debido a su fracaso en incorporar correctamente la gobernanza y discontinuidad de la participación ante perturbaciones endógenas.",
     "doc_id": 134
    }
   ],
   "citas": [
    {
     "texto": "The paper traces the Structural Failure Chain through four historical phases and examines the emerging transitional layers (Phases V–VII)...",
     "doc_id": 134
    }
   ],
   "relaciones_crudas": []
  },
