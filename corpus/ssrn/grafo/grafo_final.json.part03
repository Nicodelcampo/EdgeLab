     "revisar": false
    }
   ]
  },
  {
   "id": "hawke exogeneity score",
   "nombre_canonico": "Hawkes Exogeneity Score",
   "tipo": "metrica",
   "nombres_vistos": [
    "Hawkes Exogeneity Score"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    205
   ],
   "definiciones": [
    {
     "texto": "Ratio ρ(t) = µ̂(t)/λ(t) que estima la fracción de intensidad de trading atribuible a innovación exógena versus cascadas endógenas, integrado como feature del encoder de mercado.",
     "doc_id": 205
    }
   ],
   "citas": [
    {
     "texto": "The exogeneity score ρ(t) = µ̂(t)/λ(t) represents the estimated fraction of intensity attributable to exogenous innovation.",
     "doc_id": 205
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "exogenous information content",
     "doc_id": 205,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Hawkes Process de-clustering",
     "doc_id": 205,
     "revisar": false
    }
   ]
  },
  {
   "id": "market endogeneity",
   "nombre_canonico": "Market Endogeneity",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Market Endogeneity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    205
   ],
   "definiciones": [
    {
     "texto": "Fenómeno documentado por Bouchaud donde más del 90% de los movimientos de precio intradiarios no tienen causa exógena identificable, siendo producto de la mecánica interna del mercado (memoria larga de flujo, impacto transitorio).",
     "doc_id": 205
    }
   ],
   "citas": [
    {
     "texto": "Bouchaud shows that more than 90% of significant movements have no identifiable exogenous cause. Volatility is therefore not the reflection of a news flow but the product of the market's internal mechanics.",
     "doc_id": 205
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "endogenous noise",
     "doc_id": 205,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Hawkes Process de-clustering",
     "doc_id": 205,
     "revisar": false
    }
   ]
  },
  {
   "id": "hawke process de clustering",
   "nombre_canonico": "Hawkes Process de-clustering",
   "tipo": "metodo",
   "nombres_vistos": [
    "Hawkes Process de-clustering"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    205
   ],
   "definiciones": [
    {
     "texto": "Proceso puntual auto-excitante que descompone la intensidad condicional λ(t) en baseline exógeno µ(t) más kernel endógeno ϕ(t), permitiendo separar señal informativa de ruido de cascada.",
     "doc_id": 205
    }
   ],
   "citas": [
    {
     "texto": "The formalism suited to this task is that of Hawkes processes, self-exciting point processes whose conditional intensity decomposes into λ(t) = µ(t) + Σ ϕ(t−ti).",
     "doc_id": 205
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Market Endogeneity",
     "doc_id": 205,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "branching ratio",
     "doc_id": 205,
     "revisar": false
    }
   ]
  },
  {
   "id": "contrastive learning for embedding alignment",
   "nombre_canonico": "Contrastive Learning for Embedding Alignment",
   "tipo": "metodo",
   "nombres_vistos": [
    "Contrastive Learning for Embedding Alignment"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    205
   ],
   "definiciones": [
    {
     "texto": "Entrenamiento contrastivo inspirado en CLIP que alinea los espacios de embedding del encoder de mercado y del encoder semántico usando pares de entrenamiento construidos con un proxy de mercado observable a posteriori.",
     "doc_id": 205
    }
   ],
   "citas": [
    {
     "texto": "We use a shared projection layer trained by contrastive learning, in the spirit of Radford et al. on multimodal alignment.",
     "doc_id": 205
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Microstructural Encoder",
