     "tipo_original": "REQUIERE",
     "objeto_texto": "price impact",
     "doc_id": 176,
     "revisar": false
    }
   ]
  },
  {
   "id": "continuou time markov chain",
   "nombre_canonico": "Continuous-Time Markov Chain",
   "tipo": "metodo",
   "nombres_vistos": [
    "Continuous-Time Markov Chain"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    176
   ],
   "definiciones": [
    {
     "texto": "Modelo microscópico de dinámica del order book donde los eventos (órdenes de mercado, límite y cancelaciones) ocurren con intensidades dadas. El estado es la cantidad de órdenes en cada nivel de precio.",
     "doc_id": 176
    }
   ],
   "citas": [
    {
     "texto": "Order book dynamics are described by a continuous-time Markov chain (CTMC).",
     "doc_id": 176
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
