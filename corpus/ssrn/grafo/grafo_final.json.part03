  {
   "id": "statistical arbitrage bound",
   "nombre_canonico": "statistical arbitrage bounds",
   "tipo": "metodo",
   "nombres_vistos": [
    "statistical arbitrage bounds"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    98
   ],
   "definiciones": [
    {
     "texto": "Límites de precios libres de arbitraje estadístico, basados en la ausencia de estrategias de costo cero con pago esperado positivo y riesgo acotado.",
     "doc_id": 98
    }
   ],
   "citas": [
    {
     "texto": "We derive statistical arbitrage bounds for the buying and selling price of European derivatives under incomplete markets.",
     "doc_id": 98
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "superreplication bounds",
