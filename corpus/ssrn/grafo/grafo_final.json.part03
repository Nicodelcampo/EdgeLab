  {
   "id": "inner refinement loop",
   "nombre_canonico": "Inner Refinement Loop",
   "tipo": "metodo",
   "nombres_vistos": [
    "Inner Refinement Loop"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    138
   ],
   "definiciones": [
    {
     "texto": "Bucle interno de refinamiento que itera entre el WriterAgent (generación) y el JudgeAgent (evaluación de sintaxis, lógica y look-ahead bias) para obtener código de alta calidad.",
     "doc_id": 138
    }
   ],
   "citas": [
    {
     "texto": "The inner loop refines candidate alpha code through iterative collaboration between WriterAgent and JudgeAgent, ensuring that only high-quality candidates are backtested.",
     "doc_id": 138
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "JudgeAgent",
     "doc_id": 138,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "WriterAgent",
     "doc_id": 138,
     "revisar": false
    }
   ]
  },
  {
   "id": "outer feedback loop",
   "nombre_canonico": "Outer Feedback Loop",
   "tipo": "metodo",
   "nombres_vistos": [
    "Outer Feedback Loop"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    138
   ],
   "definiciones": [
    {
     "texto": "Bucle externo que evalúa las fórmulas refinadas a través de datos históricos (backtesting) y, de superar un umbral de calidad, las almacena en la base de conocimiento principal.",
     "doc_id": 138
    }
   ],
   "citas": [
    {
     "texto": "For each trading idea, run the inner loop to obtain refined code, backtest on historical data, analyze results, and conditionally accumulate successful alphas to the knowledge base.",
     "doc_id": 138
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "BacktestEngine",
     "doc_id": 138,
     "revisar": false
    }
   ]
  },
  {
   "id": "knowledge base retrieval",
   "nombre_canonico": "Knowledge Base Retrieval",
   "tipo": "metodo",
   "nombres_vistos": [
    "Knowledge Base Retrieval"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    138
   ],
   "definiciones": [
    {
     "texto": "Mecanismo que obtiene los ejemplos más similares de estrategias previas exitosas y patrones de 101 Alphas basándose en similitud coseno (usando un modelo de embeddings), para inyectarlos en el prompt del LLM.",
     "doc_id": 138
    }
   ],
   "citas": [
    {
     "texto": "At each inner-loop iteration, the WriterAgent queries both sources to retrieve relevant examples and proven formulaic patterns, ensuring that generation is anchored in both empirical discoveries and established mathematical operators.",
     "doc_id": 138
    }
   ],
   "relaciones_crudas": [
