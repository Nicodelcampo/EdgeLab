   ],
   "citas": [
    {
     "texto": "Spectral stability ensures that small perturbations in the representation space do not amplify across time when mediated by the actions of strategic agents.",
     "doc_id": 201
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "representation dynamics",
     "doc_id": 201,
     "revisar": false
    }
   ]
  },
  {
   "id": "game theoretic reinforcement learning",
   "nombre_canonico": "game-theoretic reinforcement learning",
   "tipo": "metodo",
   "nombres_vistos": [
    "game-theoretic reinforcement learning"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    201
   ],
   "definiciones": [
    {
     "texto": "Uso de métodos de aprendizaje por refuerzo en un entorno multi-agente donde las estrategias se actualizan en respuesta a la representación LLM y a las acciones de los demás agentes, buscando maximizar una recompensa descontada.",
     "doc_id": 201
    }
   ],
   "citas": [
    {
     "texto": "Each agent updates its strategy via an RL scheme... where the gradient is estimated from sampled trajectories.",
     "doc_id": 201
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "high-frequency trading",
     "doc_id": 201,
