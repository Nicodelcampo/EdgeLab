  {
   "id": "investor classification model",
   "nombre_canonico": "Investor Classification Model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Investor Classification Model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    159
   ],
   "definiciones": [
    {
     "texto": "Metodología basada en la obra de Kirilenko et al. (2011) que clasifica cuentas de operadores en función de su comportamiento diario, evaluando especialmente la relación entre la posición neta al final del día (inventario) y la cantidad de transacciones ejecutadas.",
     "doc_id": 159
    }
   ],
   "citas": [
    {
     "texto": "This method defines Investors as HFT or non-HFT based on their trading behavior, particularly their daily net holding position in the instrument, the level of activity on the market in terms of value traded, and the quantity of transactions executed...",
     "doc_id": 159
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "inventory versus turnover analysis",
     "doc_id": 159,
     "revisar": false
    }
   ]
  },
  {
   "id": "high frequency trader hft",
   "nombre_canonico": "High-Frequency Traders (HFT)",
   "tipo": "concepto",
   "nombres_vistos": [
    "High-Frequency Traders (HFT)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    159
   ],
   "definiciones": [
    {
     "texto": "Subconjunto de intermediarios que representan el 7% superior de las cuentas por cantidad de transacciones diarias, operando con estrategias algorítmicas hiperactivas para capturar micro-beneficios mientras mantienen posiciones netas mínimas al cierre.",
     "doc_id": 159
    }
   ],
   "citas": [
    {
     "texto": "High-Frequency Traders (HFT) can be identified as a subset of Intermediaries and represent the top 7% of trading accounts when ranked by the number of daily transactions in which they are involved.",
     "doc_id": 159
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Intermediaries",
     "doc_id": 159,
     "revisar": false
    }
   ]
  },
  {
   "id": "closeout strategy",
   "nombre_canonico": "closeout strategy",
   "tipo": "estrategia",
   "nombres_vistos": [
    "closeout strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    160
   ],
   "definiciones": [
    {
     "texto": "Regla de trading intradiario donde todas las posiciones abiertas se liquidan al final de la jornada, independientemente del valor del portafolio, mitigando el gap risk overnight.",
     "doc_id": 160
    }
   ],
   "citas": [
    {
     "texto": "trade during the day based on indicators, signals, and rules, but with the additional rule where we liquidate all positions at the end of the trading date regardless of portfolio value.",
     "doc_id": 160
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "COMPARA_CON",
     "tipo_original": "COMPARA_CON",
     "objeto_texto": "non-closeout strategy",
     "doc_id": 160,
     "revisar": true
    }
   ]
  },
  {
   "id": "non closeout strategy",
   "nombre_canonico": "non-closeout strategy",
   "tipo": "estrategia",
   "nombres_vistos": [
    "non-closeout strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    160
   ],
   "definiciones": [
    {
     "texto": "Enfoque donde las posiciones se mantienen durante la noche y se operan exclusivamente basándose en los movimientos de precio y las señales de los indicadores.",
     "doc_id": 160
    }
   ],
   "citas": [
    {
     "texto": "Hold positions over night and trade exclusively on the price movements and the interaction with indicators, signals, and rules process",
     "doc_id": 160
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "COMPARA_CON",
     "tipo_original": "COMPARA_CON",
     "objeto_texto": "closeout strategy",
     "doc_id": 160,
     "revisar": true
    }
   ]
  },
  {
   "id": "passive hft strategie",
   "nombre_canonico": "Passive HFT strategies",
   "tipo": "concepto",
   "nombres_vistos": [
    "Passive HFT strategies"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    161
   ],
   "definiciones": [
    {
     "texto": "Estrategias de trading de alta frecuencia que usan principalmente órdenes límite y están asociadas con la provisión de liquidez en el mercado.",
     "doc_id": 161
    }
   ],
   "citas": [
    {
     "texto": "Passive HFT strategies, namely those that use primarily limit orders, are associated with liquidity supply strategies...",
     "doc_id": 161
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA",
     "objeto_texto": "Market liquidity",
