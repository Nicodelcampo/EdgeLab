  {
   "id": "net asset value",
   "nombre_canonico": "Net Asset Value",
   "tipo": "metrica",
   "nombres_vistos": [
    "Net Asset Value"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    172
   ],
   "definiciones": [
    {
     "texto": "Valor liquidativo del ETF. La diferencia entre el precio del ETF y su NAV (spread) es mayor cuando el mercado subyacente tiene barreras de entrada elevadas.",
     "doc_id": 172
    }
   ],
   "citas": [
    {
     "texto": "A greater spread between the ETF price and the net asset value (NAV), greater tracking errors, and a lower probability of informed trading (PIN).",
     "doc_id": 172
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "tracking error",
     "doc_id": 172,
