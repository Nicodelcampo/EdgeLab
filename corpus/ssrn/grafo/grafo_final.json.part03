  {
   "id": "depth",
   "nombre_canonico": "depth",
   "tipo": "metrica",
   "nombres_vistos": [
    "depth"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    109
   ],
   "definiciones": [
    {
     "texto": "Cantidad acumulada de demanda (bid) o de oferta (ask) disponible entre niveles específicos del limit order book.",
     "doc_id": 109
    }
   ],
   "citas": [
    {
     "texto": "The depth measures the cumulative demand and supply for the stock at different levels of demand and supply schedules, respectively.",
     "doc_id": 109
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "midquote return",
     "doc_id": 109,
     "revisar": false
    }
   ]
  },
  {
   "id": "slope",
   "nombre_canonico": "slope",
   "tipo": "metrica",
   "nombres_vistos": [
    "slope"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    109
   ],
   "definiciones": [
    {
     "texto": "Cambio en el precio relativo a la cantidad acumulada disponible entre dos niveles del libro de órdenes; mide la sensibilidad del precio a cambios en la cantidad demandada u ofertada.",
     "doc_id": 109
    }
   ],
   "citas": [
    {
     "texto": "It is defined as the change in the price relative to the cumulative quantity available between levels l1 and l2 in period t",
     "doc_id": 109
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "midquote return",
     "doc_id": 109,
     "revisar": false
    }
   ]
  },
  {
