    191
   ],
   "definiciones": [
    {
     "texto": "Estrategia de reducción de riesgo mediante la inclusión de activos con correlaciones bajas. El crecimiento de activos bajo gestión activa ha agotado alpha y aumentado correlaciones entre activos de riesgo.",
     "doc_id": 191
    }
   ],
   "citas": [
    {
