  {
   "id": "cross asset lead lag",
   "nombre_canonico": "Cross-Asset Lead-Lag",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Cross-Asset Lead-Lag"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    206
   ],
   "definiciones": [
    {
     "texto": "Relaciones de liderazgo temporal entre diferentes instrumentos financieros donde uno proporciona información predictiva sobre precios, liquidez o volatilidad futura de otro en escalas de microsegundos a segundos.",
     "doc_id": 206
    }
   ],
   "citas": [
    {
     "texto": "Most of the lead-lag relationships in our sample exist between fundamentally related instruments.",
     "doc_id": 206
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "future returns",
     "doc_id": 206,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "Market Efficiency",
     "doc_id": 206,
     "revisar": false
    }
   ]
  },
  {
   "id": "market efficiency semi strong form",
   "nombre_canonico": "Market Efficiency (Semi-Strong Form)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Market Efficiency (Semi-Strong Form)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    206
   ],
   "definiciones": [
    {
     "texto": "Hipótesis de que los precios reflejan toda la información pública disponible. Las relaciones lead-lag explotables por HFTs más rápidos implican una violación parcial de esta hipótesis en escalas sub-segundo.",
     "doc_id": 206
    }
   ],
   "citas": [
    {
     "texto": "Lead-lag effects that imply statistical arbitrage opportunities and return predictability within time frames exploitable only by a small subset of the fastest high-frequency traders still contradict market efficiency.",
     "doc_id": 206
    }
   ],
   "relaciones_crudas": [
    {
