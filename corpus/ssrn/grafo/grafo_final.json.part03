    }
   ]
  },
  {
   "id": "ols regression",
   "nombre_canonico": "OLS regression",
   "tipo": "metodo",
   "nombres_vistos": [
    "OLS regression"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    189
   ],
   "definiciones": [
    {
     "texto": "Modelo formal de regresión lineal (mínimos cuadrados ordinarios) usado para testear si las señales de trading técnicas logran explicar la varianza de los retornos diarios.",
     "doc_id": 189
    }
   ],
   "citas": [
    {
     "texto": "In a formal test, signals from these rules are included in an OLS model trying to explain daily returns. Results show that signals can no explain the variance of returns.",
     "doc_id": 189
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "variance of returns",
     "doc_id": 189,
