  },
  {
   "id": "ping order",
   "nombre_canonico": "ping order",
   "tipo": "estrategia",
   "nombres_vistos": [
    "ping order"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    156
   ],
   "definiciones": [
    {
     "texto": "Envío de órdenes pequeñas para explorar y determinar la cantidad de liquidez oculta, especialmente en plataformas alternativas o dark pools.",
     "doc_id": 156
    }
   ],
   "citas": [
    {
     "texto": "Entering small orders in order to ascertain the level of hidden orders and particularly used to assess what is resting on a dark platform.",
     "doc_id": 156
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "message queue",
   "nombre_canonico": "message queue",
   "tipo": "concepto",
   "nombres_vistos": [
    "message queue"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    156
   ],
   "definiciones": [
    {
     "texto": "Cola en el sistema de intercambio que procesa órdenes de manera secuencial, limitando la capacidad de los HFT para cancelar sus posiciones si la cola es muy larga.",
     "doc_id": 156
    }
   ],
   "citas": [
    {
     "texto": "the exchange may have a message queue containing additional orders that will be processed before the exchange system receives and processes the market-maker's quote cancellation request.",
     "doc_id": 156
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "inventory risk",
