   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    90
   ],
   "definiciones": [
    {
     "texto": "La presencia de participantes en el mercado operando con distintas frecuencias y lógicas. El autor argumenta que esta multiplicidad de frecuencias de operación en un libro de órdenes compartido es el motor central de los hechos estilizados.",
     "doc_id": 90
    }
   ],
   "citas": [
    {
     "texto": "agent heterogeneity alone—operating at multiple timescales through a shared order book—is sufficient",
     "doc_id": 90
    }
   ],
