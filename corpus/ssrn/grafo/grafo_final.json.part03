    }
   ]
  },
  {
   "id": "speed hierarchy",
   "nombre_canonico": "speed hierarchy",
   "tipo": "concepto",
   "nombres_vistos": [
    "speed hierarchy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    157
   ],
   "definiciones": [
    {
     "texto": "La estructura de las velocidades relativas entre los HFTs, que determina su poder de mercado agregado más que su velocidad absoluta.",
     "doc_id": 157
    }
   ],
   "citas": [
    {
     "texto": "FTs’ speed hierarchies crucially influence FTs’ strategies and their market powers.",
     "doc_id": 157
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "speed tax",
   "nombre_canonico": "speed tax",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "speed tax"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    157
   ],
   "definiciones": [
    {
     "texto": "Costo indirecto que los HFT imponen a los proveedores de liquidez, los cuales lo trasladan a los traders regulares mediante peores precios.",
     "doc_id": 157
    }
   ],
   "citas": [
    {
     "texto": "FTs effectively levy a speed tax on passive liquidity providers and passive liquidity providers shift the tax burden to normal-speed liquidity demanders",
     "doc_id": 157
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "transaction costs",
     "doc_id": 157,
     "revisar": false
    }
   ]
  },
  {
   "id": "phantom liquidity",
   "nombre_canonico": "phantom liquidity",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "phantom liquidity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    157
   ],
   "definiciones": [
    {
     "texto": "Liquidez en el order book que los HFT retiran justo antes de que la orden de un trader regular sea ejecutada.",
     "doc_id": 157
    }
   ],
   "citas": [
    {
     "texto": "FTs’ trading results in 'phantom liquidity' that sometimes disappears right before a market order arrives.",
     "doc_id": 157
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "slippage",
     "doc_id": 157,
     "revisar": false
    }
   ]
  },
  {
   "id": "latency floor",
   "nombre_canonico": "latency floor",
   "tipo": "metodo",
   "nombres_vistos": [
    "latency floor"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    157
   ],
   "definiciones": [
    {
     "texto": "Regla que añade latencia aleatoria a cada orden en un exchange para mitigar las ventajas deterministas de velocidad.",
     "doc_id": 157
    }
   ],
   "citas": [
    {
     "texto": "latency floor rule, under which orders arriving within a short batching interval are executed in a random sequence",
     "doc_id": 157
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
