    }
   ]
  },
  {
   "id": "quantity competition",
   "nombre_canonico": "Quantity competition",
   "tipo": "concepto",
   "nombres_vistos": [
    "Quantity competition"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    161
   ],
   "definiciones": [
    {
     "texto": "Modelo de organización industrial donde las firmas usan su poder de mercado para elevar precios pero la competencia puede erosionarlo. Predice que al entrar más competidores, el tamaño total del mercado aumenta, los incumbentes pierden participación y los costos de liquidez disminuyen.",
     "doc_id": 161
    }
   ],
   "citas": [
    {
     "texto": "Under quantity competition, firms use their market power to raise prices, but competition can erode their market power... As the number of firms N increases: 1. Market size: total volume increases... 3. Liquidity: the price of liquidity decreases",
     "doc_id": 161
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "HFT competition",
     "doc_id": 161,
     "revisar": false
    }
   ]
  },
  {
   "id": "price competition",
   "nombre_canonico": "Price competition",
   "tipo": "concepto",
   "nombres_vistos": [
    "Price competition"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    161
   ],
   "definiciones": [
    {
     "texto": "Modelo teórico que asume que las empresas carecen de poder de mercado y bajan los precios hasta el costo marginal, por lo que los nuevos competidores no aportan beneficios adicionales. El estudio muestra empíricamente que los HFT no se comportan así.",
     "doc_id": 161
    }
   ],
   "citas": [
    {
     "texto": "Under price competition, firms lack market power, so they bid prices down to marginal cost... has the strong consequence that increased competition among similar firms brings no benefit",
     "doc_id": 161
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CONTRASTA_CON",
     "tipo_original": "CONTRASTA_CON",
     "objeto_texto": "Quantity competition",
     "doc_id": 161,
     "revisar": true
    }
   ]
  },
  {
   "id": "price synchronization",
   "nombre_canonico": "price synchronization",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "price synchronization"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    162
   ],
   "definiciones": [
    {
     "texto": "Ajuste casi instantáneo del precio de un activo en respuesta a movimientos en los precios de otros activos económicamente relacionados.",
     "doc_id": 162
    }
   ],
   "citas": [
    {
     "texto": "making the values of related securities change contemporaneously. With a model, I demonstrate how price synchronization leads to increased efficiency",
     "doc_id": 162
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "adverse selection",
     "doc_id": 162,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "price discovery",
     "doc_id": 162,
     "revisar": false
    }
   ]
  },
  {
   "id": "passive side order anticipation",
   "nombre_canonico": "passive-side order anticipation",
   "tipo": "estrategia",
   "nombres_vistos": [
    "passive-side order anticipation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    164
   ],
   "definiciones": [
    {
     "texto": "Estrategia donde los proveedores de liquidez cancelan sus cotizaciones restantes tras observar operaciones iniciales, evitando selección adversa.",
     "doc_id": 164
    }
   ],
   "citas": [
    {
     "texto": "traders may cancel their remaining quotes, which we call “passive-side order anticipation,”",
     "doc_id": 164
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "order anticipation",
     "doc_id": 164,
     "revisar": false
    }
   ]
  },
  {
   "id": "aggressive side order anticipation",
   "nombre_canonico": "aggressive-side order anticipation",
   "tipo": "estrategia",
   "nombres_vistos": [
    "aggressive-side order anticipation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    164
   ],
   "definiciones": [
    {
     "texto": "Estrategia donde algoritmos tipo sniper operan agresivamente contra las cotizaciones en otros exchanges tras inferir la dirección de una orden institucional.",
     "doc_id": 164
    }
   ],
   "citas": [
    {
     "texto": "traders other than the original trader may trade against the remaining quotes, which we call “aggressive-side order anticipation.”",
     "doc_id": 164
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "order anticipation",
     "doc_id": 164,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "adverse selection",
     "doc_id": 164,
     "revisar": false
    }
   ]
  },
  {
   "id": "noncancellation delay",
   "nombre_canonico": "noncancellation delay",
   "tipo": "metodo",
   "nombres_vistos": [
    "noncancellation delay"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    164
   ],
   "definiciones": [
    {
     "texto": "Mecanismo que retrasa el procesamiento de todas las órdenes excepto las cancelaciones, permitiendo a los creadores de mercado ajustar precios.",
     "doc_id": 164
    }
   ],
   "citas": [
    {
     "texto": "Noncancellation delay mechanisms (NDs) add a small delay between receipt at an exchange and processing for all order types but cancellations.",
     "doc_id": 164
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "aggressive-side order anticipation",
     "doc_id": 164,
     "revisar": false
    }
   ]
  },
  {
   "id": "illiquidity premium",
   "nombre_canonico": "illiquidity premium",
   "tipo": "concepto",
   "nombres_vistos": [
    "illiquidity premium"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    165
   ],
   "definiciones": [
    {
     "texto": "Retorno adicional que los inversores exigen por mantener activos ilíquidos. El paper argumenta que la intensa presencia de HFT en activos líquidos amplifica esta prima, deprimiendo el retorno esperado de dichos activos líquidos.",
     "doc_id": 165
    }
   ],
   "citas": [
    {
     "texto": "illiquid assets should provide a return premium... the magnitude of the illiquidity return premium depends not only on the cost per trade but also on trading frequency of the marginal investor",
     "doc_id": 165
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "mutual fund underperformance",
     "doc_id": 165,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "IML factor",
     "doc_id": 165,
     "revisar": false
    }
   ]
  },
  {
   "id": "hft intensity",
   "nombre_canonico": "HFT intensity",
   "tipo": "metrica",
   "nombres_vistos": [
    "HFT intensity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    165
   ],
   "definiciones": [
    {
     "texto": "Proxy que mide la actividad relativa de trading de alta frecuencia en una acción. Se construye a partir del número de mensajes de actualización de cotizaciones (quote messages) en TAQ, ortogonalizado por deciles de tamaño (market value) para evitar sesgos.",
     "doc_id": 165
    }
   ],
   "citas": [
    {
     "texto": "we use the number of quote messages, defined as the number of changes in the best bid or offer quote or size across all quote reporting venues in the United States, as our HFT proxy.",
     "doc_id": 165
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "high-frequency trading",
     "doc_id": 165,
     "revisar": false
    },
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "stock returns",
     "doc_id": 165,
     "revisar": false
    }
   ]
  },
  {
   "id": "quote message",
   "nombre_canonico": "quote messages",
   "tipo": "dato",
   "nombres_vistos": [
    "quote messages"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    165
   ],
   "definiciones": [
    {
     "texto": "Número de cambios en el mejor bid, offer o tamaño a través de todos los venues de reporte. Captura la naturaleza del HFT de enviar y cancelar masivamente órdenes.",
     "doc_id": 165
    }
   ],
   "citas": [
    {
     "texto": "number of quote messages, defined as the number of changes in the best bid or offer quote or size... This proxy captures one of the essential features of HFT—a very large number of order submissions and cancellations",
     "doc_id": 165
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "HFT intensity",
     "doc_id": 165,
     "revisar": false
    }
   ]
  },
  {
   "id": "iml factor",
   "nombre_canonico": "IML factor",
   "tipo": "metrica",
   "nombres_vistos": [
    "IML factor"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    165
   ],
   "definiciones": [
    {
     "texto": "Factor 'illiquid-minus-liquid' creado para controlar por la prima de iliquidez en modelos de valuación de activos, computado ordenando acciones por volatilidad y luego por relative quoted spread (RQS).",
     "doc_id": 165
    }
   ],
   "citas": [
    {
     "texto": "The zero-investment illiquidity premium factor, IML, is constructed as the difference in returns between the five least liquid portfolios and the five most liquid portfolios",
     "doc_id": 165
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "illiquidity premium",
     "doc_id": 165,
     "revisar": false
    }
   ]
  },
  {
   "id": "institutional trading cost",
   "nombre_canonico": "institutional trading costs",
   "tipo": "concepto",
   "nombres_vistos": [
    "institutional trading costs"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    165
   ],
   "definiciones": [
    {
     "texto": "Costos de transacción en los que incurren los fondos mutuos al operar. El paper descarta la hipótesis de que el HFT erosione los rendimientos de los fondos a través del incremento de estos costos (ej. vía back-running o predatory trading).",
     "doc_id": 165
    }
   ],
   "citas": [
    {
     "texto": "we do not find evidence to support the concern that HFT raises trading costs of mutual funds.",
     "doc_id": 165
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "illiquidity premium explanation",
     "doc_id": 165,
     "revisar": false
    }
   ]
  },
  {
   "id": "strategic run",
   "nombre_canonico": "strategic runs",
   "tipo": "estrategia",
   "nombres_vistos": [
    "strategic runs"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    166
   ],
   "definiciones": [
    {
     "texto": "Secuencia iterativa y veloz de envíos y cancelaciones de órdenes limitadas del mismo lado y cantidad, generada por algoritmos de trading de alta frecuencia (HFT) intentando interactuar o ganar prioridad frente a otros algoritmos.",
     "doc_id": 166
    }
   ],
   "citas": [
    {
     "texto": "According to the authors, a run starts with an order submission, followed by a cancellation of that order. Within a very short time interval, the algorithm resubmits the order on the same side and with the same order size.",
     "doc_id": 166
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "High-Frequency Trading (HFT)",
     "doc_id": 166,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "price discovery",
     "doc_id": 166,
     "revisar": false
    }
   ]
  },
  {
   "id": "variance decomposition",
   "nombre_canonico": "variance decomposition",
   "tipo": "metodo",
   "nombres_vistos": [
    "variance decomposition"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    166
   ],
   "definiciones": [
    {
     "texto": "Método de Hasbrouck (1991) para descomponer la varianza del precio eficiente y medir la proporción de innovación en el precio atribuible a cada tipo de evento del libro de órdenes.",
     "doc_id": 166
    }
   ],
   "citas": [
    {
     "texto": "In addition to the IRFs, we also calculate the information shares measure proposed by Hasbrouck (1991b) that is based on the decomposition of the variance of the efficient price.",
     "doc_id": 166
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "price discovery",
     "doc_id": 166,
     "revisar": false
    }
   ]
  },
  {
   "id": "aggressiveness",
   "nombre_canonico": "aggressiveness",
   "tipo": "metrica",
   "nombres_vistos": [
    "aggressiveness"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    166
   ],
   "definiciones": [
    {
     "texto": "Nivel de agresividad de un evento del libro de órdenes, medido por su distancia en ticks al mejor precio de compra/venta (BBO).",
     "doc_id": 166
    }
   ],
   "citas": [
    {
     "texto": "Firstly, we categorize limit order book events based on their aggressiveness, measured by the distance to the BBO in ticks.",
     "doc_id": 166
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "permanent price impact",
     "doc_id": 166,
     "revisar": false
    }
   ]
  },
  {
   "id": "structural vector autoregression svar",
   "nombre_canonico": "Structural Vector Autoregression (SVAR)",
   "tipo": "metodo",
   "nombres_vistos": [
    "Structural Vector Autoregression (SVAR)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    166
   ],
   "definiciones": [
    {
     "texto": "Modelo econométrico utilizado para aislar el impacto de distintas actividades del libro de órdenes (market orders, limit orders, cancelaciones) controlando por el lado (compra/venta) y la agresividad.",
     "doc_id": 166
    }
   ],
   "citas": [
    {
     "texto": "Hasbrouck (1991a) introduced a structural vectorautoregression (SVAR) model to estimate the price impact and the contribution to price discovery of trades.",
     "doc_id": 166
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "permanent price impact",
     "doc_id": 166,
     "revisar": false
    }
   ]
  },
  {
   "id": "backrunning",
   "nombre_canonico": "backrunning",
   "tipo": "estrategia",
   "nombres_vistos": [
    "backrunning"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    167
   ],
   "definiciones": [
    {
     "texto": "Estrategia en la que el HFTr opera en la misma dirección que los shocks de demanda para beneficiarse del movimiento del precio, utilizada cuando el trading se debe principalmente a información fundamental.",
     "doc_id": 167
    }
   ],
   "citas": [
    {
     "texto": "HFTr trades with any demand shocks it observes to benefit from this movement, a strategy referred to as backrunning.",
     "doc_id": 167
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "fundamental trading",
     "doc_id": 167,
     "revisar": false
    }
   ]
  },
  {
   "id": "order randomization",
   "nombre_canonico": "order randomization",
   "tipo": "estrategia",
   "nombres_vistos": [
    "order randomization"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    167
   ],
   "definiciones": [
    {
     "texto": "Acción del trader informado consistente en añadir un ruido aleatorio a sus órdenes óptimas para reducir la fracción de la demanda que contiene información, buscando reducir la utilidad esperada del HFT.",
     "doc_id": 167
    }
   ],
   "citas": [
    {
     "texto": "ITr can decide to add a noise of εrt around its optimal demand Qit* to artificially decrease the share of its demand that carries information about Ft. This is randomization.",
     "doc_id": 167
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "HFTr utility",
     "doc_id": 167,
     "revisar": false
    }
   ]
  },
  {
   "id": "information treatment effect",
   "nombre_canonico": "information treatment effect",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "information treatment effect"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    167
   ],
   "definiciones": [
    {
     "texto": "El efecto positivo del HFT sobre la eficiencia del precio que proviene de acelerar la incorporación de shocks en los precios, asumiendo que el comportamiento de los traders informados se mantiene constante.",
     "doc_id": 167
    }
   ],
   "citas": [
    {
     "texto": "the HFTr trading rule is correct on average, and consequently HFTr enhances the process of shock incorporation into prices. This is the information treatment effect.",
     "doc_id": 167
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "price efficiency",
     "doc_id": 167,
     "revisar": false
    }
   ]
  },
  {
   "id": "information content effect",
   "nombre_canonico": "information content effect",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "information content effect"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    167
   ],
   "definiciones": [
    {
     "texto": "El efecto negativo sobre la eficiencia del precio causado por la reducción del flujo de nueva información debido a que los traders informados reducen su participación o randomizan sus órdenes en respuesta al HFT.",
     "doc_id": 167
    }
   ],
   "citas": [
    {
     "texto": "Both exit and randomization imply that the share of fundamental trading over noise trading falls, decreasing price efficiency. This is the information content effect.",
     "doc_id": 167
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EMPEORA_A",
     "tipo_original": "EMPEORA_A",
     "objeto_texto": "price efficiency",
     "doc_id": 167,
     "revisar": true
    }
   ]
  },
  {
   "id": "liquidity detection",
   "nombre_canonico": "liquidity detection",
   "tipo": "estrategia",
   "nombres_vistos": [
    "liquidity detection"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    168
   ],
   "definiciones": [
    {
     "texto": "Monitoreo algorítmico de la profundidad del libro para anticiparse a grandes flujos de órdenes entrantes y posicionarse ventajosamente.",
     "doc_id": 168
    }
   ],
   "citas": [
    {
     "texto": "liquidity detection algorithms monitor order book depth to anticipate large incoming orders, allowing HFT firms to adjust positions preemptively",
     "doc_id": 168
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "order book depth",
     "doc_id": 168,
     "revisar": false
    }
   ]
  },
  {
   "id": "permanent volatility",
   "nombre_canonico": "permanent volatility",
   "tipo": "metrica",
   "nombres_vistos": [
    "permanent volatility"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    169
   ],
   "definiciones": [
    {
     "texto": "Métrica extraída tras descomponer la variación de los retornos, correspondiendo a los saltos direccionales informados y perdurables anclados en los fundamentales.",
     "doc_id": 169
    }
   ],
   "citas": [
    {
     "texto": "active HFTs contribute a much higher share to permanent volatility than NHFTs, whose contribution is basically zero.",
     "doc_id": 169
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "price discovery",
     "doc_id": 169,
     "revisar": false
    }
   ]
  },
  {
   "id": "new trading",
   "nombre_canonico": "news trading",
   "tipo": "estrategia",
   "nombres_vistos": [
    "news trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    169
   ],
   "definiciones": [
    {
     "texto": "Explotación del componente sorpresivo de anuncios pre-calendarizados a través del disparo de órdenes de forma automatizada e inmediata.",
     "doc_id": 169
    }
   ],
   "citas": [
    {
     "texto": "HFTs following news trading strategies. Since this requires fast and aggressive trading according to the surprise component of the news, HFT trades amplify both the beneﬁcial and the harmful determinants of price volatility",
     "doc_id": 169
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "high-frequency trading",
     "doc_id": 169,
     "revisar": false
    }
   ]
  },
  {
   "id": "fleeting order",
   "nombre_canonico": "fleeting order",
   "tipo": "concepto",
   "nombres_vistos": [
    "fleeting order"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    169
   ],
   "definiciones": [
    {
     "texto": "Puntas limitadas con un lapso de vida sumamente corto (a menudo inferior a dos segundos) que se cancelan si no son llenadas rápido.",
     "doc_id": 169
    }
   ],
   "citas": [
    {
     "texto": "over one-third of limit orders are canceled within two seconds in the US equity market and name those “ﬂeeting orders”. The calculated median deletion time of 2.5 seconds is close to their ﬁndings.",
     "doc_id": 169
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "information arbitrage",
   "nombre_canonico": "information arbitrage",
   "tipo": "concepto",
   "nombres_vistos": [
    "information arbitrage"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    169
   ],
   "definiciones": [
    {
     "texto": "Beneficio capturado gracias a un desequilibrio de velocidad donde un trader rápido golpea el libro de posturas lentas antes de que éstas ajusten sus precios post-noticia.",
     "doc_id": 169
    }
   ],
   "citas": [
    {
     "texto": "As soon as slower market participants also react to the news announcement by selling futures contracts... HFTs buy back the contracts at a much lower price and realize short-term trading gains. This eﬀect is called information arbitrage.",
     "doc_id": 169
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "high-frequency trading",
     "doc_id": 169,
