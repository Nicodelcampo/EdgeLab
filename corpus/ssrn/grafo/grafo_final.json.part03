   "tipo": "metodo",
   "nombres_vistos": [
    "impulse response function"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    109
   ],
   "definiciones": [
    {
     "texto": "Función utilizada para analizar el efecto acumulativo a largo plazo de las variables del limit order book sobre el retorno después de varias transacciones.",
     "doc_id": 109
    }
   ],
   "citas": [
    {
     "texto": "We calculate the impulse response functions of return to each limit order book variable... to reveal the long term cumulative effects",
     "doc_id": 109
    }
   ],
