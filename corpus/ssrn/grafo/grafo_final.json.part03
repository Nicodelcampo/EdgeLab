  {
   "id": "mahalanobi distance",
   "nombre_canonico": "Mahalanobis distance",
   "tipo": "metrica",
   "nombres_vistos": [
    "Mahalanobis distance"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    216
   ],
   "definiciones": [
    {
     "texto": "Métrica St que mide la distancia de cada punto latente zt al centroide del ruido ¯znoise, ponderada por la inversa de la matriz de covarianza Σnoise estimada adaptativamente vía EMA solo en períodos de ruido confirmado. Valores altos de St indican que el mercado ha abandonado su distribución estándar por presencia de flujo informado.",
     "doc_id": 216
    }
   ],
   "citas": [
    {
     "texto": "the Mahalanobis distance, which accounts for noise dispersion through its covariance matrix Σnoise.",
     "doc_id": 216
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "anomaly detection",
     "doc_id": 216,
