  {
   "id": "governance through trading grading",
   "nombre_canonico": "Governance through trading (grading)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Governance through trading (grading)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    143
   ],
   "definiciones": [
    {
     "texto": "Mecanismo por el cual un mayor nivel de operaciones empuja el precio de la acción hacia su valor fundamental, revelando el desempeño del gerente e induciendo un mayor esfuerzo gerencial ex-ante.",
     "doc_id": 143
    }
   ],
   "citas": [
    {
     "texto": "Governance through trading is the mechanism in which higher trading impounds new information into the price, pushing it toward its fundamental value. This induces higher managerial effort ex-ante.",
     "doc_id": 143
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "COMPLEMENTA",
     "tipo_original": "COMPLEMENTA",
     "objeto_texto": "Voice (direct intervention)",
     "doc_id": 143,
     "revisar": true
    },
    {
     "tipo": "MEDIDO_POR",
     "tipo_original": "MEDIDO_POR",
     "objeto_texto": "Abnormal turnover",
     "doc_id": 143,
     "revisar": true
    }
   ]
  },
  {
   "id": "voice",
   "nombre_canonico": "Voice",
   "tipo": "concepto",
   "nombres_vistos": [
    "Voice"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    143
   ],
   "definiciones": [
    {
     "texto": "Intervención o monitoreo directo por parte de los grandes accionistas institucionales (blockholders) para mejorar el gobierno corporativo.",
     "doc_id": 143
    }
   ],
   "citas": [
    {
     "texto": "Recent theories argue for governance through trading (grading) as an alternative governance mechanism to direct intervention (voice).",
     "doc_id": 143
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "COMPLEMENTA",
     "tipo_original": "COMPLEMENTA",
     "objeto_texto": "Governance through trading (grading)",
     "doc_id": 143,
     "revisar": true
    }
   ]
  },
  {
   "id": "multiple blockholder structure",
   "nombre_canonico": "Multiple blockholders structure",
   "tipo": "concepto",
   "nombres_vistos": [
    "Multiple blockholders structure"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    143
   ],
   "definiciones": [
    {
     "texto": "Estructura de propiedad donde la empresa cuenta con varios grandes accionistas institucionales en lugar de un único dominante, lo cual genera un problema de free-rider para la intervención pero fomenta el trading competitivo.",
     "doc_id": 143
    }
   ],
   "citas": [
    {
     "texto": "even though a multiple blockholder structure might reduce the effectiveness of voice, it strengthens grading. Multiple blockholders act competitively in their trading behavior",
     "doc_id": 143
    }
   ],
   "relaciones_crudas": [
