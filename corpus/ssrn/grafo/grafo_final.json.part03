    }
   ]
  },
  {
   "id": "endowment shock",
   "nombre_canonico": "endowment shock",
   "tipo": "concepto",
   "nombres_vistos": [
    "endowment shock"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    153
   ],
   "definiciones": [
    {
     "texto": "Choque de exposición o inventario exógeno que motiva a los participantes de corto plazo a entrar al mercado y demandar liquidez urgentemente para cubrir riesgos.",
     "doc_id": 153
    }
   ],
   "citas": [
    {
     "texto": "A short-term trader receives a random endowment of a risky asset u1 whose payoff is perfectly correlated with the one of the asset traded in the market, and posts a market order",
     "doc_id": 153
    }
   ],
   "relaciones_crudas": [
