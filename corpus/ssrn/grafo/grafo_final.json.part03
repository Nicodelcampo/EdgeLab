  {
   "id": "market microstructure representation learning mmrl",
   "nombre_canonico": "Market Microstructure Representation Learning (MMRL)",
   "tipo": "metodo",
   "nombres_vistos": [
    "Market Microstructure Representation Learning (MMRL)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    202
   ],
   "definiciones": [
    {
     "texto": "Framework que convierte datos crudos de microestructura en una secuencia de tokens vectoriales para alimentar un encoder que extrae representaciones latentes de intención de ejecución, usables en predicción multi-horizonte.",
     "doc_id": 202
    }
   ],
   "citas": [
    {
     "texto": "We propose a framework called Market Microstructure Representation Learning (MMRL), which converts order-book dynamics into a sequence of structured tokens, and extracts a latent execution representation that can be used for multi-horizon prediction.",
     "doc_id": 202
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "COMPUESTO_POR",
     "tipo_original": "COMPUESTO_POR",
     "objeto_texto": "Microstructure Tokenization",
     "doc_id": 202,
     "revisar": true
    },
    {
     "tipo": "COMPUESTO_POR",
     "tipo_original": "COMPUESTO_POR",
     "objeto_texto": "Latent Execution Embedding",
     "doc_id": 202,
     "revisar": true
    },
    {
     "tipo": "COMPUESTO_POR",
     "tipo_original": "COMPUESTO_POR",
     "objeto_texto": "Cross-Horizon Adaptive Forecasting",
     "doc_id": 202,
     "revisar": true
    }
   ]
  },
  {
   "id": "microstructure tokenization",
   "nombre_canonico": "Microstructure Tokenization",
   "tipo": "metodo",
   "nombres_vistos": [
    "Microstructure Tokenization"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    202
   ],
   "definiciones": [
    {
     "texto": "Mapeo que convierte el estado del LOB, sus cambios, flujo de órdenes, spread e imbalance en un vector de token de dimensión fija mediante una función de embedding φ.",
     "doc_id": 202
    }
   ],
   "citas": [
    {
     "texto": "The microstructure token at time t is τt := ϕ(xt) ∈ Rdτ, where ϕ : Rdx → Rdτ is an embedding function.",
     "doc_id": 202
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Market Microstructure Representation Learning",
     "doc_id": 202,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Order Book Imbalance",
     "doc_id": 202,
     "revisar": false
    }
   ]
  },
  {
   "id": "latent execution embedding",
   "nombre_canonico": "Latent Execution Embedding",
   "tipo": "concepto",
   "nombres_vistos": [
    "Latent Execution Embedding"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    202
   ],
   "definiciones": [
    {
     "texto": "Vector latente zt extraído por un encoder paramétrico Fθ a partir de la secuencia de tokens de microestructura, interpretado como representación de intención de ejecución y presión de cola.",
     "doc_id": 202
    }
   ],
   "citas": [
    {
     "texto": "The idea is that zt encodes execution intent, queue pressure, and other latent aspects that are not directly observable from st alone.",
     "doc_id": 202
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Market Microstructure Representation Learning",
     "doc_id": 202,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Microstructure Tokenization",
     "doc_id": 202,
     "revisar": false
    }
   ]
  },
  {
   "id": "cross horizon adaptive forecasting",
   "nombre_canonico": "Cross-Horizon Adaptive Forecasting",
   "tipo": "metodo",
   "nombres_vistos": [
    "Cross-Horizon Adaptive Forecasting"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    202
   ],
   "definiciones": [
    {
     "texto": "Sistema de predicción multi-horizonte con cabezales por horizonte h que comparten una representación latente común, minimizando una pérdida ponderada sobre todos los horizontes.",
     "doc_id": 202
    }
   ],
   "citas": [
    {
     "texto": "For each h ∈ H, define a prediction head br(h)t = gψh(ht, zt) ... Stacking all heads gives a vector-valued prediction.",
     "doc_id": 202
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Market Microstructure Representation Learning",
     "doc_id": 202,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Latent Execution Embedding",
     "doc_id": 202,
     "revisar": false
    }
   ]
  },
  {
   "id": "adversarial microstructure noise",
   "nombre_canonico": "Adversarial Microstructure Noise",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "Adversarial Microstructure Noise"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    202
   ],
   "definiciones": [
    {
     "texto": "Perturbaciones acotadas εt añadidas a los tokens de microestructura que modelan ruido por retrasos de mensajes, cancelaciones y órdenes ocultas. El encoder debe ser robusto a estas perturbaciones.",
     "doc_id": 202
    }
   ],
   "citas": [
    {
     "texto": "Microstructure data are noisy due to message delays, cancellations, and hidden orders. We consider adversarial perturbations on the token level.",
     "doc_id": 202
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Lipschitz Encoder",
     "doc_id": 202,
     "revisar": false
    }
   ]
  },
  {
   "id": "lipschitz encoder",
   "nombre_canonico": "Lipschitz Encoder",
   "tipo": "concepto",
   "nombres_vistos": [
    "Lipschitz Encoder"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    202
   ],
   "definiciones": [
    {
     "texto": "Propiedad del encoder que acota la variación de cada coordenada del embedding latente ante perturbaciones del token de entrada, garantizando estabilidad del riesgo empírico.",
     "doc_id": 202
    }
   ],
   "citas": [
    {
     "texto": "Assumption 1 (Coordinatewise Lipschitz Encoder). For each coordinate k ∈ {1, . . . , dz}, there exists βk ≥ 0 such that ... |Gθ,k(τ1, . . . , τt−1, u) − Gθ,k(τ1, . . . , τt−1, v)| ≤ βk ∥u − v∥2.",
     "doc_id": 202
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Adversarial Microstructure Noise",
     "doc_id": 202,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "bounded weights",
     "doc_id": 202,
     "revisar": false
    }
   ]
  },
  {
   "id": "variance bound",
   "nombre_canonico": "Variance Bound",
   "tipo": "metrica",
   "nombres_vistos": [
    "Variance Bound"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    202
   ],
   "definiciones": [
    {
     "texto": "Cota que acota la varianza de cada coordenada del embedding latente bajo perturbaciones aleatorias por la varianza del token de entrada, escalada por la constante de Lipschitz β².",
     "doc_id": 202
    }
   ],
   "citas": [
    {
     "texto": "Var(˜zk) ≤ β² Var(˜τ) ... When β < 1 after normalization, latent variance contracts relative to input variance, which can be interpreted as a form of robustness or noise smoothing.",
     "doc_id": 202
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "encoder robustness",
     "doc_id": 202,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Lipschitz Encoder",
     "doc_id": 202,
     "revisar": false
    }
   ]
  },
  {
   "id": "limit order book state",
   "nombre_canonico": "Limit Order Book State",
   "tipo": "dato",
   "nombres_vistos": [
    "Limit Order Book State"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    202
   ],
   "definiciones": [
    {
     "texto": "Vector st que captura los precios y volúmenes de best bid/ask y niveles profundos del LOB en tiempo discreto fino (milisegundos).",
     "doc_id": 202
    }
   ],
   "citas": [
    {
     "texto": "Let st ∈ Rds denote the LOB state at time t; typical components include best bid/ask prices, corresponding volumes, and possibly a few deeper levels.",
     "doc_id": 202
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Microstructure Tokenization",
     "doc_id": 202,
     "revisar": false
    }
   ]
  },
  {
   "id": "representation induced stochastic game",
   "nombre_canonico": "Representation-Induced Stochastic Game",
   "tipo": "concepto",
   "nombres_vistos": [
    "Representation-Induced Stochastic Game"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    203
   ],
   "definiciones": [
    {
     "texto": "Juego estocástico donde el estado público es el embedding Zt = Φ(Xt−k+1:t) producido por un encoder transformer aplicado a la historia del LOB, y los agentes eligen acciones en función de Zt y sus estados privados.",
     "doc_id": 203
    }
   ],
   "citas": [
    {
     "texto": "Our core object is a representation-induced stochastic game: agents observe an embedding Zt = Φ(Xt−k+1:t) produced by a transformer-style encoder Φ applied to LOB histories, and choose actions as functions of Zt (and private states).",
     "doc_id": 203
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "LLM-Based Encoder",
     "doc_id": 203,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Markov Perfect Equilibrium",
     "doc_id": 203,
     "revisar": false
    }
   ]
  },
  {
   "id": "llm based encoder",
   "nombre_canonico": "LLM-Based Encoder",
   "tipo": "metodo",
   "nombres_vistos": [
    "LLM-Based Encoder"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    203
   ],
   "definiciones": [
    {
     "texto": "Encoder transformer-style Φ que mapea una ventana de k estados del LOB a un embedding Zt ∈ Rd en espacio de representación, diseñado para preservar estructura económicamente relevante.",
     "doc_id": 203
    }
   ],
   "citas": [
    {
     "texto": "A transformer-style encoder Φ : Xk → Rd, Zt = Φ(Xt−k+1, . . . , Xt) produces an embedding Zt ∈ Rd summarizing recent message-level dynamics.",
     "doc_id": 203
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Limit Order Book State",
     "doc_id": 203,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Lipschitz continuity",
     "doc_id": 203,
     "revisar": false
    }
   ]
  },
  {
   "id": "representation filtration",
   "nombre_canonico": "Representation Filtration",
   "tipo": "concepto",
   "nombres_vistos": [
    "Representation Filtration"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    203
   ],
   "definiciones": [
    {
     "texto": "Filtración FZ_t generada por la historia de embeddings {Z0, . . . , Zt}, que define el conjunto de información pública disponible para las políticas de los agentes.",
     "doc_id": 203
    }
   ],
   "citas": [
    {
     "texto": "Define the representation filtration FZ_t = σ(Z0, . . . , Zt). Agents may be restricted to policies measurable w.r.t. FZ_t (and private states).",
     "doc_id": 203
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "LLM-Based Encoder",
     "doc_id": 203,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Markov Perfect Equilibrium",
     "doc_id": 203,
     "revisar": false
    }
   ]
  },
  {
   "id": "markov perfect equilibrium",
   "nombre_canonico": "Markov Perfect Equilibrium",
   "tipo": "concepto",
   "nombres_vistos": [
    "Markov Perfect Equilibrium"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    203
   ],
   "definiciones": [
    {
     "texto": "Perfil de políticas π* donde cada agente maximiza su payoff descontado esperado usando políticas medibles respecto al estado de representación y su estado privado, sin incentivo a desviarse unilateralmente.",
     "doc_id": 203
    }
   ],
   "citas": [
    {
     "texto": "A policy profile π* is a representation-based MPE if for every agent i and every (z, θi), πi*(· | z, θi) ∈ arg max Ji(πi, π−i*; Z0 = z, θi0 = θi).",
     "doc_id": 203
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Representation-Induced Stochastic Game",
     "doc_id": 203,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Representation Filtration",
     "doc_id": 203,
     "revisar": false
    }
   ]
  },
  {
   "id": "strategic similarity modulu",
   "nombre_canonico": "Strategic Similarity Modulus",
   "tipo": "metrica",
   "nombres_vistos": [
    "Strategic Similarity Modulus"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    203
   ],
   "definiciones": [
    {
     "texto": "Supremo de la diferencia de payoff sobre todos los perfiles de estrategia entre dos embeddings z y z', que formaliza la idea de que embeddings cercanos corresponden a entornos estratégicos similares.",
     "doc_id": 203
    }
   ],
   "citas": [
    {
     "texto": "Definition 3.2 (Representation-Induced Strategic Similarity). Let U(θ; z) denote a payoff functional ... Define ∆strat(z, z′) = supθ∈Θ |U(θ; z) − U(θ; z′)|.",
     "doc_id": 203
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "embedding geometry quality",
     "doc_id": 203,
     "revisar": false
    }
   ]
  },
  {
   "id": "lipschitz stability of equilibria",
   "nombre_canonico": "Lipschitz Stability of Equilibria",
   "tipo": "concepto",
   "nombres_vistos": [
    "Lipschitz Stability of Equilibria"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    203
   ],
   "definiciones": [
    {
     "texto": "Propiedad que garantiza que pequeños cambios en el embedding producen cambios acotados en el perfil de acciones de equilibrio, con constante Leq dependiente de la concavidad fuerte de los payoffs.",
     "doc_id": 203
    }
   ],
   "citas": [
    {
     "texto": "Theorem 5.4 (Lipschitz Stability of Best Responses). Under Assumption 5.3, the equilibrium action profile is locally unique and there exists Leq > 0 such that ∥a*(z) − a*(z′)∥ ≤ Leq∥z − z′∥.",
     "doc_id": 203
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Markov Perfect Equilibrium",
     "doc_id": 203,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "strong concavity",
     "doc_id": 203,
     "revisar": false
    }
   ]
  },
  {
   "id": "spectral gap and mixing",
   "nombre_canonico": "Spectral Gap and Mixing",
   "tipo": "metrica",
   "nombres_vistos": [
    "Spectral Gap and Mixing"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    203
   ],
   "definiciones": [
    {
     "texto": "Propiedad del operador de Markov inducido por las políticas de equilibrio que garantiza convergencia exponencial a la distribución invariante µ, con tasa λ (spectral gap).",
     "doc_id": 203
    }
   ],
   "citas": [
    {
     "texto": "Theorem 6.4 (Mixing Bound). Under Assumption 6.3, there exist constants C > 0 and λ > 0 such that ∥Kn(z, ·) − µ∥TV ≤ Ce−λn, ∀z ∈ S, ∀n ≥ 0.",
     "doc_id": 203
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Markov Perfect Equilibrium",
     "doc_id": 203,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "convergence speed",
     "doc_id": 203,
     "revisar": false
    }
   ]
  },
  {
   "id": "representation based market impact",
   "nombre_canonico": "Representation-Based Market Impact",
   "tipo": "metrica",
   "nombres_vistos": [
    "Representation-Based Market Impact"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    203
   ],
   "definiciones": [
    {
     "texto": "Cambio esperado en el mid-price condicional al estado de embedding actual y a las acciones de los agentes, que es Lipschitz en el embedding.",
     "doc_id": 203
    }
   ],
   "citas": [
    {
     "texto": "Define (conditional) market impact I(z, a) = E[Pt+1 − Pt | Zt = z, at = a].",
     "doc_id": 203
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "LLM-Based Encoder",
     "doc_id": 203,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "price impact",
     "doc_id": 203,
     "revisar": false
    }
   ]
  },
  {
   "id": "representation game volatility coupling",
   "nombre_canonico": "Representation-Game-Volatility Coupling",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Representation-Game-Volatility Coupling"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    203
   ],
   "definiciones": [
    {
     "texto": "Cadena causal que vincula el embedding Zt con las acciones de equilibrio, el flujo agregado de órdenes, el cambio de precio y la volatilidad condicional, todas Lipschitz-locales.",
     "doc_id": 203
    }
   ],
   "citas": [
    {
     "texto": "High-frequency price dynamics couple through Zt → a*(Zt) → Qt = Σ a*i(Zt) → (Pt+1 − Pt) → σ²t, and each map is locally Lipschitz.",
     "doc_id": 203
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "volatility",
     "doc_id": 203,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Representation-Based Market Impact",
     "doc_id": 203,
     "revisar": false
    }
   ]
  },
  {
   "id": "encoder perturbation robustness",
   "nombre_canonico": "Encoder Perturbation Robustness",
   "tipo": "concepto",
   "nombres_vistos": [
    "Encoder Perturbation Robustness"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    203
   ],
   "definiciones": [
    {
     "texto": "Estabilidad de las acciones de equilibrio ante perturbaciones acotadas del encoder Φ, demostrada mediante la combinación de Lipschitz del encoder y la estabilidad Lipschitz del equilibrio.",
     "doc_id": 203
    }
   ],
   "citas": [
    {
     "texto": "Theorem 5.6 (Equilibrium Robustness to Encoder Perturbations). Under Assumptions 5.3 and 5.5, there exists Ceq > 0 such that ∥a*,ε(Zε_t) − a*(Zt)∥ ≤ Ceq ε.",
     "doc_id": 203
    }
   ],
