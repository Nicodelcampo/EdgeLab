  {
   "id": "weibull shape parameter",
   "nombre_canonico": "Weibull shape parameter",
   "tipo": "metrica",
   "nombres_vistos": [
    "Weibull shape parameter"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    158
   ],
   "definiciones": [
    {
     "texto": "Métrica basada en la distribución Weibull para modelar la duración temporal de la inactividad de trading; valores altos indican intervalos cortos entre trades.",
     "doc_id": 158
    }
   ],
   "citas": [
    {
     "texto": "I use the shape parameter for the Weibull distribution. In this sample, a higher shape parameter indicates a lower time between trades.",
     "doc_id": 158
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
