    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "relative periodicity",
     "doc_id": 96,
     "revisar": false
    }
   ]
  },
  {
   "id": "liquidity supplying at",
   "nombre_canonico": "liquidity-supplying AT",
   "tipo": "concepto",
   "nombres_vistos": [
    "liquidity-supplying AT"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    97
   ],
   "definiciones": [
    {
     "texto": "Estrategias de trading algorítmico que proveen liquidez al mercado, medidas a través del ratio de mensajes de cotización respecto a la cantidad de operaciones (Quote-to-Trade ratio).",
     "doc_id": 97
    }
   ],
   "citas": [
    {
     "texto": "We follow Hendershott, Jones and Menkveld (2011)... and use the ratio of number of quote messages to number of trades, QTi,t, as our proxy for liquidity-supplying strategies employed by AT.",
     "doc_id": 97
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "AUMENTA",
     "tipo_original": "AUMENTA",
     "objeto_texto": "investment-to-price sensitivity",
     "doc_id": 97,
     "revisar": true
    }
   ]
  },
  {
   "id": "liquidity demanding at",
   "nombre_canonico": "liquidity-demanding AT",
   "tipo": "concepto",
   "nombres_vistos": [
    "liquidity-demanding AT"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    97
   ],
   "definiciones": [
    {
     "texto": "Estrategias algorítmicas agresivas que consumen liquidez aprovechando cotizaciones obsoletas (oportunidades de arbitraje de latencia).",
     "doc_id": 97
    }
   ],
   "citas": [
    {
     "texto": "We measure the liquidity-demanding AT activities as the number of latency arbitrage opportunities or “stale” quotes in the spirit of Budish, Cramton and Shim (2015).",
     "doc_id": 97
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "DISMINUYE",
     "tipo_original": "DISMINUYE",
     "objeto_texto": "investment-to-price sensitivity",
