   "doc_ids": [
    196
   ],
   "definiciones": [
    {
     "texto": "Estrategia de referencia obtenida al asumir incorrectamente que las comisiones de préstamo de acciones son nulas. Tiende a operar demasiado agresivamente ante desalineaciones de precios menores.",
     "doc_id": 196
    }
   ],
   "citas": [
    {
     "texto": "When adopting the cost-naive strategy, the investor trades on the relative mispricing too aggressively, leading to excessive stock borrowing fees payment and resulting in considerably lower Sharpe ratios.",
