  {
   "id": "exchange traded fund",
   "nombre_canonico": "Exchange-Traded Fund",
   "tipo": "concepto",
   "nombres_vistos": [
    "Exchange-Traded Fund"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    172
   ],
   "definiciones": [
    {
     "texto": "Vehículo de inversión que replica índices de países específicos listado en el mercado estadounidense, permitiendo a inversores acceder a mercados extranjeros con la misma facilidad que el trading doméstico.",
     "doc_id": 172
    }
   ],
   "citas": [
    {
     "texto": "These country ETFs have emerged as viable options for individual investors who want easy access to overseas markets.",
     "doc_id": 172
    }
   ],
   "relaciones_crudas": [
