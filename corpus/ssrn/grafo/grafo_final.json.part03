   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    93
   ],
   "definiciones": [
    {
     "texto": "Indicadores tradicionales como inflación o producción industrial, cuya capacidad para explicar variaciones de tipo de cambio en horizontes cortos ha disminuido.",
     "doc_id": 93
    }
   ],
   "citas": [
    {
     "texto": "Inflation differentials have negligible explanatory power for FX pricing in the 2010–2020 sample, while broader economic conditions contribute selectively",
     "doc_id": 93
    }
   ],
   "relaciones_crudas": []
