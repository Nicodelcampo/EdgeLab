   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    177
   ],
   "definiciones": [
    {
     "texto": "Batería de pruebas, incluyendo la interrupción aleatoria de datos y adición de ruido en las series, para validar la estabilidad de un sistema algorítmico y rechazar modelos inestables.",
     "doc_id": 177
    }
   ],
   "citas": [
    {
