   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    84
   ],
   "definiciones": [
    {
     "texto": "Un modelo lineal estructurado, empleado como arquitectura interna, que procesa secuencias históricas progresivamente ajustando la longitud de la secuencia y la dimensión de las características para producir asignaciones de volumen de manera eficiente.",
     "doc_id": 84
    }
   ],
   "citas": [
    {
     "texto": "The TLN is conceptually simple and highly interpretable—essentially a linear model with structured transformations—yet it is integrated within a deep learning framework that enables the minimization of arbitrary loss functions...",
     "doc_id": 84
    }
   ],
   "relaciones_crudas": [
