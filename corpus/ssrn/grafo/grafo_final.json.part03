  {
   "id": "informational divergence metric d t",
   "nombre_canonico": "Informational Divergence Metric D(t)",
   "tipo": "metrica",
   "nombres_vistos": [
    "Informational Divergence Metric D(t)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    205
   ],
   "definiciones": [
    {
     "texto": "Métrica definida como D(t) = 1 − cos(vmarket(t), vpublic(t)) ∈ [0, 2], que mide la brecha entre la representación vectorial del estado microestructural y la del consenso público en tiempo real.",
     "doc_id": 205
    }
   ],
   "citas": [
    {
     "texto": "The informational divergence metric is defined as D(t) = 1 − (vmarket(t) · vpublic(t)) / (∥vmarket(t)∥ · ∥vpublic(t)∥) with D(t) ∈ [0, 2].",
     "doc_id": 205
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "information asymmetry",
     "doc_id": 205,
