   "tipo": "fenomeno",
   "nombres_vistos": [
    "multiple equilibria"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    153
   ],
   "definiciones": [
    {
     "texto": "Situación teórica en la que el mercado puede estabilizarse en diferentes niveles de liquidez (alta, media, baja) para las mismas condiciones fundamentales.",
     "doc_id": 153
    }
   ],
   "citas": [
    {
     "texto": "This can create a self-sustaining loop that turns the demand for liquidity into an increasing function of illiquidity... and leading to multiple equilibria.",
     "doc_id": 153
    }
   ],
   "relaciones_crudas": [
    {
