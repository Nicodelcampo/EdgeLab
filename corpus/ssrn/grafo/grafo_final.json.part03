    "Signal Normalization"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    138
   ],
   "definiciones": [
    {
     "texto": "Etapa defensiva donde la señal generada es recortada (clipping) al rango de [-5, 5] para prevenir que observaciones extremas dominen las métricas.",
     "doc_id": 138
    }
   ],
   "citas": [
    {
     "texto": "The clipping operation constrains signal magnitudes to the range [-5, 5]... This ensures all generated code is executable, produces the required signal matrix output, prevents extreme outliers from dominating backtest metrics",
     "doc_id": 138
    }
   ],
   "relaciones_crudas": [
