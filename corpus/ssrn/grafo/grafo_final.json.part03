     "doc_id": 216,
     "revisar": false
    }
   ]
  },
  {
   "id": "optic",
   "nombre_canonico": "OPTICS",
   "tipo": "metodo",
   "nombres_vistos": [
    "OPTICS"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    217
   ],
   "definiciones": [
    {
     "texto": "Algoritmo de clustering basado en densidad que detecta clusters de densidades variables, superando una limitación de DBSCAN. En el paper se usa con cardinalidad mínima 2 por cluster para generar muchos clusters pequeños.",
     "doc_id": 217
    }
   ],
   "citas": [
    {
     "texto": "Building on DBSCAN, OPTICS (Ordering Points To Identify the Clustering Structure), introduced by Ankerst et al. (1999), is a more advanced clustering algorithm that excels at detecting clusters of varying densities, which is a limitation of DBSCAN.",
     "doc_id": 217
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "DBSCAN",
     "doc_id": 217,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "clustering",
     "doc_id": 217,
     "revisar": false
    }
   ]
  },
  {
   "id": "k mean",
   "nombre_canonico": "K-means",
   "tipo": "metodo",
   "nombres_vistos": [
    "K-means"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    217
   ],
   "definiciones": [
    {
     "texto": "Algoritmo de partición que divide los datos en un número predeterminado de clusters, asignando cada punto al centroide más cercano. Su limitación es exigir especificar k a priori, lo que motivó usar OPTICS en el paper.",
     "doc_id": 217
    }
   ],
   "citas": [
    {
     "texto": "A notable limitation of this approach is that it requires the user to specify the number of clusters a priori, which can be challenging when the optimal number of clusters is unknown.",
     "doc_id": 217
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "clustering",
     "doc_id": 217,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "OPTICS",
     "doc_id": 217,
     "revisar": false
    }
   ]
  },
  {
   "id": "partial correlation",
   "nombre_canonico": "partial correlation",
   "tipo": "metodo",
   "nombres_vistos": [
    "partial correlation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    217
   ],
   "definiciones": [
    {
     "texto": "Métrica de distancia novedosa que aísla la correlación pura entre dos acciones eliminando correlaciones espurias causadas por exposición compartida a un tercer factor (el mercado). Transformada como PC = 1 - |ρ_par| para usarse en clustering.",
     "doc_id": 217
    }
   ],
   "citas": [
    {
     "texto": "Partial correlation quantifies the extent to which a variable influences the correlation between a pair of other variables, isolating the direct relationship from confounding effects.",
     "doc_id": 217
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "pairs trading",
     "doc_id": 217,
     "revisar": false
    },
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "clustering",
     "doc_id": 217,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "look-ahead bias",
     "doc_id": 217,
     "revisar": false
    }
   ]
  },
  {
   "id": "sum of squared deviation",
   "nombre_canonico": "sum of squared deviations",
   "tipo": "metodo",
   "nombres_vistos": [
    "sum of squared deviations"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    218
   ],
   "definiciones": [
    {
     "texto": "Medida de similitud entre series de precios normalizadas utilizada para seleccionar pares; los pares con la menor suma de desviaciones cuadradas entre sus precios normalizados son elegidos para trading.",
     "doc_id": 218
    }
   ],
   "citas": [
    {
     "texto": "The pairs that are selected for trading have the smallest distance measure, which is defined as the sum of squared deviations between the two normalized price series.",
     "doc_id": 218
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "pairs trading",
     "doc_id": 218,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "normalized price series",
     "doc_id": 218,
     "revisar": false
    }
   ]
  },
  {
   "id": "normalized price serie",
   "nombre_canonico": "normalized price series",
   "tipo": "metodo",
   "nombres_vistos": [
    "normalized price series"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    218
   ],
   "definiciones": [
    {
     "texto": "Series de precios que se normalizan para comenzar desde uno y evolucionan usando la serie de retornos totales, evitando señales falsas por splits o dividendos.",
     "doc_id": 218
    }
   ],
   "citas": [
    {
     "texto": "Normalized price series are defined to start from one, and then evolve using the return series. False trading signals due to splits or dividends are avoided by using total return series to construct the series.",
     "doc_id": 218
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "sum of squared deviations",
     "doc_id": 218,
