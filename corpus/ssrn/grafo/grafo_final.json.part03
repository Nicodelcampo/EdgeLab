    }
   ]
  },
  {
   "id": "dynamic programming dp based trading",
   "nombre_canonico": "Dynamic Programming (DP) based trading",
   "tipo": "metodo",
   "nombres_vistos": [
    "Dynamic Programming (DP) based trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    175
   ],
   "definiciones": [
    {
     "texto": "Uso de programación dinámica para ajustar automáticamente la ejecución algorítmica a las ondas de precios del mercado en tiempo real y a las posiciones de inventario.",
     "doc_id": 175
    }
   ],
   "citas": [
    {
     "texto": "DP algorithms can adjust execution automatically to real-time market price waves as well as inventory positions, and thus are more responsive and realistic.",
     "doc_id": 175
    }
   ],
   "relaciones_crudas": [
