  {
   "id": "midpoint volatility",
   "nombre_canonico": "Midpoint Volatility",
   "tipo": "metrica",
   "nombres_vistos": [
    "Midpoint Volatility"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    206
   ],
   "definiciones": [
    {
     "texto": "Volatilidad calculada sobre el midpoint del LOB. La volatilidad de transaction price de un activo tiende a liderar la volatilidad de midpoint de otros activos.",
     "doc_id": 206
    }
   ],
   "citas": [
    {
     "texto": "The transaction price volatility of multiple assets tends to lead the midpoint volatility of other assets.",
     "doc_id": 206
    }
   ],
   "relaciones_crudas": [
