   "doc_frecuencia": 1,
   "doc_ids": [
    155
   ],
   "definiciones": [
    {
     "texto": "Situación en la que los individuos ignoran su propio conjunto de creencias al tomar una decisión y simplemente imitan a otros.",
     "doc_id": 155
    }
   ],
   "citas": [
    {
     "texto": "Informational cascades imply that individuals ignore their own set of beliefs when making a decision, simply imitating others",
     "doc_id": 155
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "non-fundamental herding",
     "doc_id": 155,
     "revisar": false
    }
   ]
  },
  {
   "id": "non fundamental herding",
   "nombre_canonico": "non-fundamental herding",
   "tipo": "concepto",
   "nombres_vistos": [
    "non-fundamental herding"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    155
   ],
   "definiciones": [
    {
     "texto": "Herding intencional guiado por el ruido y el sentimiento, en el cual los inversores (o algoritmos) imitan las acciones de otros sin depender de nueva información fundamental clara.",
     "doc_id": 155
    }
   ],
   "citas": [
    {
     "texto": "In this situation, “intentional” or non-fundamental herding may arise, indicating that investors mimic each others’ actions with intent. Non-fundamental herding is noise-driven and affected by sentiment",
     "doc_id": 155
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "informational cascades",
     "doc_id": 155,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "High Frequency Trading",
     "doc_id": 155,
     "revisar": false
    }
   ]
  },
  {
   "id": "fundamental herding",
   "nombre_canonico": "fundamental herding",
   "tipo": "concepto",
   "nombres_vistos": [
    "fundamental herding"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    155
   ],
   "definiciones": [
    {
     "texto": "Herding espurio que ocurre cuando un grupo de inversores observa e interpreta el mismo conjunto de información pública de la misma manera, operando en la misma dirección sin la intención de imitarse.",
     "doc_id": 155
    }
   ],
   "citas": [
    {
     "texto": "This will give rise to “spurious” or fundamental herding in the sense that investors did not suppress their own beliefs with the intention to follow others.",
     "doc_id": 155
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "non-fundamental herding",
     "doc_id": 155,
     "revisar": false
    }
   ]
  },
  {
   "id": "anti herding",
   "nombre_canonico": "anti-herding",
   "tipo": "concepto",
   "nombres_vistos": [
    "anti-herding"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    155
   ],
   "definiciones": [
    {
     "texto": "Comportamiento en el cual los participantes del mercado ignoran la información del mercado en general y operan en contra del consenso, exhibiendo una dispersión de retornos anormalmente alta.",
     "doc_id": 155
    }
   ],
   "citas": [
    {
     "texto": "Anti-herding implies that market participants largely ignore market-wide information and trade against the market consensus",
     "doc_id": 155
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "herding",
     "doc_id": 155,
     "revisar": false
    }
   ]
  },
  {
   "id": "quoteupdate",
   "nombre_canonico": "QuoteUpdates",
   "tipo": "metrica",
   "nombres_vistos": [
    "QuoteUpdates"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    155
   ],
   "definiciones": [
    {
     "texto": "Número promedio de cambios de cotización (precio y cantidad) en los mejores precios por minuto, utilizado como proxy principal de la actividad de HFT.",
     "doc_id": 155
    }
   ],
   "citas": [
    {
     "texto": "we estimate QuoteUpdates as the average number of quote (price and quantity) changes at best prices per minute",
     "doc_id": 155
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "High Frequency Trading",
     "doc_id": 155,
     "revisar": false
    }
   ]
  },
  {
   "id": "hft trade",
   "nombre_canonico": "HFT_trades",
   "tipo": "metrica",
   "nombres_vistos": [
    "HFT_trades"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    155
   ],
   "definiciones": [
    {
     "texto": "Medida proxy alternativa para las transacciones HFT, calculada como el volumen de operaciones negativo (en 100s de USD) dividido por el número total de mensajes de trade y quote por minuto.",
     "doc_id": 155
    }
   ],
   "citas": [
    {
     "texto": "and HFT_trades as the average negative trading volume (in USD 100) divided by the total number of messages per minute",
     "doc_id": 155
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "High Frequency Trading",
     "doc_id": 155,
     "revisar": false
    }
   ]
  },
  {
   "id": "colocation date",
   "nombre_canonico": "colocation date",
   "tipo": "dato",
   "nombres_vistos": [
    "colocation date"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    155
   ],
   "definiciones": [
    {
     "texto": "Fecha en la que cada exchange comenzó a alojar oficialmente los servidores informáticos de las empresas HFT dentro de su centro de datos, empleada como experimento natural.",
     "doc_id": 155
    }
   ],
   "citas": [
    {
     "texto": "the date each exchange started housing the trading firms’ computer servers within the exchange’s data centre, as the HFT start date.",
     "doc_id": 155
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "High Frequency Trading",
     "doc_id": 155,
