    },
    {
     "tipo": "NO_AFECTA",
     "tipo_original": "NO_AFECTA",
     "objeto_texto": "liquidez",
     "doc_id": 96,
     "revisar": true
    }
   ]
  },
  {
   "id": "relative periodicity",
   "nombre_canonico": "relative periodicity",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "relative periodicity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    96
   ],
   "definiciones": [
    {
     "texto": "Patrón temporal donde los picos en la actividad de trading tienden a repetirse exactamente un segundo después del pico de actividad inicial, originados probablemente por bucles de espera algorítmicos.",
     "doc_id": 96
    }
   ],
   "citas": [
    {
     "texto": "Second, for the relative periodicity, trading activity spikes are likely to repeat at exactly one-second frequencies.",
     "doc_id": 96
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "AUMENTA",
     "tipo_original": "AUMENTA",
     "objeto_texto": "volatilidad",
     "doc_id": 96,
     "revisar": true
    },
    {
     "tipo": "NO_AFECTA",
     "tipo_original": "NO_AFECTA",
     "objeto_texto": "liquidez",
     "doc_id": 96,
     "revisar": true
    }
   ]
  },
  {
   "id": "behavioral algorithmic trading",
   "nombre_canonico": "behavioral algorithmic trading",
   "tipo": "concepto",
   "nombres_vistos": [
    "behavioral algorithmic trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    96
   ],
   "definiciones": [
    {
     "texto": "Concepto que indica que los algoritmos de trading heredan sesgos cognitivos o conductuales (como la preferencia por números y tiempos redondos) de los programadores humanos que los codifican.",
     "doc_id": 96
    }
   ],
   "citas": [
    {
     "texto": "Due to a programmer’s psychological preference for round numbers, a time loop often starts at a round time, such as 9:30am, and repeats at rounded-time intervals, such as one second.",
     "doc_id": 96
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "absolute periodicity",
     "doc_id": 96,
