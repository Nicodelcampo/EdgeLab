   "doc_ids": [
    84
   ],
   "definiciones": [
    {
     "texto": "Función de pérdida que calcula la diferencia al cuadrado entre el precio de ejecución promedio y el VWAP de mercado, penalizando más severamente las grandes desviaciones.",
     "doc_id": 84
    }
   ],
   "citas": [
    {
     "texto": "the Quadratic VWAP Loss measures the squared difference, thereby penalizing larger deviations more heavily.",
