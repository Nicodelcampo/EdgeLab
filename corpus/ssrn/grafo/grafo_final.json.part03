   "definiciones": [
    {
     "texto": "Estrategia de protección que combina la posesión del activo subyacente con la compra de una opción put protectora y la venta de una opción call, limitando tanto el potencial de ganancias como el de pérdidas.",
     "doc_id": 81
    }
   ],
   "citas": [
