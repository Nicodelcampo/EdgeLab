    83
   ],
   "definiciones": [
    {
     "texto": "Arquitectura híbrida que combina CNN para detectar patrones locales en la serie temporal de residuals y transformer (attention) para combinarlos en patrones globales. Es el componente más innovador y el principal diferenciador de performance: duplica el Sharpe vs un modelo deep sin transformer.",
     "doc_id": 83
    }
   ],
   "citas": [
