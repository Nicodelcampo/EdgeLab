  {
   "id": "no arbitrage valuation",
   "nombre_canonico": "No-Arbitrage Valuation",
   "tipo": "concepto",
   "nombres_vistos": [
    "No-Arbitrage Valuation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    192
   ],
   "definiciones": [
    {
     "texto": "Principio que implica la existencia de un pricing kernel o medida martingala equivalente bajo la cual los precios descontados son martingalas. Proporciona disciplina para combinar estimación estadística con consistencia financiera.",
     "doc_id": 192
    }
   ],
   "citas": [
    {
     "texto": "The no-arbitrage condition implies the existence of a pricing kernel or an equivalent martingale measure under which discounted asset prices are martingales.",
     "doc_id": 192
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
