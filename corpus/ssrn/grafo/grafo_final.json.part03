   "nombres_vistos": [
    "transaction tax"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    125
   ],
   "definiciones": [
    {
     "texto": "Costo fijo impuesto sobre el valor nocional de las transacciones ejecutadas, utilizado teóricamente como mecanismo de política para desincentivar el exceso de trading.",
     "doc_id": 125
    }
   ],
   "citas": [
