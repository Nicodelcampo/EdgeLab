    }
   ]
  },
  {
   "id": "strategic complementarity",
   "nombre_canonico": "strategic complementarity",
   "tipo": "concepto",
   "nombres_vistos": [
    "strategic complementarity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    153
   ],
   "definiciones": [
    {
     "texto": "Dinámica perversa donde la decisión de un trader de consumir liquidez ante el deterioro del mercado incentiva a otros a ser igual de agresivos, agotando el mercado.",
     "doc_id": 153
    }
   ],
   "citas": [
    {
     "texto": "strategic complementarities in traders’ liquidity consumption decisions: traders demand more liquidity when the market becomes less liquid, which in turn makes the market more illiquid",
     "doc_id": 153
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "liquidity fragility",
     "doc_id": 153,
