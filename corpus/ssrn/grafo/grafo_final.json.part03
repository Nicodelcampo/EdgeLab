   "tipo": "metrica",
   "nombres_vistos": [
    "financial depth"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    110
   ],
   "definiciones": [
    {
     "texto": "Métrica de desarrollo financiero representada por la proporción entre el volumen de transacciones de los intermediarios y la producción agregada.",
     "doc_id": 110
    }
   ],
   "citas": [
    {
     "texto": "By depth is meant some ratio of financial throughput to final output.",
     "doc_id": 110
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "financial efficiency",
   "nombre_canonico": "financial efficiency",
   "tipo": "concepto",
   "nombres_vistos": [
    "financial efficiency"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    110
   ],
   "definiciones": [
    {
     "texto": "Eficiencia del sector financiero definida a partir de la reducción en los costos de intermediación y evaluación de prestatarios.",
     "doc_id": 110
    }
   ],
   "citas": [
    {
     "texto": "Reductions in the cost of screening or in the tax on intermediary profits thus increase the efficiency of the financial sector",
     "doc_id": 110
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "quantity weighted qw midpoint",
   "nombre_canonico": "quantity-weighted (QW) midpoint",
   "tipo": "metrica",
   "nombres_vistos": [
    "quantity-weighted (QW) midpoint"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    111
   ],
   "definiciones": [
    {
     "texto": "Ajusta la ponderación de los mejores precios de bid y ask basándose en sus respectivos volúmenes (imbalance del order book).",
     "doc_id": 111
    }
   ],
   "citas": [
    {
     "texto": "adjusts the weighting of the best bid and ask prices based on their respective volumes.",
     "doc_id": 111
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA",
     "objeto_texto": "midpoint",
     "doc_id": 111,
     "revisar": false
    }
   ]
  },
  {
   "id": "constrained quantity weighted cqw midpoint",
   "nombre_canonico": "constrained quantity-weighted (CQW) midpoint",
   "tipo": "metrica",
   "nombres_vistos": [
    "constrained quantity-weighted (CQW) midpoint"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    111
   ],
   "definiciones": [
    {
     "texto": "Una versión conservadora del QW midpoint donde la corrección está limitada a la mitad del tick size, haciéndolo robusto bajo desbalances extremos.",
     "doc_id": 111
    }
   ],
   "citas": [
    {
     "texto": "adjusts the midpoint in a more conservative manner... the correction is capped at half the tick size, ensuring that the measure remains a reasonable approximation of the true value",
     "doc_id": 111
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA",
     "objeto_texto": "quantity-weighted (QW) midpoint",
     "doc_id": 111,
     "revisar": false
    },
    {
     "tipo": "APROXIMA",
     "tipo_original": "APROXIMA",
     "objeto_texto": "true value",
     "doc_id": 111,
     "revisar": true
    }
   ]
  },
  {
   "id": "return predictability",
   "nombre_canonico": "return predictability",
   "tipo": "metodo",
   "nombres_vistos": [
    "return predictability"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    111
   ],
   "definiciones": [
    {
     "texto": "Se utiliza como una medida inversa de eficiencia; una mayor predictibilidad de los retornos a muy corto plazo indica que la medida de precio es menos eficiente porque aún no ha incorporado la información pasada.",
     "doc_id": 111
    }
   ],
   "citas": [
    {
     "texto": "we employ the predictability of future stock returns, calculated using the five different price measures, as our inverse measure of price efficiency.",
     "doc_id": 111
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "price efficiency",
     "doc_id": 111,
     "revisar": false
    }
   ]
  },
  {
   "id": "auction theory",
   "nombre_canonico": "auction theory",
   "tipo": "metodo",
   "nombres_vistos": [
    "auction theory"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    112
   ],
   "definiciones": [
    {
     "texto": "Teoría de subastas aplicada al diseño de mercados eléctricos (DAM, RTM, GDAM). El mecanismo de double-sided auction con merit-order clearing se analiza en contraste con el bargaining informal del mandi.",
     "doc_id": 112
    }
   ],
   "citas": [
    {
     "texto": "Market clearing in both the DAM and GDAM follows a double-sided auction mechanism",
     "doc_id": 112
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "market microstructure",
     "doc_id": 112,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "price discovery",
     "doc_id": 112,
     "revisar": false
    }
   ]
  },
  {
   "id": "behavioral finance",
   "nombre_canonico": "behavioral finance",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "behavioral finance"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    112
   ],
   "definiciones": [
    {
     "texto": "Sesgos conductuales (herding, anchoring) que amplifican la volatilidad en RTM más allá de lo que justifican los fundamentals de oferta-demanda. Un spike en una ventana de clearing puede inducir sobre-bidding en ventanas subsecuentes.",
     "doc_id": 112
    }
   ],
   "citas": [
    {
     "texto": "herding behavior is well documented in financial markets and agricultural spot markets alike. Power exchanges are not immune to similar dynamics",
     "doc_id": 112
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "volatility clustering",
     "doc_id": 112,
     "revisar": false
    }
   ]
  },
  {
   "id": "displayed limit order book",
   "nombre_canonico": "displayed limit order book",
   "tipo": "dato",
   "nombres_vistos": [
    "displayed limit order book"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    114
   ],
   "definiciones": [
    {
     "texto": "La porción visible del libro de órdenes electrónicas que muestra las cotizaciones públicas a los participantes del mercado, excluyendo las órdenes ocultas.",
     "doc_id": 114
    }
   ],
   "citas": [
    {
     "texto": "the displayed order book is what traders actually see when they make their order submission decisions.",
     "doc_id": 114
    }
   ],
   "relaciones_crudas": [
    {
