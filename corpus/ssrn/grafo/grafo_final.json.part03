   "tipo": "fenomeno",
   "nombres_vistos": [
    "regime shifts"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    137
   ],
   "definiciones": [
    {
     "texto": "Cambios estructurales en el proceso generador de datos que quiebran los supuestos de estacionariedad, independencia y ergodicidad de los modelos financieros. En la analogía del paper, equivalen a la acción disruptiva del Mula en la psicohistoria de Asimov.",
     "doc_id": 137
    }
   ],
   "citas": [
    {
     "texto": "Financial models often break down in the presence of regime shifts, structural breaks, or when participants become aware of and act upon the models themselves",
     "doc_id": 137
    }
   ],
