   "tipo": "metodo",
   "nombres_vistos": [
    "Mean Field Games"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    192
   ],
   "definiciones": [
    {
     "texto": "Límite de juegos estocásticos con muchos agentes interactuando, donde la acción de un trader grande afecta las oportunidades de otros. El enfoque de Carmona-Delarue usa FBSDEs acopladas (HJB-Fokker-Planck).",
     "doc_id": 192
    }
   ],
   "citas": [
    {
     "texto": "This leads to stochastic games, and, in markets with many interacting agents, to mean field game (MFG) limits.",
     "doc_id": 192
    }
   ],
