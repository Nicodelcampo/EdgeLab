    }
   ]
  },
  {
   "id": "arbitrage activity",
   "nombre_canonico": "Arbitrage Activity",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Arbitrage Activity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    172
   ],
   "definiciones": [
    {
     "texto": "Actividad de arbitraje institucional entre el ETF y su subyacente. Mercados subyacentes más accesibles fomentan mayor actividad de arbitraje en ETFs.",
     "doc_id": 172
    }
   ],
   "citas": [
    {
     "texto": "Improved accessibility in the underlying market correlates with increased arbitrage activity, better tracking ability, and a higher probability of informed trading in ETFs.",
     "doc_id": 172
    }
   ],
