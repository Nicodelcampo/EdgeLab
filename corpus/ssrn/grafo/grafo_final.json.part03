    }
   ]
  },
  {
   "id": "displayed depth",
   "nombre_canonico": "displayed depth",
   "tipo": "metrica",
   "nombres_vistos": [
    "displayed depth"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    114
   ],
   "definiciones": [
    {
     "texto": "Volumen acumulado visible de acciones en el libro de órdenes medido en tres niveles: en el mejor bid/ask, a un centavo de los mejores precios, y en el resto del libro.",
     "doc_id": 114
    }
   ],
   "citas": [
    {
     "texto": "We measure the cumulative displayed depth in the limit order book at three levels: at the quotes... within one cent away from the quotes, and in the rest of the limit order book.",
     "doc_id": 114
    }
   ],
   "relaciones_crudas": [
