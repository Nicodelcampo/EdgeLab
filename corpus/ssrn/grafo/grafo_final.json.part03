   "doc_ids": [
    125
   ],
   "definiciones": [
    {
     "texto": "Metodología de simulación que evalúa dinámicas de mercado permitiendo que agentes individuales actúen y se adapten según lógicas predefinidas.",
     "doc_id": 125
    }
   ],
   "citas": [
