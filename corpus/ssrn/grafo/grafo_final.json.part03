  {
   "id": "private information trading",
   "nombre_canonico": "private information trading",
   "tipo": "concepto",
   "nombres_vistos": [
    "private information trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    94
   ],
   "definiciones": [
    {
     "texto": "Negociación en los mercados de valores basada en información privada no compartida con el público general, lo que genera asimetría de información y selección adversa para inversores desinformados.",
     "doc_id": 94
    }
   ],
   "citas": [
    {
     "texto": "The amount of private information trading, PRIVATE, is defined as the coefficient C2 in the time-series regression... estimated coefficient C2 increases as more information becomes available to insiders but is not shared with the general public.",
     "doc_id": 94
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "information asymmetry",
     "doc_id": 94,
     "revisar": false
    }
   ]
  },
  {
   "id": "ownership wedge",
   "nombre_canonico": "ownership wedge",
   "tipo": "metrica",
   "nombres_vistos": [
    "ownership wedge"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    94
   ],
   "definiciones": [
    {
     "texto": "Diferencia entre los derechos de control (control rights) y los derechos a los flujos de efectivo (cash flow rights) del mayor accionista, utilizada como proxy de los costos de agencia.",
     "doc_id": 94
    }
   ],
   "citas": [
    {
     "texto": "We measure agency costs as the ownership wedge - the difference between control rights and cash flow rights of the largest shareholder.",
     "doc_id": 94
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "agency costs",
     "doc_id": 94,
     "revisar": false
    }
   ]
  },
  {
   "id": "earning opacity",
   "nombre_canonico": "earnings opacity",
   "tipo": "metrica",
   "nombres_vistos": [
    "earnings opacity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    94
   ],
   "definiciones": [
    {
     "texto": "Grado de falta de transparencia o manipulación en los reportes financieros corporativos, calculada a través de la correlación negativa entre cambios en los accruals (devengos) y cambios en los flujos de caja operativos.",
     "doc_id": 94
    }
   ],
   "citas": [
    {
     "texto": "we calculate earnings opacity, OPACITY, as -1 times the Spearman correlation between the changes in accruals and the changes in cash flow from operations, both scaled by lagged total assets.",
     "doc_id": 94
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "private information trading",
     "doc_id": 94,
     "revisar": false
    }
   ]
  },
  {
   "id": "return autocorrelation conditional on trading volume",
   "nombre_canonico": "return autocorrelation conditional on trading volume",
   "tipo": "metodo",
   "nombres_vistos": [
    "return autocorrelation conditional on trading volume"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    94
   ],
   "definiciones": [
    {
     "texto": "Modelo econométrico temporal que utiliza la autocorrelación de retornos accionarios condicionados al volumen transado para estimar la cantidad de private information trading, propuesto originalmente por Llorente et al. (2002).",
     "doc_id": 94
    }
   ],
   "citas": [
    {
     "texto": "To quantify the amount of private information trading, we use a measure developed by Llorente et al. (2002), which is based on stock return autocorrelation conditional on trading volume.",
     "doc_id": 94
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "private information trading",
     "doc_id": 94,
     "revisar": false
    }
   ]
  },
  {
   "id": "absolute periodicity",
   "nombre_canonico": "absolute periodicity",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "absolute periodicity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    96
   ],
   "definiciones": [
    {
     "texto": "Patrón estacional de microestructura en el que la actividad de trading (operaciones y cotizaciones) aumenta un 40% durante los primeros 100 milisegundos de un segundo en comparación con el resto del segundo.",
     "doc_id": 96
    }
   ],
   "citas": [
    {
     "texto": "First, for the absolute periodicity, trading activity is higher at the start of a second, e.g., between 11h:11m:11s:000ms and 11h:11m:11s:099ms.",
     "doc_id": 96
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "AUMENTA",
     "tipo_original": "AUMENTA",
     "objeto_texto": "volatilidad",
     "doc_id": 96,
