   "tipo": "metrica",
   "nombres_vistos": [
    "Drawdown Penalty"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    204
   ],
   "definiciones": [
    {
     "texto": "Término en la función de recompensa que introduce el drawdown máximo del valor de la cartera escalado por un parámetro para suprimir las caídas extremas en el patrimonio.",
     "doc_id": 204
    }
   ],
   "citas": [
    {
     "texto": "we introduce a penalty mechanism based on net value drawdowns, whose intensity is controlled by the hyperparameter δ.",
     "doc_id": 204
    }
   ],
