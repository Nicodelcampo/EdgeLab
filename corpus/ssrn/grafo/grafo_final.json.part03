   "tipo": "metodo",
   "nombres_vistos": [
    "cross-modal interaction mechanism"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    87
   ],
   "definiciones": [
    {
     "texto": "Módulo que utiliza un mecanismo de compuerta (gated mechanism) y la función Softmax para realizar una reponderación adaptativa de las distintas modalidades mientras suprime información redundante o conflictiva.",
     "doc_id": 87
    }
   ],
   "citas": [
    {
     "texto": "a gated interaction mechanism is used to carry out dynamic modal reweighting while suppressing redundant and conflicting information.",
     "doc_id": 87
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "multimodal feature fusion",
     "doc_id": 87,
