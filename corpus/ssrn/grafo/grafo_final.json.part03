    }
   ]
  },
  {
   "id": "forecast closure",
   "nombre_canonico": "Forecast Closure",
   "tipo": "concepto",
   "nombres_vistos": [
    "Forecast Closure"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    134
   ],
   "definiciones": [
    {
     "texto": "La creencia de que una representación suficientemente precisa del comportamiento del mercado o de su dinámica producirá naturalmente arquitecturas de decisión completas.",
     "doc_id": 134
    }
   ],
   "citas": [
    {
     "texto": "For decades, quantitative finance pursued forecast closure: the belief that sufficiently accurate representation of market behaviour would eventually yield complete decision architectures.",
     "doc_id": 134
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "participation closure",
   "nombre_canonico": "Participation Closure",
   "tipo": "concepto",
   "nombres_vistos": [
    "Participation Closure"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    134
   ],
   "definiciones": [
    {
     "texto": "Un marco en el que la admisibilidad de participar en el mercado (basada en el estado y asimetrías de transición) se define primero, delineando el dominio en el que la previsión puede operar de manera segura.",
     "doc_id": 134
    }
   ],
   "citas": [
    {
     "texto": "The field is undergoing a profound transition — from the pursuit of forecast closure to the establishment of participation closure.",
     "doc_id": 134
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "dynamic participation optimality theorem 3",
   "nombre_canonico": "Dynamic Participation Optimality (Theorem 3)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Dynamic Participation Optimality (Theorem 3)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    134
   ],
   "definiciones": [
    {
     "texto": "Teorema propuesto que demuestra que las políticas de inversión puramente predictivas son estrictamente inferiores a políticas dependientes del estado y de la trayectoria cuando existen condiciones dinámicas y de persistencia asimétrica.",
     "doc_id": 134
    }
   ],
   "citas": [
    {
     "texto": "Theorem 3 (Dynamic Participation Optimality) demonstrates that forecast-only policies are strictly dominated by state- and path-dependent policies in Bellmanconsistent environments.",
     "doc_id": 134
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "LIMITA",
     "tipo_original": "LIMITA",
     "objeto_texto": "Forecast Closure",
     "doc_id": 134,
     "revisar": true
    }
   ]
  },
  {
   "id": "participation governance",
   "nombre_canonico": "Participation Governance",
   "tipo": "metodo",
   "nombres_vistos": [
    "Participation Governance"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    134
   ],
   "definiciones": [
    {
     "texto": "La consideración de la admisibilidad de participación como una primitiva financiera central y de primer nivel (no como un mero riesgo secundario) que regula activamente cuándo es seguro tener presencia en el mercado.",
     "doc_id": 134
    }
   ],
   "citas": [
    {
     "texto": "Participation governance is emerging as a first-class financial primitive. Rather than functioning as a secondary risk-management overlay, it defines the admissible domain within which forecasting and optimization can legitimately operate.",
     "doc_id": 134
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Participation Closure",
     "doc_id": 134,
     "revisar": false
    }
   ]
  },
  {
   "id": "structural failure chain",
