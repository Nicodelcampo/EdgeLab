    172
   ],
   "definiciones": [
    {
     "texto": "Modelo de regresión con datos de panel aplicado a 40 country ETFs listados en EE.UU. para examinar el impacto de la accesibilidad del mercado subyacente sobre los ETFs.",
     "doc_id": 172
    }
   ],
   "citas": [
    {
     "texto": "We employ a panel regression model to examine the impact of underlying market accessibility on ETFs using US-listed 40 country ETFs.",
     "doc_id": 172
    }
   ],
