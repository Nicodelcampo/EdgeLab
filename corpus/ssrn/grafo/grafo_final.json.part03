  {
   "id": "pin",
   "nombre_canonico": "PIN",
   "tipo": "metrica",
   "nombres_vistos": [
    "PIN"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    142
   ],
   "definiciones": [
    {
     "texto": "Probability of Informed Trading, métrica del modelo EKOP (Easley, Kiefer, O'Hara, Paperman 1996) que mide cómo la información privada afecta los precios a través del desbalance de órdenes. El paper demuestra que la estimación de PIN es sensible al parámetro delta (probabilidad de que la info sea buena/mala).",
     "doc_id": 142
    }
   ],
   "citas": [
    {
     "texto": "The Probability of informed trading (PIN) is frequently employed in financial market research to measure how private information affects asset prices",
     "doc_id": 142
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "informed trading",
     "doc_id": 142,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "order flow imbalance",
     "doc_id": 142,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "EKOP model",
     "doc_id": 142,
     "revisar": false
    }
   ]
  },
  {
   "id": "ekop model",
   "nombre_canonico": "EKOP model",
   "tipo": "metodo",
   "nombres_vistos": [
    "EKOP model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    142
   ],
   "definiciones": [
    {
     "texto": "Modelo clásico de Easley, Kiefer, O'Hara y Paperman (1996) que extrae PIN de órdenes desbalanceadas asumiendo tres escenarios: sin noticias, malas noticias (alpha*delta), y buenas noticias (alpha*(1-delta)).",
     "doc_id": 142
    }
   ],
   "citas": [
    {
     "texto": "The EKOP model extracts information from imbalanced order placed by buyers and sellers where one side have private information",
     "doc_id": 142
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "PIN",
     "doc_id": 142,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "order flow imbalance",
