   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    84
   ],
   "definiciones": [
    {
     "texto": "Función utilizada en la capa de salida para transformar las predicciones del modelo en un vector de asignación de volumen válido, garantizando que los pesos sean no negativos y sumen a uno, y permitiendo una diferenciación suave.",
     "doc_id": 84
    }
   ],
   "citas": [
    {
     "texto": "A key innovation in the framework is the use of the softmax function to enforce allocation constraints... naturally transforms any real-valued input vector z into a smooth probability distribution.",
     "doc_id": 84
    }
   ],
