    93
   ],
   "definiciones": [
    {
     "texto": "Diferencias en información, aversión al riesgo y restricciones de capital entre distintos tipos de participantes que generan impactos asimétricos en el precio.",
     "doc_id": 93
    }
   ],
   "citas": [
    {
     "texto": "Trader heterogeneity emerges as a dominant pricing channel in JPY, GBP, and AUD, providing the first cross-currency evidence that institutional and non-institutional positions affect prices asymmetrically.",
     "doc_id": 93
    }
   ],
   "relaciones_crudas": [
