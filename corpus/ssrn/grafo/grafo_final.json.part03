    }
   ]
  },
  {
   "id": "style investing",
   "nombre_canonico": "Style Investing",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Style Investing"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    190
   ],
   "definiciones": [
    {
     "texto": "Especialización de inversores en carteras basadas en características pre-definidas como value/growth, small/large-cap o momentum. Cuando las características cambian, los style investors deben rebalancear, generando volumen de trading.",
     "doc_id": 190
    }
   ],
   "citas": [
    {
     "texto": "Many investors in equity markets follow trading styles based on stock characteristics like firm size or momentum. Because stocks' characteristics change over time, style investors must rebalance their portfolios to avoid style drift.",
     "doc_id": 190
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "trading volume",
     "doc_id": 190,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "rebalancing trades",
     "doc_id": 190,
     "revisar": false
    }
   ]
  },
  {
   "id": "propensity to sell",
   "nombre_canonico": "Propensity to Sell",
   "tipo": "metrica",
   "nombres_vistos": [
    "Propensity to Sell"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    190
   ],
   "definiciones": [
    {
     "texto": "Probabilidad estimada de que un mutual fund venda una acción en función del cambio absoluto en sus características. Se modela con un linear probability model usando datos de holdings de mutual funds.",
     "doc_id": 190
    }
   ],
   "citas": [
    {
     "texto": "I estimate the relationship between the propensity to sell and changes in stock characteristics with a multivariate linear probability model.",
     "doc_id": 190
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "trading volume",
     "doc_id": 190,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "linear probability model",
     "doc_id": 190,
     "revisar": false
    }
   ]
  },
  {
   "id": "turnover",
   "nombre_canonico": "Turnover",
   "tipo": "metrica",
   "nombres_vistos": [
    "Turnover"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    190
   ],
   "definiciones": [
    {
     "texto": "Volumen de negociación anual como porcentaje de shares outstanding. Promedio de ~87% para NYSE/AMEX y ~174% para Nasdaq. Una diferencia de una desviación estándar en propensión a vender se asocia con 20-30% de diferencia en turnover.",
     "doc_id": 190
    }
   ],
   "citas": [
    {
     "texto": "A one cross-sectional standard deviation difference in the propensity to sell measure is associated with a difference in annual turnover of around 20% to 30%.",
     "doc_id": 190
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "trading volume",
     "doc_id": 190,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "propensity to sell",
     "doc_id": 190,
     "revisar": false
    }
   ]
  },
  {
   "id": "linear probability model",
   "nombre_canonico": "Linear Probability Model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Linear Probability Model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    190
   ],
   "definiciones": [
    {
     "texto": "Modelo econométrico que estima P(sell=1 | |delta characteristics|) = alpha + beta'|delta c_it| usando datos de cartera de mutual funds para cuantificar cómo cambios en características afectan decisiones de venta.",
     "doc_id": 190
    }
   ],
   "citas": [
    {
     "texto": "I use a linear probability model P(s_jit = 1| |delta c_it|) = alpha_t + beta'|delta c_it|.",
     "doc_id": 190
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "propensity to sell",
     "doc_id": 190,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "mutual fund holdings",
     "doc_id": 190,
     "revisar": false
    }
   ]
  },
  {
   "id": "instrumental variable",
   "nombre_canonico": "Instrumental Variables",
   "tipo": "metodo",
   "nombres_vistos": [
    "Instrumental Variables"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    190
   ],
   "definiciones": [
    {
     "texto": "Técnica para abordar la endogeneidad de características basadas en precio: se instrumenta la propensión a vender con características no basadas en precio (book leverage, book ROA) para descartar causalidad inversa.",
     "doc_id": 190
    }
   ],
   "citas": [
    {
     "texto": "The propensity-to-sell measure based on all stock characteristics is instrumented with a propensity-to-sell measure calculated using only stock characteristics that are not price-based.",
     "doc_id": 190
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "endogeneity bias",
     "doc_id": 190,
     "revisar": false
    },
    {
