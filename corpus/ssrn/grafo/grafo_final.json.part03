   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    138
   ],
   "definiciones": [
    {
     "texto": "Biblioteca de 101 fórmulas matemáticas usadas empíricamente como patrones estructurados. Se codifican como registros recuperables para acotar el espacio de búsqueda del WriterAgent.",
     "doc_id": 138
    }
   ],
   "citas": [
    {
     "texto": "We integrate the WorldQuant 101 Formulaic Alphas as a generation foundation, grounding LLM synthesis in proven mathematical patterns and substantially narrowing the search space",
     "doc_id": 138
    }
   ],
   "relaciones_crudas": [
