     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "NAV",
     "doc_id": 172,
     "revisar": false
    }
   ]
  },
  {
   "id": "market linkage",
   "nombre_canonico": "Market Linkage",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Market Linkage"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    172
   ],
   "definiciones": [
    {
     "texto": "Conexión entre el mercado del ETF y su mercado subyacente, afectada por las barreras de negociación. Cambios regulatorios en el subyacente impactan significativamente al ETF.",
     "doc_id": 172
    }
   ],
   "citas": [
    {
     "texto": "Due to the high trading volume and the varied objectives of institutional investors in the ETF market, even minor impacts on the underlying market result in substantial gains or losses for numerous stakeholders.",
     "doc_id": 172
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "arbitrage activity",
     "doc_id": 172,
     "revisar": false
    },
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "ETF market structure",
     "doc_id": 172,
     "revisar": false
    }
   ]
  },
  {
   "id": "institutional arbitrage activity",
   "nombre_canonico": "Institutional arbitrage activity",
   "tipo": "metrica",
   "nombres_vistos": [
    "Institutional arbitrage activity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    173
   ],
   "definiciones": [
    {
     "texto": "Nivel de arbitraje ejecutado por instituciones para capturar oportunidades generadas entre el precio del ETF y el mercado subyacente. Se mide mediante el desequilibrio de órdenes (order imbalance).",
     "doc_id": 173
    }
   ],
   "citas": [
    {
     "texto": "we measure arbitrage activity by analyzing ETF order imbalance.",
     "doc_id": 173
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "AUMENTA_CON",
     "tipo_original": "AUMENTA_CON",
     "objeto_texto": "market accessibility",
     "doc_id": 173,
     "revisar": true
    }
   ]
  },
  {
   "id": "tracking ability",
   "nombre_canonico": "Tracking ability",
   "tipo": "metrica",
   "nombres_vistos": [
    "Tracking ability"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    173
   ],
   "definiciones": [
    {
     "texto": "Capacidad de un ETF para seguir fielmente a su índice o activos subyacentes, calculada a partir de las diferencias (errores de seguimiento y spread absoluto) entre el precio del ETF y el Net Asset Value (NAV).",
     "doc_id": 173
    }
   ],
   "citas": [
    {
     "texto": "We define three variables that represent the ETFs’ tracking ability. First, the absolute ETF premium (|Premium|)... Second, the tracking error that is based on the NAV and ETF returns... Third, the tracking error that is based on the ETF and the underlying index return.",
     "doc_id": 173
    }
   ],
   "relaciones_crudas": [
