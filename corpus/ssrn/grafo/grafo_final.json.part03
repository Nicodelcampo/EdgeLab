   "doc_ids": [
    101
   ],
   "definiciones": [
    {
     "texto": "Bandas que delimitan las curvas de trading. Se calculan usando cuantiles históricos de curvas de ejecución acumulativas, con el fin de controlar el riesgo limitando la desviación de la curva adaptativa frente a la curva de volumen real del mercado.",
     "doc_id": 101
    }
   ],
   "citas": [
    {
     "texto": "A trading envelope is a band delimited by two bound curves... One can interprete these two bounds as the lower/upper thresholds for proportion of cumulative executed volume at the end of each slice.",
     "doc_id": 101
    }
   ],
