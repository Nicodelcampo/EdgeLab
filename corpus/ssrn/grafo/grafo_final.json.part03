   "tipo": "fenomeno",
   "nombres_vistos": [
    "model reflexivity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    137
   ],
   "definiciones": [
    {
     "texto": "Fenómeno donde los participantes del mercado alteran su comportamiento basándose en las acciones anticipadas de los modelos, creando bucles de retroalimentación que invalidan las predicciones. Es uno de los 'Mulas Financieros' que rompen los modelos cuantitativos.",
     "doc_id": 137
    }
   ],
   "citas": [
    {
     "texto": "situations in which market participants alter their behavior based on the anticipated actions of models, creating feedback loops that invalidate forecasts",
     "doc_id": 137
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
