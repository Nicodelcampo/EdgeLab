    93
   ],
   "definiciones": [
    {
     "texto": "Condiciones de política y liquidez, particularmente las tasas de interés y expectativas, que actúan como propulsores primordiales del FX.",
     "doc_id": 93
    }
   ],
   "citas": [
    {
     "texto": "Monetary policy transmission operates primarily through policy rates rather than money supply, and is among the strongest pricing channels",
     "doc_id": 93
    }
   ],
   "relaciones_crudas": [
