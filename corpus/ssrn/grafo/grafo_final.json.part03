   "tipo": "estrategia",
   "nombres_vistos": [
    "risk-seeking strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    89
   ],
   "definiciones": [
    {
     "texto": "Regla empírica en el backtest donde se envía una orden de compra si la predicción de cambio de precio es positiva, o si es negativa pero no cruza cierto umbral.",
     "doc_id": 89
    }
   ],
   "citas": [
    {
     "texto": "for a risk-seeking strategy, the decision for the trader will be BUY if the change in the stock price is positive or if the change in the stock price is negative and within a certain threshold.",
     "doc_id": 89
    }
   ],
   "relaciones_crudas": [
