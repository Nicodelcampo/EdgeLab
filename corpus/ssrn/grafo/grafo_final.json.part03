   "tipo": "fenomeno",
   "nombres_vistos": [
    "dry market"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    98
   ],
   "definiciones": [
    {
     "texto": "Mercados donde la liquidez no es continua, modelados con transacciones probabilísticas, causando incompetitud dinámica en los mercados.",
     "doc_id": 98
    }
   ],
   "citas": [
    {
     "texto": "Under such illiquidity we say that markets are dry. In this framework, dryness changes what is otherwise a complete market into a dynamically incomplete market.",
     "doc_id": 98
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "incomplete market",
