  {
   "id": "delta",
   "nombre_canonico": "delta",
   "tipo": "metrica",
   "nombres_vistos": [
    "delta"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    156
   ],
   "definiciones": [
    {
     "texto": "Medida de exposición agregada para monitorear el riesgo, calculada sumando los deltas de las posiciones u opciones transaccionadas.",
     "doc_id": 156
    }
   ],
   "citas": [
    {
     "texto": "calculating an equivalent stock position, i.e., a net delta (by, for example, summing delta values for all contracts traded by the market-maker",
     "doc_id": 156
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "inventory risk",
     "doc_id": 156,
     "revisar": false
    }
   ]
  },
  {
   "id": "gamma",
   "nombre_canonico": "gamma",
   "tipo": "metrica",
   "nombres_vistos": [
    "gamma"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    156
   ],
   "definiciones": [
    {
     "texto": "Tasa de cambio del parámetro delta respecto al subyacente. El gamma neto provee un estimado de la velocidad con que cambiará la exposición direccional.",
     "doc_id": 156
    }
   ],
   "citas": [
    {
     "texto": "Gamma is known to be the rate of change of the delta parameter with respect to the rate of change of the underlying security, such as the stock.",
     "doc_id": 156
    }
   ],
   "relaciones_crudas": [
    {
