    169
   ],
   "definiciones": [
    {
     "texto": "Rechazo o cancelación intencional de órdenes limitadas activas, el cual aumenta de manera significativa por parte del HFT anticipándose a saltos de riesgo.",
     "doc_id": 169
    }
   ],
   "citas": [
    {
     "texto": "passive HFTs tend to delete more limit orders as soon as market volatility rises suddenly... already withdraw from markets several minutes before the event due to the risk of being adversely selected.",
     "doc_id": 169
    }
   ],
   "relaciones_crudas": [
