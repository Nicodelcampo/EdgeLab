    127
   ],
   "definiciones": [
    {
     "texto": "Detección de puntos de reversión de precio, específicamente de tendencia bajista a alcista, usando la tercera derivada del precio. El paper propone que deceleración de caída (negative jerk) precede sistemáticamente reversiones alcistas.",
     "doc_id": 127
    }
   ],
   "citas": [
    {
     "texto": "periods of decelerating decline (negative jerk) systematically precede bullish reversals",
