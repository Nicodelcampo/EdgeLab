   "tipo": "metodo",
   "nombres_vistos": [
    "adaptive estimation scheme"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    88
   ],
   "definiciones": [
    {
     "texto": "Esquema donde los coeficientes de la combinación lineal (betas) se recalculan periódicamente basados en una ventana móvil, para forzar la reversión a la media frente a la no estacionariedad del spread clásico.",
     "doc_id": 88
    }
   ],
   "citas": [
    {
     "texto": "In order to control the non-stationarity of the synthetic asset, we adopt an adaptive estimation scheme in which the coefficients of the linear combination are periodically re-calculated.",
     "doc_id": 88
    }
   ],
