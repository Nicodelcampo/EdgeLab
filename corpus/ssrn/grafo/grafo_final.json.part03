  {
   "id": "tail risk oriented attention control mechanism",
   "nombre_canonico": "tail risk-oriented attention control mechanism",
   "tipo": "metodo",
   "nombres_vistos": [
    "tail risk-oriented attention control mechanism"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    87
   ],
   "definiciones": [
    {
     "texto": "Mecanismo que detecta muestras de volatilidad extrema e incorpora señales de riesgo de cola directamente en el proceso de fusión de características, permitiendo ajustar dinámicamente los pesos atencionales para mitigar la exposición a pérdidas extremas.",
     "doc_id": 87
    }
   ],
   "citas": [
    {
     "texto": "The Tail Risk-Oriented Attention Control Mechanism is designed to detect extreme volatility samples and make dynamic adjustments in representation level.",
     "doc_id": 87
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "extreme loss exposure",
     "doc_id": 87,
     "revisar": false
    },
    {
