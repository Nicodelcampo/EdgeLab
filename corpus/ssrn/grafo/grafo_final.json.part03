  {
   "id": "var system",
   "nombre_canonico": "VAR system",
   "tipo": "metodo",
   "nombres_vistos": [
    "VAR system"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    109
   ],
   "definiciones": [
    {
     "texto": "Modelo de vectores autorregresivos utilizado para capturar las dinámicas e interacciones lineales entre el retorno, la dirección de la transacción (trade direction) y las variables del limit order book.",
     "doc_id": 109
    }
   ],
   "citas": [
    {
     "texto": "we estimate a linear vector autoregressive system (VAR) that includes midquote return, trade direction and each limit order book variable one at a time",
     "doc_id": 109
    }
   ],
   "relaciones_crudas": [
