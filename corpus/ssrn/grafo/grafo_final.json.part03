    }
   ]
  },
  {
   "id": "aggressive hft strategie",
   "nombre_canonico": "Aggressive HFT strategies",
   "tipo": "concepto",
   "nombres_vistos": [
    "Aggressive HFT strategies"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    161
   ],
   "definiciones": [
    {
     "texto": "Estrategias de HFT que utilizan principalmente órdenes a mercado (marketable orders) para aprovechar oportunidades de arbitraje de corta duración.",
     "doc_id": 161
    }
   ],
   "citas": [
    {
     "texto": "Aggressive HFT strategies, namely those that use primarily marketable orders, are associated with short-lived arbitrage opportunities",
     "doc_id": 161
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
