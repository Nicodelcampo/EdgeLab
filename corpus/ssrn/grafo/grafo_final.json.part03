  {
   "id": "order book imbalance at level 1",
   "nombre_canonico": "Order Book Imbalance at Level 1",
   "tipo": "metrica",
   "nombres_vistos": [
    "Order Book Imbalance at Level 1"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    206
   ],
   "definiciones": [
    {
     "texto": "Medida de imbalance calculada como la diferencia normalizada entre volumen bid y ask en el mejor nivel del libro de órdenes, identificada como una de las medidas con mayor capacidad de liderazgo cross-asset.",
     "doc_id": 206
    }
   ],
   "citas": [
    {
     "texto": "We find that transaction prices and the order book imbalance (OBI) at the best quotes of one asset provide information about future midpoint returns of another asset.",
     "doc_id": 206
    }
   ],
   "relaciones_crudas": [
