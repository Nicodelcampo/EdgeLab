    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Semantic Encoder",
     "doc_id": 205,
     "revisar": false
    }
   ]
  },
  {
   "id": "microstructural encoder",
   "nombre_canonico": "Microstructural Encoder",
   "tipo": "metodo",
   "nombres_vistos": [
    "Microstructural Encoder"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    205
   ],
   "definiciones": [
    {
     "texto": "Red neuronal profunda Eθ que proyecta snapshots del LOB enriquecidos con el exogeneity score ρ(t) del filtro de Hawkes a un espacio latente compartido de dimensión d.",
     "doc_id": 205
    }
   ],
   "citas": [
    {
     "texto": "The encoder Eθ is a deep neural network that compresses the high dimension of the enriched LOB into a latent space of dimension d.",
     "doc_id": 205
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Multimodal Embedding Pipeline",
     "doc_id": 205,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Hawkes Exogeneity Score",
     "doc_id": 205,
     "revisar": false
    }
   ]
  },
  {
   "id": "semantic encoder",
   "nombre_canonico": "Semantic Encoder",
   "tipo": "metodo",
   "nombres_vistos": [
    "Semantic Encoder"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    205
   ],
   "definiciones": [
    {
     "texto": "Modelo de lenguaje pre-entrenado especializado en finanzas (tipo FinBERT) que proyecta el agregado de noticias, tweets y reportes de analistas a vectores densos en el espacio compartido.",
     "doc_id": 205
    }
   ],
   "citas": [
    {
     "texto": "A specialized model such as FinBERT is preferable because it distinguishes bullish from bearish tone in sector jargon and produces embeddings whose geometry reflects financial relationships.",
     "doc_id": 205
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Multimodal Embedding Pipeline",
