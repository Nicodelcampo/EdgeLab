    }
   ]
  },
  {
   "id": "sharpe ratio of ic",
   "nombre_canonico": "Sharpe Ratio of IC",
   "tipo": "metrica",
   "nombres_vistos": [
    "Sharpe Ratio of IC"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    138
   ],
   "definiciones": [
    {
     "texto": "Medida que indica la consistencia del IC en el tiempo, penalizando factores con varianza alta del IC.",
     "doc_id": 138
    }
   ],
   "citas": [
    {
     "texto": "The Sharpe ratio of IC is the annualized IC information ratio, measuring the consistency of the IC signal over time and penalizing strategies with high IC variance",
     "doc_id": 138
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "risk-adjusted consistency",
     "doc_id": 138,
