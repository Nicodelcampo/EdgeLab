   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    196
   ],
   "definiciones": [
    {
     "texto": "Parte de la asignación óptima que busca reducir el riesgo creando exposiciones compensatorias. Este componente explica por qué a veces es óptimo realizar una venta en corto incluso si los costos de financiamiento superan su rentabilidad esperada, a modo de cobertura de la posición larga.",
     "doc_id": 196
    }
   ],
   "citas": [
    {
     "texto": "it can be optimal to short sell the overvalued stock even if the short selling costs exceed the expected return earned from short selling... the investor takes a large long position on stock 1, which is undervalued, and it is optimal to short sell stock 2 to hedge the risk associated with this position.",
     "doc_id": 196
    }
   ],
