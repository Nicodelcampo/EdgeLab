   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    87
   ],
   "definiciones": [
    {
     "texto": "Integración de múltiples fuentes de información heterogéneas (datos técnicos de precios, sentimiento de texto y características de microestructura) en un tensor de estado unificado para capturar la dinámica compleja del mercado.",
     "doc_id": 87
    }
   ],
   "citas": [
    {
     "texto": "In order to solve this problem, multimodal modeling constructs a unified representation space in which time-aligned features are integrated into a state tensor",
     "doc_id": 87
    }
   ],
