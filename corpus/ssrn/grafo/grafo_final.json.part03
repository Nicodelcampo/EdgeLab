   "nombres_vistos": [
    "tail risk signal"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    87
   ],
   "definiciones": [
    {
     "texto": "Señal cuantitativa que mide la intensidad de pérdida extrema mediante el efecto combinado del sesgo de retorno, amplificación de volatilidad y contracción de liquidez.",
     "doc_id": 87
    }
   ],
   "citas": [
    {
     "texto": "a tail enhancement mechanism is introduced to quantify the extreme loss intensity by the combined effect of return bias, volatility amplification and liquidity contraction",
     "doc_id": 87
    }
   ],
