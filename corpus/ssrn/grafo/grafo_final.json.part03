   "definiciones": [
    {
     "texto": "Marco de trabajo estructural en el cual un LLM infiere un estado semántico a partir de texto, el cual se utiliza para modular la dinámica de un modelo clásico de probabilidad, sin reemplazar el modelo de observación subyacente.",
     "doc_id": 197
