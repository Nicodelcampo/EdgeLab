    }
   ]
  },
  {
   "id": "no arbitrage region",
   "nombre_canonico": "no-arbitrage region",
   "tipo": "concepto",
   "nombres_vistos": [
    "no-arbitrage region"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    124
   ],
   "definiciones": [
    {
     "texto": "El rango de precios medios dentro del cual un grupo de activos estructuralmente dependientes no presenta oportunidades de arbitraje, delimitado por sus bid-ask spreads.",
     "doc_id": 124
    }
   ],
   "citas": [
    {
     "texto": "The no-arbitrage region, denoted by A ⊂Rn, is the set of midprices that makes this economy arbitrage free.",
     "doc_id": 124
    }
   ],
   "relaciones_crudas": [
    {
