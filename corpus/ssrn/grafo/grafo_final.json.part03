   "doc_ids": [
    136
   ],
   "definiciones": [
    {
     "texto": "Formulación del hedging como problema de aprendizaje bajo costos de transacción y preferencias de riesgo (Buehler et al., 2019). La red aprende políticas que minimizan la distribución de pérdidas terminales en vez de replicar un delta hedge frictionless.",
     "doc_id": 136
    }
   ],
   "citas": [
    {
     "texto": "Buehler et al. (2019) formulate hedging under transaction costs and risk preferences as a learning problem",
     "doc_id": 136
    }
   ],
