   "tipo": "metodo",
   "nombres_vistos": [
    "HFT identification"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    171
   ],
   "definiciones": [
    {
     "texto": "Metodología heurística para etiquetar el flujo de órdenes HFT que asume que la emisión de múltiples órdenes idénticas en intervalos de un segundo o menos provienen de un algoritmo.",
     "doc_id": 171
    }
   ],
   "citas": [
    {
     "texto": "Many HFTs are identified as if more than one order message with the same size and direction (buy/sell) comes from the same investor within a short interval, such as one second or less.",
     "doc_id": 171
    }
   ],
