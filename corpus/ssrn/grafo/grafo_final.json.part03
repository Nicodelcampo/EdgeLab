    "Information Coefficient (IC) for spread"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    100
   ],
   "definiciones": [
    {
     "texto": "Correlación entre el Z-score contemporáneo y el retorno futuro del spread. Se usa en el filtro final del universo de pares para identificar aquellos con mayor poder predictivo de convergencia.",
     "doc_id": 100
    }
   ],
   "citas": [
    {
     "texto": "For each pair, we compute the correlation between the contemporaneous Z-score and the future spread return... negative IC values indicate that positive Z-scores tend to be followed by downward spread moves",
     "doc_id": 100
    }
   ],
   "relaciones_crudas": [
    {
