   ],
   "definiciones": [
    {
     "texto": "Test estadístico clásico (Engle-Granger) de estacionariedad que el paper elimina de su pipeline final tras demostrar que descarta oportunidades rentables de reversión local a corto plazo en mercados cripto de rápida evolución.",
     "doc_id": 100
    }
   ],
   "citas": [
    {
