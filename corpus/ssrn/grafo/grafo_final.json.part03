   ],
   "definiciones": [
    {
     "texto": "Índice que mide la fluctuación extrema en los precios de los activos, utilizado en el entorno de trading para detener compras ante riesgo sistémico y reducir el drawdown.",
     "doc_id": 126
    }
   ],
   "citas": [
    {
