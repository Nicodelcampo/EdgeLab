    86
   ],
   "definiciones": [
    {
     "texto": "Método para asignar pesos a los activos en el enfoque multivariado, escalando las posiciones por la correlación entre el precio normalizado de cada activo del canasto y el activo principal.",
     "doc_id": 86
    }
   ],
   "citas": [
    {
     "texto": "This approach will calculate the weights using... the correlation of the normalized price series k with the normalized price of i",
