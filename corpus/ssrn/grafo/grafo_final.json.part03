   "tipo": "concepto",
   "nombres_vistos": [
    "reservation price"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    98
   ],
   "definiciones": [
    {
     "texto": "El precio exacto que hace indiferente a un agente entre incluir o no el derivado en su cartera.",
     "doc_id": 98
    }
   ],
   "citas": [
    {
     "texto": "the price for which any agent is indi®erent between transacting or not transacting the derivative, to be called the reservation price of the derivative, is contained within the statistical arbitrage bounds derived above.",
     "doc_id": 98
