   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    93
   ],
   "definiciones": [
    {
     "texto": "Instrumento del mercado de opciones utilizado para medir la asimetría y el sesgo de las expectativas direccionales respecto a una divisa.",
     "doc_id": 93
    }
   ],
   "citas": [
    {
     "texto": "Risk reversals are included because they reflect option traders’ expectations of price asymmetry.",
