   "doc_frecuencia": 1,
   "doc_ids": [
    136
   ],
   "definiciones": [
    {
     "texto": "Fundamento matemático de asset pricing donde precios descontados son martingalas bajo una medida de pricing equivalente. El paper argumenta que no es solo una base histórica sino un test de consistencia económica para modelos AI.",
     "doc_id": 136
    }
   ],
   "citas": [
    {
     "texto": "Martingale pricing is not simply a historical foundation of derivatives. It becomes a way to distinguish statistical fit from economic consistency",
     "doc_id": 136
    }
   ],
