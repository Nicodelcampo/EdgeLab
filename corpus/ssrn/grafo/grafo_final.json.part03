     "doc_id": 205,
     "revisar": false
    }
   ]
  },
  {
   "id": "vector database for divergence detection",
   "nombre_canonico": "Vector Database for Divergence Detection",
   "tipo": "metodo",
   "nombres_vistos": [
    "Vector Database for Divergence Detection"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    205
   ],
   "definiciones": [
    {
     "texto": "Base de datos vectorial (Milvus/Qdrant) que almacena tripletas (vmarket, vpublic, D(t)) con metadata, permite búsqueda ANN de precedentes históricos y calibración dinámica de umbrales de detección.",
     "doc_id": 205
    }
   ],
   "citas": [
    {
     "texto": "The Vector DB ensures not only storage but also inference, memory and contextualization.",
     "doc_id": 205
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Informational Divergence Metric D(t)",
     "doc_id": 205,
     "revisar": false
    },
    {
     "tipo": "USA",
