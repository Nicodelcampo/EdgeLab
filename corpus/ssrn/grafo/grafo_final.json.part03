   "definiciones": [
    {
     "texto": "Datos de LOB de Deutsche Börse A7 Analytics Platform con timestamps en nanosegundos, cubriendo 10 niveles de profundidad bid/ask para 19 instrumentos en Xetra y Eurex durante enero-junio 2021.",
     "doc_id": 206
    }
   ],
   "citas": [
