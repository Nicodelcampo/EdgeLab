  {
   "id": "superreplication bound",
   "nombre_canonico": "superreplication bounds",
   "tipo": "concepto",
   "nombres_vistos": [
    "superreplication bounds"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    98
   ],
   "definiciones": [
    {
     "texto": "Límites del intervalo de valoración libres de arbitraje puro. Representan el costo máximo y mínimo para replicar con seguridad el pago del derivado.",
     "doc_id": 98
    }
   ],
   "citas": [
    {
     "texto": "The superreplicating bounds establish the limits of the interval for arbitrage-free value of the option. If the price is outside this range, then a positive pro¯t is attainable with probability one.",
     "doc_id": 98
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "statistical arbitrage bounds",
     "doc_id": 98,
     "revisar": false
    }
   ]
  },
  {
