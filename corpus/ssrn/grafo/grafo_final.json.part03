   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    115
   ],
   "definiciones": [
    {
     "texto": "Propiedad de una serie en que su media y covarianza se mantienen finitas e independientes del tiempo.",
     "doc_id": 115
    }
   ],
   "citas": [
