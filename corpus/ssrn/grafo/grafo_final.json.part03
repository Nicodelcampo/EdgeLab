     "objeto_texto": "Approximate Nearest Neighbor Search",
     "doc_id": 205,
     "revisar": false
    }
   ]
  },
  {
   "id": "hayashi yoshida estimator",
   "nombre_canonico": "Hayashi-Yoshida Estimator",
   "tipo": "metodo",
   "nombres_vistos": [
    "Hayashi-Yoshida Estimator"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    206
   ],
   "definiciones": [
    {
     "texto": "Estimador de correlación no paramétrico para series temporales irregularmente espaciadas de distinta longitud que evita el sesgo de Epps sin requerir interpolación, sumando productos de diferencias en intervalos solapantes.",
     "doc_id": 206
    }
   ],
   "citas": [
    {
     "texto": "The HY-estimator sums up all products of time-overlapping differences of two time series and yields an unbiased estimate of the integrated covariance.",
     "doc_id": 206
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "non-synchronous time series",
     "doc_id": 206,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Epps Effect",
     "doc_id": 206,
     "revisar": false
    }
   ]
  },
  {
   "id": "epp effect",
   "nombre_canonico": "Epps Effect",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Epps Effect"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    206
   ],
   "definiciones": [
    {
     "texto": "Sesgo hacia cero en estimaciones de correlación cuando series temporales no sincrónicas se muestrean sincrónicamente a altas frecuencias mediante interpolación, documentado por Epps (1979).",
     "doc_id": 206
    }
   ],
   "citas": [
    {
     "texto": "The application of standard statistical correlation techniques via interpolation is biased, as correlation estimates decrease when the time series are synchronously sampled at high frequencies.",
     "doc_id": 206
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "accurate correlation estimation",
     "doc_id": 206,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Hayashi-Yoshida Estimator",
     "doc_id": 206,
     "revisar": false
    }
   ]
  },
  {
   "id": "lead lag strength lls",
   "nombre_canonico": "Lead-Lag Strength (LLS)",
   "tipo": "metrica",
   "nombres_vistos": [
    "Lead-Lag Strength (LLS)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    206
   ],
   "definiciones": [
    {
     "texto": "Métrica propuesta que combina la asimetría de la curva HY (como el LLR) con un factor de escala basado en la correlación promedio al cuadrado, capturando dirección y magnitud del lead-lag controlando el nivel de correlación.",
     "doc_id": 206
    }
   ],
   "citas": [
    {
     "texto": "The LLS displays the asymmetry of the HY-curve while controlling for the level of correlation. As a result, it indicates the direction and strength of the lead-lag relationship between two time series.",
     "doc_id": 206
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Lead-Lag Ratio",
     "doc_id": 206,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "lead-lag relationship strength",
     "doc_id": 206,
     "revisar": false
    }
   ]
  },
  {
   "id": "lead lag ratio",
   "nombre_canonico": "Lead-Lag Ratio",
   "tipo": "metrica",
   "nombres_vistos": [
    "Lead-Lag Ratio"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    206
   ],
   "definiciones": [
    {
     "texto": "Ratio del área bajo la curva HY de leads positivos sobre lags negativos. Mayor que 1 indica liderazgo de Y sobre X, pero no controla el nivel absoluto de correlación.",
     "doc_id": 206
    }
   ],
   "citas": [
    {
     "texto": "LLR = Σ ρ²(+ℓ) / Σ ρ²(−ℓ) ... The LLR becomes larger than 1 if the area under the HY-curve of leads is larger than the area under the curve of lags.",
     "doc_id": 206
    }
   ],
   "relaciones_crudas": [
    {
