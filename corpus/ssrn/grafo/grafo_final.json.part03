    }
   ]
  },
  {
   "id": "hawke graph",
   "nombre_canonico": "Hawkes graph",
   "tipo": "metodo",
   "nombres_vistos": [
    "Hawkes graph"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    207
   ],
   "definiciones": [
    {
     "texto": "Método de Achab et al. 2018 que estima directamente la matriz de normas de kernels M_{ij} = integral phi(j->i)(u)du a partir de probabilidades condicionales del proceso puntual, usado aquí para determinar si un kernel es catalizador o inhibitorio antes del ajuste por mínimos cuadrados.",
     "doc_id": 207
    }
   ],
   "citas": [
    {
     "texto": "we make use of the Hawkes Graph Achab et al. 2018 which directly estimates the kernel norms matrix M_{d x d} […] we purely use this method to identify whether a kernel is catalysing or inhibiting in nature.",
     "doc_id": 207
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "non-parametric calibration",
     "doc_id": 207,
