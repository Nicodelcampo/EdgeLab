   "tipo": "metodo",
   "nombres_vistos": [
    "Multi-Agent System"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    138
   ],
   "definiciones": [
    {
     "texto": "Diseño con cuatro agentes especializados (WriterAgent, JudgeAgent, ReviewerAgent, BacktestEngine) que asumen distintos roles para generar código, evaluarlo, backtestearlo y proveer feedback sin intervención humana.",
     "doc_id": 138
    }
   ],
   "citas": [
    {
     "texto": "Four specialized agents (Writer, Judge, Reviewer, Evaluator) collaboratively generate, validate, and improve candidate alphas without human intervention.",
     "doc_id": 138
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
