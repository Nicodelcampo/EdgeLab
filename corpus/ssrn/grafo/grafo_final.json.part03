   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    127
   ],
   "definiciones": [
    {
     "texto": "Tercera derivada temporal del precio (tasa de cambio de la aceleración), adaptada del concepto físico de jerk. El paper la estima mediante regresión cuadrática sobre aceleraciones de precio rodantes; curvatura negativa indica frenado dinámico que precede reversiones alcistas.",
     "doc_id": 127
    }
   ],
   "citas": [
    {
     "texto": "the third derivative — jerk — has received no attention in quantitative finance. In classical mechanics, jerk is the rate of change of acceleration",
     "doc_id": 127
    }
   ],
