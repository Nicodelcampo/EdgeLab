   "doc_frecuencia": 1,
   "doc_ids": [
    154
   ],
   "definiciones": [
    {
     "texto": "Debilitamiento temporal del drift positivo de una señal, modelado matemáticamente mediante la intensidad de salto de la cadena de Markov hacia un estado de ruido.",
     "doc_id": 154
    }
   ],
   "citas": [
