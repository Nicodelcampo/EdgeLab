   "nombres_vistos": [
    "quantitative trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    132
   ],
   "definiciones": [
    {
     "texto": "Uso de modelos matemáticos y algoritmos para analizar datos financieros e identificar oportunidades, ejecutando operaciones automáticamente basadas en reglas predeterminadas.",
     "doc_id": 132
    }
   ],
   "citas": [
    {
     "texto": "Quantitative trading refers to the use of mathematical models and algorithms to make trading decisions.",
     "doc_id": 132
    }
   ],
   "relaciones_crudas": []
  },
  {
   "id": "feature engineering",
   "nombre_canonico": "feature engineering",
