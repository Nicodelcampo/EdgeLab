   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    204
   ],
   "definiciones": [
    {
     "texto": "Función de recompensa que penaliza el drawdown máximo y los costos de transacción frecuentes, a la vez que recompensa el retorno acumulado para equilibrar beneficios y control de riesgos.",
     "doc_id": 204
    }
   ],
   "citas": [
    {
     "texto": "we designed a composite reward incorporating transaction costs, risk exposure, and position constraints, achieving equilibrium between return enhancement and risk exposure control.",
     "doc_id": 204
    }
   ],
