   "definiciones": [
    {
     "texto": "Función de pérdida que mide la diferencia absoluta entre el precio de ejecución promedio logrado y el VWAP de mercado real.",
     "doc_id": 84
    }
   ],
   "citas": [
    {
     "texto": "The Absolute VWAP Loss measures the absolute difference between the achieved VWAP and the market VWAP",
