  {
   "id": "factorial moment",
   "nombre_canonico": "Factorial Moments",
   "tipo": "metodo",
   "nombres_vistos": [
    "Factorial Moments"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    193
   ],
   "definiciones": [
    {
     "texto": "Herramienta de física nuclear para caracterizar distribuciones de multiplicidad. Momentos factoriales normalizados F_q que son iguales a 1 para estadística Gaussiana sin correlaciones y crecen por encima de 1 cuando hay correlaciones y fluctuaciones dinámicas.",
     "doc_id": 193
    }
   ],
   "citas": [
    {
     "texto": "Factorial moments are convenient tools in nuclear physics to characterize the multiplicity distributions when phase-space resolution becomes small.",
     "doc_id": 193
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "intermittency",
