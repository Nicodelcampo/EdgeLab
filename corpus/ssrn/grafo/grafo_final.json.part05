  {
   "id": "information asymmetry speed based",
   "nombre_canonico": "Information Asymmetry (Speed-Based)",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "Information Asymmetry (Speed-Based)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    365
   ],
   "definiciones": [
    {
     "texto": "Nuevo tipo de asimetría de información donde HFT tiene ventaja de velocidad para ejecutar órdenes más rápido que traders de baja frecuencia, explotando beneficios sin acceso a mejor información fundamental.",
     "doc_id": 365
    }
   ],
   "citas": [
    {
     "texto": "Algorithmic trading promotes a new type of information asymmetry, i.e. HFT has the speed advantage for profit exploitation by realizing its order specification in a faster pace than conventional traders with low trading frequency.",
     "doc_id": 365
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "High-Frequency Trading (HFT)",
     "doc_id": 365,
     "revisar": false
    }
   ]
