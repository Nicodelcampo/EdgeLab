   "tipo": "estrategia",
   "nombres_vistos": [
    "Collection-Level Floor Bids"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    364
   ],
   "definiciones": [
    {
     "texto": "Ofertas para comprar cualquier token en una colección; constituyen el best bid efectivo en la mayoría de snapshots del orderbook y reducen spreads medidos en más de un tercio.",
     "doc_id": 364
    }
   ],
   "citas": [
    {
     "texto": "Collection-level floor bids constitute the effective best bid in the vast majority of orderbook snapshots and reduce measured spreads by more than one-third.",
     "doc_id": 364
    }
   ],
   "relaciones_crudas": [
