   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    375
   ],
   "definiciones": [
    {
     "texto": "Metodología robusta que suma ganancias/pérdidas acumuladas no realizadas durante todo el período de inversión mediante mark-to-market, invariante al horizonte temporal elegido. Demostrada idéntica a FIFO.",
     "doc_id": 375
    }
   ],
   "citas": [
    {
     "texto": "To sum the accrued but unrealized capital gains/losses over the entire period of the investment by marking-to-market to achieve a holding-period-invariant (HPI) methodology.",
     "doc_id": 375
    }
   ],
   "relaciones_crudas": [
    {
