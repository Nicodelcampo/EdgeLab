   "tipo": "fenomeno",
   "nombres_vistos": [
    "Unwinding Theory"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    378
   ],
   "definiciones": [
    {
     "texto": "Teoría de Khandani y Lo (2007) que explica el drawdown de quant funds de agosto 2007 como liquidación forzosa de posiciones; validada por los resultados del paper.",
     "doc_id": 378
    }
   ],
   "citas": [
    {
     "texto": "We obtain results which are consistent with Khandani and Lo (2007) and validate their 'unwinding' theory for the quant fund drawdown of August 2007.",
     "doc_id": 378
    }
   ],
   "relaciones_crudas": [
