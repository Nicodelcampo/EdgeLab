  {
   "id": "hayashi yoshida hy cross correlation estimator",
   "nombre_canonico": "Hayashi-Yoshida (HY) Cross-Correlation Estimator",
   "tipo": "metodo",
   "nombres_vistos": [
    "Hayashi-Yoshida (HY) Cross-Correlation Estimator"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    367
   ],
   "definiciones": [
    {
     "texto": "Estimador de correlación cruzada que permite tiempos de llegada de cotizaciones irregulares y no sincrónicos sin necesidad de remuestreo grueso; crítico para detectar patrones lead-lag sub-segundo.",
     "doc_id": 367
    }
   ],
   "citas": [
    {
     "texto": "We employ the Hayashi-Yoshida cross-correlation estimator to measure the speed of price adjustment. The HY estimator readily allows for irregular and non-synchronous quote arrival times without the need for coarse resampling.",
     "doc_id": 367
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Lead-Lag Relationship",
     "doc_id": 367,
     "revisar": false
    }
   ]
  },
  {
   "id": "lead lag relationship sub second",
   "nombre_canonico": "Lead-Lag Relationship (Sub-Second)",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Lead-Lag Relationship (Sub-Second)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    367
   ],
   "definiciones": [
    {
     "texto": "Relación temporal donde un contrato de futuros lidera a otro en el ajuste de precios; S&P 500 lidera FTSE 100 por 98ms y DAX por 349ms en promedio, con patrones intradiarios marcados.",
     "doc_id": 367
    }
   ],
   "citas": [
    {
     "texto": "The S&P 500 leads the FTSE 100 and DAX contracts by 98 and 349 milliseconds respectively, consistent with the notion that international price discovery originates in the US.",
     "doc_id": 367
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PREDICE",
     "tipo_original": "PREDICE",
     "objeto_texto": "Mid-Quote Changes",
     "doc_id": 367,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Statistical Arbitrage",
     "doc_id": 367,
     "revisar": false
    }
   ]
  },
  {
   "id": "best bid and offer bbo quote data",
   "nombre_canonico": "Best Bid and Offer (BBO) Quote Data",
   "tipo": "dato",
   "nombres_vistos": [
    "Best Bid and Offer (BBO) Quote Data"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    367
   ],
   "definiciones": [
    {
     "texto": "Cotizaciones del mejor bid y ask timestampadas al milisegundo que forman el nivel superior del order book central, constituyendo una serie continua de precios libre de cotizaciones obsoletas.",
     "doc_id": 367
    }
   ],
   "citas": [
    {
     "texto": "We employ Best Bid and Offer (BBO) quote data, time-stamped to the millisecond. BBO quotes form the top level of the Central Limit Order Book, thus constituting a continuous price series free of stale quotes.",
     "doc_id": 367
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Hayashi-Yoshida (HY) Cross-Correlation Estimator",
     "doc_id": 367,
     "revisar": false
    }
   ]
  },
  {
   "id": "statistical arbitrage strategy",
   "nombre_canonico": "Statistical Arbitrage Strategy",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Statistical Arbitrage Strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    367
   ],
   "definiciones": [
    {
     "texto": "Estrategia basada en disparadores de umbral simple: movimientos del mid-quote del contrato líder pronostican movimientos del contrato rezagado con precisión direccional >85%, generando beneficios de ~GBP 100,000/mes.",
     "doc_id": 367
    }
   ],
   "citas": [
    {
     "texto": "A simple statistical arbitrage strategy exploiting these relations yields economically significant profits which are robust to market impact costs and the bid-ask spread.",
     "doc_id": 367
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Lead-Lag Relationship (Sub-Second)",
     "doc_id": 367,
     "revisar": false
    }
   ]
  },
  {
   "id": "intraday seasonality of lead lag",
   "nombre_canonico": "Intraday Seasonality of Lead-Lag",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Intraday Seasonality of Lead-Lag"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    367
   ],
   "definiciones": [
    {
     "texto": "Correlaciones pico alrededor de anuncios macroeconómicos a las 13:30 GMT, caen al cierre de mercados cash europeos a las 16:30 GMT, y rebotan en trading nocturno.",
     "doc_id": 367
    }
   ],
   "citas": [
    {
     "texto": "Correlations among all pairs peak around daily economic announcements at 13:30 GMT, and fall sharply when the FTSE 100 and DAX cash markets close at 16:30 GMT.",
     "doc_id": 367
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Lead-Lag Relationship (Sub-Second)",
     "doc_id": 367,
     "revisar": false
    }
   ]
  },
  {
   "id": "directional accuracy",
   "nombre_canonico": "Directional Accuracy",
   "tipo": "metrica",
   "nombres_vistos": [
    "Directional Accuracy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    367
   ],
   "definiciones": [
    {
     "texto": "Precisión direccional >85% al pronosticar movimientos del mid-quote del contrato rezagado basado en triggers del líder; relacionada con la sensibilidad del umbral.",
     "doc_id": 367
    }
   ],
   "citas": [
    {
     "texto": "Based on simple threshold triggers, mid-quote moves of leading contracts forecast subsequent moves of lagging contracts with a directional accuracy of over 85%.",
     "doc_id": 367
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Statistical Arbitrage Strategy",
     "doc_id": 367,
     "revisar": false
    }
   ]
  },
  {
   "id": "cross market efficiency",
   "nombre_canonico": "Cross-Market Efficiency",
   "tipo": "concepto",
   "nombres_vistos": [
    "Cross-Market Efficiency"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    367
   ],
   "definiciones": [
    {
     "texto": "Ineficiencia entre mercados internacionales: los flujos de información no son instantáneos sino que exhiben breves retardos que inducen anomalías de precio lo suficientemente grandes para compensar arbitrajistas.",
     "doc_id": 367
    }
   ],
   "citas": [
    {
     "texto": "Our results accord with the Grossman and Stiglitz (1976, 1980) suggestion that temporary disequilibria incentivize arbitrageurs to correct pricing anomalies.",
     "doc_id": 367
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CONTRADICE_A",
     "tipo_original": "CONTRADICE_A",
     "objeto_texto": "Market Efficiency",
     "doc_id": 367,
     "revisar": false
    }
   ]
  },
  {
   "id": "conditional volatility",
   "nombre_canonico": "Conditional Volatility",
   "tipo": "concepto",
   "nombres_vistos": [
    "Conditional Volatility"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    368
   ],
   "definiciones": [
    {
     "texto": "Volatilidad de retornos que depende de valores pasados o efectos económicos; central para medir riesgo y determinar el retorno requerido y precio de activos.",
     "doc_id": 368
    }
   ],
   "citas": [
    {
     "texto": "Volatility is the common means by which risk is measured and is therefore central to determining the required return and, by association, the price of assets.",
     "doc_id": 368
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Risk",
     "doc_id": 368,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Asset Pricing",
     "doc_id": 368,
     "revisar": false
    }
   ]
  },
  {
   "id": "market microstructure volatility channel",
   "nombre_canonico": "Market Microstructure Volatility Channel",
   "tipo": "concepto",
   "nombres_vistos": [
    "Market Microstructure Volatility Channel"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    368
   ],
   "definiciones": [
    {
     "texto": "Mecanismo teórico por el cual spreads bid-ask, liquidez y tasa de ajuste del precio al order flow afectan la volatilidad condicional de retornos.",
     "doc_id": 368
    }
   ],
   "citas": [
    {
     "texto": "From a simple representation of the value process for a stock we show how market microstructure might influence conditional volatility in returns.",
     "doc_id": 368
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Market Microstructure",
     "doc_id": 368,
     "revisar": false
    }
   ]
  },
  {
   "id": "price impact lambda",
   "nombre_canonico": "Price Impact (Lambda)",
   "tipo": "metrica",
   "nombres_vistos": [
    "Price Impact (Lambda)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    368
   ],
   "definiciones": [
    {
     "texto": "Parámetro lambda de Kyle (1985) que mide la respuesta del precio al order flow; los market makers ajustan lambda pero enfrentan reducción del contenido informacional del order flow por spreads.",
     "doc_id": 368
    }
   ],
   "citas": [
    {
     "texto": "Market makers would not make systematic errors in pricing, rather adjusting the response of price to order flow, denoted by lambda in Kyle (1985).",
     "doc_id": 368
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Market Microstructure Volatility Channel",
     "doc_id": 368,
     "revisar": false
    }
   ]
  },
  {
   "id": "spread induced autocorrelation",
   "nombre_canonico": "Spread-Induced Autocorrelation",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Spread-Induced Autocorrelation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    368
   ],
   "definiciones": [
    {
     "texto": "Los spreads impiden el proceso de descubrimiento de precio resultando en autocorrelación positiva en retornos; asimétrica: reduce probabilidad de compras creando demanda latente.",
     "doc_id": 368
    }
   ],
   "citas": [
    {
     "texto": "Spreads impede the price discovery process, resulting in positive autocorrelation in returns.",
     "doc_id": 368
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Conditional Volatility",
     "doc_id": 368,
     "revisar": false
    }
   ]
  },
  {
   "id": "illiquidity effect",
   "nombre_canonico": "Illiquidity Effect",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Illiquidity Effect"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    368
   ],
   "definiciones": [
    {
     "texto": "Los mercados ilíquidos responden más a cualquier trade dado (Amihud 2002), implicando mayor volatilidad en retornos de activos.",
     "doc_id": 368
    }
   ],
   "citas": [
    {
     "texto": "After Amihud (2002) and later Florakis et al (2011) we expect illiquid markets to respond more to any given trade. This would imply a greater volatility in asset returns.",
     "doc_id": 368
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Conditional Volatility",
     "doc_id": 368,
     "revisar": false
    }
   ]
  },
  {
   "id": "arch family model",
   "nombre_canonico": "ARCH Family Models",
   "tipo": "metodo",
   "nombres_vistos": [
    "ARCH Family Models"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    368
   ],
   "definiciones": [
    {
     "texto": "Familia de modelos de volatilidad condicional iniciada por Engle (1982) y Bollerslev (1986); el artículo propone integrar explícitamente variables de microestructura en su especificación.",
     "doc_id": 368
    }
   ],
   "citas": [
    {
     "texto": "The model presented includes a measure for volatility in the underlying asset value, changes in which might reflect much of the existing ARCH family of models.",
     "doc_id": 368
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Conditional Volatility",
     "doc_id": 368,
     "revisar": false
    }
   ]
  },
  {
   "id": "mixture of distribution hypothesi",
   "nombre_canonico": "Mixture of Distribution Hypothesis",
   "tipo": "concepto",
   "nombres_vistos": [
    "Mixture of Distribution Hypothesis"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    368
   ],
   "definiciones": [
    {
     "texto": "Hipótesis de que volumen y volatilidad están determinados conjuntamente por el flujo de información; el order flow firmado determina precios mientras el no firmado determina volatilidad.",
     "doc_id": 368
    }
   ],
   "citas": [
    {
     "texto": "The confirmation of intuition that signed order flow determines prices whilst unsigned determines volatility.",
     "doc_id": 368
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Conditional Volatility",
     "doc_id": 368,
     "revisar": false
    }
   ]
  },
  {
   "id": "illiquidity and volatility link",
   "nombre_canonico": "Illiquidity and Volatility Link",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "Illiquidity and Volatility Link"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    368
   ],
   "definiciones": [
    {
     "texto": "Posibilidad de que modelos de asset pricing sean poco fiables si no incorporan la dependencia de la volatilidad condicional respecto a variables de microestructura.",
     "doc_id": 368
    }
   ],
   "citas": [
    {
     "texto": "Where the volatility in returns is conditional on past values or economic effects there is therefore the possibility that asset pricing models are unreliable if they fail to account for these effects.",
     "doc_id": 368
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Asset Pricing",
     "doc_id": 368,
     "revisar": false
    }
   ]
  },
  {
   "id": "true effective spread",
   "nombre_canonico": "True Effective Spread",
   "tipo": "metrica",
   "nombres_vistos": [
    "True Effective Spread"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    369
   ],
   "definiciones": [
    {
     "texto": "Spread efectivo corregido por dirección real de trade y por efecto mecánico de órdenes límite agresivas que fijan el NBBO; para opciones minoristas promedia 1.07%, 60% menor que el convencional (2.59%).",
     "doc_id": 369
    }
   ],
   "citas": [
    {
     "texto": "True effective spreads for retail option trades are on average 1.07% (0.66% median), about 60% lower than the conventional effective spreads.",
     "doc_id": 369
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Retail Trading Costs",
     "doc_id": 369,
     "revisar": false
    },
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Conventional Effective Spread",
     "doc_id": 369,
     "revisar": false
    }
   ]
  },
  {
   "id": "non marketable limit order",
   "nombre_canonico": "Non-Marketable Limit Orders",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Non-Marketable Limit Orders"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    369
   ],
   "definiciones": [
    {
     "texto": "Órdenes límite no ejecutables inmediatamente que representan 17% del volumen en acciones y >34% en opciones según Form 606; contradicen la asunción previa de que minoristas raramente usan límites.",
     "doc_id": 369
    }
   ],
   "citas": [
    {
     "texto": "Non-marketable limit orders account for 17% of stock volume but more than 34% of option volume in Form 606 reports by retail brokers.",
     "doc_id": 369
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Retail Trading Costs",
     "doc_id": 369,
     "revisar": false
    }
   ]
  },
  {
   "id": "form 606 report",
   "nombre_canonico": "Form 606 Reports",
   "tipo": "dato",
   "nombres_vistos": [
    "Form 606 Reports"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    369
   ],
   "definiciones": [
    {
     "texto": "Informes regulatorios donde cada broker minorista debe divulgar todo el trading en valores de renta variable negociados en bolsa y opciones listadas a nivel de clase de activo.",
     "doc_id": 369
    }
   ],
   "citas": [
    {
     "texto": "Form 606 reports cover the entire retail trader population as every retail broker must disclose all trading in exchange-traded equity securities and listed options at the asset class level.",
     "doc_id": 369
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Non-Marketable Limit Orders",
     "doc_id": 369,
     "revisar": false
    }
   ]
  },
  {
   "id": "nbbo mechanical bia",
   "nombre_canonico": "NBBO Mechanical Bias",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "NBBO Mechanical Bias"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    369
   ],
   "definiciones": [
    {
     "texto": "Sesgo que ocurre cuando una orden límite agresiva de un minorista fija el NBBO; el midquote pre-trade incorpora la propia cotización del trader, haciendo que el trade parezca artificialmente favorable.",
     "doc_id": 369
    }
   ],
   "citas": [
    {
     "texto": "When the midquote embeds the trader's own quote, the conventional benchmark makes the trade appear artificially favorable and understates costs.",
     "doc_id": 369
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Conventional Effective Spread",
     "doc_id": 369,
     "revisar": false
    }
   ]
  },
  {
   "id": "e q ratio effective to quoted spread",
   "nombre_canonico": "E/Q Ratio (Effective-to-Quoted Spread)",
   "tipo": "metrica",
   "nombres_vistos": [
    "E/Q Ratio (Effective-to-Quoted Spread)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    369
   ],
   "definiciones": [
    {
     "texto": "Ratio de spread efectivo a spread cotizado que mide calidad de ejecución; los efectos fijos de trader explican 71% de su variación, mientras los de broker explican <1%.",
     "doc_id": 369
    }
   ],
   "citas": [
    {
     "texto": "Trader fixed effects explain 71% of the E/Q ratio variation, while broker fixed effects explain less than 1%.",
     "doc_id": 369
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Execution Quality",
     "doc_id": 369,
     "revisar": false
    }
   ]
  },
  {
   "id": "execution persistence",
   "nombre_canonico": "Execution Persistence",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Execution Persistence"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    369
   ],
   "definiciones": [
    {
     "texto": "Persistencia de habilidad de ejecución: 52% de traders en el quintil inferior de costos en la primera mitad de su historial permanecen allí en la segunda mitad, muy por encima del 20% aleatorio.",
     "doc_id": 369
    }
   ],
   "citas": [
    {
     "texto": "Among traders in the bottom quintile of execution costs in the first half of their tenure, 52% remain in this quintile in the second half, far above the 20% random baseline.",
     "doc_id": 369
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Trader Skill",
     "doc_id": 369,
     "revisar": false
    }
   ]
  },
  {
   "id": "price improvement option",
   "nombre_canonico": "Price Improvement (Options)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Price Improvement (Options)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    369
   ],
   "definiciones": [
    {
     "texto": "Mejora de precio obtenida por minoristas mediante órdenes límite que ejecutan dentro del spread cotizado, resultando en costos efectivos menores que los cotizados.",
     "doc_id": 369
    }
   ],
   "citas": [
    {
     "texto": "Retail investors commonly use limit orders to reduce trading costs.",
     "doc_id": 369
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Limit Orders",
     "doc_id": 369,
     "revisar": false
    }
   ]
  },
  {
   "id": "option volume share retail",
   "nombre_canonico": "Options Volume Share (Retail)",
   "tipo": "metrica",
   "nombres_vistos": [
    "Options Volume Share (Retail)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    369
   ],
   "definiciones": [
    {
     "texto": "Inversores minoristas representan ~40% del volumen total de opciones y ~25% del volumen de acciones según estimaciones de Form 606.",
     "doc_id": 369
    }
   ],
   "citas": [
    {
     "texto": "We estimate that individual retail investors account for about 40% of total option volume and about a quarter of total equity volume.",
     "doc_id": 369
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Retail Trading Activity",
     "doc_id": 369,
