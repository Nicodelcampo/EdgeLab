    }
   ]
  },
  {
   "id": "parametric vs non parametric pair trading",
   "nombre_canonico": "Parametric vs Non-Parametric Pairs Trading",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Parametric vs Non-Parametric Pairs Trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    320
   ],
   "definiciones": [
    {
     "texto": "Comparación entre estrategias basadas en modelos formales de series temporales (AR(1) para el spread, cointegración) y métodos no paramétricos simples (distance method). Los modelos paramétricos capturan mejor pares con mispricings frecuentes pero de menor magnitud; el resultado neto es similar.",
     "doc_id": 320
    }
   ],
   "citas": [
    {
     "texto": "Strategies that are formulated around stationary pricing relations using autoregressive and cointegration models are better able to identify predictable pricing relations compared to simple non-parametric methods. However, the mispricings... are smaller in magnitude.",
     "doc_id": 320
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "Distance Method",
     "doc_id": 320,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Cointegration Test",
     "doc_id": 320,
     "revisar": false
    }
   ]
  },
  {
   "id": "ar 1 spread modeling",
   "nombre_canonico": "AR(1) Spread Modeling",
   "tipo": "metodo",
   "nombres_vistos": [
    "AR(1) Spread Modeling"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    320
   ],
   "definiciones": [
    {
     "texto": "Modelo autorregresivo de primer orden para el spread entre dos acciones. Si el coeficiente AR es <1 (estacionario), el spread es mean-reverting y pueden identificarse oportunidades de trading cuando el spread se desvía de su media.",
     "doc_id": 320
    }
   ],
   "citas": [
    {
     "texto": "I search for stationary pricing relations by using a first-order autoregressive model for pricing spreads between two securities.",
     "doc_id": 320
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Stationarity Condition",
     "doc_id": 320,
