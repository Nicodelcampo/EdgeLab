   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    379
   ],
   "definiciones": [
    {
     "texto": "Estrategias que no requieren análisis de microestructura pero dependen significativamente del impacto de mercado; permiten analizar grandes volúmenes de datos con algoritmos complejos.",
     "doc_id": 379
    }
   ],
   "citas": [
    {
     "texto": "Medium frequency trading strategies include all trading activities, that do not require market microstructure analysis on one side and significantly depend on market impact on the other side.",
     "doc_id": 379
    }
