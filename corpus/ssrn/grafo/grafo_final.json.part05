   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    319
   ],
   "definiciones": [
    {
     "texto": "Construcción de eigenportafolios usando PCA sobre retornos de criptomonedas para extraer factores estadísticos y aislar el componente idiosincrático (residual) de cada activo. Adaptación del enfoque de Avellaneda y Lee (2008) al mercado cripto.",
     "doc_id": 319
    }
   ],
   "citas": [
    {
     "texto": "The methodology involves constructing eigenportfolios, estimating the Ornstein-Uhlenbeck process for residual mean reversion, and implementing a walk-forward validation framework.",
     "doc_id": 319
    }
   ],
   "relaciones_crudas": [
