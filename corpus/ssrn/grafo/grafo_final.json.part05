  {
   "id": "tragedy of the common in dex",
   "nombre_canonico": "Tragedy of the commons in DEXs",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Tragedy of the commons in DEXs"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    329
   ],
   "definiciones": [
    {
     "texto": "Fallo de coordinación donde los LPs no retiran liquidez para evitar pérdidas por arbitraje porque las pérdidas se comparten entre todo el pool, pero los costos de retirada (gas fees) son individuales. Cada LP solo pujará hasta su pérdida individual esperada, que es una fracción de la ganancia total del arbitrajista.",
     "doc_id": 329
    }
   ],
   "citas": [
    {
     "texto": "This creates a 'tragedy of the commons': losses to LPs are shared across the entire liquidity pool, but an arbitrageur offering the highest gas fee captures the entire arbitrage profit from trading against the pool.",
     "doc_id": 329
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Arbitrage losses for LPs",
     "doc_id": 329,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "Efficient liquidity provision",
     "doc_id": 329,
     "revisar": false
    }
   ]
  },
