  {
   "id": "trading bloc exchange tbe",
   "nombre_canonico": "Trading Bloc Exchange (TBE)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Trading Bloc Exchange (TBE)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    354
   ],
   "definiciones": [
    {
     "texto": "Mercado unificado donde acciones, bonos, derivados, commodities y FX se comercian exclusivamente en BCUs, operando como infraestructura financiera regional.",
     "doc_id": 354
    }
   ],
   "citas": [
    {
     "texto": "The Trading Bloc Exchange operates as a unified marketplace where equities, bonds, derivatives, commodities, and foreign exchange are traded exclusively in BCUs.",
     "doc_id": 354
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Bloc Currency Unit (BCU)",
     "doc_id": 354,
