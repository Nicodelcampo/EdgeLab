     "objeto_texto": "Markovian SDE",
     "doc_id": 326,
     "revisar": true
    }
   ]
  },
  {
   "id": "open loop equilibrium control",
   "nombre_canonico": "Open-loop equilibrium control",
   "tipo": "metodo",
   "nombres_vistos": [
    "Open-loop equilibrium control"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    326
   ],
   "definiciones": [
    {
     "texto": "Formulación game-theoretical del control time-consistent donde se considera un juego secuencial con todas las encarnaciones futuras del decisor como jugadores. La estrategia de equilibrio es un Nash sub-game perfect, derivado mediante BSDEs. Extiende el framework de Hu, Jin y Zhou (2012, 2017) a sistemas no Markovianos.",
     "doc_id": 326
    }
   ],
   "citas": [
    {
     "texto": "We use the open-loop equilibrium control framework in Hu, Jin, & Zhou (2012, 2017). The open-loop method uses backward stochastic differential equations (BSDEs) to allow the uniqueness of the equilibrium to be addressed.",
     "doc_id": 326
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "RESUELVE",
     "tipo_original": "RESUELVE",
     "objeto_texto": "Time inconsistency of mean-variance",
