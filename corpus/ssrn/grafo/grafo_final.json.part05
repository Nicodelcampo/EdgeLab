   "tipo": "fenomeno",
   "nombres_vistos": [
    "Price Reversal"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    352
   ],
   "definiciones": [
    {
     "texto": "Característica distintiva del noise trading según Hasbrouck: cambios en precios asociados a noise deben ser transitorios y revertirse en el futuro.",
     "doc_id": 352
    }
   ],
   "citas": [
    {
     "texto": "Hasbrouck (1988, 1991a,b) suggest that one of the distinct features of noise trading is that its related changes should be transient.",
     "doc_id": 352
    }
   ],
   "relaciones_crudas": [
    {
