   "nombres_vistos": [
    "Race to Zero"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    365
   ],
   "definiciones": [
    {
     "texto": "Fenómeno de competencia por velocidad extrema en trading algorítmico que plantea desafíos regulatorios sobre volatilidad de mercado en plataformas digitales.",
     "doc_id": 365
    }
   ],
   "citas": [
    {
     "texto": "This brings a new challenge to regulation in this type of digital markets, specially concerned with the market volatility under 'the race to zero'.",
     "doc_id": 365
    }
   ],
   "relaciones_crudas": [
