  },
  {
   "id": "patient technical trader ptt",
   "nombre_canonico": "Patient Technical Traders (PTT)",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Patient Technical Traders (PTT)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    328
   ],
   "definiciones": [
    {
     "texto": "Traders técnicos que siguen la dirección de la señal pero envían únicamente limit orders en lugar de órdenes que toman liquidez. No pagan el spread por inmediatez y compiten con otras limit orders por prioridad de precio y tiempo.",
     "doc_id": 328
    }
   ],
   "citas": [
    {
     "texto": "Patient technical traders (PTT) follow the same process but they submit limit orders instead of liquidity-taking orders. Those traders do not pay the spread for immediacy and compete with other limit orders to gain price and time priority.",
     "doc_id": 328
    }
   ],
