   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    366
   ],
   "definiciones": [
    {
     "texto": "Estructura de FinRL: capa inferior de entornos (simula mercados con datos históricos), capa intermedia de agentes (algoritmos DRL), y capa superior de aplicaciones (tareas de trading).",
     "doc_id": 366
    }
   ],
   "citas": [
    {
     "texto": "Embodied as a three-layer architecture with modular structures, FinRL implements fine-tuned state-of-the-art DRL algorithms.",
     "doc_id": 366
    }
   ],
   "relaciones_crudas": [
