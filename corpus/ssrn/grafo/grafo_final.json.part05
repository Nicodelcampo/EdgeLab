    328
   ],
   "definiciones": [
    {
     "texto": "Traders informados que operan agresivamente en la dirección dominante evaluada mediante trade imbalance, enviando market y marketable limit orders de compra cuando el signed trade imbalance > 40% y de venta cuando < -40%.",
     "doc_id": 328
