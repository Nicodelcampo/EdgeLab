   ],
   "definiciones": [
    {
     "texto": "Asignación normalizada de órdenes q̃t = qt/Q que debe igualar el perfil de volumen de mercado Ṽt; el error entre ambos constituye el slippage de asignación de volumen.",
     "doc_id": 371
    }
   ],
   "citas": [
    {
