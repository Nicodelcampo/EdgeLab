   "tipo": "metrica",
   "nombres_vistos": [
    "High-Frequency Quote Updates (HFQU)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    356
   ],
   "definiciones": [
    {
     "texto": "Medida de actividad HFT que captura actualizaciones de cotización de alta frecuencia; post-A10 se concentra en el minuto exacto antes de la pausa y después de la reanudación.",
     "doc_id": 356
    }
   ],
   "citas": [
    {
     "texto": "For high-frequency quote updates HFQU, there are a dozen significant 1-minute bins that show an increase from the base bin level an hour before trading pauses.",
     "doc_id": 356
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "High-Frequency Trading (HFT) Activity",
     "doc_id": 356,
     "revisar": false
    }
   ]
  },
  {
   "id": "percentage quoted spread",
   "nombre_canonico": "Percentage Quoted Spread",
   "tipo": "metrica",
   "nombres_vistos": [
    "Percentage Quoted Spread"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    356
   ],
   "definiciones": [
    {
     "texto": "Medida de liquidez que mejora desde 14 minutos antes de las pausas en la era pre-A10; post-A10, la mejora de liquidez es menos de la mitad en magnitud.",
     "doc_id": 356
    }
   ],
   "citas": [
    {
     "texto": "Liquidity measured by percentage quoted spread starts to improve from 14 minutes before trading pauses till 2 minutes before trading pauses.",
     "doc_id": 356
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Market Liquidity",
     "doc_id": 356,
     "revisar": false
    }
   ]
  },
  {
   "id": "highlow volatility",
   "nombre_canonico": "HighLow Volatility",
   "tipo": "metrica",
   "nombres_vistos": [
    "HighLow Volatility"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    356
   ],
   "definiciones": [
    {
     "texto": "Medida de volatilidad de corto plazo que solo aumenta significativamente en el minuto antes de la pausa y después de la reanudación en la era pre-A10; post-A10 hay 3 bins más significativos pre-pausa y 22 más post-reanudación.",
     "doc_id": 356
    }
   ],
   "citas": [
    {
     "texto": "The short-term volatility measure HighLow only increases significantly at the minute just before trading pauses and at the minute right after trading resumes.",
     "doc_id": 356
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Volatility",
     "doc_id": 356,
