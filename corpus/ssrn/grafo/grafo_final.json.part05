   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    328
   ],
   "definiciones": [
    {
     "texto": "Categoría de traders que envían market y marketable limit orders en la dirección sugerida por una señal técnica. No envían órdenes agresivas en dirección opuesta a la señal. Representan la versión más inmediata y costosa del trading técnico.",
     "doc_id": 328
    }
   ],
   "citas": [
    {
     "texto": "Aggressive technical traders (ATT) who submit market and marketable limit orders in the direction suggested by a technical signal. They do not submit any aggressive order in the direction opposed to the signal.",
     "doc_id": 328
    }
   ],
   "relaciones_crudas": [
