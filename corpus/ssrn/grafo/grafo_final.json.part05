   "nombre_canonico": "Xetra Auction Market System (XAMS)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Xetra Auction Market System (XAMS)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    365
   ],
   "definiciones": [
    {
     "texto": "Sistema de subasta electrónica de Deutsche Boerse; subasta multi-unidad de doble lado con fase de llamada (call phase) y fase de determinación de precio; considerado modelo bottom-up con interacción de traders heterogéneos.",
     "doc_id": 365
    }
   ],
   "citas": [
    {
     "texto": "We consider the Xetra auction market system (XAMS) from 'bottom-up', which the interaction among heterogeneous traders and Xetra auction market mechanism generates non-equilibrium price dynamics.",
     "doc_id": 365
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "Electronic Security Trading Platform",
     "doc_id": 365,
     "revisar": false
    }
   ]
  },
  {
   "id": "price setter",
   "nombre_canonico": "Price Setter",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Price Setter"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    365
   ],
   "definiciones": [
    {
     "texto": "Representación de HFT con ventaja de velocidad: obtiene primera prioridad de ejecución y tiene conocimiento completo de la microestructura de Xetra, permitiéndole manipular intencionalmente el precio contra el order book central.",
     "doc_id": 365
    }
   ],
   "citas": [
    {
     "texto": "We develop the representation of HFT with speed advantage by the role of price setter that is assumed to obtain first priority for its order execution in Xetra auction market.",
     "doc_id": 365
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "High-Frequency Trading (HFT)",
     "doc_id": 365,
     "revisar": false
    },
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Market Efficiency",
     "doc_id": 365,
     "revisar": false
    }
   ]
  },
  {
   "id": "agent based model abm",
   "nombre_canonico": "Agent-Based Model (ABM)",
   "tipo": "metodo",
   "nombres_vistos": [
    "Agent-Based Model (ABM)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    365
   ],
   "definiciones": [
    {
     "texto": "Metodología de simulación con agentes heterogéneos interactuando en el mecanismo real de subasta Xetra (XAMM), usando simulación Monte Carlo para experimentos de mercado.",
     "doc_id": 365
    }
   ],
   "citas": [
    {
     "texto": "We construct the corresponding agent-based model of XAMS and conduct market experiments with the Monte Carlo computer simulation.",
     "doc_id": 365
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Xetra Auction Market System (XAMS)",
     "doc_id": 365,
     "revisar": false
    }
   ]
  },
  {
   "id": "pre trade transparency",
   "nombre_canonico": "Pre-Trade Transparency",
   "tipo": "concepto",
   "nombres_vistos": [
    "Pre-Trade Transparency"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    365
   ],
   "definiciones": [
    {
     "texto": "Transparencia pre-negociación donde traders obtienen información en tiempo real del order book central durante la call phase; supuesto razonable dado que Xetra provee los 5 mejores precios.",
     "doc_id": 365
    }
   ],
   "citas": [
    {
     "texto": "We assume pre-trade transparency as the market transparency, i.e. during the call phase, traders obtain real-time information about the central order book.",
     "doc_id": 365
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Xetra Auction Market System (XAMS)",
     "doc_id": 365,
     "revisar": false
    }
   ]
  },
  {
   "id": "xetra auction market mechanism xamm",
   "nombre_canonico": "Xetra Auction Market Mechanism (XAMM)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Xetra Auction Market Mechanism (XAMM)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    365
   ],
   "definiciones": [
    {
     "texto": "Mecanismo computacional de determinación de precio y volumen en la subasta Xetra; incluido de forma realista en el modelo ABM en lugar de usar simplificaciones de double auction continua.",
     "doc_id": 365
    }
   ],
   "citas": [
    {
     "texto": "We aim at including the actual auction market mechanism, XAMM. The inclusion of XAMM has influences in two aspects: XAMM determines the trading price and trading volume in market dynamics.",
     "doc_id": 365
    }
   ],
   "relaciones_crudas": [
