   "doc_ids": [
    349
   ],
   "definiciones": [
    {
     "texto": "Uso de inteligencia artificial y machine learning para mejorar la supervisión del mercado, aunque también puede emplearse con fines maliciosos perpetuando prácticas como front-running y spoofing.",
     "doc_id": 349
    }
   ],
   "citas": [
    {
     "texto": "Using artificial intelligence solutions ('AI'), such as machine learning, to improve market surveillance.",
     "doc_id": 349
    }
   ],
   "relaciones_crudas": [
    {
