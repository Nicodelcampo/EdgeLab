     "tipo_original": "REQUIERE",
     "objeto_texto": "Characteristic matrix Delta(lambda)",
     "doc_id": 326,
     "revisar": false
    }
   ]
  },
  {
   "id": "characteristic matrix and spectrum",
   "nombre_canonico": "Characteristic matrix and spectrum",
   "tipo": "metodo",
   "nombres_vistos": [
    "Characteristic matrix and spectrum"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    326
   ],
   "definiciones": [
    {
     "texto": "Matriz característica Delta(lambda) = lambda*I - H - integral e^{lambda*u} K(u)du + e^{-lambda*p} M. El espectro sigma(H,K,M) = {lambda: det[Delta(lambda)]=0} determina la estabilidad asintótica y las condiciones para statistical arbitrage. Tiene un número infinito numerable de raíces (eigenvalues).",
     "doc_id": 326
    }
   ],
   "citas": [
    {
     "texto": "Define the characteristic matrix Delta(lambda) = lambda*I - H - integral_{-p}^{0} e^{lambda u} K(u)du + e^{-lambda p} M and the spectrum sigma(H,K,M) := {lambda in C; det[Delta(lambda)] = 0}.",
     "doc_id": 326
    }
   ],
   "relaciones_crudas": [
    {
