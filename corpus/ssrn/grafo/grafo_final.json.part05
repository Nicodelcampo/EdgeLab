   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    319
   ],
   "definiciones": [
    {
     "texto": "Universo de trading dinámico con filtros: exclusión de special coins (stablecoins, wrapped tokens), selección por EWMA de market cap, filtro de volumen medio de trading mínimo, y filtro de shocks negativos para evitar activos en distress.",
     "doc_id": 319
    }
   ],
   "citas": [
    {
     "texto": "Dynamic trading universe includes special coins exclusion, exponential weighted moving average and market cap filter, median trading volume filter, and negative shock filter.",
     "doc_id": 319
