  {
   "id": "opening reference price",
   "nombre_canonico": "Opening Reference Price",
   "tipo": "dato",
   "nombres_vistos": [
    "Opening Reference Price"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    356
   ],
   "definiciones": [
    {
     "texto": "Precio de referencia inicial que antes del A10 podía ser el midquote de best bid/ask, causando bandas de precio poco realistas; post-A10 se usa el precio de cierre del día anterior.",
     "doc_id": 356
    }
   ],
   "citas": [
    {
     "texto": "The initial reference price is decided by the first trade price of a stock on its primary listing exchange if that trade occurs within 5 minutes from market opening.",
     "doc_id": 356
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
