     "tipo_original": "USA",
     "objeto_texto": "Backward Stochastic Differential Equation (BSDE)",
     "doc_id": 326,
     "revisar": false
    }
   ]
  },
  {
   "id": "fundamental matrix solution y 0",
   "nombre_canonico": "Fundamental matrix solution (y_0)",
   "tipo": "metodo",
   "nombres_vistos": [
    "Fundamental matrix solution (y_0)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    326
   ],
   "definiciones": [
    {
     "texto": "Solución a la functional differential equation autónoma asociada: dy_0/dt = Hy_0(t) + integral K(u)y_0(t+u)du - My_0(t-p), con condición inicial y_0(0)=I_n. Permite representar la solución de la SDDE como Y(t) = a(t) + y_1(t) + integral y_0(t-s)Sigma dW(s).",
     "doc_id": 326
    }
   ],
   "citas": [
    {
     "texto": "y_0 is called the fundamental matrix solution. It is clear that for t > p, y_0(t) is continuously differentiable.",
     "doc_id": 326
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Risk premium representation",
     "doc_id": 326,
