    }
   ]
  },
  {
   "id": "digital transformation",
   "nombre_canonico": "Digital Transformation",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Digital Transformation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    353
   ],
   "definiciones": [
    {
     "texto": "Transformación digital de la economía que el sistema de comercio aún no ha asimilado, quedando completamente desprevenido para los grandes sistemas de IA emergentes.",
     "doc_id": 353
    }
   ],
   "citas": [
    {
     "texto": "The trade system has not yet caught up with the digital transformation, appears to be entirely unprepared to deal with the large powerful AI systems now emerging.",
     "doc_id": 353
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "AI Governance",
     "doc_id": 353,
