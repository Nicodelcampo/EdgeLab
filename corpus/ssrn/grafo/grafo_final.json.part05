  {
   "id": "statistical arbitrage condition",
   "nombre_canonico": "Statistical arbitrage conditions",
   "tipo": "concepto",
   "nombres_vistos": [
    "Statistical arbitrage conditions"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    326
   ],
   "definiciones": [
    {
     "texto": "Condiciones de Hogan, Jarrow, Teo y Warachka (2004): (i) costo inicial cero, (ii) ganancia esperada positiva en el límite, (iii) probabilidad de pérdida converge a 0, (iv) varianza time-averaged converge a 0. El paper demuestra que la estrategia de equilibrio bajo SDDE las satisface si los eigenvalues tienen parte real no positiva.",
     "doc_id": 326
    }
   ],
   "citas": [
    {
     "texto": "We rigorously prove that our equilibrium strategy leads to statistical arbitrage when the eigenvalues of the AFDEs satisfy certain conditions.",
     "doc_id": 326
    }
   ],
