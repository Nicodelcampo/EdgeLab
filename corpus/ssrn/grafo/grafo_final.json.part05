    357
   ],
   "definiciones": [
    {
     "texto": "Modelo formal que integra un equilibrio espacial de geografía económica con un modelo de elección de plataforma por parte de incumbentes políticos.",
     "doc_id": 357
    }
   ],
   "citas": [
    {
     "texto": "I then present the formal model, which embeds a spatial equilibrium model from economic geography within a formal model of incumbents choosing party platforms.",
     "doc_id": 357
    }
   ],
