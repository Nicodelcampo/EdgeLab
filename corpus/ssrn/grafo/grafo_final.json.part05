   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    375
   ],
   "definiciones": [
    {
     "texto": "Supuesto sesgo conductual de vender ganadores y mantener perdedores; el paper demuestra que es un artefacto de la metodología C-T, no un fenómeno real; los locales compran bajo y venden alto.",
     "doc_id": 375
    }
   ],
   "citas": [
    {
     "texto": "The supposed 'disposition effect' simply a by-product of superior information.",
     "doc_id": 375
    }
