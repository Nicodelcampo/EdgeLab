     "doc_id": 355
    }
   ],
   "citas": [
    {
     "texto": "Her flagship fund, ARK Innovation (ticker: ARKK) has gone from $2.0 billion in assets under management in January 2020 to $18.3 billion in November 2021.",
     "doc_id": 355
    }
