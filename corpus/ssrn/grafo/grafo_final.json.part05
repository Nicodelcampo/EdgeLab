  {
   "id": "calendar time c t methodology",
   "nombre_canonico": "Calendar-Time (C-T) Methodology",
   "tipo": "metodo",
   "nombres_vistos": [
    "Calendar-Time (C-T) Methodology"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    375
   ],
   "definiciones": [
    {
     "texto": "Metodología dominante que mide rendimiento en intervalos calendario marcando a mercado activos no vendidos; ignora el destino de inversiones previas y reduce un problema multiperíodo a intervalos de un período.",
     "doc_id": 375
    }
   ],
   "citas": [
    {
     "texto": "The C-T methodology only records the investor's portfolio over sequences of the designated interval, with all earlier portfolio additions discarded. Hence, the fate of earlier investments remains unrecorded.",
     "doc_id": 375
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CONTRADICE_A",
     "tipo_original": "CONTRADICE_A",
