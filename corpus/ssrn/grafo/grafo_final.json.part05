  {
   "id": "ou closed form discretization",
   "nombre_canonico": "OU Closed-Form Discretization",
   "tipo": "metodo",
   "nombres_vistos": [
    "OU Closed-Form Discretization"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    319
   ],
   "definiciones": [
    {
     "texto": "Discretización exacta (closed-form) del proceso OU para estimación de parámetros, superior al enfoque naive de Euler. Permite estimar correctamente el mean-reversion time y generar señales de trading más precisas que la discretización aproximada.",
     "doc_id": 319
    }
   ],
   "citas": [
    {
     "texto": "Exact Approach: Closed-Form Discretization and Parameter Estimation for the Ornstein-Uhlenbeck process, used instead of the naive Euler discretization.",
     "doc_id": 319
    }
   ],
