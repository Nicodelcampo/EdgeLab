  {
   "id": "synthetic portfolio",
   "nombre_canonico": "Synthetic Portfolio",
   "tipo": "metodo",
   "nombres_vistos": [
    "Synthetic Portfolio"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    355
   ],
   "definiciones": [
    {
     "texto": "Portafolio sintético estático construido manteniendo constante la cartera durante un mes basado en las tenencias del primer día de trading de cada mes, para aislar el efecto del trading activo.",
     "doc_id": 355
    }
   ],
   "citas": [
    {
     "texto": "I create synthetic portfolios that do not trade based on the daily holdings information by holding the portfolio constant for one month based on the holdings of the portfolio on the first day of trading for each month.",
     "doc_id": 355
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Active ETF",
     "doc_id": 355,
     "revisar": false
    }
   ]
  },
  {
   "id": "alpha decomposition",
   "nombre_canonico": "Alpha Decomposition",
   "tipo": "metodo",
   "nombres_vistos": [
    "Alpha Decomposition"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    355
   ],
   "definiciones": [
    {
     "texto": "Descomposición del alpha de fondos activos en componente de selección de acciones (stock picking) y componente de trading activo, comparando retornos reales con portafolios sintéticos.",
     "doc_id": 355
    }
   ],
   "citas": [
    {
     "texto": "I seek to determine whether actively managed ETF performance is attributable to picking and holding stocks, actively trading positions, or both.",
     "doc_id": 355
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Active ETF",
     "doc_id": 355,
     "revisar": false
    }
   ]
  },
  {
   "id": "stock picking",
   "nombre_canonico": "Stock Picking",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Stock Picking"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    355
   ],
   "definiciones": [
    {
     "texto": "Habilidad de seleccionar acciones ganadoras como fuente de alpha; el paper encuentra que es el principal driver del rendimiento de ARK, no el trading activo.",
     "doc_id": 355
    }
   ],
   "citas": [
    {
     "texto": "I find that active trading on average reduces ARK's one-month returns by 1.36 percentage points.",
     "doc_id": 355
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Active ETF",
     "doc_id": 355,
     "revisar": false
    }
   ]
  },
  {
