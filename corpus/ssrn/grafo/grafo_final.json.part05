  {
   "id": "margin account",
   "nombre_canonico": "Margin Account",
   "tipo": "concepto",
   "nombres_vistos": [
    "Margin Account"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    380
   ],
   "definiciones": [
    {
     "texto": "Cuenta de corretaje que permite usar margen para apalancar posiciones; regulada por Regulation T en EE.UU. con margen típico de 50% para cuentas individuales.",
     "doc_id": 380
    }
   ],
   "citas": [
    {
     "texto": "A margin account is brokerage account that is allowed to use margin in order to leverage its investment positions.",
     "doc_id": 380
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Leverage",
     "doc_id": 380,
     "revisar": false
    }
   ]
  },
  {
   "id": "strategic asset allocation",
   "nombre_canonico": "Strategic Asset Allocation",
   "tipo": "concepto",
   "nombres_vistos": [
    "Strategic Asset Allocation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    380
   ],
   "definiciones": [
    {
     "texto": "Asignación estratégica predefinida que especifica qué valores comerciar, peso objetivo post-trading y exposición (long/short) de cada valor en el portafolio.",
     "doc_id": 380
    }
   ],
   "citas": [
    {
     "texto": "The output of the strategic allocation consists of a list of securities to trade, the target weight of each security in the portfolio post trading, as well as the exposure of each security.",
     "doc_id": 380
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Algorithmic Trading",
     "doc_id": 380,
     "revisar": false
    }
   ]
  },
  {
   "id": "regulation t reg t",
   "nombre_canonico": "Regulation T (Reg T)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Regulation T (Reg T)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    380
   ],
   "definiciones": [
    {
     "texto": "Regulación estadounidense que controla el uso de margen para cuentas individuales con límite típico de 50%, permitiendo controlar un nocional del doble del valor neto.",
     "doc_id": 380
    }
   ],
   "citas": [
    {
     "texto": "In the United States, brokerages will usually authorize margin on a non-retirement account invested in equities of up to Reg. T margin of 50%.",
     "doc_id": 380
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Margin Account",
     "doc_id": 380,
     "revisar": false
    }
   ]
  },
  {
   "id": "notional value",
   "nombre_canonico": "Notional Value",
   "tipo": "metrica",
   "nombres_vistos": [
    "Notional Value"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    380
   ],
   "definiciones": [
    {
     "texto": "Valor nocional E = A + L (net asset value + leverage), que representa el capital total controlado por la cuenta.",
     "doc_id": 380
    }
   ],
   "citas": [
    {
     "texto": "By definition, the notional investment equals the sum of the net asset value and the borrowed amount.",
     "doc_id": 380
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Leverage",
     "doc_id": 380,
     "revisar": false
    }
   ]
  },
  {
   "id": "buying power",
   "nombre_canonico": "Buying Power",
   "tipo": "metrica",
   "nombres_vistos": [
    "Buying Power"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    380
   ],
   "definiciones": [
    {
     "texto": "Poder de compra = $2,000 para una cuenta de $1,000 con margen 50%, representando el nocional máximo desplegable.",
     "doc_id": 380
    }
   ],
   "citas": [
    {
     "texto": "An account with 50% margin can deploy a notional amount equal to twice its net asset value.",
     "doc_id": 380
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Leverage",
     "doc_id": 380,
     "revisar": false
    }
   ]
  },
  {
   "id": "agency intermediation",
   "nombre_canonico": "Agency Intermediation",
   "tipo": "concepto",
   "nombres_vistos": [
    "Agency Intermediation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    381
   ],
   "definiciones": [
    {
     "texto": "Intermediación donde brokers ejecutan trades en nombre de inversores ganando comisiones sin tomar riesgo de inventario; requiere monitoreo por parte del cliente.",
     "doc_id": 381
    }
   ],
   "citas": [
    {
     "texto": "In the former, intermediaries serve as brokers, earn commissions, and execute trades on behalf of investors without taking inventory risk.",
     "doc_id": 381
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "Principal Intermediation",
     "doc_id": 381,
     "revisar": false
    }
   ]
  },
  {
   "id": "principal intermediation",
   "nombre_canonico": "Principal Intermediation",
   "tipo": "concepto",
   "nombres_vistos": [
    "Principal Intermediation"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    381
   ],
   "definiciones": [
    {
     "texto": "Intermediación donde dealers comercian contra inversores ganando markups y asumiendo riesgo de inventario; internaliza resultados de ejecución.",
     "doc_id": 381
    }
   ],
   "citas": [
    {
     "texto": "In the latter, intermediaries serve as dealers, earn markups, and take on inventory risk.",
     "doc_id": 381
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "Agency Intermediation",
     "doc_id": 381,
     "revisar": false
    }
   ]
  },
  {
   "id": "market transparency",
   "nombre_canonico": "Market Transparency",
   "tipo": "concepto",
   "nombres_vistos": [
    "Market Transparency"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    381
   ],
   "definiciones": [
    {
     "texto": "Grado en que cotizaciones y trades son reportados públicamente; mercados totalmente transparentes (equities, futures) dominados por agency; opacos (fixed income) por principal.",
     "doc_id": 381
    }
   ],
   "citas": [
    {
     "texto": "Agency intermediation will dominate markets with high transparency and turnover.",
     "doc_id": 381
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Agency Intermediation",
     "doc_id": 381,
     "revisar": false
    }
   ]
  },
  {
   "id": "dealer inventory cost",
   "nombre_canonico": "Dealer Inventory Cost",
   "tipo": "metrica",
   "nombres_vistos": [
    "Dealer Inventory Cost"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    381
   ],
   "definiciones": [
    {
     "texto": "Costo de mantener inventario para dealers; su aumento (ej. por regulaciones de capital post-2008) induce sustitución endógena hacia intermediación agency.",
     "doc_id": 381
    }
   ],
   "citas": [
    {
     "texto": "When dealer inventory cost increases, agency intermediation will rise endogenously.",
     "doc_id": 381
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Agency Intermediation",
     "doc_id": 381,
     "revisar": false
    }
   ]
  },
  {
   "id": "monitoring cost",
   "nombre_canonico": "Monitoring Cost",
   "tipo": "metrica",
   "nombres_vistos": [
    "Monitoring Cost"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    381
   ],
   "definiciones": [
    {
     "texto": "Costo de monitorear brokers que no internalizan resultados de ejecución; más efectivo en mercados transparentes con suficiente turnover observable.",
     "doc_id": 381
    }
   ],
   "citas": [
    {
     "texto": "Customers need to monitor brokers, and monitoring is more effective when market is transparent.",
     "doc_id": 381
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Agency Intermediation",
     "doc_id": 381,
     "revisar": false
    }
   ]
  },
  {
   "id": "fundamental trader",
   "nombre_canonico": "Fundamental Trader",
   "tipo": "concepto",
   "nombres_vistos": [
    "Fundamental Trader"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    382
   ],
   "definiciones": [
    {
     "texto": "Trader que opera en baja frecuencia (períodos 1 y 3) con capacidad de recolectar y procesar información costosa sobre el valor del activo; ajusta estrategia ante presencia de HFT.",
     "doc_id": 382
    }
   ],
   "citas": [
    {
     "texto": "There is a fundamental trader who can trade only at a low frequency but who has the necessary means to collect and process costly information about the asset value.",
     "doc_id": 382
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "High-Frequency Trader (HFT)",
     "doc_id": 382,
     "revisar": false
    }
   ]
  },
  {
   "id": "hft information type",
   "nombre_canonico": "HFT Information Types",
   "tipo": "concepto",
   "nombres_vistos": [
    "HFT Information Types"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    382
   ],
   "definiciones": [
    {
     "texto": "Dos tipos: (1) información correlacionada con actividad de trading pasada del fundamental (order book data) - induce ajuste defensivo; (2) señal correlacionada con su información privada - no induce ajuste.",
     "doc_id": 382
    }
   ],
   "citas": [
    {
     "texto": "If this information is correlated with the fundamental trader's past trading activities... the latter will strongly adjust both information collection and trading decisions. However, if the high frequency trader observes a signal correlated with the information of the fundamental trader... the decisions of the fundamental trader are little affected.",
     "doc_id": 382
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Price Informativeness",
     "doc_id": 382,
     "revisar": false
    }
   ]
  },
  {
   "id": "price informativeness vs price efficiency",
   "nombre_canonico": "Price Informativeness vs Price Efficiency",
   "tipo": "metrica",
   "nombres_vistos": [
    "Price Informativeness vs Price Efficiency"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    382
   ],
   "definiciones": [
    {
     "texto": "Informatividad mide cuánto del valor fundamental producible reflejan los precios; eficiencia mide cuánto de la información producida se incorpora. Pueden divergir en el tiempo.",
     "doc_id": 382
    }
   ],
   "citas": [
    {
     "texto": "Both measures might diverge over time: prices might incorporate more produced information, but they might reflect the asset value less well eventually.",
     "doc_id": 382
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Market Quality",
     "doc_id": 382,
     "revisar": false
    }
   ]
  },
  {
   "id": "information production",
   "nombre_canonico": "Information Production",
   "tipo": "concepto",
   "nombres_vistos": [
    "Information Production"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    382
   ],
   "definiciones": [
    {
     "texto": "Decisión del trader fundamental sobre la precisión de su señal privada; puede reducirse ante HFT que observa actividad pasada porque producir información se vuelve menos rentable.",
     "doc_id": 382
    }
   ],
   "citas": [
    {
     "texto": "He might reduce the precision of his signal... producing fundamental information becomes less profitable compared to the benchmark.",
     "doc_id": 382
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Fundamental Trader",
     "doc_id": 382,
     "revisar": false
    }
   ]
  },
  {
   "id": "opportunistic imbalancing",
   "nombre_canonico": "Opportunistic Imbalancing",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Opportunistic Imbalancing"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    383
   ],
   "definiciones": [
    {
     "texto": "Estrategia de agentes que anticipan la dirección del desbalance del sistema para beneficiarse: si el sistema está corto, generar/spillear extra para vender al precio de desbalance más alto.",
     "doc_id": 383
    }
   ],
   "citas": [
    {
     "texto": "By attempting to profit from 'opportunistic imbalancing,' active participants would seek to correctly anticipate the direction of system imbalance and would effectively be undertaking statistical arbitrage.",
     "doc_id": 383
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Statistical Arbitrage",
     "doc_id": 383,
     "revisar": false
    }
   ]
  },
  {
   "id": "single price settlement",
   "nombre_canonico": "Single Price Settlement",
   "tipo": "concepto",
   "nombres_vistos": [
    "Single Price Settlement"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    383
   ],
   "definiciones": [
    {
     "texto": "Sistema de liquidación de precio único para desbalances que crea incentivos para arbitraje estadístico; contrasta con sistemas de precio dual diseñados para desincentivar el imbalancing oportunista.",
     "doc_id": 383
    }
   ],
   "citas": [
    {
     "texto": "The first pre-condition to attract this statistical arbitrage is evidently a single price settlement process.",
     "doc_id": 383
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Opportunistic Imbalancing",
     "doc_id": 383,
     "revisar": false
    }
   ]
  },
  {
   "id": "dual settlement price",
   "nombre_canonico": "Dual Settlement Prices",
   "tipo": "concepto",
   "nombres_vistos": [
    "Dual Settlement Prices"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    383
   ],
   "definiciones": [
    {
     "texto": "Precios de liquidación dual que representan costos distintos de compra y venta del operador; aplicados en Francia, España e Italia para desincentivar el imbalancing oportunista.",
     "doc_id": 383
    }
   ],
   "citas": [
    {
     "texto": "Dual settlement prices are generally applied in order to deter the opportunistic imbalancing.",
     "doc_id": 383
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "Single Price Settlement",
     "doc_id": 383,
     "revisar": false
    }
   ]
  },
  {
   "id": "hft identification criteria",
   "nombre_canonico": "HFT Identification Criteria",
   "tipo": "metodo",
   "nombres_vistos": [
    "HFT Identification Criteria"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    384
   ],
   "definiciones": [
    {
     "texto": "Tres criterios: alto switching rate, inventario cero overnight 4 de 5 días, y vida media de orden menor a 1 minuto.",
     "doc_id": 384
    }
   ],
   "citas": [
    {
     "texto": "A high switching rate, a zero overnight inventory four days out of five, and an average order lifetime of less than one minute.",
     "doc_id": 384
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "DEFINE",
     "tipo_original": "DEFINE",
     "objeto_texto": "High-Frequency Trader (HFT)",
     "doc_id": 384,
     "revisar": true
    }
   ]
  },
  {
   "id": "insider trading constraint",
   "nombre_canonico": "Insider Trading Constraints",
   "tipo": "concepto",
   "nombres_vistos": [
    "Insider Trading Constraints"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    386
   ],
   "definiciones": [
    {
     "texto": "Restricciones unilaterales mínimas (short-selling constraints, minimum buying level) que ponen un piso a precios y cambian la sensibilidad de la función de pricing del market maker al order flow.",
     "doc_id": 386
    }
   ],
   "citas": [
    {
     "texto": "The constraints put a floor on price distribution and reduce its volatility.",
     "doc_id": 386
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Price Floor",
     "doc_id": 386,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Kyle (1985) Model",
     "doc_id": 386,
     "revisar": false
    }
   ]
  },
  {
   "id": "asymmetric price sensitivity",
   "nombre_canonico": "Asymmetric Price Sensitivity",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Asymmetric Price Sensitivity"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    386
   ],
   "definiciones": [
    {
     "texto": "Fenómeno donde la función de pricing tiene sensibilidad no constante al order flow: órdenes de venta impactan el precio menos que las de compra debido a restricciones al insider.",
     "doc_id": 386
    }
   ],
   "citas": [
    {
     "texto": "The market maker's pricing function has non-constant sensitivity to order flows, with selling orders impacting the price less than positive orders.",
     "doc_id": 386
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Price Floor",
     "doc_id": 386,
     "revisar": false
    }
   ]
  },
  {
   "id": "short term shareholder",
   "nombre_canonico": "Short-Term Shareholders",
   "tipo": "concepto",
   "nombres_vistos": [
    "Short-Term Shareholders"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    386
   ],
   "definiciones": [
    {
     "texto": "Shareholders que valoran el precio de mercado más allá del valor fundamental; su aversión al riesgo sobre volatilidad interim determina el nivel óptimo de restricciones.",
     "doc_id": 386
    }
   ],
   "citas": [
    {
     "texto": "I define 'short-term shareholders' to be those whose valuation depends on prices in a way that departs from fundamentals.",
     "doc_id": 386
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Insider Trading Constraints",
     "doc_id": 386,
     "revisar": false
    }
   ]
  },
  {
   "id": "quadratic approximation of pricing function",
   "nombre_canonico": "Quadratic Approximation of Pricing Function",
   "tipo": "metodo",
   "nombres_vistos": [
    "Quadratic Approximation of Pricing Function"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    386
   ],
   "definiciones": [
    {
     "texto": "Aproximación cuadrática que caracteriza la estrategia de equilibrio del market maker casi completamente dentro de dos desviaciones estándar del order flow.",
     "doc_id": 386
    }
   ],
   "citas": [
    {
     "texto": "A quadratic approximation of the price function can characterize the market maker's equilibrium strategy and insider almost entirely within two standard deviations of the order flows.",
     "doc_id": 386
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Kyle (1985) Model",
     "doc_id": 386,
     "revisar": false
    }
   ]
  },
  {
   "id": "conditional irrelevance result",
   "nombre_canonico": "Conditional Irrelevance Result",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Conditional Irrelevance Result"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    387
   ],
   "definiciones": [
    {
     "texto": "Resultado de irrelevancia condicional: tomando como dada la fracción de informados, RPE es independiente del nivel de delays. Se rompe cuando la adquisición de información es endógena.",
     "doc_id": 387
    }
   ],
   "citas": [
    {
     "texto": "By taking as given the fraction of informed traders, revelatory price efficiency (RPE) is independent of the level of trading delays.",
     "doc_id": 387
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Trading Delays",
     "doc_id": 387,
     "revisar": false
    }
   ]
  },
  {
   "id": "price dispersion hump shaped",
   "nombre_canonico": "Price Dispersion (Hump-Shaped)",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Price Dispersion (Hump-Shaped)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    387
   ],
   "definiciones": [
    {
     "texto": "Dispersión de precios con forma de joroba respecto a delays: baja con delays pequeños, sube con delays moderados (traders acceden en tiempos dispersos), y baja con delays severos (información ya revelada).",
     "doc_id": 387
    }
   ],
   "citas": [
    {
     "texto": "Price dispersion is non-monotonic in trading delays... price dispersion turns out to be a hump-shaped function of trading delays.",
     "doc_id": 387
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Trading Delays",
     "doc_id": 387,
     "revisar": false
    }
   ]
  },
  {
   "id": "grossman stiglitz extension",
   "nombre_canonico": "Grossman-Stiglitz Extension",
   "tipo": "metodo",
   "nombres_vistos": [
    "Grossman-Stiglitz Extension"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    387
   ],
   "definiciones": [
    {
     "texto": "Extensión dinámica del modelo Grossman-Stiglitz donde traders ganan acceso único al mercado en tiempos estocásticos i.i.d. con delays uniformes para informados y no informados.",
     "doc_id": 387
    }
   ],
   "citas": [
    {
     "texto": "We develop a competitive asset trading model that nests Grossman and Stiglitz (1980) as a special case.",
     "doc_id": 387
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Trading Delays",
     "doc_id": 387,
     "revisar": false
    }
   ]
  },
  {
   "id": "shadow trading",
   "nombre_canonico": "Shadow Trading",
   "tipo": "concepto",
   "nombres_vistos": [
    "Shadow Trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    388
   ],
   "definiciones": [
    {
     "texto": "Teoría de responsabilidad por insider trading donde un insider usa información material no pública de su empresa para comerciar acciones de otra empresa comparable, no de la propia.",
     "doc_id": 388
    }
   ],
   "citas": [
    {
     "texto": "The SEC uses the 'shadow trading' theory of liability.",
     "doc_id": 388
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Insider Trading Law",
     "doc_id": 388,
     "revisar": false
    }
   ]
  },
  {
   "id": "section 10 b of securitie exchange act 1934",
   "nombre_canonico": "Section 10(b) of Securities Exchange Act 1934",
   "tipo": "concepto",
   "nombres_vistos": [
    "Section 10(b) of Securities Exchange Act 1934"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    388
   ],
   "definiciones": [
    {
     "texto": "Disposición general anti-fraude usada por el SEC como base legal amplia para persecución de insider trading ante ausencia de régimen estatutario explícito.",
     "doc_id": 388
    }
   ],
   "citas": [
    {
     "texto": "Section 10(b) of the 1934 Act, which is a general anti-fraud provision that makes it unlawful to use any manipulative or deceptive device in connection with the purchase or sale of any security.",
     "doc_id": 388
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Insider Trading Law",
     "doc_id": 388,
     "revisar": false
    }
   ]
  },
  {
   "id": "section 16 short swing trading",
   "nombre_canonico": "Section 16 (Short Swing Trading)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Section 16 (Short Swing Trading)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    388
   ],
   "definiciones": [
    {
     "texto": "Única provisión expresa sobre insider trading en el Securities Exchange Act de 1934; limitada a compra/venta dentro de 6 meses por ciertos insiders; no aplicable por el SEC.",
     "doc_id": 388
    }
   ],
   "citas": [
    {
     "texto": "The only provision that expressly pertains to insider trading in the 1934 Act is Section 16. And it only focuses on short swing trading.",
     "doc_id": 388
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Insider Trading Law",
     "doc_id": 388,
     "revisar": false
    }
   ]
  },
  {
   "id": "option pair trading",
   "nombre_canonico": "Options Pairs Trading",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Options Pairs Trading"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    389
   ],
   "definiciones": [
    {
     "texto": "Estrategia de pares aplicada a opciones usando Black-Scholes para construir portafolios de opciones por pares que dependen solo de volatilidad de mercado.",
     "doc_id": 389
    }
   ],
   "citas": [
    {
     "texto": "We create alternative volatility-managed portfolios via options pairs trading. Using the seminal Black-Scholes model, we construct pairwise options portfolios that are only dependent on market volatility.",
     "doc_id": 389
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Volatility Management",
     "doc_id": 389,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Pairs Trading",
     "doc_id": 389,
     "revisar": false
    }
   ]
  },
  {
   "id": "microstructure effect on volatility",
   "nombre_canonico": "Microstructure Effects on Volatility",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Microstructure Effects on Volatility"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    389
   ],
   "definiciones": [
    {
     "texto": "Efectos de microestructura (intraday price bounce, price dispersion, price impact, realized volatility) que impactan significativamente estimaciones de volatilidad y persisten en el tiempo.",
     "doc_id": 389
    }
   ],
   "citas": [
    {
     "texto": "Microstructure factors exhibit persistence and can be effectively utilized to create profitable strategies.",
     "doc_id": 389
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Volatility",
     "doc_id": 389,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Options Pairs Trading",
     "doc_id": 389,
     "revisar": false
    }
   ]
  },
  {
   "id": "ols vs neural network",
   "nombre_canonico": "OLS vs Neural Networks",
   "tipo": "metodo",
   "nombres_vistos": [
    "OLS vs Neural Networks"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    389
   ],
   "definiciones": [
    {
     "texto": "OLS lineal supera a redes neuronales en predicción de volatilidad para esta aplicación de options pairs trading, desafiando la tendencia hacia métodos de IA complejos.",
     "doc_id": 389
    }
   ],
   "citas": [
    {
     "texto": "While AI-based prediction using Neural Networks is explored, we find that simple OLS linear regressions outperform in the specific application considered.",
     "doc_id": 389
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
