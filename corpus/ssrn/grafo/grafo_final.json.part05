  {
   "id": "single stock circuit breaker sscb",
   "nombre_canonico": "Single-Stock Circuit Breaker (SSCB)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Single-Stock Circuit Breaker (SSCB)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    356
   ],
   "definiciones": [
    {
     "texto": "Predecesor del LULD introducido por SEC y FINRA en junio 2010 tras el Flash Crash, reemplazado gradualmente desde abril 2013.",
     "doc_id": 356
    }
   ],
   "citas": [
    {
     "texto": "Its predecessor is the single-stock circuit breaker (SSCB) mechanism which was introduced by SEC and FINRA in June 2010.",
     "doc_id": 356
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Limit Up-Limit Down (LULD) Plan",
     "doc_id": 356,
     "revisar": false
    }
   ]
  },
  {
   "id": "straddle state limit state",
   "nombre_canonico": "Straddle State / Limit State",
   "tipo": "concepto",
   "nombres_vistos": [
    "Straddle State / Limit State"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    356
   ],
   "definiciones": [
    {
     "texto": "Estados intermedios del plan LULD antes de alcanzar la pausa de trading; el precio debe atravesar estos estados antes de que se active una pausa.",
     "doc_id": 356
    }
   ],
   "citas": [
    {
     "texto": "The current prevailing stock-level trading pause mechanism in the US market is under the Limit Up-Limit Down (LULD) plan, which contains straddle states, limit states, trading pauses, and clearly erroneous trades.",
     "doc_id": 356
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Limit Up-Limit Down (LULD) Plan",
     "doc_id": 356,
     "revisar": false
    }
   ]
  },
  {
   "id": "trade policy realignment",
   "nombre_canonico": "Trade Policy Realignment",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Trade Policy Realignment"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    357
   ],
   "definiciones": [
    {
     "texto": "Cambio en las posiciones de partidos políticos sobre comercio internacional: la izquierda pasa de proteccionista a pro-comercio, la derecha de libre mercado a proteccionista.",
     "doc_id": 357
    }
   ],
   "citas": [
    {
     "texto": "Previously protectionist Left parties are increasingly endorsing globalization, while formerly 'free market' Right parties are increasingly becoming the parties of protectionism.",
     "doc_id": 357
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Internal Migration",
     "doc_id": 357,
     "revisar": false
    }
   ]
  },
  {
   "id": "skill biased internal migration",
