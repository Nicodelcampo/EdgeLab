    }
   ]
  },
  {
   "id": "vwap execution strategy",
   "nombre_canonico": "VWAP Execution Strategy",
   "tipo": "estrategia",
   "nombres_vistos": [
    "VWAP Execution Strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    370
   ],
   "definiciones": [
    {
     "texto": "Estrategia donde la velocidad de ejecución es proporcional al volumen de trading del activo (ζt = γ·vt); demostrada óptima para trader neutral al riesgo en el modelo AC con volumen.",
     "doc_id": 370
    }
   ],
   "citas": [
    {
     "texto": "The execution speed of the VWAP strategy is proportional to the trading volume of the relevant security.",
     "doc_id": 370
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "Optimal Execution Strategy",
     "doc_id": 370,
     "revisar": false
    }
   ]
  },
  {
   "id": "temporary market impact mi",
   "nombre_canonico": "Temporary Market Impact (MI)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Temporary Market Impact (MI)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    370
   ],
   "definiciones": [
    {
     "texto": "Efecto del comportamiento de inversión del trader sobre los precios; en el modelo AC generalizado, la función de MI temporal es afectada por el volumen de trading.",
     "doc_id": 370
    }
   ],
   "citas": [
    {
     "texto": "The temporary MI function is affected by the trading volume.",
     "doc_id": 370
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Almgren-Chriss Model",
     "doc_id": 370,
     "revisar": false
    }
   ]
  },
  {
   "id": "vwap slippage",
   "nombre_canonico": "VWAP Slippage",
   "tipo": "metrica",
   "nombres_vistos": [
    "VWAP Slippage"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    370
   ],
   "definiciones": [
    {
     "texto": "Diferencia entre el VWAP del trader y el VWAP del mercado; minimizar el slippage es un problema de ejecución estudiado en la literatura.",
     "doc_id": 370
    }
   ],
   "citas": [
    {
     "texto": "The difference between two VWAPs, Svwap_T(ζ) and SVWAP_T, is called a VWAP slippage.",
     "doc_id": 370
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Execution Quality",
     "doc_id": 370,
     "revisar": false
    }
   ]
  },
  {
   "id": "involvement ratio γ",
   "nombre_canonico": "Involvement Ratio (γ)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Involvement Ratio (γ)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    370
   ],
   "definiciones": [
    {
     "texto": "Ratio de participación γ = Φ/VT que define la proporción del volumen de mercado que el trader ejecuta; en práctica VT es inobservable antes de T.",
     "doc_id": 370
    }
   ],
   "citas": [
    {
     "texto": "γ is called an involvement ratio.",
     "doc_id": 370
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "DEFINE",
     "tipo_original": "DEFINE",
     "objeto_texto": "VWAP Execution Strategy",
     "doc_id": 370,
     "revisar": true
    }
   ]
  },
  {
   "id": "risk neutral optimality",
   "nombre_canonico": "Risk-Neutral Optimality",
   "tipo": "concepto",
   "nombres_vistos": [
    "Risk-Neutral Optimality"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    370
   ],
   "definiciones": [
    {
     "texto": "Bajo neutralidad al riesgo, la estrategia VWAP es la estrategia de ejecución óptima en el modelo AC con volumen explícito.",
     "doc_id": 370
    }
   ],
   "citas": [
    {
     "texto": "We show that the VWAP strategy is the optimal execution strategy for a risk-neutral trader.",
     "doc_id": 370
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "VWAP Execution Strategy",
     "doc_id": 370,
     "revisar": false
    }
   ]
  },
  {
   "id": "price recovery resilience",
   "nombre_canonico": "Price Recovery/Resilience",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Price Recovery/Resilience"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    370
   ],
   "definiciones": [
    {
     "texto": "Propiedad del impacto de mercado por la cual el precio se recupera tras una operación, también reconocida como resiliencia o MI transitorio.",
     "doc_id": 370
    }
   ],
   "citas": [
    {
     "texto": "The price recovery effect is also recognized as the resilience of the MI or transient MI.",
     "doc_id": 370
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Market Impact",
     "doc_id": 370,
     "revisar": false
    }
   ]
  },
  {
   "id": "geometric brownian motion volume",
   "nombre_canonico": "Geometric Brownian Motion (Volume)",
   "tipo": "dato",
   "nombres_vistos": [
    "Geometric Brownian Motion (Volume)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    370
   ],
   "definiciones": [
    {
     "texto": "Supuesto de que el proceso de volumen sigue un movimiento browniano geométrico para el análisis de optimización media-varianza.",
     "doc_id": 370
    }
   ],
   "citas": [
    {
     "texto": "We study the mean variance optimization problem when the trading volume process follows the geometric Brownian motion.",
     "doc_id": 370
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Trading Volume Process",
     "doc_id": 370,
     "revisar": false
    }
   ]
  },
  {
   "id": "path signature",
   "nombre_canonico": "Path Signatures",
   "tipo": "metodo",
   "nombres_vistos": [
    "Path Signatures"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    371
   ],
   "definiciones": [
    {
     "texto": "Técnica de extracción de features geométricos de trayectorias precio-volumen; captura dependencias temporales complejas como input al transformer.",
     "doc_id": 371
    }
   ],
   "citas": [
    {
