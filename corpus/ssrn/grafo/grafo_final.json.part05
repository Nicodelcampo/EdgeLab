  {
   "id": "stochastic delay differential equation sdde",
   "nombre_canonico": "Stochastic Delay Differential Equation (SDDE)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Stochastic Delay Differential Equation (SDDE)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    326
   ],
   "definiciones": [
    {
     "texto": "Ecuación diferencial estocástica con memoria donde el drift depende de una integral de Lebesgue-Stieltjes sobre valores pasados de Y. La inclusión de distributed delay (integral) y discrete delay (MY(t-p)) permite capturar efectos de ajuste gradual de desviaciones de precios.",
     "doc_id": 326
    }
   ],
   "citas": [
    {
     "texto": "Stochastic delay differential equations (SDDE) can be understood in some cases as the diffusion limit of high-order autoregressive moving average (ARMA) time series.",
     "doc_id": 326
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
