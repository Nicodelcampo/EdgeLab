   "doc_ids": [
    352
   ],
   "definiciones": [
    {
     "texto": "NT interpretado como predictor contrarian de retornos del índice bursátil: alto noise trading predice retornos negativos futuros.",
     "doc_id": 352
    }
   ],
   "citas": [
    {
     "texto": "We interpret NT as a contrarian predictor of stock market index returns.",
     "doc_id": 352
    }
   ],
   "relaciones_crudas": [
    {
