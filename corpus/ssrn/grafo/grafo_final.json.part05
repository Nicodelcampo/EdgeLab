   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    378
   ],
   "definiciones": [
    {
     "texto": "Residuo estacionario del modelo de cointegración entre pares de acciones; cuando es grande (pequeño), la estrategia va corto (largo) esperando convergencia.",
     "doc_id": 378
    }
   ],
   "citas": [
    {
     "texto": "Xt is a stationary, or mean-reverting, process. This process will be referred to as the cointegration residual.",
     "doc_id": 378
    }
   ],
   "relaciones_crudas": [
