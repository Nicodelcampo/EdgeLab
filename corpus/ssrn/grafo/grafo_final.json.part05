    352
   ],
   "definiciones": [
    {
     "texto": "Apagón inesperado del proveedor de datos financieros Wind el 8 de enero de 2024, usado como shock exógeno para validar la medida NT: sin información confiable, aumenta la ocurrencia de números de suerte en precios.",
     "doc_id": 352
    }
   ],
   "citas": [
    {
     "texto": "Wind is the leading financial data provider in China. On January 8, 2024, it experienced an unexpected outage that prevented users from retrieving data.",
