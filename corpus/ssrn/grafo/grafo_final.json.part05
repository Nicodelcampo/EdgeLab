    }
   ]
  },
  {
   "id": "spoofing layering",
   "nombre_canonico": "Spoofing/Layering",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Spoofing/Layering"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    349
   ],
   "definiciones": [
    {
     "texto": "Técnica de manipulación que consiste en colocar y cancelar rápidamente órdenes falsas para crear una impresión artificial de liquidez y mover el precio en dirección favorable.",
     "doc_id": 349
    }
   ],
   "citas": [
    {
     "texto": "Perpetuate unlawful practices such as front-running and layering/spoofing.",
     "doc_id": 349
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Market Manipulation",
     "doc_id": 349,
     "revisar": false
    }
   ]
  },
  {
   "id": "order book",
   "nombre_canonico": "Order Book",
   "tipo": "dato",
   "nombres_vistos": [
    "Order Book"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    349
   ],
   "definiciones": [
    {
     "texto": "Sistema computarizado estructurado donde las transacciones se ingresan, enrutan, ejecutan y liquidan electrónicamente con poca o ninguna intervención humana.",
     "doc_id": 349
    }
   ],
   "citas": [
    {
     "texto": "Stock exchanges have become essentially a well-structured computer system over which transactions are entered, routed, executed and cleared electronically in their order books with little or no human intervention.",
     "doc_id": 349
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Electronic Trading",
     "doc_id": 349,
     "revisar": false
    }
   ]
  },
  {
   "id": "market welfare",
   "nombre_canonico": "Market Welfare",
   "tipo": "metrica",
   "nombres_vistos": [
    "Market Welfare"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    350
   ],
   "definiciones": [
    {
     "texto": "Medida de bienestar total del mercado usada para determinar el intervalo de batch óptimo; el THPNE maximiza el bienestar total aunque puede perjudicar la liquidez.",
     "doc_id": 350
    }
   ],
   "citas": [
    {
     "texto": "By maximizing the total market welfare measure, an optimal batch interval is determined to achieve the most efficient THPNE within the batch mechanism.",
     "doc_id": 350
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Market Efficiency",
     "doc_id": 350,
     "revisar": false
    }
   ]
  },
  {
   "id": "poisson new arrival process",
   "nombre_canonico": "Poisson News Arrival Process",
   "tipo": "dato",
   "nombres_vistos": [
    "Poisson News Arrival Process"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    350
   ],
   "definiciones": [
    {
     "texto": "Proceso de Poisson con tasa lambda que modela la llegada de noticias durante un intervalo batch; cada noticia impacta el precio del activo en sigma.",
     "doc_id": 350
    }
   ],
   "citas": [
    {
     "texto": "During the period (0, tau], news arrives followed by an independent Poisson process with arrival rate lambda, and each news impacts the asset price by sigma.",
     "doc_id": 350
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Batch Trading Mechanism",
     "doc_id": 350,
     "revisar": false
    }
   ]
  },
  {
   "id": "spread quoting strategy",
   "nombre_canonico": "Spread Quoting Strategy",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Spread Quoting Strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    350
   ],
   "definiciones": [
    {
     "texto": "Estrategia óptima del HFM en THPNE: adoptar el spread más estrecho posible (price priority) para disuadir la entrada de competidores.",
     "doc_id": 350
    }
   ],
   "citas": [
    {
     "texto": "In THPNE under news neutrality, the HFM adopts the narrowest spread quoting strategy, termed 'price priority for the market maker'.",
     "doc_id": 350
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
     "tipo_original": "PARTE_DE",
     "objeto_texto": "Trembling-Hand Perfect Nash Equilibrium (THPNE)",
     "doc_id": 350,
     "revisar": false
    }
   ]
  },
  {
   "id": "arm race in hft",
   "nombre_canonico": "Arms Race in HFT",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Arms Race in HFT"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    350
   ],
   "definiciones": [
    {
     "texto": "Competencia por velocidad entre HFTs que genera desperdicio de recursos; el mecanismo batch la transforma en competencia por precio.",
     "doc_id": 350
    }
   ],
   "citas": [
    {
     "texto": "This behavior supports the arms race inherent in the batch mechanism, benefiting total market welfare but harming market liquidity.",
     "doc_id": 350
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Systemic Risk",
     "doc_id": 350,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Batch Trading Mechanism",
     "doc_id": 350,
     "revisar": false
    }
   ]
  },
  {
   "id": "liquidity trader lt",
   "nombre_canonico": "Liquidity Traders (LT)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Liquidity Traders (LT)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    350
   ],
   "definiciones": [
    {
     "texto": "Traders que llegan según proceso de Poisson independiente y comercian inmediatamente por motivos de liquidez; operan en baja frecuencia.",
     "doc_id": 350
    }
   ],
   "citas": [
    {
     "texto": "Liquidity traders (LTs), who arrive stochastically and trade immediately upon arrival.",
     "doc_id": 350
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "High-Frequency Trader (HFT)",
     "doc_id": 350,
     "revisar": false
    }
   ]
  },
  {
   "id": "new neutrality",
   "nombre_canonico": "News Neutrality",
   "tipo": "dato",
   "nombres_vistos": [
    "News Neutrality"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    350
   ],
   "definiciones": [
    {
     "texto": "Supuesto de que las probabilidades de noticias buenas y malas son ambas del 50%, asegurando que las expectativas de volumen en ambos lados del HFM sean iguales.",
     "doc_id": 350
    }
   ],
   "citas": [
    {
     "texto": "It is reasonable to assume news neutrality, which means that the probabilities of good and bad news are both 50%.",
     "doc_id": 350
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Trembling-Hand Perfect Nash Equilibrium (THPNE)",
     "doc_id": 350,
     "revisar": false
    }
   ]
  },
  {
   "id": "price jump",
   "nombre_canonico": "Price Jump",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Price Jump"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    351
   ],
   "definiciones": [
    {
     "texto": "Fenómeno donde el precio cambia significativamente en un solo intervalo, que los modelos continuos o de noticia única no pueden explicar; el modelo de noticias múltiples lo captura como combinación de dos procesos de Poisson.",
     "doc_id": 351
    }
   ],
   "citas": [
    {
     "texto": "The multiple news setting is not only more realistic and broader in applicability, but also provides a depiction of the microstructure and the drivers for price jumps.",
     "doc_id": 351
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Multiple News Arrival",
     "doc_id": 351,
     "revisar": false
    },
    {
     "tipo": "CONTRADICE_A",
     "tipo_original": "CONTRADICE_A",
     "objeto_texto": "Random Walk",
     "doc_id": 351,
     "revisar": false
    }
   ]
  },
  {
   "id": "poisson process",
   "nombre_canonico": "Poisson Process",
   "tipo": "dato",
   "nombres_vistos": [
    "Poisson Process"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    351
   ],
   "definiciones": [
    {
     "texto": "El precio ya no sigue un random walk sino una combinación de dos procesos de Poisson; la distribución de noticias es idéntica en cada batch, y la esperanza del precio converge a un movimiento browniano por el teorema central del límite.",
     "doc_id": 351
    }
   ],
   "citas": [
    {
     "texto": "The price no longer obeys the random walk process; instead, it's a combination of two Poisson processes. Since the distribution of news is identical in each batch interval, the price expectancy converges to a Brownian motion according to the central limit theorem.",
     "doc_id": 351
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Price Jump",
     "doc_id": 351,
     "revisar": false
    }
   ]
  },
  {
   "id": "three tiered game model",
   "nombre_canonico": "Three-Tiered Game Model",
   "tipo": "metodo",
   "nombres_vistos": [
    "Three-Tiered Game Model"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    351
   ],
   "definiciones": [
    {
     "texto": "Modelo de tres juegos interconectados: HFT game (competencia por ser HFM), HFM game (estrategia de spread), y HFI game (timing de órdenes).",
     "doc_id": 351
    }
   ],
   "citas": [
    {
     "texto": "We define three interconnected games: the HFT game, in which HFTs compete for the high-frequency market maker (HFM) position; the HFM game, in which potential HFM competitors determine the spread-quoting strategy; and the HFI game, in which high-frequency investors (HFIs) dynamically optimize the order timing strategies.",
     "doc_id": 351
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Batch Trading Mechanism",
     "doc_id": 351,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Trembling-Hand Perfect Nash Equilibrium (THPNE)",
     "doc_id": 351,
     "revisar": false
    }
   ]
  },
  {
   "id": "risk free arbitrage",
   "nombre_canonico": "Risk-Free Arbitrage",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Risk-Free Arbitrage"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    351
   ],
   "definiciones": [
    {
     "texto": "Oportunidad de arbitraje sin riesgo que existe bajo el mecanismo continuo; el mecanismo batch la elimina al limitar la ventana de sniping al intervalo de latencia entre HFTs.",
     "doc_id": 351
    }
   ],
   "citas": [
    {
     "texto": "Risk-free arbitrage vanishes if multiple news arrives before settlement, thereby diminishing the profitability of high-frequency traders (HFTs).",
     "doc_id": 351
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Batch Trading Mechanism",
     "doc_id": 351,
     "revisar": false
    }
   ]
  },
  {
   "id": "chinese numerological superstition",
   "nombre_canonico": "Chinese Numerological Superstition",
   "tipo": "concepto",
   "nombres_vistos": [
    "Chinese Numerological Superstition"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    352
   ],
   "definiciones": [
    {
     "texto": "Superstición china que considera el número 8 como afortunado (suena como 'prosperidad') y el 4 como desafortunado (suena como 'muerte'), explotada para identificar comportamiento de traders no informados.",
     "doc_id": 352
    }
   ],
   "citas": [
    {
     "texto": "Chinese numerological superstition considers the number 8 lucky and the number 4 unlucky due to their pronunciations in Chinese, which sound like 'prosper' and 'death', respectively.",
     "doc_id": 352
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Noise Trading (NT) Measure",
     "doc_id": 352,
     "revisar": false
    }
   ]
  },
  {
   "id": "systematic mispricing",
   "nombre_canonico": "Systematic Mispricing",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Systematic Mispricing"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    352
   ],
   "definiciones": [
    {
     "texto": "Desviación de precios de activos de sus valores fundamentales a nivel de mercado causada por noise trading agregado, que genera predictibilidad de retornos.",
     "doc_id": 352
    }
   ],
   "citas": [
    {
     "texto": "Our findings support the notion that noise trading contributes to systematic mispricing in the stock market.",
     "doc_id": 352
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Noise Trading Activity",
     "doc_id": 352,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "Market Efficiency",
     "doc_id": 352,
     "revisar": false
    }
   ]
  },
  {
   "id": "arbitrage cost",
   "nombre_canonico": "Arbitrage Costs",
   "tipo": "concepto",
   "nombres_vistos": [
    "Arbitrage Costs"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    352
   ],
   "definiciones": [
    {
     "texto": "Costos que limitan la capacidad de los arbitrajistas para corregir mispricing; niveles altos de arbitrage costs fortalecen el poder predictivo de NT.",
     "doc_id": 352
    }
   ],
   "citas": [
    {
     "texto": "The results also hold out of sample and are stronger when arbitrage costs are high and information availability is low.",
     "doc_id": 352
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CONTRADICE_A",
     "tipo_original": "CONTRADICE_A",
     "objeto_texto": "Market Efficiency",
     "doc_id": 352,
     "revisar": false
    }
   ]
  },
  {
   "id": "short sale constraint",
   "nombre_canonico": "Short-Sale Constraints",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Short-Sale Constraints"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    352
   ],
   "definiciones": [
    {
     "texto": "Restricciones a ventas en corto que dificultan la corrección del sobreprecio más que del subprecio, haciendo que alto noise trading lleve a sobrevaloración neta y retornos futuros negativos.",
     "doc_id": 352
    }
   ],
   "citas": [
    {
     "texto": "Underpricing is more easily eliminated than is overpricing because short-sale constraints hinder arbitrage concerning overpricing compared with underpricing.",
     "doc_id": 352
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Overpricing",
     "doc_id": 352,
     "revisar": false
    }
   ]
  },
