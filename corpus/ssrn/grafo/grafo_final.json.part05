     "objeto_texto": "Developed Markets Arbitrage",
     "doc_id": 316,
     "revisar": false
    }
   ]
  },
  {
   "id": "trading time volume based signal",
   "nombre_canonico": "Trading Time (Volume-Based Signals)",
   "tipo": "metodo",
   "nombres_vistos": [
    "Trading Time (Volume-Based Signals)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    317
   ],
   "definiciones": [
    {
     "texto": "Uso de tiempo de trading (basado en volumen) en lugar de tiempo calendario para generar señales. Mejora significativamente el desempeño de estrategias basadas en ETFs: Sharpe ratio sube de 1.1 a 1.51 (2003-2007) al incorporar información de volumen diario.",
     "doc_id": 317
    }
   ],
   "citas": [
    {
     "texto": "We introduce a method to take into account daily trading volume information in the signals (using 'trading time' as opposed to calendar time), and observe significant improvements in performance.",
     "doc_id": 317
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Calendar Time Signals",
     "doc_id": 317,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Daily Trading Volume",
     "doc_id": 317,
     "revisar": false
    }
   ]
  },
  {
   "id": "quant fund unwinding theory",
   "nombre_canonico": "Quant Fund Unwinding Theory",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Quant Fund Unwinding Theory"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    317
   ],
   "definiciones": [
    {
     "texto": "Teoría de Khandani y Lo (2007) sobre el drawdown de quant funds en agosto 2007: liquidación forzosa de posiciones por parte de fondos cuantitativos generó un ciclo de retroalimentación negativa. El paper valida esta teoría con datos de desempeño de estrategias PCA y ETF.",
     "doc_id": 317
    }
   ],
   "citas": [
    {
     "texto": "We obtain results which are consistent with Khandani and Lo (2007) and validate their 'unwinding' theory for the quant fund drawdown of August 2007.",
     "doc_id": 317
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "August 2007 Quant Drawdown",
     "doc_id": 317,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Liquidity Crisis 2007",
     "doc_id": 317,
     "revisar": false
    }
   ]
  },
  {
   "id": "multi view spectral clustering",
   "nombre_canonico": "Multi-View Spectral Clustering",
   "tipo": "metodo",
   "nombres_vistos": [
    "Multi-View Spectral Clustering"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    318
   ],
   "definiciones": [
    {
     "texto": "Algoritmo de clustering que preserva información espacial y temporal entre features evitando la concatenación del enfoque single-view. Toma como input una colección de matrices de features (precios, realized variance, realized beta, etc.) en lugar de una sola matriz concatenada.",
     "doc_id": 318
    }
   ],
   "citas": [
    {
     "texto": "Multi-view clustering algorithms aim to preserve spatial and temporal information by forgoing the concatenation step. The input to multi-view clustering algorithms is a collection of features matrices.",
     "doc_id": 318
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Single-View Spectral Clustering",
     "doc_id": 318,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Realized Estimators",
     "doc_id": 318,
     "revisar": false
    }
   ]
  },
  {
   "id": "realized estimator from high frequency data",
   "nombre_canonico": "Realized Estimators from High-Frequency Data",
   "tipo": "dato",
   "nombres_vistos": [
    "Realized Estimators from High-Frequency Data"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    318
   ],
   "definiciones": [
    {
     "texto": "Estimadores de cantidades variacionales (realized volatility, realized beta, quadratic variation) derivados de datos intradiarios de alta frecuencia a cadencia diaria. Incorporan información de procesos estocásticos continuos que los precios de cierre solos no capturan, reduciendo clustering espurio.",
     "doc_id": 318
    }
   ],
   "citas": [
    {
     "texto": "We incorporate realized estimators (i.e. realized volatility, realized beta, and others) derived from high-frequency intraday data into the daily feature set.",
     "doc_id": 318
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Closing Price Only Features",
     "doc_id": 318,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Quadratic Variation",
     "doc_id": 318,
     "revisar": false
    }
   ]
  },
  {
   "id": "spuriou clustering risk",
   "nombre_canonico": "Spurious Clustering Risk",
   "tipo": "riesgo_metodologico",
   "nombres_vistos": [
    "Spurious Clustering Risk"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    318
   ],
   "definiciones": [
    {
     "texto": "Riesgo de que activos disímiles sean agrupados erróneamente en el período de formación. Si esto ocurre, los gaps de precio percibidos en el período de trading son espurios (no cierran o se amplían) y el arbitrajista pierde. Features adicionales mitigan este riesgo.",
     "doc_id": 318
    }
   ],
   "citas": [
    {
     "texto": "If dissimilar assets are erroneously clustered together, then any perceived price gaps are spurious, the gaps will not close or even widen, and the statistical arbitrageur will almost surely lose on the trade.",
     "doc_id": 318
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Trading Losses",
     "doc_id": 318,
     "revisar": false
    },
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Multi-View Spectral Clustering",
     "doc_id": 318,
     "revisar": false
    }
   ]
  },
  {
   "id": "feature supremacy over signal type",
   "nombre_canonico": "Feature Supremacy over Signal Type",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Feature Supremacy over Signal Type"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    318
   ],
   "definiciones": [
    {
     "texto": "Hallazgo central: la rentabilidad del trading está más influenciada por la selección de features y métodos de clustering que por la elección de señales o reglas de trading. Esto implica que mejorar el paso de identificación de similares (clustering) es más rentable que sofisticar las reglas de entrada/salida.",
     "doc_id": 318
    }
   ],
   "citas": [
    {
     "texto": "Trading profitability is influenced more by the selection of feature sets and clustering methods than by the choice of signals or trading rules.",
     "doc_id": 318
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CONTRADICE_A",
     "tipo_original": "CONTRADICE_A",
     "objeto_texto": "Trading Rule Optimization Focus",
     "doc_id": 318,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Asset Clustering Quality",
     "doc_id": 318,
     "revisar": false
    }
   ]
  },
  {
   "id": "pca eigenportfolio construction",
