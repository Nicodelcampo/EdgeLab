    }
   ]
  },
  {
   "id": "monte carlo critical value for robust test",
   "nombre_canonico": "Monte Carlo Critical Values for Robust Tests",
   "tipo": "metodo",
   "nombres_vistos": [
    "Monte Carlo Critical Values for Robust Tests"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    314
   ],
   "definiciones": [
    {
     "texto": "Simulaciones Monte Carlo para generar valores críticos de los tests robustos de cointegración bajo distintas distribuciones de error (normal, t, contaminada). Permite evaluar potencia y tamaño de los tests frente al Engle-Granger tradicional.",
     "doc_id": 314
    }
   ],
   "citas": [
    {
     "texto": "Critical values are generated and power calculated for various error distributions.",
     "doc_id": 314
    }
   ],
   "relaciones_crudas": [
