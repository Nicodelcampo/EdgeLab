   ],
   "definiciones": [
    {
     "texto": "Exposición neta direccional de un trader; el 87% de traders nunca cambia la dirección de su exposición, contradiciendo modelos de información asimétrica donde traders informados toman posiciones en ambas direcciones.",
     "doc_id": 359
    }
   ],
   "citas": [
    {
