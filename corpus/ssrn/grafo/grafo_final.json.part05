  {
   "id": "market neutral portfolio",
   "nombre_canonico": "Market-Neutral Portfolio",
   "tipo": "concepto",
   "nombres_vistos": [
    "Market-Neutral Portfolio"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    378
   ],
   "definiciones": [
    {
     "texto": "Portafolio con beta cero respecto al mercado, característica definitoria del statistical arbitrage junto con señales sistemáticas y mecanismo estadístico de generación de retornos.",
     "doc_id": 378
    }
   ],
   "citas": [
    {
     "texto": "The trading book is market-neutral, in the sense that it has zero beta with the market.",
     "doc_id": 378
    }
   ],
   "relaciones_crudas": [
    {
