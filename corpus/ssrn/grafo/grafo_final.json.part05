   "tipo": "concepto",
   "nombres_vistos": [
    "Mean-Reversion Paradigm"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    378
   ],
   "definiciones": [
    {
     "texto": "Paradigma asociado con sobre-reacción del mercado: activos temporalmente sub/sobrevalorados respecto a valores de referencia; base del statistical arbitrage.",
     "doc_id": 378
    }
   ],
   "citas": [
    {
     "texto": "The mean-reversion paradigm is typically associated with market over-reaction: assets are temporarily under- or over-priced with respect to one or several reference securities.",
     "doc_id": 378
    }
   ],
   "relaciones_crudas": [
    {
