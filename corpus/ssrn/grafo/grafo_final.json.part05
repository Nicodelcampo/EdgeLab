  {
   "id": "macd moving average convergence divergence",
   "nombre_canonico": "MACD (Moving Average Convergence/Divergence)",
   "tipo": "metodo",
   "nombres_vistos": [
    "MACD (Moving Average Convergence/Divergence)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    328
   ],
   "definiciones": [
    {
     "texto": "Oscilador basado en medias móviles exponenciales: Diff_t = EMA12(price)_t - EMA26(price)_t, Signal_t = EMA9(Diff)_t, MACD = Diff_t - Signal_t. Señal de compra cuando el histograma cruza la línea cero hacia arriba y venta cuando cruza hacia abajo.",
     "doc_id": 328
    }
   ],
   "citas": [
    {
     "texto": "MACD = Diff_t - Signal_t, where Diff_t is also called the MACD curve, Signal_t, the signal line and MACD, the MACD histogram.",
     "doc_id": 328
    }
   ],
