  {
   "id": "limit up limit down luld plan",
   "nombre_canonico": "Limit Up-Limit Down (LULD) Plan",
   "tipo": "concepto",
   "nombres_vistos": [
    "Limit Up-Limit Down (LULD) Plan"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    356
   ],
   "definiciones": [
    {
     "texto": "Mecanismo de circuit breaker a nivel de acción individual en EE.UU. que previene que las acciones se comercien fuera de una banda de precio basada en un precio de referencia evolutivo.",
     "doc_id": 356
    }
   ],
   "citas": [
    {
     "texto": "Trading pauses on individual stocks under the Limit Up-Limit Down (LULD) Plan are key volatility circuit breakers in the US market, designed to prevent future disastrous market events similar to the 2010 Flash Crash.",
     "doc_id": 356
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Flash Crash",
     "doc_id": 356,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Trading Pause",
     "doc_id": 356,
     "revisar": false
    }
   ]
  },
  {
   "id": "amendment 10 a10",
   "nombre_canonico": "Amendment 10 (A10)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Amendment 10 (A10)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    356
   ],
   "definiciones": [
    {
     "texto": "Enmienda al Plan LULD vigente desde julio 2016 que corrigió precios de referencia de apertura problemáticos usando el precio de cierre del día anterior, reduciendo dramáticamente pausas innecesarias.",
     "doc_id": 356
    }
   ],
   "citas": [
    {
     "texto": "Amendment 10 of the LULD Plan came into effect on 18 July 2016 with the approval of the SEC.",
     "doc_id": 356
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Limit Up-Limit Down (LULD) Plan",
     "doc_id": 356,
     "revisar": false
    }
   ]
  },
  {
   "id": "high frequency quote update hfqu",
