   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    401
   ],
   "definiciones": [
    {
     "texto": "Crashes se forman mucho más rápido que bubbles debido a la asimetría introducida por restricciones de trading bajo información asimétrica.",
     "doc_id": 401
    }
   ],
   "citas": [
    {
     "texto": "A dynamic implication of this result is that crashes (large downward price movements) are formed much faster than bubbles (large upward price movements).",
     "doc_id": 401
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Trading Constraints (Borrowing & Short-Sale)",
     "doc_id": 401,
     "revisar": false
    }
   ]
  },
  {
   "id": "implicit price function",
   "nombre_canonico": "Implicit Price Function",
   "tipo": "metodo",
   "nombres_vistos": [
    "Implicit Price Function"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    401
   ],
   "definiciones": [
    {
     "texto": "Enfoque alternativo al REE: la función de precio implícita depende de variables de estado y demanda del uninformed, explotando que la demanda del informed no depende de la distribución de precios de equilibrio.",
     "doc_id": 401
    }
   ],
   "citas": [
    {
     "texto": "This approach contributes to the literature... our implicit function approach to solve non-linear REEs can be applied to multi-asset settings with any generalized distributions, quasiconcave preferences, and convex constraint sets.",
     "doc_id": 401
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Explicit Price Function",
     "doc_id": 401,
     "revisar": false
    }
   ]
  },
  {
   "id": "price level dependent informativeness",
   "nombre_canonico": "Price-Level-Dependent Informativeness",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Price-Level-Dependent Informativeness"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    401
   ],
   "definiciones": [
    {
     "texto": "La informatividad del precio varía con el nivel de precio, no es constante; resultado del equilibrio no lineal bajo restricciones.",
     "doc_id": 401
    }
   ],
   "citas": [
    {
     "texto": "Price informativeness varies with the price level.",
     "doc_id": 401
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Price Efficiency",
     "doc_id": 401,
     "revisar": false
    }
   ]
  }
 ],
