    375
   ],
   "definiciones": [
    {
     "texto": "Identidad matemática demostrada: la suma de ganancias acumuladas no realizadas (HPI) equivale exactamente a la suma de ganancias contables realizadas FIFO más mark-to-market de activos no vendidos.",
     "doc_id": 375
