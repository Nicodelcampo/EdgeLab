  {
   "id": "machine knowledge capital",
   "nombre_canonico": "Machine Knowledge Capital",
   "tipo": "concepto",
   "nombres_vistos": [
    "Machine Knowledge Capital"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    353
   ],
   "definiciones": [
    {
     "texto": "Nueva forma de capital económico que industrializa la producción del equivalente mecánico del capital humano, comparable en impacto transformador al paso de la tierra a la maquinaria en la revolución industrial.",
     "doc_id": 353
    }
   ],
   "citas": [
    {
     "texto": "The technological advances in scaling AI systems in the late 2010s and early 2020s materially changed economic and technological conditions, ushering in a new economic age, one of machine knowledge capital.",
     "doc_id": 353
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "EQUIVALE_A",
     "tipo_original": "EQUIVALE_A",
     "objeto_texto": "Artificial Intelligence",
     "doc_id": 353,
     "revisar": false
    },
    {
