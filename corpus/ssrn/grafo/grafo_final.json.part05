   "tipo": "fenomeno",
   "nombres_vistos": [
    "Skill-Biased Internal Migration"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    357
   ],
   "definiciones": [
    {
     "texto": "Migración de trabajadores con educación universitaria hacia distritos de alta densidad en busca de salarios más altos; mecanismo causal clave del modelo.",
     "doc_id": 357
    }
   ],
   "citas": [
    {
     "texto": "As college-educated workers migrate to high-density constituencies in pursuit of higher wages, Left incumbents increasingly embrace free trade, while Right incumbents take more protectionist positions.",
     "doc_id": 357
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Trade Policy Realignment",
