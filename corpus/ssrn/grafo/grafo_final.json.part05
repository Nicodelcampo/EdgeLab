   "tipo": "concepto",
   "nombres_vistos": [
    "Limit Up/Limit Down Bands"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    358
   ],
   "definiciones": [
    {
     "texto": "Reglas de pausa regulatoria sobre ventanas móviles de 5 minutos que pueden mitigar pero no detener crashes o bubbles en índices con dinámica de precio HFT.",
     "doc_id": 358
    }
   ],
   "citas": [
    {
     "texto": "Extant regulatory proposals to control price dynamics of select stocks, i.e., pause rules such as 'limit up/limit down' bands over 5-minute rolling windows, may mitigate but not stop future market crashes or price bubbles.",
     "doc_id": 358
    }
   ],
