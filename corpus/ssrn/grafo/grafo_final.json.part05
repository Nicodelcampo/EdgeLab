   "tipo": "concepto",
   "nombres_vistos": [
    "WTO General Exceptions"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    353
   ],
   "definiciones": [
    {
     "texto": "Cláusulas de excepción general de la OMC que permiten restricciones comerciales por seguridad nacional u otras razones de política pública protegidas.",
     "doc_id": 353
    }
   ],
   "citas": [
    {
     "texto": "Sorting out whether trade restrictions are legitimately for national security or other policy rationales protected under the WTO's general exceptions clause.",
     "doc_id": 353
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Trade Restrictions",
     "doc_id": 353,
