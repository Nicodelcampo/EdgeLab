    "Trading Time"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    378
   ],
   "definiciones": [
    {
     "texto": "Método que incorpora información de volumen diario transformando tiempo calendario en tiempo de trading; mejora significativamente señales basadas en ETF (Sharpe 1.51 post-2003).",
     "doc_id": 378
    }
   ],
   "citas": [
    {
     "texto": "We introduce a method to take into account daily trading volume information in the signals (using 'trading time' as opposed to calendar time), and observe significant improvements in performance.",
     "doc_id": 378
    }
   ],
   "relaciones_crudas": [
