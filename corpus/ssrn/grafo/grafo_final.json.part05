   "tipo": "concepto",
   "nombres_vistos": [
    "Two-Tier Orderbook"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    364
   ],
   "definiciones": [
    {
     "texto": "Estructura de orderbook donde coexisten órdenes token-específicas (tier superior) y bids a nivel colección que ofrecen comprar cualquier token de la colección a un precio determinado (tier inferior). Sin contraparte en mercados de valores tradicionales.",
     "doc_id": 364
    }
   ],
   "citas": [
    {
     "texto": "We call this structure the two-tier orderbook: token-specific orders in the upper tier and collection-level floor bids in the lower.",
     "doc_id": 364
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "PARTE_DE",
