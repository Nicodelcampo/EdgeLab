   "definiciones": [
    {
     "texto": "Prueba de causalidad de Granger aplicada para determinar si el trading técnico causa dinámicas de liquidez en el libro de órdenes, complementando el estudio de eventos intradiario no paramétrico y el modelo de datos de panel.",
     "doc_id": 328
