    }
   ]
  },
  {
   "id": "synthetic data",
   "nombre_canonico": "Synthetic Data",
   "tipo": "dato",
   "nombres_vistos": [
    "Synthetic Data"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    353
   ],
   "definiciones": [
    {
     "texto": "Datos generados por sistemas de IA que transforman datos existentes en contenido sintético no cubierto por marcos legales actuales.",
     "doc_id": 353
    }
   ],
   "citas": [
    {
     "texto": "Transform existing data into so called 'synthetic' data that is not covered by existing legal frameworks.",
     "doc_id": 353
    }
   ],
   "relaciones_crudas": [
