  {
   "id": "securitie information processor sip",
   "nombre_canonico": "Securities Information Processor (SIP)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Securities Information Processor (SIP)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    356
   ],
   "definiciones": [
    {
     "texto": "Sistema que calcula la banda de precio para cada acción basado en un precio de referencia evolutivo; fuente de datos para el plan LULD.",
     "doc_id": 356
    }
   ],
   "citas": [
    {
     "texto": "The price band for a stock is calculated by the Securities Information Processors (SIPs) based on an evolving reference price.",
     "doc_id": 356
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
