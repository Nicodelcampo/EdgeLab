     "doc_id": 314,
     "revisar": false
    }
   ]
  },
  {
   "id": "spread fade strategy",
   "nombre_canonico": "SPREAD_FADE Strategy",
   "tipo": "estrategia",
   "nombres_vistos": [
    "SPREAD_FADE Strategy"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    315
   ],
   "definiciones": [
    {
     "texto": "Arbitraje microestructural en mercados de predicción binarios: cuando el ask cotizado en un outcome near-certain está por debajo de la probabilidad verdadera implicada por su complemento, existe entrada con expected value positivo. Edge libre de riesgo si market maker spread > 2 × taker fee.",
     "doc_id": 315
    }
   ],
   "citas": [
    {
     "texto": "When the quoted ask on a nearly certain outcome is below the true probability implied by its complement, a positive-expected-value entry exists regardless of one's view on the underlying.",
     "doc_id": 315
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Bid-Ask Spread",
     "doc_id": 315,
     "revisar": false
    },
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Near-Certain Outcome Markets",
     "doc_id": 315,
     "revisar": false
    }
   ]
  },
  {
   "id": "cross market consistency arbitrage",
   "nombre_canonico": "CROSS_MARKET Consistency Arbitrage",
   "tipo": "estrategia",
   "nombres_vistos": [
    "CROSS_MARKET Consistency Arbitrage"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    315
   ],
   "definiciones": [
    {
     "texto": "Identifica grupos de mercados de outcomes mutuamente excluyentes (brackets de torneo, nominaciones) cuyos precios YES suman >1 + 2×round-trip fee. El exceso sobre este umbral constituye oversubscription explotable shorteando outcomes sobrevalorados vía contratos NO complementarios.",
     "doc_id": 315
    }
   ],
   "citas": [
    {
     "texto": "A well-defined set of mutually exclusive outcomes must price such that their YES asks sum to no more than 1 plus twice the round-trip fee; excess above this threshold constitutes exploitable oversubscription.",
     "doc_id": 315
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Mutually Exclusive Outcomes",
     "doc_id": 315,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "NO Contracts",
     "doc_id": 315,
     "revisar": false
    }
   ]
  },
  {
   "id": "dep graph stochastic dominance arbitrage",
   "nombre_canonico": "DEP_GRAPH Stochastic Dominance Arbitrage",
   "tipo": "estrategia",
   "nombres_vistos": [
    "DEP_GRAPH Stochastic Dominance Arbitrage"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    315
   ],
   "definiciones": [
    {
     "texto": "Refuerza restricciones de dominancia estocástica en ladders de strike para criptoactivos: el evento 'activo X excede strike K' debe ser al menos tan probable como 'activo X excede strike K' > K'. Violaciones constituyen arbitraje puro.",
     "doc_id": 315
    }
   ],
   "citas": [
    {
     "texto": "Enforces stochastic dominance constraints on strike-price ladders: a lower strike must price at least as high as any higher strike, and violations constitute pure arbitrage.",
     "doc_id": 315
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Strike Price Ladder",
     "doc_id": 315,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Crypto Assets",
     "doc_id": 315,
     "revisar": false
    }
   ]
  },
  {
   "id": "fractional kelly sizing",
   "nombre_canonico": "Fractional Kelly Sizing",
   "tipo": "metodo",
   "nombres_vistos": [
    "Fractional Kelly Sizing"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    315
   ],
   "definiciones": [
    {
     "texto": "Dimensionamiento de trades usando criterio de Kelly fraccional con cap de 25% del bankroll por trade. Kelly (1956) maximiza tasa de crecimiento de largo plazo; la versión fraccional es más conservadora y práctica para gestión de riesgo.",
     "doc_id": 315
    }
   ],
   "citas": [
    {
     "texto": "Fractional Kelly sizing produces trade-size distributions consistent with theoretical optima.",
     "doc_id": 315
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MITIGA",
     "tipo_original": "MITIGA",
     "objeto_texto": "Risk of Ruin",
     "doc_id": 315,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Kelly Criterion",
     "doc_id": 315,
     "revisar": false
    }
   ]
  },
  {
   "id": "binary prediction market structure",
   "nombre_canonico": "Binary Prediction Market Structure",
   "tipo": "concepto",
   "nombres_vistos": [
    "Binary Prediction Market Structure"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    315
   ],
   "definiciones": [
    {
     "texto": "Mercados donde cada contrato resuelve a exactamente $1 (YES) o $0 (NO), imponiendo restricciones duras de no-arbitraje que son rutinariamente violadas. Causas: costo estructural de market-making, dificultad computacional de consistencia cross-contract, y latency gap.",
     "doc_id": 315
    }
   ],
   "citas": [
    {
     "texto": "Unlike continuous-price securities, each contract resolves to exactly $1 (YES wins) or $0 (NO wins), imposing hard no-arbitrage constraints that are routinely violated in practice.",
     "doc_id": 315
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CAUSA",
     "tipo_original": "CAUSA",
     "objeto_texto": "Arbitrage Opportunities",
     "doc_id": 315,
     "revisar": false
    },
    {
     "tipo": "SE_OPONE_A",
     "tipo_original": "SE_OPONE_A",
     "objeto_texto": "Continuous-Price Securities",
     "doc_id": 315,
     "revisar": false
    }
   ]
  },
  {
   "id": "latency sub strategy in prediction market",
   "nombre_canonico": "Latency Sub-Strategy in Prediction Markets",
   "tipo": "estrategia",
   "nombres_vistos": [
    "Latency Sub-Strategy in Prediction Markets"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    315
   ],
   "definiciones": [
    {
     "texto": "Sub-estrategia auxiliar de DEP_GRAPH que se activa cuando un activo de referencia se mueve más rápido de lo que el mercado de predicción re-precifica. La latencia en prediction markets se mide en segundos a minutos (vs milisegundos en equity).",
     "doc_id": 315
    }
   ],
   "citas": [
    {
     "texto": "An ancillary latency sub-strategy fires when a reference asset moves faster than the prediction market reprices.",
     "doc_id": 315
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Reference Asset Price Feed",
     "doc_id": 315,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Crypto Derivatives",
     "doc_id": 315,
     "revisar": false
    }
   ]
  },
  {
   "id": "multivariate cointegration johansen",
   "nombre_canonico": "Multivariate Cointegration (Johansen)",
   "tipo": "metodo",
   "nombres_vistos": [
    "Multivariate Cointegration (Johansen)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    316
   ],
   "definiciones": [
    {
     "texto": "Test de cointegración multivariado de Johansen (1988) que permite identificar relaciones de equilibrio entre múltiples activos simultáneamente, a diferencia del enfoque bivariado de pares. Los parámetros se estiman por máxima verosimilitud y el spread se modela para trades de mean-reversion.",
     "doc_id": 316
    }
   ],
   "citas": [
    {
     "texto": "We built a cointegrated portfolio using Johansen test which allows for exploring cointegration in a multivariate case. Unlike traditional methods focusing solely on pairs, this methodology conducts cointegration tests across multiple assets concurrently.",
     "doc_id": 316
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MEJORA_A",
     "tipo_original": "MEJORA_A",
     "objeto_texto": "Pairs Trading",
     "doc_id": 316,
     "revisar": false
    },
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Vector Error Correction Model",
     "doc_id": 316,
     "revisar": false
    }
   ]
  },
  {
   "id": "spread modeling for mean reversion",
   "nombre_canonico": "Spread Modeling for Mean-Reversion",
   "tipo": "metodo",
   "nombres_vistos": [
    "Spread Modeling for Mean-Reversion"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    316
   ],
   "definiciones": [
    {
     "texto": "El spread (combinación lineal estacionaria de precios) se modela para identificar divergencias del equilibrio y generar señales contrarian. Permite determinar pesos óptimos de cada activo en el portafolio, consistente con teoría económica.",
     "doc_id": 316
    }
   ],
   "citas": [
    {
     "texto": "Arbitrage opportunities were discovered by modeling the spread, targeting mean-reversion trades. This approach is consistent with economic theory and allows for determining portfolio asset weights.",
     "doc_id": 316
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Cointegration Residual",
     "doc_id": 316,
     "revisar": false
    },
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
     "objeto_texto": "Contrarian Trading",
     "doc_id": 316,
     "revisar": false
    }
   ]
  },
  {
   "id": "hurst exponent for mean reversion quality",
   "nombre_canonico": "Hurst Exponent for Mean-Reversion Quality",
   "tipo": "metrica",
   "nombres_vistos": [
    "Hurst Exponent for Mean-Reversion Quality"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    316
   ],
   "definiciones": [
    {
     "texto": "Exponente de Hurst usado para evaluar la calidad de difusión random walk del spread y verificar que sea genuinamente mean-reverting. Complementa el half-life del proceso Ornstein-Uhlenbeck como criterio de selección de pares/portafolios.",
     "doc_id": 316
    }
   ],
   "citas": [
    {
     "texto": "Ramos-Requena et al. (2017) introduced the use of the Hurst exponent to assess the quality of random walk diffusion, observing whether the spread is truly mean-reverting.",
     "doc_id": 316
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "USA",
     "tipo_original": "USA",
     "objeto_texto": "Ornstein-Uhlenbeck Half-Life",
     "doc_id": 316,
     "revisar": false
    },
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Mean-Reversion Quality",
     "doc_id": 316,
     "revisar": false
    }
   ]
  },
  {
   "id": "emerging market arbitrage bovespa",
   "nombre_canonico": "Emerging Market Arbitrage (Bovespa)",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Emerging Market Arbitrage (Bovespa)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    316
   ],
   "definiciones": [
    {
     "texto": "Mercado brasileño (Bovespa) como emerging market con potencial de identificar más oportunidades de arbitraje que mercados desarrollados, pero con menos investigación previa en pairs trading. Período 1997-2023 cubre múltiples crisis económicas.",
     "doc_id": 316
    }
   ],
   "citas": [
    {
     "texto": "The study was conducted on the Brazilian market, an emerging market with the potential for identifying arbitrage opportunities compared to more established markets. This market also lacks sufficient research.",
     "doc_id": 316
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "APLICA_A",
     "tipo_original": "APLICA_A",
