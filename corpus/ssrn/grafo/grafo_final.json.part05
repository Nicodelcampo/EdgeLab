   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    352
   ],
   "definiciones": [
    {
     "texto": "Porcentaje de propiedad de inversores minoristas, positivamente correlacionado con NT, validando que la medida captura actividad de traders no informados.",
     "doc_id": 352
    }
   ],
   "citas": [
    {
     "texto": "NT is positively correlated with retail trader ownership and negatively correlated with investor experience, the two important determinants of noise trading.",
     "doc_id": 352
    }
   ],
