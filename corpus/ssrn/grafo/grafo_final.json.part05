   "doc_ids": [
    328
   ],
   "definiciones": [
    {
     "texto": "Modelo de Chiarella y Ladley (2016) que extiende Goettler et al. (2005, 2009) usando una técnica numérica para identificar un equilibrio Markov perfecto donde traders técnicos y informados optimizan endógenamente sus estrategias de submission de órdenes condicional al estado del mercado.",
     "doc_id": 328
    }
   ],
   "citas": [
    {
     "texto": "Chiarella and Ladley (2016) use this approach to model the interaction between technical and informed traders in an order book... they are able to derive optimal strategies in the sense that both groups of traders submit and modify their orders in order to maximize their expected payoff, conditional on the state of the market.",
     "doc_id": 328
    }
   ],
