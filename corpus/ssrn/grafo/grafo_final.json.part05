    }
   ]
  },
  {
   "id": "bloc central bank bcb",
   "nombre_canonico": "Bloc Central Bank (BCB)",
   "tipo": "concepto",
   "nombres_vistos": [
    "Bloc Central Bank (BCB)"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    354
   ],
   "definiciones": [
    {
     "texto": "Banco central del bloque que emite BCUs, mantiene el ledger, monitorea riesgo sistémico y actúa como prestamista de última instancia para bancos centrales miembros.",
     "doc_id": 354
    }
   ],
   "citas": [
    {
     "texto": "BCUs are issued to member central banks proportional to their gold contribution ratios to the BCB.",
     "doc_id": 354
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "REQUIERE",
     "tipo_original": "REQUIERE",
     "objeto_texto": "Trading Bloc Exchange (TBE)",
     "doc_id": 354,
     "revisar": false
    }
   ]
  },
  {
   "id": "gold ratio issuance",
   "nombre_canonico": "Gold-Ratio Issuance",
   "tipo": "metodo",
   "nombres_vistos": [
    "Gold-Ratio Issuance"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    354
   ],
   "definiciones": [
    {
     "texto": "Mecanismo por el cual las BCUs se asignan proporcionalmente a las contribuciones de oro de cada banco central miembro al BCB, creando una oferta semi-fija inmune al efecto multiplicador monetario.",
     "doc_id": 354
    }
   ],
   "citas": [
    {
     "texto": "BCU issued proportional to gold contribution ratios.",
     "doc_id": 354
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "MIDE",
     "tipo_original": "MIDE",
     "objeto_texto": "Bloc Currency Unit (BCU)",
     "doc_id": 354,
     "revisar": false
    }
   ]
  },
  {
   "id": "money multiplier effect",
   "nombre_canonico": "Money Multiplier Effect",
   "tipo": "fenomeno",
   "nombres_vistos": [
    "Money Multiplier Effect"
   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    354
   ],
   "definiciones": [
    {
     "texto": "Efecto por el cual los préstamos bancarios expanden la oferta monetaria en sistemas de moneda fiduciaria nacional; las BCUs lo evitan al tener oferta semi-fija.",
     "doc_id": 354
    }
   ],
   "citas": [
    {
     "texto": "This ensures that the aggregate BCU supply remains relatively fixed...and is immune to the money multiplier effect that affects national fiat currencies when loans are made by banks, thereby maintaining long-term purchasing power.",
     "doc_id": 354
    }
   ],
   "relaciones_crudas": [
    {
     "tipo": "CONTRADICE_A",
     "tipo_original": "CONTRADICE_A",
     "objeto_texto": "Bloc Currency Unit (BCU)",
     "doc_id": 354,
     "revisar": false
    }
   ]
  },
