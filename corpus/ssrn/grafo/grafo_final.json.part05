   "doc_ids": [
    355
   ],
   "definiciones": [
    {
     "texto": "ETF de gestión activa que bajo norma SEC debe reportar sus tenencias diariamente, otorgando acceso sin precedentes a las estrategias de gestores de alto perfil.",
     "doc_id": 355
    }
   ],
   "citas": [
    {
     "texto": "Under SEC rule, actively managed ETFs must report daily holdings.",
     "doc_id": 355
    }
   ],
   "relaciones_crudas": [
    {
