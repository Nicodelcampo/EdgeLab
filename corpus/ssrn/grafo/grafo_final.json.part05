   ],
   "menciones": 1,
   "doc_frecuencia": 1,
   "doc_ids": [
    358
   ],
   "definiciones": [
    {
     "texto": "Ratio de Sharpe de estrategias HFT que depende de exposición al hedge factor, costos de trading, umbrales de volatilidad y capacidad de predecir volatilidad inducida por bid-ask bounce.",
     "doc_id": 358
    }
   ],
   "citas": [
    {
