{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExperimentRegistrySchema",
  "description": "Machine-readable schema for experiment runs in Edge Discovery Factory.",
  "type": "object",
  "required": [
    "experiment_id",
    "hypothesis_id",
    "research_stage",
    "code_commit",
    "input_hashes",
    "indicator_configs",
    "corridor_config",
    "assets",
    "contracts",
    "sessions",
    "control_definition",
    "friction_model",
    "multiplicity_family",
    "result",
    "uncertainty",
    "artifact_hashes"
  ],
  "properties": {
    "experiment_id": { "type": "string" },
    "hypothesis_id": { "type": "string" },
    "research_stage": { "type": "string" },
    "code_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "input_hashes": { "type": "object" },
    "indicator_configs": { "type": "array" },
    "corridor_config": { "type": "object" },
    "assets": { "type": "array", "items": { "type": "string" } },
    "contracts": { "type": "array", "items": { "type": "string" } },
    "sessions": { "type": "array", "items": { "type": "string" } },
    "control_definition": { "type": "object" },
    "outcome_definition": { "type": ["object", "null"] },
    "friction_model": { "type": "object" },
    "multiplicity_family": { "type": "string" },
    "result": { "type": "string" },
    "uncertainty": { "type": "string" },
    "failure_reason": { "type": ["string", "null"] },
    "artifact_hashes": { "type": "object" }
  },
  "additionalProperties": false
}
