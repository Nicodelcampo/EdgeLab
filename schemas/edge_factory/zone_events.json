{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZoneEventsCanonicalSchema",
  "description": "Canonical machine-readable schema for verified causal zone events in Edge Discovery Factory.",
  "type": "object",
  "required": [
    "instrument",
    "contract",
    "session_id",
    "indicator",
    "indicator_version",
    "config_id",
    "zone_id",
    "origin_ts",
    "signal_available_ts",
    "executable_fill_ts",
    "bar_key",
    "side",
    "bottom",
    "top",
    "state",
    "termination_reason",
    "availability_quality",
    "source_sha256",
    "engine_version"
  ],
  "properties": {
    "instrument": { "type": "string", "minLength": 1 },
    "contract": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "indicator": { "type": "string", "minLength": 1 },
    "indicator_version": { "type": "string", "minLength": 1 },
    "config_id": { "type": "string", "minLength": 1 },
    "zone_id": { "type": "string", "minLength": 1 },
    "origin_ts": { "type": "integer", "description": "UTC timestamp in nanoseconds when zone begins formation" },
    "signal_available_ts": { "type": "integer", "description": "UTC timestamp in nanoseconds when zone is strictly observable" },
    "executable_fill_ts": { "type": "integer", "description": "UTC timestamp in nanoseconds when order fill could first occur" },
    "bar_key": { "type": "string", "minLength": 1 },
    "side": { "type": "string", "enum": ["BULL", "BEAR", "NEUTRAL"] },
    "bottom": { "type": "number" },
    "top": { "type": "number" },
    "state": { "type": "string", "minLength": 1 },
    "termination_reason": { "type": "string", "minLength": 1 },
    "availability_quality": {
      "type": "string",
      "enum": ["EXPLICIT_EXACT", "EXPLICIT_FALLBACK"],
      "description": "Causal datasets reject ORIGIN_FALLBACK_UNVERIFIED."
    },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "engine_version": { "type": "string", "minLength": 1 },
    "height_ticks": { "type": "number" },
    "total_vol": { "type": "number" },
    "vol_rate": { "type": "number" },
    "pasos": { "type": "integer" }
  },
  "additionalProperties": false
}
