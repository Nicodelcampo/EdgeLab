{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgelab.local/schemas/edge_brain/skill.json",
  "title": "EdgeLab Skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_id",
    "name",
    "description",
    "workflow_steps",
    "input_schema",
    "output_schema",
    "version",
    "status",
    "created_at_utc"
  ],
  "properties": {
    "skill_id": {
      "type": "string",
      "pattern": "^SKILL-[A-Za-z0-9._:-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "workflow_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_schema": {
      "type": "string"
    },
    "output_schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "DEPRECATED"
      ]
    },
    "created_at_utc": {
      "type": "string"
    }
  }
}