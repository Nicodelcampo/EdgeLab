{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgelab.local/schemas/edge_brain/measurement_contract.json",
  "title": "EdgeLab Measurement Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["measurement_id", "intended_measurement", "mathematical_definition", "actual_implementation", "unit_of_analysis", "event_start", "signal_available_at", "measurement_matures_at", "required_wait", "reason_for_wait", "numerator", "denominator", "eligibility", "exclusions", "known_proxies", "semantic_gap", "code_commit", "query_hash", "required_tests", "status"],
  "properties": {
    "measurement_id": {"type": "string", "pattern": "^MC-[A-Za-z0-9._:-]+$"},
    "intended_measurement": {"type": "string", "minLength": 1},
    "mathematical_definition": {"type": "string", "minLength": 1},
    "actual_implementation": {"type": "object", "additionalProperties": false, "required": ["description", "code_refs"], "properties": {"description": {"type": "string", "minLength": 1}, "code_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "unit_of_analysis": {"type": "string", "minLength": 1},
    "event_start": {"type": "string", "minLength": 1},
    "signal_available_at": {"type": "string", "minLength": 1},
    "measurement_matures_at": {"type": "string", "minLength": 1},
    "required_wait": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {"value": {"type": "number", "minimum": 0}, "unit": {"enum": ["ticks", "bars", "nanoseconds", "sessions", "event_defined"]}}},
    "reason_for_wait": {"type": "string", "minLength": 1},
    "numerator": {"type": ["string", "null"]},
    "denominator": {"type": ["string", "null"]},
    "eligibility": {"type": "array", "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "known_proxies": {"type": "array", "items": {"type": "string"}},
    "semantic_gap": {"type": ["string", "null"]},
    "code_commit": {"type": "string", "minLength": 7},
    "query_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "required_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["DRAFT", "PREREGISTERED", "VERIFIED", "CONTRADICTED", "INVALIDATED_BY_MEASUREMENT_ERROR", "SUPERSEDED"]}
  }
}
