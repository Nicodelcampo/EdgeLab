{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgelab.local/schemas/edge_brain/repair_action.json",
  "title": "EdgeLab Repair Action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repair_id",
    "failure_id",
    "description",
    "changes_made",
    "verified_by_test",
    "status",
    "executed_at_utc"
  ],
  "properties": {
    "repair_id": {
      "type": "string",
      "pattern": "^REPAIR-[A-Za-z0-9._:-]+$"
    },
    "failure_id": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "changes_made": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_by_test": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "PLANNED",
        "APPLIED",
        "VERIFIED",
        "REVERTED"
      ]
    },
    "executed_at_utc": {
      "type": "string"
    }
  }
}