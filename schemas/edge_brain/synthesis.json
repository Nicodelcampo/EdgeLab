{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgelab.local/schemas/edge_brain/synthesis.json",
  "title": "EdgeLab Synthesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "synthesis_id",
    "title",
    "summary",
    "source_record_ids",
    "has_unresolved_conflicts",
    "can_promote",
    "generated_by",
    "status",
    "created_at_utc"
  ],
  "properties": {
    "synthesis_id": {
      "type": "string",
      "pattern": "^SYNTH-[A-Za-z0-9._:-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source_record_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "has_unresolved_conflicts": {
      "type": "boolean"
    },
    "can_promote": {
      "type": "boolean"
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "ACCEPTED",
        "REJECTED",
        "BLOCKED_BY_CONFLICT"
      ]
    },
    "created_at_utc": {
      "type": "string"
    }
  }
}