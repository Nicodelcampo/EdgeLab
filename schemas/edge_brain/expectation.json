{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgelab.local/schemas/edge_brain/expectation.json",
  "title": "EdgeLab Expectation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expectation_id",
    "episode_id",
    "statement",
    "metric",
    "expected_direction",
    "status",
    "created_at_utc"
  ],
  "properties": {
    "expectation_id": {
      "type": "string",
      "pattern": "^EXP-[A-Za-z0-9._:-]+$"
    },
    "episode_id": {
      "type": "string"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "expected_direction": {
      "enum": [
        "POSITIVE",
        "NEGATIVE",
        "NEUTRAL",
        "INVARIANT",
        "GREATER_THAN",
        "LESS_THAN"
      ]
    },
    "baseline_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "expected_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "status": {
      "enum": [
        "PROPOSED",
        "CONFIRMED",
        "REFUTED",
        "UNTESTED"
      ]
    },
    "created_at_utc": {
      "type": "string"
    }
  }
}