[Unit]
Description=EdgeLab cartera viva: seguimiento, régimen de mañana, contratos por cuenta y cola de investigación (docs/CARTERA_VIVA.md)
After=network-online.target
Wants=network-online.target
OnFailure=edgelab-alerta@%n.service

[Service]
Type=oneshot
User=edgelab
Group=edgelab
WorkingDirectory=/opt/edgelab/EdgeLab
Environment=HOME=/opt/edgelab
Environment=PATH=/opt/edgelab/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/edgelab/autopilot.env
ExecStart=/opt/edgelab/venv/bin/python tools/cartera_diaria.py ciclo --config /etc/edgelab/cartera.json
ExecStopPost=-/opt/edgelab/EdgeLab/deploy/debian/sync_state.sh
TimeoutStartSec=2700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/edgelab-autopilot /opt/edgelab
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=3G
