{"hash": "20225314338e4afa02fcc2f906221182a477ae05c389591d5be71cedafa767a4", "payload": {"conditions": ["MNQ 25t"], "confidence": "LOW", "created_at_utc": "2026-09-28T16:04:51.180774+00:00", "episode_id": "EP-BRAIN-LECCIONES-20260928", "evidence_record_ids": [], "lesson_id": "LES-ESPEJO-SIM-SCOPE-20260928", "robustness": "REPLICATED", "scope": "METHODOLOGICAL", "statement": "La semejanza vuelta/impulso de ESPEJO-SIM (MNQ 25t, métrica automática) está replicada en 3 contratos (+2..5 pp, parecidas - poco parecidas); su exceso sobre f no se sostiene (f sesgado). No se trasladó a ES 100t con el modelo de Nico: instrumento, escala y métrica cambian a la vez.", "status": "PROPOSED"}, "prev_hash": "bdad25af9b371305c39282add1801049300c39027513cbedd3182dbcbb53cd4e", "schema": "edgelab_hippocampus_ledger_v1", "type": "lesson_recorded"}
