# === EdgeLab .gitignore ===
# Datos, caches, secretos y artefactos regenerables quedan fuera de Git.
# IMPORTANTE: /data/ está anclado a la raíz. edgelab/data/ contiene código.

# Python
__pycache__/
*.py[cod]
*.pyo
*.nbc
*.nbi
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Entornos
.venv/
.venv-*/
venv/
env/
_env_probes/

# Configuración local y secretos
.env
.env.*
config.local.*
*.local.toml
config/local.toml
secrets.*
credentials.*

# Datos grandes — SOLO raíz
/data/*
!/data/nt8_oracles/
!/data/nt8_oracles/*
/TickData/
*.Last.txt
*.zip
*.rar
*.7z

# Checkpoints parciales
diag/**/*.checkpoint.json

# Runtime
runs/*
!runs/censo/
runs/censo/*
!runs/censo/manifiesto_universo.json
!runs/intake_l2/
!runs/intake_l2/*
cache/
artifacts/
dist/
logs/
*.log
!diag/tasa_senales/rss_y_equivalencia_70s.log
suspicious_trades.csv

# Oráculos reales
oracles/**/*.csv
oracles/**/*.txt
oracles/**/*.bak
oracles/*.csv
oracles/*.txt
oracles/*.bak

# SO / IDE
Thumbs.db
.DS_Store
.idea/
.vscode/

# Modelos externos
sidecar/kronos_env/
sidecar/Kronos/
sidecar/pesos/

# Backups locales NT8
archive/nt8_cs_backup/

# salidas descargadas de kernels de Kaggle (artefactos locales, no fuente)
notebooks/kaggle/**/output/
notebooks/kaggle/**/output_v2/
