{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://edgelab.local/schemas/edge_brain/coverage_artifact.json","type":"object","additionalProperties":false,"required":["coverage_artifact_id","schema_version","created_at_utc","holdout_boundary_ns","code_commit","invariants","cells","state_counts"],"properties":{"coverage_artifact_id":{"type":"string","pattern":"^COV-[a-f0-9]{16}$"},"schema_version":{"const":"1.0.0"},"created_at_utc":{"type":"string","format":"date-time"},"holdout_boundary_ns":{"type":"integer"},"code_commit":{"type":"string","minLength":7},"invariants":{"type":"array","items":{"type":"string"}},"state_counts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},"cells":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["instrument","contract","calendar_month","state","observed_active_minutes","expected_active_minutes","evidence_ref"],"properties":{"instrument":{"type":"string"},"contract":{"type":"string"},"calendar_month":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}$"},"state":{"enum":["OBSERVED","OBSERVED_PARTIAL","OBSERVED_SPARSE","NOT_OBSERVED","EXPECTED_BUT_MISSING","NOT_ELIGIBLE"]},"observed_active_minutes":{"type":["integer","null"],"minimum":0},"expected_active_minutes":{"type":["integer","null"],"minimum":0},"evidence_ref":{"type":["string","null"]}}}}}}
