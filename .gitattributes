# Force LF line endings for specs and markdown docs to ensure SHA-256 hash stability across Windows and Linux
* text=auto

specs/*.json text eol=lf
docs/*.md text eol=lf
docs/**/*.md text eol=lf
*.md text eol=lf
artifacts/hippocampus/*.jsonl -text
# Corpus SSRN in-repo: byte-exact (los hashes de custodia son sobre bytes)
corpus/ssrn/** -text
