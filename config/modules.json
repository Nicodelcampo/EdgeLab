    "0": "Fuentes externas y captura",
    "1": "Configuracion, instrumentos y sesiones",
    "2": "Datos y custodia",
    "3": "Indicadores y kernels",
    "4": "Contexto, estadistica y busqueda",
    "5": "Ejecucion y validacion",
    "6": "Memoria y gobernanza",
    "7": "Operacion e interfaces"
  },
  "status_values": [
    "core",
    "experimental",
    "legacy",
    "planned"
