# Copy to config/local.toml (gitignored). Never add credentials here.
# local.toml > environment > default.toml > workspace defaults.
[paths]
# root = "/absolute/path/to/edgelab-workspace"
# data_dir = "/absolute/path/to/data"
# nt8_export_root = "/absolute/path/to/approved-exports"
# vectorbt_ecosystem_root = "/absolute/path/to/approved-legacy-sources"
# es_ticks = "/absolute/path/to/approved-es-ticks.parquet"
# nq_raw_dir = "/absolute/path/to/approved-nt8-raw"
# eurusd_ticks_raw = "/absolute/path/to/approved-eurusd.csv"
# Paths do NOT grant approval to read data. Use the campaign manifest.
