# PLANTILLA — copiá a config/local.toml (gitignored) y ajustá a ESTA máquina.
# config/local.toml tiene la MÁXIMA precedencia. Solo rutas; sin secretos.
# Usá barras normales (/) para evitar problemas con backslashes.
#
# Alternativa sin archivo: exportar variables de entorno EDGELAB_* (menor
# precedencia que local.toml). Ej: EDGELAB_VECTORBT_ROOT, EDGELAB_CEREBRO_ROOT.

[paths]
# --- fuentes externas del ecosistema (read-only) ---
# vectorbt_ecosystem_root = "C:/ProyectosQuant/VectorBTecosistema"   # -> ES_TICKS, ES_M1
# cerebro_root            = "C:/ProyectosQuant/CerebroSSRN"          # ledger científico
# nq_raw_dir              = "D:/A  Trading"                          # exports NT8 por contrato
# eurusd_ticks_raw        = "C:/Users/<vos>/JForex4/viewer/data/EURUSD_ticks.csv"
# nt8_export_root         = "C:/ruta/a/exports/nt8"                  # futuro NT8 Bridge

# --- directorios internos (opcional: reubicar fuera del repo) ---
# artifacts_dir = "D:/EdgeLabArtifacts"
# runs_dir      = "D:/EdgeLabRuns"
